{
  "schema_version": 1,
  "instance": {
    "id": "genshin-ts",
    "name": "Genshin-TS"
  },
  "pkc": {
    "version": "0.1.0",
    "projection_path": ".local/knowledge"
  },
  "adapter": {
    "skill": ".agents/skills/genshin-ts-project-adapter/SKILL.md",
    "task_start": {
      "memory_then_knowledge_signals": [
        "complex_diagnosis",
        "architecture_or_domain_change",
        "historical_constraint",
        "cross_file_judgment",
        "real_environment_evidence",
        "static_gil_asset_work",
        "game_map_writeback",
        "injection_or_overwrite_safety"
      ],
      "knowledge_levels": [
        1,
        2
      ],
      "mechanical_default": "no_query"
    },
    "task_end": {
      "value_signals": [
        "stable_diagnostic_constraint",
        "red_green_regression",
        "external_environment_evidence",
        "architecture_decision",
        "knowledge_invalidated",
        "production_validation_closed_loop"
      ],
      "max_bundles": 3,
      "default_write": false
    }
  },
  "authority": {
    "registry": "data/knowledge/registry.json",
    "actors": "data/knowledge/actors.json",
    "store": "data/knowledge",
    "knowledge": "knowledge"
  },
  "identities": {
    "principal": {
      "id": "project-owner"
    },
    "executor": {
      "id": "pi"
    },
    "workspace": {
      "id": "genshin-ts-feat-composite",
      "path": "."
    },
    "writer": {
      "id": "project-owner"
    }
  },
  "compatibility": {
    "v1_actor_map": {
      "project-owner": "project-owner"
    },
    "confirmed_mapping": {
      "review_status": "human_confirmed",
      "verification_scope": "explicit_required"
    }
  },
  "memory": {
    "roles": [
      {
        "role": "operating_entry",
        "path": "AGENTS.md",
        "mutation_policy": "reference"
      },
      {
        "role": "current_recovery",
        "path": "docs/project-intelligence/CURRENT.md",
        "mutation_policy": "replace"
      },
      {
        "role": "decision_entry",
        "path": "docs/composite-ir/architecture-redesign/decision-log.md",
        "mutation_policy": "curated_history"
      }
    ],
    "contexts": [
      {
        "id": "compiler-diagnostics",
        "default": false,
        "lifecycle": "active",
        "goal": "Diagnose and fix complex compiler bugs with reproducible IR/GIA and editor/game evidence.",
        "recovery_role": "current_recovery",
        "validation_gate": "npm run build && focused compiler regression && git diff --check",
        "priority": 2,
        "applies_to": {
          "paths": [
            "src/compiler/**",
            "tests/composite/**",
            "docs/architecture/composite/**",
            "docs/composite-ir/**"
          ],
          "workspaces": [
            "genshin-ts-feat-composite"
          ],
          "branches": [
            "feat/composite"
          ]
        },
        "current_recovery": "docs/project-intelligence/CURRENT.md#compiler-diagnostics"
      },
      {
        "id": "static-gil-assembly-production",
        "default": true,
        "lifecycle": "active",
        "goal": "Develop static GIL assembly creation into a configurable, regression-tested, backed-up, and game-validated production workflow.",
        "current_recovery": "docs/project-intelligence/contexts/static-gil-assembly-production.md",
        "validation_gate": "npm run build && focused static assembly regression && independent candidate/raw-wire validation && git diff --check; real-map writes require explicit confirmation and game behavior requires user confirmation",
        "priority": 1,
        "applies_to": {
          "paths": [
            "src/cli/gil_static_assemblies.ts",
            "src/cli/assets_static_assemblies.ts",
            "tests/gil_static_assemblies.ts",
            "docs/architecture/gil-static-model-assets.md",
            "knowledge/static-gil-assets/**",
            "knowledge/game-map-writeback/**"
          ],
          "workspaces": [
            "genshin-ts-feat-composite"
          ],
          "branches": [
            "feat/composite"
          ]
        },
        "recovery_role": "current_recovery"
      }
    ],
    "startup_budget": {
      "max_files": 3,
      "max_characters": 14000
    },
    "applies_to": {
      "workspace": ".",
      "branches": [
        "feat/composite"
      ]
    }
  },
  "relations": {
    "context_nodes": [
      {
        "context_id": "compiler-diagnostics",
        "node_id": "compiler-diagnostics"
      },
      {
        "context_id": "compiler-diagnostics",
        "node_id": "composite-boundary"
      },
      {
        "context_id": "compiler-diagnostics",
        "node_id": "validation-evidence"
      },
      {
        "context_id": "static-gil-assembly-production",
        "node_id": "static-gil-assets"
      },
      {
        "context_id": "static-gil-assembly-production",
        "node_id": "game-map-writeback"
      },
      {
        "context_id": "static-gil-assembly-production",
        "node_id": "validation-evidence"
      }
    ],
    "decision_claims": [],
    "evidence_pointers": [
      {
        "id": "ptr-static-assembly-production-validation",
        "kind": "resolvable",
        "reality_key": "static-assembly-production-validation-2026-07-25",
        "path": "docs/architecture/gil-static-model-assets.md",
        "locator": "section 19.2.1 and maintenance record"
      }
    ]
  }
}
