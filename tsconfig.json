{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "genshin-ts": ["./src/index.ts"],
      "genshin-ts/*": ["./src/*"]
    },

    "lib": ["ES2022"],
    "types": ["gsts", "node"],
    "typeRoots": ["./types-local", "./node_modules/@types"],

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "composite": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "noImplicitReturns": true
  },
  "include": [
    "src",
    "src/**/*.d.ts",
    "src/**/*.json",
    "scripts",
    "examples",
    "tests",
    "tools/explain-gil-node-graph.ts",
    "tools/parse-gil-node-graph.ts",
    "resources/**/*.json",
    "gsts.config.ts",
    "gsts.test.config.ts"
  ],
  "exclude": [
    "tests/generated",
    "tests/enum_cases",
    "tests/composite",
    "src/runtime/server_globals.d.ts",
    "examples/**/*.fragment.ts",
    "examples/rubik-2x2"
  ]
}
