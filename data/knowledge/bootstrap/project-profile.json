      "role": "editor/game candidate and validation artifacts"
    }
  ],
  "memory_role_candidates": [
    {
      "role": "operating_entry",
      "path": "AGENTS.md",
      "status": "mapped"
    },
    {
      "role": "current_recovery",
      "path": "docs/composite-ir/architecture-redesign/STATUS.md",
