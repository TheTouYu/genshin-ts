      "path": "docs/architecture/composite/testing.md",
      "status": "mapped"
    }
  ],
  "input_types": [
    "compiler bug report",
    "minimal TypeScript fixture",
    "IR JSON",
    "real GIA reference",
    "editor/game validation feedback"
  ],
  "evidence_types": [
    "committed source and config authority",
    "focused red-to-green regression",
    "real GIA structural/wire observation",
    "reproducible commit baseline",
    "editor import observation",
    "user-confirmed game behavior"
  ],
  "state_sources": {
    "committed": [
      "Git HEAD 4db6c96e0b7905134eeb23088c3351b431841a06",
      "tracked source/tests/docs"
    ],
    "working": [
      "git status --short --branch",
      "working-tree observations remain pending/proposal"
    ],
    "released": [
      "Changelog.md",
      "Changelog_ZH.md",
      "release tags when explicitly needed"
    ],
    "external": [
      "real GIA files",
      "Beyond_Local_Export candidates",
      "user editor/game confirmation"
    ]
  },
  "policy": {
    "permissions": "Repository content may be read in a bounded local workflow; game-file copy, injection, overwrite, deletion, mapId/nodeGraphId operations require explicit user confirmation.",
    "remote_models": "Only bounded, explicitly listed non-secret project content may be transferred; .env, credentials, user_edit bulk content, unrelated working-tree bodies, generated/vendor trees and game data are local-only by default.",
    "local_only_paths": [
      ".env",
      "user_edit",
      "Beyond_Local_Export",
      ".git",
      "node_modules",
      "src/thirdparty"
    ]
  },
  "completion_gates": [
    "Lock a concrete historical fixture and pre-fix red baseline",
    "Identify affected node family and legal exceptions",
    "Focused regression passes on current implementation",
    "Run npm run build and relevant adjacent Composite regressions",
    "Separate automatic, real-GIA, editor, and game evidence",
    "Record unverified scope and preserve existing working-tree changes"
  ],
  "exclusions": [
    "full-repository scan",
    "bulk history/document migration",
    "automatic Context/Node creation from directories",
    "unrelated working-tree body reads",
    "production compiler code modification during PPI Alpha",
    "game injection or overwrite",
    "automatic commit or push"
  ]
}
