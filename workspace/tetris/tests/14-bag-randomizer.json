  "asserts": [
    {
      "at": 15.4,
      "kind": "log",
      "contains": "gameover score=",
      "source": "client"
    },
    {
      "at": 15.4,
      "kind": "lua",
      "source": "local logs = query.logs()\nlocal pieces = {}\nfor _, line in ipairs(logs) do\n  local b, p = line:match('^bag=(%d+) piece=(%u)')\n  if b then pieces[#pieces + 1] = { bag = tonumber(b), name = p } end\nend\nassert(#pieces >= 40, 'pieces=' .. #pieces)\nlocal segs, cur = {}, {}\nfor _, e in ipairs(pieces) do\n  if #cur > 0 and e.bag < cur[#cur].bag then segs[#segs + 1] = cur; cur = {} end\n  cur[#cur + 1] = e\nend\nsegs[#segs + 1] = cur\nassert(#segs == 3, 'segs=' .. #segs)\nlocal NAMES = { I = 1, O = 1, T = 1, S = 1, Z = 1, J = 1, L = 1 }\nfor si, seg in ipairs(segs) do\n  assert(seg[1].bag == 1, 'seg' .. si .. ' firstbag=' .. seg[1].bag)\n  assert(seg[1].name ~= 'S' and seg[1].name ~= 'Z', 'seg' .. si .. ' first=' .. seg[1].name)\n  local byBag = {}\n  for _, e in ipairs(seg) do\n    byBag[e.bag] = byBag[e.bag] or {}\n    byBag[e.bag][#byBag[e.bag] + 1] = e.name\n  end\n  local maxBag = 0\n  for b in pairs(byBag) do if b > maxBag then maxBag = b end end\n  for b = 1, maxBag do\n    local names = byBag[b]\n    assert(names, 'seg' .. si .. ' bag' .. b .. ' missing')\n    if b < maxBag then\n      assert(#names == 7, 'seg' .. si .. ' bag' .. b .. ' n=' .. #names)\n    else\n      assert(#names <= 7, 'seg' .. si .. ' lastbag n=' .. #names)\n    end\n    local seen = {}\n    for _, n in ipairs(names) do\n      assert(NAMES[n], 'seg' .. si .. ' bad ' .. n)\n      assert(not seen[n], 'seg' .. si .. ' bag' .. b .. ' dup ' .. n)\n      seen[n] = 1\n    end\n  end\n  for i = 1, #seg - 11 do\n    local seen, n7 = {}, 0\n    for j = i, i + 11 do\n      if not seen[seg[j].name] then seen[seg[j].name] = 1; n7 = n7 + 1 end\n    end\n    assert(n7 == 7, 'seg' .. si .. ' win@' .. i .. ' kinds=' .. n7)\n  end\nend\nlocal expect = 'L,S,T,J,I,O,Z,T,O,J,L,Z,I,S'\nlocal got = {}\nfor i = 1, 14 do got[#got + 1] = segs[1][i].name end\nassert(table.concat(got, ',') == expect, 'seg1 first14=' .. table.concat(got, ','))\nassert(segs[1][15] ~= nil and segs[1][15].bag == 3, 'seg1 15th not bag3')\nreturn true"
    }
  ]
