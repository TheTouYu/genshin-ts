onClipEvent(keyDown){
   if(Key.isDown(74))
   {
      with(_parent._parent)
      {
         gotoAndPlay(180);
      }
   }
   if(Key.isDown(83))
   {
      with(_parent)
      {
         gotoAndPlay(5);
      }
   }
   if(Key.isDown(87))
   {
      with(_parent)
      {
         gotoAndPlay(10);
      }
   }
}
