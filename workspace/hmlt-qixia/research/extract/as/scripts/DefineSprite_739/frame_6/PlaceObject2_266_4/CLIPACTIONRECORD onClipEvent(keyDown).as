onClipEvent(keyDown){
   with(_parent)
   {
      if(Key.isDown(65))
      {
         gotoAndPlay(1);
      }
      if(Key.isDown(68))
      {
         gotoAndPlay(1);
      }
      if(Key.isDown(83))
      {
         gotoAndPlay(10);
      }
      if(Key.isDown(87))
      {
         gotoAndPlay(15);
      }
      if(Key.isDown(74))
      {
         with(_root.zp)
         {
            gotoAndStop(5);
            _quality = "medium";
         }
      }
   }
}
