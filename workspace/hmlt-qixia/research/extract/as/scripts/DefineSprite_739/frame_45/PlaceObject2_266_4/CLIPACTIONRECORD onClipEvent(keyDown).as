onClipEvent(keyDown){
   with(_parent)
   {
      if(Key.isDown(87))
      {
         gotoAndPlay(20);
      }
      if(Key.isDown(83))
      {
         gotoAndPlay(15);
      }
      if(Key.isDown(65))
      {
         gotoAndPlay(35);
      }
      if(Key.isDown(74))
      {
         fscommand("allowscale","false");
         gotoAndPlay(39);
      }
      if(Key.isDown(68))
      {
         gotoAndPlay(15);
      }
   }
}
