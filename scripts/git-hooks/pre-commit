#!/usr/bin/env bash
# doc_health pre-commit 门禁（源文件，安装到 .git/hooks/pre-commit）
# 安装：scripts/install-git-hooks.sh
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! python3 scripts/doc_health.py --staged; then
  echo ""
  echo "❌ doc_health 门禁未通过：请修复上述问题后重新提交。"
  echo "   手动检查：python3 scripts/doc_health.py"
  echo "   不要用 --no-verify 绕过（文档治理红线）。"
  exit 1
fi
exit 0
