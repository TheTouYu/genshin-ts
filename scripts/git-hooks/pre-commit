#!/usr/bin/env bash
# doc_health pre-commit 门禁（源文件，安装到 .git/hooks/pre-commit）
# 安装：scripts/install-git-hooks.sh
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! python3 scripts/doc_health.py --staged; then
  echo ""
  echo "❌ doc_health 门禁未通过：本次提交包含文档治理问题。"
  echo ""
  echo "🤖 AI 代理指引（请根据情况选择）："
  echo "   1) 如果只有少量具体问题：按上方 FAIL 逐条修复即可"
  echo "      （常见：补 doc-type/status/updated、补 @status、删陈旧句、更新 BOARD HEAD）。"
  echo "   2) 如果涉及多个文件、状态头协议、归档/收口、或你不确定规范："
  echo "      请加载技能 document-governance（.agents/skills/document-governance/SKILL.md），"
  echo "      或阅读 docs/maintenance/document-governance.md 后再修复。"
  echo ""
  echo "   修复后重新 git add + git commit。"
  echo "   不要用 git commit --no-verify 绕过（文档治理红线）。"
  exit 1
fi
exit 0
