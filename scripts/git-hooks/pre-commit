#!/usr/bin/env bash
# doc_health pre-commit 门禁（源文件，安装到 .git/hooks/pre-commit）
# 安装：bash scripts/install-git-hooks.sh
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Python 经 scripts/py.mjs 统一解析（GSTS_PYTHON → PATH 里的 python3 / python / py -3 → DSH 运行时）。
# 别在这里写死 python3：Win11 的 PATH 里一个入口都没有，写死会让钩子以 127 拦下全部提交（2026-11-25 实证）。
if ! command -v node >/dev/null 2>&1; then
  echo "❌ doc_health 门禁跑不起来：找不到 node（钩子经 scripts/py.mjs 找 Python，需要 node）。"
  echo "   装 node 后重新 git commit；不要用 git commit --no-verify 绕过（文档治理红线）。"
  exit 1
fi
rc=0
node scripts/py.mjs scripts/doc_health.py --staged || rc=$?

if [ "$rc" -eq 127 ]; then
  echo ""
  echo "❌ doc_health 门禁跑不起来：没有可用的 Python（诊断见上）。"
  echo "   修复环境后重新 git commit；不要用 git commit --no-verify 绕过（文档治理红线）。"
  exit 1
elif [ "$rc" -ne 0 ]; then
  echo ""
  echo "❌ doc_health 门禁未通过：本次提交包含文档治理问题。"
  echo ""
  echo "🤖 AI 代理指引（请根据情况选择）："
  echo "   1) 如果只有少量具体问题：按上方 FAIL 逐条修复即可"
  echo "      （常见：补 doc-type/status/updated、补 @status、删陈旧句、更新 BOARD HEAD）。"
  echo "   2) 如果涉及多个文件、状态头协议、归档/收口、或你不确定规范："
  echo "      请加载技能 document-governance（.agents/skills/document-governance/SKILL.md），"
  echo "      或阅读 docs/maintenance/document-governance.md 后再修复。"
  echo ""
  echo "   修复后重新 git add + git commit。"
  echo "   不要用 git commit --no-verify 绕过（文档治理红线）。"
  exit 1
fi
exit 0
