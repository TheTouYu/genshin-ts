  "rules": {
    "assets": {
      "name": "自定义变量（实体容器）",
      "container": "root5.1[entity].7.11（四类实体同构：关卡 def=10003004 固定 / 普通 def=资源定义如 10005018 / 玩家 def=1000000 / 角色 def=1000001；元件定义 root4.1.8.11 同构）",
      "entryForm": {
        "f2": "name：显式 UTF-8",
        "f3": "类型码（VarType：1=entity 2=guid 3=int 4=bool 5=float 6=str 8=int_list 9=bool_list 10=float_list 11=str_list 12=vec3 15=vec3_list 27=dict 等）",
        "f4": "默认值消息 {1:类型码, 2:{1:类型码, 2:{}} 双层包裹, f<类型码+10>:值}",
        "f5": "1（恒写）",
        "f6": "{1:类型码, 2:{}} 单层类型包裹（编辑器形态；旧实现多包一层已修）"
      },
      "valueForms": {
        "scalar-zero": "int 0 / bool false / str '' / float 0 → f<类型码+10> = 空消息（默认值省略哲学）",
        "scalar-nonzero": "int/float/bool/str 非默认值 → 显式 payload（str 在 f16.f1）",
        "vec3": "f22 = {1:{f1,f2,f3: fixed32}} 包裹，分量稀疏（零分量省略；全零 = {1:空}）",
        "lists": "f<类型码+10>：原始标量列表 packed（元素原始字节拼接；entity 元素=完整 {f1(varint)} 拼接）；str_list 重复 field1(len){字符串}；vec3_list 重复 field1(len){向量消息}（元素稀疏）",
        "dict": "f37 = parallel f501 keys + f502 values + f503 key 类型码 + f504 value 类型码；Map25 实体映射层非新建必需"
      },
