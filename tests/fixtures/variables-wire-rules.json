    "graph": {
      "name": "图变量（GraphVariable）",
      "container": "NodeGraph 消息 f6 graphValues（root10 图容器记录内）",
      "recordForm": {
        "f2": "name：显式 UTF-8",
        "f3": "VarType 类型码",
        "f4": "VarBase（值；列表=ArrayBase f109 逐元素记录）",
        "f5": "exposed（false 默认省略）",
        "f6": "structId（0 默认省略）",
        "f7": "keyType = 6（简单类型也写）",
        "f8": "valueType = 6"
      },
      "valueForms": {
        "list": "class=10002 ArrayBase + f2 alreadySetVal（非空列表保留）+ itemType{1:1,100:{类型}}（无 kind）+ f109 逐元素独立 VarBase 记录",
        "list-element-default": "元素 = {class, itemType, 空 payload}，无 f2 alreadySetVal、无 kind",
        "list-element-nondefault": "元素 = {class, f2 alreadySetVal=1, itemType, 显式 payload}（如 f102={1:1234}）",
        "empty-list": "列表层 alreadySetVal 也省略（编辑器 v6 变量_6..10）",
        "scalar-zero": "int/float/str/bool 零值 = {class, itemType{1:1,100:{类型}}, 空 payload}",
        "vec3-zero": "零 vec3 = class 7 + bVector{val:{}}",
        "scalar-nondefault": "非默认值 = alreadySetVal=1 + 显式 payload"
      },
