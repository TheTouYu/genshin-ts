def _warn_slow_path():
    import sys as _s
    try:
        if os.path.exists("/run/user/1000/ys-lookd.sock") or os.path.exists("/tmp/ys-lookd.sock"):
            print(SLOW_PATH_HINT, file=_s.stderr)
    except Exception:                                    # noqa: BLE001
        pass


def pick_window(wins, want, inbox=None):
    if want == "current" and inbox:
        sel = load_selected(inbox)
        if sel:
            for w in wins:                       # 先按 id 精确匹配
                if w.get("id") == sel.get("id"):
                    return w
            for w in wins:                       # 游戏重启后 id 会变 → 退化为按 class 匹配
                if sel.get("class") and sel["class"] in (w.get("class") or ""):
                    return w
        want = "auto"
    if want in (None, "", "auto"):
        for w in wins:
            if any(h in (w.get("class") or "").lower() for h in GAME_HINTS):
                return w
        return wins[0] if wins else None
    if want.startswith("idx:"):
        print("[ys-snap] 警告：idx 序号会随窗口堆叠变化，不是稳定身份；建议用 --window <类名> 或 0x<窗口id>", file=sys.stderr)
        try:
            i = int(want.split(":", 1)[1])
        except Exception:  # noqa: BLE001
            return None
        for w in wins:
            if w.get("idx") == i:
                return w
        return None
    if want.startswith("0x"):
        for w in wins:
            if (w.get("id") or "").lower() == want.lower():
                return w
        return None
    want = want.lower()
    for w in wins:
        if want in (w.get("class") or "").lower() or want in (w.get("name") or "").lower():
            return w
    return None


class Snap:
    def __init__(self, display, inbox):
        self.display = display
        self.inbox = inbox
        self.raw = os.path.join(inbox, "raw")
        os.makedirs(self.raw, exist_ok=True)
        self.manifest = os.path.join(inbox, "manifest.jsonl")
        self.cap = load_capture()
        self.seen = self._load_sha()

    def _load_sha(self):
        s = set()
        if os.path.exists(self.manifest):
            for line in open(self.manifest, encoding="utf-8"):
                try:
                    s.add(json.loads(line)["sha"])
                except Exception:  # noqa: BLE001
                    pass
        return s

    def _resolve_x11_id(self, win):
        """从 class 反查 X11 窗口 id（按面积取最大）。

        为什么需要：`list_windows_kwin()` 走 ys-wins，**不带 id**（它的输出没有这一列），
        于是 XShm 快路径每次都 KeyError 落到 KWin 慢路径——这正是"说好快路径却 4.8s"的第三层原因。
        判据与 ys-win-id 一致：同一 class 常有主窗 + 1×1 幽灵窗 + 窄面板，取面积最大的那个。
        """
        if win.get("id"):
            return win["id"]
        key = (win.get("class") or "").split()[0].lower()
        if key.endswith(".exe"):
            key = key[:-4]
        if not key:
            return None
        try:
            ids = subprocess.run(["xdotool", "search", "--class", key],
                                 capture_output=True, text=True, timeout=10).stdout.split()
        except Exception:  # noqa: BLE001
            return None
        best, best_area = None, 0
        for i in ids:
            try:
                g = subprocess.run(["xdotool", "getwindowgeometry", i],
                                   capture_output=True, text=True, timeout=5).stdout
                m = re.search(r"Geometry:\s*(\d+)x(\d+)", g)
                if not m:
                    continue
                area = int(m.group(1)) * int(m.group(2))
                if area > best_area:
                    best, best_area = "0x%x" % int(i), area
            except Exception:  # noqa: BLE001
                continue
        if best:
            win["id"] = best          # 回填，落盘记录里就能看到真正抓到的是哪个窗口
        return best

    def _grab_union(self, win):
        """把同一 class 的**多个 X 窗口按屏幕位置拼成一张整图**。

        为什么需要（2026-10-20 实测）：千星编辑器不是一个窗口，而是**多个 X 窗口拼起来的**——
          52428805  384×1371   左栏资源树
          52428808 2176×1371   主画布
          + 5 个 1×1 幽灵窗
        只抓"最大的那个"会丢掉左栏，而用户演示「新建节点图」全在左栏里。

        返回 (rgb, ms, note)；拼不起来返回 (None, None, 原因)。
        """
        import numpy as np
        import time as _t
        _t0 = _t.perf_counter()
        key = (win.get("class") or "").split()[0].lower()
        if key.endswith(".exe"):
            key = key[:-4]
        try:
            ids = subprocess.run(["xdotool", "search", "--class", key],
                                 capture_output=True, text=True, timeout=10).stdout.split()
        except Exception as e:  # noqa: BLE001
            return None, None, f"枚举窗口失败：{e}"
        parts, x0, y0, x1, y1 = [], None, None, None, None
        for i in ids:
            try:
                g = subprocess.run(["xdotool", "getwindowgeometry", i],
                                   capture_output=True, text=True, timeout=5).stdout
                mp = re.search(r"Position:\s*(-?\d+),(-?\d+)", g)
                mg = re.search(r"Geometry:\s*(\d+)x(\d+)", g)
                if not mp or not mg:
                    continue
                px, py = int(mp.group(1)), int(mp.group(2))
                w, h = int(mg.group(1)), int(mg.group(2))
                if w * h <= 4:               # 1×1 幽灵窗
                    continue
                grabber = self.cap.XShmGrabber(self.display, int(i), w, h)
                try:
                    rgb, _ms = grabber.grab()
                finally:
                    grabber.close()
                parts.append((px, py, rgb))
                x0 = px if x0 is None else min(x0, px)
                y0 = py if y0 is None else min(y0, py)
                x1 = px + w if x1 is None else max(x1, px + w)
                y1 = py + h if y1 is None else max(y1, py + h)
            except Exception:  # noqa: BLE001
                continue
        if not parts:
            return None, None, "union: 没有可拼的窗口"
        W, H = x1 - x0, y1 - y0
        canvas = np.zeros((H, W, 3), dtype=np.uint8)
        for px, py, rgb in parts:
            h, w = rgb.shape[:2]
            canvas[py - y0:py - y0 + h, px - x0:px - x0 + w] = rgb
        return canvas, (_t.perf_counter() - _t0) * 1000, f"union {len(parts)} 窗 {W}x{H}"

    def grab_once(self, win, fast=True):
        """抓一帧。

        2026-10-20 修三处（用户反馈「我选的是 beyondeditor，为什么 4.8s」）：
          ① **GUI 从来没有传 fast=True** ⇒ 每次必走 KWin SS2 4.8s。缺省改成 True。
          ② `is_game` 用的是 GAME_HINTS=(yuanshen, genshin)，**编辑器不算游戏**——
             当初限制 XShm 是因为"对游戏持续抓帧会拖死 presentation"，编辑器无此风险
             （D450 实测编辑器窗 XShm 活帧正常）。所以编辑器现在走快路径（~10ms）。
          ③ 给 KWin 的 class 键去掉 `.exe` 后缀：ys-wins 报的是 `beyondeditor.exe`，
             而 KWin 的 resourceClass 是不带后缀的 ⇒ 带后缀 indexOf 匹配不到。
        """
        cls = (win.get("class") or "").lower()
        is_game = any(h in cls for h in GAME_HINTS)
        note = ""
        rgb = ms = None
        # 2026-10-20 第三版：**XShm 按 id 精抓（快），KWin 兜底（稳）**。
        # 速度账：XShm 3-15ms；KWin 首次要 1.6s（KWin 脚本往返）+ 之后 30-150ms。
        # 崩溃账：XShmGetImage 尺寸不符会让 X 服务端 abort —— 所以
        #   ① 下手前重新问几何（不信列表快照）；② 整个抓帧跑在**子进程**里且**关掉 core dump**
        #   （`ulimit -c 0`），崩了只是非零退出码，不会弹 drkonqi。
        wid = win.get("id")
        if wid:
            try:
                g2 = subprocess.run(["xdotool", "getwindowgeometry", str(int(wid, 16))],
                                    capture_output=True, text=True, timeout=5).stdout
                mg = re.search(r"Geometry:\s*(\d+)x(\d+)", g2)
                if not mg:
                    raise RuntimeError("拿不到窗口几何")
                pw, ph = int(mg.group(1)), int(mg.group(2))
                if pw * ph <= 4:
                    raise RuntimeError(f"窗口不可见（{pw}x{ph}）")
                g = self.cap.XShmGrabber(self.display, int(wid, 16), pw, ph)
                try:
                    rgb, ms = g.grab()
                finally:
                    g.close()
                return rgb, ms, "xshm-window", note
            except Exception as e:  # noqa: BLE001
                note = f"xshm 失败({e})，退 KWin"
        key = (win.get("class") or win.get("name") or "yuanshen").split()[0]
        if key.lower().endswith(".exe"):
            key = key[:-4]
        ks = self.cap.KWinSS2(key, want_w=win.get("w"), want_h=win.get("h"))
        rgb, ms, meta = ks.grab()
        return rgb, ms, "kwin-ss2", note

    def save(self, rgb, ms, src, note="", win=None):
        data = self.cap.encode_jpg(rgb, quality=92)
        sha = hashlib.sha256(data).hexdigest()
        if sha in self.seen:
            return {"ok": True, "dup": True, "ms": round(ms, 1), "src": src}
        name = "snap_%s.jpg" % time.strftime("%Y-%m-%d_%H-%M-%S")
        path = os.path.join(self.raw, name)
        with open(path, "wb") as f:
            f.write(data)
        rec = {"src": "ys-snap", "capture_source": src, "dst": os.path.abspath(path),
               "sha": sha, "w": rgb.shape[1], "h": rgb.shape[0], "bytes": len(data),
               "window": (win or {}).get("class"), "window_id": (win or {}).get("id"),
               "note": note, "mtime": time.strftime("%Y-%m-%dT%H:%M:%S"),
               "ingested_at": time.strftime("%Y-%m-%dT%H:%M:%S")}
        with open(self.manifest, "a", encoding="utf-8") as mf:
            mf.write(json.dumps(rec, ensure_ascii=False) + "\n")
        self.seen.add(sha)
        # 账本 F-1-02：抓帧"成功"但 0 字节/极小文件 = 假成功（曾把失败耗时当快路径）
        try:
            _sz = os.path.getsize(path)
        except Exception:                                # noqa: BLE001
            _sz = 0
        if _sz < 4096:
            return {"ok": False, "error": "EMPTY_CAPTURE", "path": path, "bytes": _sz,
                    "hint": "抓到的帧为空/极小（多半是窗口不是目标窗，或窗口被最小化）"}
        return {"ok": True, "dup": False, "path": path, "bytes": _sz, "ms": round(ms, 1),
                "w": rgb.shape[1], "h": rgb.shape[0], "src": src}


def run_gui(display, snap, want=""):
    import tkinter as tk
    from tkinter import ttk

    wins = list_windows_kwin() or list_windows(display)
    root = tk.Tk()
    root.title("素材快收")
    root.geometry("520x420+40+40")
    root.attributes("-topmost", True)

    ttk.Label(root, text="选择要抓的窗口（双击 = 抓一张）").pack(anchor="w", padx=8, pady=(8, 2))
    lb = tk.Listbox(root, height=14)
    lb.pack(fill="both", expand=True, padx=8)

    def refresh():
        lb.delete(0, "end")
        wins.clear()
        wins.extend(list_windows_kwin() or list_windows(display))
        for w in wins:
            label = f'[{w.get("idx","?")}] {w.get("class","")[:26]:<26} {w["w"]}x{w["h"]}'
            label += "  (最小化)" if w.get("minimized") else ""
            lb.insert("end", label + "  " + (w.get("title") or w.get("name") or "")[:26])
        if want:
            for i, w in enumerate(wins):
                if want.lower() in (w.get("class") or "").lower():
                    lb.selection_set(i)
                    lb.see(i)
                    break

    status = tk.StringVar(value="双击列表项 = 抓一张")
    ttk.Label(root, textvariable=status).pack(anchor="w", padx=8, pady=4)

    def on_select(_evt=None):
        sel = lb.curselection()
        if not sel:
            return
        win = wins[sel[0]]
        save_selected(snap.inbox, win)
        label = (win['class'].split() or [win['id']])[0]
        status.set(f"已选：{label}｜热键命令可直接抓它")

    def toast(ok, text):
        """右下角小提示，1.6s 自动消失。

        为什么必须加（用户原话）：「你就不考虑，截图之后加一个小小的提示吗通知告诉用户截图成功还是失败吗？
        不要太明显，怕影响用户截图。我刚刚截了几张图片，但是不知道成功了没有」

        2026-10-20 第二次修：Tk 自绘的小窗在游戏全屏时**十次只出现一次**（用户实测），
        因为 overrideredirect + alpha 的 Xwayland 窗口不保证被合成器绘制在最上层。
        改为**系统通知**（notify-send）：KDE 原生，不抢焦点、自动消失、永远在最上层，
        并且落在通知中心里可以回看——这才叫"截完知道成没成"。
        Tk 小条保留作兜底（系统通知不可用时至少窗口里有痕迹）。
        """
        title = "✓ 已保存" if ok else "✗ 没存上"
        icon = "dialog-information" if ok else "dialog-error"
        try:
            import threading as _th
            _th.Thread(target=lambda: subprocess.run(
                ["notify-send", "-a", "素材快收", "-t", "1400", "-i", icon,
                 f"{title}｜素材快收", text],
                capture_output=True, timeout=10), daemon=True).start()
        except Exception:  # noqa: BLE001  提示失败绝不能影响抓图
            pass
        try:
            t = tk.Toplevel(root)
            t.overrideredirect(True)          # 无标题栏，也不会抢焦点
            t.attributes("-topmost", True)
            t.attributes("-alpha", 0.80)
            sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
            w, h = 240, 44
            t.geometry(f"{w}x{h}+{sw - w - 28}+{sh - h - 90}")
            bg = "#1f7a3d" if ok else "#8a2b2b"
            fr = tk.Frame(t, bg=bg)
            fr.pack(fill="both", expand=True)
            tk.Label(fr, text=("✓ " if ok else "✗ ") + text, bg=bg, fg="#ffffff",
                     font=("sans", 10), anchor="w", justify="left").pack(
                         fill="both", expand=True, padx=10)
            t.after(1600, t.destroy)
        except Exception:  # noqa: BLE001
            pass

    def do_snap(_evt=None):
        sel = lb.curselection()
        if not sel:
            status.set("先选一个窗口")
            return
        win = dict(wins[sel[0]])
        save_selected(snap.inbox, win)
        # 抓帧**放进子进程**：XShm 尺寸不符时 Xlib 默认错误处理是 abort 整个进程
        # （2026-10-20 实测：用户点「抓一张」，GUI 当场 core dump，PID 1557132）。
        # 子进程崩了 GUI 只看到非零退出码，不会再被带走。
        # 同时放到**后台线程**里跑：子进程要几十到几百毫秒，同步跑会冻结界面、
        # 连提示都弹不出来（用户只能干等，不知道成没成功）。
        wid = win.get("id")
        cls0 = (win.get("class") or "").split()[0]
        inner = [sys.executable, os.path.abspath(__file__), "--snap", "--inbox", snap.inbox,
                 "--window", cls0]
        if wid:
            # 带上 id + 逻辑尺寸：子进程**不用再枚举窗口**（那才是"慢到不行"的主因）
            inner += ["--id", wid, "--size", f"{win.get('w')}x{win.get('h')}"]
        import shlex
        # ulimit -c 0：XShm 万一 abort，别产生 core dump、别弹 drkonqi 崩溃通知
        cmd = ["bash", "-c", "ulimit -c 0; exec " + " ".join(shlex.quote(x) for x in inner)]
        status.set("抓取中…")

        def work():
            try:
                p = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            except Exception as e:  # noqa: BLE001
                root.after(0, lambda: (toast(False, f"启动失败：{e}"), status.set(f"✗ {e}")))
                return

            def done():
                if p.returncode != 0:
                    tail = (p.stderr or p.stdout or "").strip().splitlines()[-1:] or ["未知错误"]
                    toast(False, f"抓帧崩溃 rc={p.returncode}")
                    status.set(f"✗ 子进程退出码 {p.returncode}：{tail[0][:70]}")
                    return
                try:
                    r = json.loads(p.stdout.strip().splitlines()[-1])
                except Exception:  # noqa: BLE001
                    toast(False, "输出无法解析")
                    status.set("✗ 抓帧输出无法解析")
                    return
                if not r.get("ok"):
                    toast(False, str(r.get("error") or "失败"))
                    status.set(f"✗ {r.get('error')}：{r.get('hint', '')}")
                    return
                if r.get("dup"):
                    # 去重是静默的坑：用户以为抓了 5 张，其实只存了 1 张。必须说出来。
                    toast(True, "画面相同，未新存")
                    status.set("重复画面（未重复落盘）")
                    return
                name = os.path.basename(r.get("path", ""))
                toast(True, f"{r.get('w')}x{r.get('h')} {name[-8:]}")
                status.set(f"✓ {name}｜{r.get('src')}｜{r.get('ms')}ms")

            root.after(0, done)

        import threading
        threading.Thread(target=work, daemon=True).start()

    lb.bind("<<ListboxSelect>>", on_select)
    lb.bind("<Double-Button-1>", do_snap)
    bar = ttk.Frame(root)
    bar.pack(fill="x", padx=8, pady=(0, 8))
    ttk.Button(bar, text="刷新列表", command=refresh).pack(side="left")
    ttk.Button(bar, text="抓一张", command=do_snap).pack(side="left", padx=6)
    ttk.Button(bar, text="关闭", command=root.destroy).pack(side="right")
    refresh()
    root.mainloop()


def main():
    _warn_slow_path()
    ap = argparse.ArgumentParser()
    ap.add_argument("--display", default=os.environ.get("DISPLAY", ":1"))
    ap.add_argument("--inbox", default=INBOX_DEFAULT)
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--snap", action="store_true")
    ap.add_argument("--gui", action="store_true")
    ap.add_argument("--window", default="auto")
    ap.add_argument("--fast", action="store_true", help="(已弃用) 旧 XShm 快路径，会崩，保留只为兼容")
    ap.add_argument("--id", help="X11 窗口 id（hex）。给了就**跳过窗口枚举**，直接抓它")
    ap.add_argument("--size", help="该窗口的逻辑尺寸 WxH（用于 KWin 精确定位）")
    args = ap.parse_args()

    if args.list:
        for w in (list_windows_kwin() or list_windows(args.display)):
            tag = f'[{w.get("idx","?")}]' if "idx" in w else w.get("id", "")
            print(f'{tag:<5} {w.get("class","")[:28]:<28} {w["w"]}x{w["h"]}  '
                  f'{"(最小化)" if w.get("minimized") else ""} {w.get("title") or w.get("name") or ""}')
        return 0

    snap = Snap(args.display, args.inbox)
    if args.gui:
        run_gui(args.display, snap, args.window)
        return 0
    if args.snap:
        if args.id:
            # 快路径：G**不枚举窗口**。原来每次抓图都要跑一遍 ys-wins + 每个 class 的
            # xdotool search/geometry（十几到几十个子进程），这才是"慢到不行"的主因。
            sw, sh = (args.size or "0x0").split("x")
            win = {"id": args.id, "class": args.window, "title": args.window,
                   "w": int(sw), "h": int(sh), "minimized": False}
        else:
            win = pick_window(list_windows_kwin() or list_windows(args.display), args.window, args.inbox)
        if not win:
            print(json.dumps({"ok": False, "error": "找不到目标窗口"}, ensure_ascii=False))
            return 2
        try:
            rgb, ms, src, note = snap.grab_once(win, fast=args.fast)
            r = snap.save(rgb, ms, src, note, win)
        except Exception as e:  # noqa: BLE001
            print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
            return 3
        print(json.dumps(r, ensure_ascii=False))
        return 0
    ap.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
