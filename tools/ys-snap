#!/usr/bin/env python3
"""ys-snap — 素材快收（薄客户端：抓帧交给既有抓帧层，本工具只管"选窗口 + 触发 + 落盘"）。

2026-10-19 事故后的设计修订（用户裁定）：
  上一版在后台起了 10fps 的常驻抓帧守护，连续读游戏窗口 **15 分钟、约 9000 次**，
  把原神的 presentation 拖死（游戏进程活着、GPU 0%、画面冻结）。
  ⇒ 本工具**不做任何后台轮询**：每次触发只抓一帧，抓完立刻释放共享内存段并退出。
  ⇒ 游戏窗口默认走 **KWin ScreenShot2**（读合成器自己的副本，约 250ms），不走 XShm 直读；
     只有显式 `--fast` 且目标不是游戏时才用 XShm（约 10ms）。

用法：
  ys-snap --list                       # 列出所有可抓窗口（class / 标题 / 尺寸）
  ys-snap --snap --window yuanshen     # 抓一帧到 inbox（按 class 子串选窗）
  ys-snap --snap --window 0x1400001    # 按窗口 id
  ys-snap --gui                        # 窗口选择器 GUI（列表 + 抓一张）
  ys-snap --snap --window auto --fast  # 显式允许 XShm 快路径（别对游戏用）

落盘：.scratch/gui-corpus/inbox/raw/snap_<ts>.jpg + manifest.jsonl（内容 sha256 去重）。
"""
import argparse
import hashlib
import importlib.util
import json
import os
import sys
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CAP_MODULE = os.path.join(HERE, "ys-editor", "ys_capture.py")
INBOX_DEFAULT = ".scratch/gui-corpus/inbox"
GAME_HINTS = ("yuanshen", "genshin")


def load_capture():
    spec = importlib.util.spec_from_file_location("ys_capture", CAP_MODULE)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)  # noqa: S301 本地自有模块
    return mod


def _x11_candidates(cls):
    """某个 class 在 X11 侧的全部窗口 [(id, w, h)]。"""
    import subprocess
    key = (cls or "").split()[0].lower()
    if key.endswith(".exe"):
        key = key[:-4]
    if not key:
        return []
    try:
        ids = subprocess.run(["xdotool", "search", "--class", key],
                             capture_output=True, text=True, timeout=10).stdout.split()
    except Exception:  # noqa: BLE001
        return []
    out = []
    for i in ids:
        try:
            g = subprocess.run(["xdotool", "getwindowgeometry", i],
                               capture_output=True, text=True, timeout=5).stdout
            m = re.search(r"Geometry:\s*(\d+)x(\d+)", g)
            if m:
                out.append((int(i), int(m.group(1)), int(m.group(2))))
        except Exception:  # noqa: BLE001
            continue
    return out


def list_windows_kwin():
    """KWin 全量窗口。**每个窗口一行**，但每行都带上它自己的 X11 id。

    2026-10-20 用户纠正：「它实际上有很多窗口的，单独选择窗口截图就是正确的做法，只是要修复 bug」。

    真正的 bug 是：列表行**没有 id**（ys-wins 不输出这一列），抓取时只能按 class 回查，
    而同一 class 下有多条（左栏 384x1371 / 主画布 2176x1371 / 若干 1x1 幽灵窗）
    ⇒ 回查到哪个算哪个。修法是**给每一行绑定它自己的 id**，选了谁就抓谁。

    ys-wins 给的是逻辑坐标（÷1.5），xdotool 给物理坐标 ⇒ 按 w/h 以 1.5 比例做最近匹配。
    """
    import subprocess
    try:
        out = subprocess.run([os.path.join(HERE, "ys-editor", "ys-wins")],
                             capture_output=True, text=True, timeout=15).stdout
    except Exception:  # noqa: BLE001
        return []
    cache = {}
    wins = []
    for line in out.splitlines():
        m = re.match(r"\[(\d+)\]\s+(.*?)\s+\|\s+(.*?)\s+\|\s+(\d+),(\d+)\s+(\d+)x(\d+)\s+\|\s+min=(\d)", line)
        if not m:
            continue
        idx, title, cls, xs, ys, ws, hs, mn = m.groups()
        cls = cls.strip()
        w, h = int(ws), int(hs)
        if cls not in cache:
            cache[cls] = _x11_candidates(cls)
        # 在同类候选里找尺寸最接近的（逻辑 1707 vs 物理 2560 ⇒ 比例 1.5）
        best, best_err = None, None
        best_wh = (w, h)
        for wid, cw, ch in cache[cls]:
            for scale in (1.0, 1.5):
                err = abs(cw - w * scale) + abs(ch - h * scale)
                if best_err is None or err < best_err:
                    best, best_err, best_wh = wid, err, (cw, ch)
        wins.append({"idx": int(idx), "title": title.strip(), "class": cls,
                     "x": int(xs), "y": int(ys), "w": w, "h": h,
                     "pw": best_wh[0], "ph": best_wh[1],   # 物理尺寸：XShm 必须按它抓
                     "id": ("0x%x" % best) if best else None,
                     "minimized": mn == "1"})
    return wins


def list_windows(display, min_side=200):
    from Xlib import display as xd, X
    d = xd.Display(display)
    out = []
    for w in d.screen().root.query_tree().children:
        try:
            a = w.get_attributes()
            if a.map_state != X.IsViewable:
                continue
            g = w.get_geometry()
            if g.width < min_side or g.height < min_side:
                continue
            cls = w.get_full_property(d.intern_atom("WM_CLASS"), X.AnyPropertyType)
            val = cls.value.decode("latin-1", "ignore").replace("\x00", " ").strip() if cls else ""
            name = w.get_wm_name() or ""
            if isinstance(name, bytes):
                name = name.decode("utf-8", "ignore")
            out.append({"id": hex(w.id), "class": val, "name": str(name)[:60],
                        "w": g.width, "h": g.height})
        except Exception:  # noqa: BLE001
            continue
    return out


def selected_path(inbox):
    return os.path.join(inbox, "selected-window.json")


def save_selected(inbox, win):
    with open(selected_path(inbox), "w", encoding="utf-8") as f:
        json.dump(win, f, ensure_ascii=False)


def load_selected(inbox):
    p = selected_path(inbox)
    if not os.path.exists(p):
        return None
    try:
        return json.load(open(p, encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return None


