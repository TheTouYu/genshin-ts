#!/usr/bin/env python3
"""failure-ledger — 失败账本与自我递归进化的仪表盘。

## 它解决什么问题

复盘最常见的失败：**记了，但没防线**。文档写得再细，下次遇到同类错误仍然照犯，
因为"记住"依赖人和模型的记忆，而记忆在换会话/压缩后会掉。

本工具把每条失败变成一行记录，并强制它绑定一条**可执行**的防线：
  · status=prevented  ⇒ gate 字段必须指向 `failure-ledger.gates.tsv` 里的检查命令，`check` 会真跑
  · status=open       ⇒ 没有机械防线（靠纪律/靠人看），仪表盘上单独计数 —— **open 数才是真债**

## 分类（6 类，每类有一个可判定的定义，避免主观分类）

  遗漏  该看的信息在产物里已有，但流程没用上（人眼可见、机器没看）
  身份  动作作用到了错误对象（坐标对、对象错；或清理命令匹配到自身）
  环境  同一命令在两个执行域行为不同（槽内/槽外、DISPLAY、剪贴板、路径）
  静默  失败没有信号（退出码 0 / stderr 空 / 静默降级），调用方无从发现
  归因  没做分层取证就下因果结论（结论先行、证据缺失）
  判据  判据/刻度本身不可信（阈值脆、单帧过拟合、量错对象或刻度）
  能力缺口 感知层没有对应读数，导致下游只能靠猜或降级（例：没有滚动条检测 ⇒ 只能滚轮逐屏、无法 seek）

用法:
  tools/failure-ledger add --class 身份 --symptom "..." --evidence "..." \
        --prevention "..." [--gate gate2] [--status prevented|open] [--id]
  tools/failure-ledger list [--class X] [--status open]
  tools/failure-ledger dashboard [--json]
  tools/failure-ledger check            # 真跑每个被引用的 gate（去重），任何 FAIL → 退出码 1
退出码: 0 正常 / 1 check 有 FAIL / 2 用法或数据错误
"""
import argparse
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
LEDGER = os.path.join(ROOT, 'docs/maintenance/failure-ledger.tsv')
GATES = os.path.join(HERE, 'failure-ledger.gates.tsv')
CLASSES = ('遗漏', '身份', '环境', '静默', '归因', '判据', '能力缺口')
COLS = ('id', 'date', 'class', 'symptom', 'evidence', 'prevention', 'gate', 'inject', 'status', 'note')


def read_tsv(path):
    if not os.path.exists(path):
        return []
    rows = []
    with open(path, encoding='utf-8') as fh:
        head = fh.readline().rstrip('\n').split('\t')
        for ln in fh:
            if not ln.strip() or ln.startswith('#'):
                continue
            vals = ln.rstrip('\n').split('\t')
            vals += [''] * (len(head) - len(vals))
            rows.append(dict(zip(head, vals)))
    return rows


def read_gates():
    return {g['gate']: g for g in read_tsv(GATES)}


def load():
    return read_tsv(LEDGER)


def cmd_add(a):
    if a['class'] not in CLASSES:
        print('错误：class 必须是 %s 之一' % '/'.join(CLASSES), file=sys.stderr)
        return 2
    rows = load()
    rid = a.get('id') or 'F-%s-%02d' % ((a.get('date') or '').replace('-', '') or 'nodate',
                                        len(rows) + 1)
    if a['status'] == 'prevented' and not a.get('gate'):
        print('错误：status=prevented 必须给 --gate（否则和 open 没区别）', file=sys.stderr)
        return 2
    if a.get('gate') and a['gate'] not in read_gates():
        print('错误：gate=%s 不在 %s 里；先登记检查命令' % (a['gate'], GATES), file=sys.stderr)
        return 2
    # 2026-10-21 修：argparse 对「给了 flag 但没给值」与「没给 flag」都返回 None，
    # `a.get('inject', '')` 只在 key 缺失时才有默认值 ⇒ 不传 --inject/--note 时写入即崩
    # （TypeError: sequence item 7: expected str instance, NoneType found）。统一 None→''。
    row = dict(zip(COLS, [rid, a.get('date') or '', a['class'], a['symptom'], a.get('evidence') or '',
                          a.get('prevention') or '', a.get('gate') or '', a.get('inject') or '',
                          a['status'], a.get('note') or '']))
    newfile = not os.path.exists(LEDGER)
    with open(LEDGER, 'a', encoding='utf-8') as fh:
        if newfile:
            fh.write('\t'.join(COLS) + '\n')
        fh.write('\t'.join(row[c] for c in COLS) + '\n')
    print('已记录 %s [%s/%s]' % (rid, a['class'], a['status']))
    return 0


def cmd_list(a):
    rows = load()
    if a.get('class'):
        rows = [r for r in rows if r['class'] == a['class']]
    if a.get('status'):
        rows = [r for r in rows if r['status'] == a['status']]
    for r in rows:
        print('%-12s %-10s %-4s %-6s %s' % (r['id'], r['date'], r['class'], r['status'],
                                            r['symptom'][:60]))
    print('— 共 %d 条' % len(rows))
    return 0


def stats():
    rows = load()
    total = len(rows)
    by_class = {c: 0 for c in CLASSES}
    for r in rows:
        if r['class'] in by_class:
            by_class[r['class']] += 1
    prevented = sum(1 for r in rows if r['status'] == 'prevented')
    open_ = total - prevented
    return {'total': total, 'by_class': by_class, 'prevented': prevented,
            'open': open_, 'prevented_ratio': round(prevented / total, 3) if total else 0.0,
            'rows': rows}


def cmd_dashboard(a):
    st = stats()
    rows = st['rows']
    if a.get('json'):
        print(json.dumps({k: v for k, v in st.items() if k != 'rows'}, ensure_ascii=False, indent=1))
        return 0
    print('══ 失败账本仪表盘 ══')
    print('总数 %d｜已建机械防线 %d｜**未建防线 %d**（这个数才是真债）'
          % (st['total'], st['prevented'], st['open']))
    print('\n【按类别分布】')
    for c in CLASSES:
        n = st['by_class'][c]
        bar = '█' * n
        print('  %-4s %2d %s' % (c, n, bar))
    print('\n【未建防线的条目】（每条都该变成工具/探针/门禁，或明确接受"靠纪律"）')
    any_open = False
    for r in rows:
        if r['status'] != 'prevented':
            any_open = True
            print('  %-12s %-4s %s' % (r['id'], r['class'], r['symptom'][:64]))
    if not any_open:
        print('  （无）')
    print('\n【同类复发检查】同一 class 若有 ≥3 条集中在同一提交窗口，说明该族治理失败')
    return 0


def audit_inject(gates_all):
    """静态审计：不执行任何门禁，只回答「注入用例到底能不能证明东西」。

    三类（2026-10-22 加，起因是发现 72 条里 15 条的 inject 就是 gate 命令本身）：
      · 真实注入   inject 是另一条命令（通常会先造故障再跑门禁）
      · 假注入     inject == 该账目自己的 gate 命令 ⇒ 只是重跑门禁，恒绿，证明不了任何事
      · 无注入     空 ⇒ 本来就是 unproven
    只比命令串（去空白归一），不执行——判内容必须跑起来才知道，那是 check 全量的活。
    """
    rows = [r for r in load() if r['status'] == 'prevented']
    real, fake, missing = [], [], []
    for r in rows:
        inj = ' '.join((r.get('inject') or '').split())
        _gl = [x.strip() for x in (r.get('gate') or '').split(',') if x.strip()]
        cmds = {' '.join((gates_all.get(one, {}).get('command') or '').split()) for one in _gl}
        if not inj:
            missing.append((r['id'], r.get('gate', '')))
        elif inj in cmds:
            fake.append((r['id'], r.get('gate', ''), inj))
        else:
            real.append((r['id'], r.get('gate', '')))
    for i, g, inj in fake:
        print('  [FAKE]  %-16s gate=%-20s inject 就是门禁命令：%s' % (i, g, inj[:80]))
    for i, g in missing:
        print('  [NONE]  %-16s gate=%s' % (i, g))
    print('INJECT-AUDIT prevented=%d real=%d fake=%d missing=%d verdict=%s'
          % (len(rows), len(real), len(fake), len(missing),
             'PASS' if not fake and not missing else 'FAIL'))
    return 0 if (not fake and not missing) else 1


def cmd_check(a):
    """（--fast：只跑 tier=fast 的 gate；慢 gate 留给出轮/夜间全量跑）"""
    """真跑每条 prevented 的 gate（去重）+ 它的注入用例；缺用例 = UNPROVEN，退出码 1。

    为什么要注入用例（2026-10-17 用户令）：`gate` 只能证明"门禁跑得起来"，
    不能证明"它真能拦住这条账目对应的错误"。注入用例 = 主动造一次故障，门禁必须报红。
    """
    gates_all = read_gates()
    if a.get('audit_inject', False):
        return audit_inject(gates_all)
    gates = gates_all
    if a.get('fast', False):
        gates = {k: v for k, v in gates_all.items() if (v.get('tier') or 'fast') != 'slow'}
    skipped = 0
    rows = load()
    used_gates, fails, unproven, inject_fail, fake = [], 0, 0, 0, 0
    inj_done, inj_seen = {}, set()          # 注入用例按命令去重（见下）
    gate_ms, inject_ms = {}, {}             # 每项耗时（2026-10-22：优化前先量）
    _t_start = time.time()
    for r in rows:
        if r['status'] != 'prevented':
            continue
        # gate 字段支持逗号多值（实测 F-3-05 写的是 `act,slider`）：以前把整串当一个 key 查
        # ⇒ 明明两个 gate 都已登记，却报「未在 gates.tsv 登记」，账本常年红着 1 条（假红）。
        g = r.get('gate', '')
        _gl = [x.strip() for x in g.split(',') if x.strip()]
        # fast 模式：这条账目的 gate 全被 tier 过滤 ⇒ 连它的 inject 用例也跳过
        # （否则慢 gate 的注入脚本照样跑，--fast 仍要几分钟）
        if a.get('fast', False) and _gl and all((one in gates_all and one not in gates) for one in _gl):
            skipped += 1
            continue
        for one in _gl:
            if one in used_gates:
                continue
            if one in gates_all and one not in gates:
                skipped += 1
                continue
            used_gates.append(one)
            cmd = gates[one]['command'] if one in gates else ''
            if not cmd:
                print('  [FAIL] %-16s gate=%s 未在 gates.tsv 登记' % (r['id'], one)); fails += 1; continue
            _t0 = time.time()
            p = subprocess.run(cmd, shell=True, cwd=ROOT, capture_output=True, text=True)
            _ms = int((time.time() - _t0) * 1000)
            gate_ms[one] = gate_ms.get(one, 0) + _ms
            ok = p.returncode == 0
            fails += 0 if ok else 1
            tail = (p.stdout or p.stderr).strip().splitlines()
            print('  [%s] %-16s %6.1fs %s' % ('PASS' if ok else 'FAIL', one, _ms / 1000.0,
                                              tail[-1][:70] if tail else ''))
        inj = r.get('inject', '')
        if a.get('fast', False):
            continue          # fast = 只验门禁可跑；注入用例（造故障）留全量
        if not inj:
            print('  [UNPROVEN] %-12s 无注入用例（无法证明门禁非空转）' % r['id']); unproven += 1
            continue
        # 2026-10-22：**假注入**判别——inject 与它自己的 gate 命令完全相同 ⇒ 没造故障，
        # 只是把门禁又跑了一遍，恒绿。这类"有 inject 但证明不了任何事"的账目比空 inject 更危险：
        # 账本上它是绿的，看不出防线从未被检验过。实测当日 72 条里有 15 条是这种。
        # 判据只比命令串（去空白归一），不比脚本内容——比内容要跑起来才知道，代价太大。
        _inj_n = ' '.join(inj.split())
        _gate_cmds = {' '.join((gates_all.get(one, {}).get('command') or '').split())
                      for one in _gl}
        if _inj_n and _inj_n in _gate_cmds:
            # 2026-10-22：**不执行**——它等于把刚跑过的门禁再跑一遍，纯浪费（实测 13 条 ≈117s）。
            # 但也绝不记成通过：这类账目的防线从未被检验过，必须显式暴露成 fake。
            print('  [FAKE]   %-16s inject 与 gate 命令相同（重跑门禁，未造故障）' % r['id'])
            fake += 1
            continue
        # 注入用例**按命令去重**（2026-10-18 实测）：以前只对 gate 去重、对 inject 不去重，
        # 而同一条注入用例会被多条账目共用（`ledger-inject.sh regress-neg` 被 6 条引用）⇒
        # 同一条命令白跑 5 次。整轮 check 从 523s 降到 ~220s，纯属重复执行。
        # 语义不变：每条账目仍然"有注入用例且被判过"，只是判过的结果直接复用。
        if inj in inj_done:
            ok_inj, last_line = inj_done[inj]
        else:
            _t0 = time.time()
            pi = subprocess.run(inj, shell=True, cwd=ROOT, capture_output=True, text=True)
            inject_ms[inj] = int((time.time() - _t0) * 1000)
            ok_inj = pi.returncode == 0
            tail_i = (pi.stdout or pi.stderr).strip().splitlines()
            last_line = tail_i[-1][:70] if tail_i else ''
            inj_done[inj] = (ok_inj, last_line)
        inject_fail += 0 if ok_inj else 1
        reused = '  (复用)' if inj in inj_seen else ''
        inj_seen.add(inj)
        print('  [%s] %-16s inject %s%s' % ('PASS' if ok_inj else 'FAIL', r['id'],
                                            last_line, reused))
    # 2026-10-22：把「每个门禁/注入用例花了多久」打出来——没有计时就没法"先打主导项"，
    # 优化只能靠猜（本项目铁律：慢流程先拆环节计时）。
    _all = dict(gate_ms)
    for k, v in inject_ms.items():
        _all['inject:' + k.split('/')[-1][:28]] = v
    _top = sorted(_all.items(), key=lambda kv: -kv[1])[:10]
    print('LEDGER-TIMING total=%.1fs top=%s' % (time.time() - _t_start,
                                                ' | '.join('%s %.1fs' % (k, v / 1000.0)
                                                           for k, v in _top)))
    print('LEDGER-RESULT gates=%d skipped=%d gate_fail=%d unproven=%d fake_inject=%d '
          'inject_fail=%d verdict=%s'
          % (len(used_gates), skipped, fails, unproven, fake, inject_fail,
             'PASS' if (fails + unproven + fake + inject_fail) == 0 else 'FAIL'))
    return 0 if (fails + unproven + fake + inject_fail) == 0 else 1


def main():
    ap = argparse.ArgumentParser(description='失败账本（每条失败必须绑一条可执行防线）')
    sub = ap.add_subparsers(dest='cmd', required=True)
    a1 = sub.add_parser('add')
    for f in ('class', 'symptom', 'evidence', 'prevention', 'gate', 'inject', 'status', 'date', 'note', 'id'):
        a1.add_argument('--' + f, required=(f in ('class', 'symptom', 'status')))
    a1.set_defaults(func=cmd_add)
    a2 = sub.add_parser('list')
    a2.add_argument('--class')
    a2.add_argument('--status')
    a2.set_defaults(func=cmd_list)
    a3 = sub.add_parser('dashboard')
    a3.add_argument('--json', action='store_true')
    a3.set_defaults(func=cmd_dashboard)
    a4 = sub.add_parser('check')
    a4.add_argument('--fast', action='store_true', help='只跑 tier=fast 的 gate（快检）')
    a4.add_argument('--audit-inject', action='store_true',
                    help='静态审计注入用例（不执行任何门禁）：空 inject / 假 inject（== gate 命令）')
    a4.set_defaults(func=cmd_check)
    a = vars(ap.parse_args())
    return a['func'](a)


if __name__ == '__main__':
    sys.exit(main())
