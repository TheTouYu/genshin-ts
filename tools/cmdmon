#!/usr/bin/env python3
"""cmdmon — 独立命令监控模块（采集 / 报警 / 报告）。

存在理由（2026-10-17 用户提议）：
  「做一个独立的、监控全部执行命令追踪的监控模块。它简单但是有效，
    可以快速发现一些执行过程中的坑，全项目收益。」

它读 DSH 会话事件流（`~/.dsh/sessions/*/session.v4.jsonl.zstd`）——那里已经有
**每次工具调用**的名字、参数、起止时间、是否报错，不需要改任何现有工具，
也不需要重启任何进程。生产数据零侵入。

用法:
  tools/cmdmon scan                 # 一次性把当前会话灌进账本（幂等）
  tools/cmdmon report [--since 6h]  # 类别占比 / 最慢 / 失败 / 重复
  tools/cmdmon alerts [--since 6h]  # 只列异常（慢 / 失败 / 裸 sleep / 重试风暴 / GUI 风暴）
  tools/cmdmon daemon [--interval 2]  # 常驻：每 2s 增量采集并即时报警
  tools/cmdmon status

账本: ~/.dsh/cmdlog/{commands.jsonl, alerts.jsonl, state.json, daemon.log}
判据（报警五条，故意少而准）:
  slow    单次调用 ≥ 30s
  fail    isError=true 或输出含 [exit code: N≠0]
  sleep   bash 命令里出现裸 `sleep <数字>`（用时长冒充同步的经典缺陷）
  repeat  同一条命令 10 分钟内重复 ≥3 次（重试风暴 / 参数猜错）
  guistorm 120 秒内 GUI 类调用 ≥8 次（仪器在空转）
"""
import argparse
import fcntl
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from collections import defaultdict

HOME = os.path.expanduser('~')
HERE = os.path.dirname(os.path.abspath(__file__))   # tools/ —— 兄弟工具（agent-coach）与它同目录
LOGDIR = os.path.join(HOME, '.dsh', 'cmdlog')
COMMANDS = os.path.join(LOGDIR, 'commands.jsonl')
ALERTS = os.path.join(LOGDIR, 'alerts.jsonl')
STATE = os.path.join(LOGDIR, 'state.json')

CAT = {
    'gui': ('ys-', 'xdotool', 'ydotool', 'spectacle', 'import -window', 'kwin', 'ys_look',
            'ys-pointer', 'ys-peek', 'ys-act', 'ys-put', 'ys-state', 'ys-observe', 'ys-fast',
            'ys-switch', 'ys-play', 'ys-round', 'ys-verify'),
    'build': ('npm run build', 'gsts', 'tsc', 'build.mjs'),
    'test': ('npm test', 'npx tsx tests/', 'quicktest'),
    'git': ('git status', 'git add', 'git commit', 'git log', 'git diff', 'git show', 'git checkout'),
    'verify': ('tools/', 'python3 .agents/skills', '.agents/skills/debug-log'),
    'memory': ('memo_',),
    'context': ('compress', 'acp_status', 'decompress', 'search_context'),
    'explore': ('grep ', 'rg ', 'find ', 'ls ', 'cat ', 'sed -n', 'head ', 'tail ', 'wc -'),
}
TOOL_CAT = {'read': 'fs', 'write': 'fs', 'edit': 'fs', 'glob': 'fs', 'grep': 'fs',
            'memo_recall': 'memory', 'memo_write': 'memory', 'memo_stats': 'memory',
            'compress': 'context', 'acp_status': 'context',
            'subagent': 'delegate', 'workflow': 'delegate', 'subagent_fork': 'delegate',
            'ask_user_question': 'wait_human'}

SLOW_MS = 30000
SLEEP_RE = re.compile(r'\bsleep\s+[0-9]')
EXIT_RE = re.compile(r'\[exit code:\s*(-?\d+)\]')


def classify(name, args):
    if name in TOOL_CAT:
        return TOOL_CAT[name]
    if name != 'bash':
        return name
    try:
        cmd = json.loads(args).get('command', '')
    except Exception:
        cmd = str(args)
    for cat, pats in CAT.items():
        for p in pats:
            if p in cmd:
                return cat
    return 'bash-other'


def bash_cmd(args):
    try:
        return json.loads(args).get('command', '')
    except Exception:
        return str(args)


def latest_session(workspace=None):
    if workspace:
        pat = os.path.join(HOME, '.dsh', 'sessions', f'--*{workspace}*--', '*', 'session.v4.jsonl.zstd')
    else:
        pat = os.path.join(HOME, '.dsh', 'sessions', '*', '*', 'session.v4.jsonl.zstd')
    files = glob.glob(pat)
    return max(files, key=os.path.getmtime) if files else None


def decode(path):
    raw = open(path, 'rb').read()
    if path.endswith('.zstd'):
        p = subprocess.run(['zstd', '-dc'], input=raw, capture_output=True)
        raw = p.stdout or b''
    out = []
    for line in raw.decode('utf-8', 'replace').split('\n'):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except Exception:
            continue
    return out


def load_state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {'seen': [], 'path': None}


def save_state(st):
    st['seen'] = st['seen'][-8000:]
    tmp = STATE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(st, f)
    os.replace(tmp, STATE)


def parse_session(events):
    """返回 [(callId, ts_start_ms, name, args, dur_ms, is_error, exit_code)]"""
    calls, done = {}, {}
    for o in events:
        t = o.get('type')
        if t == 'tool/call':
            d = o.get('data', {})
            calls[d.get('callId')] = (o.get('time'), d.get('name', '?'), d.get('arguments', ''),
                                      d.get('turn'))
        elif t == 'tool/result':
            d = o.get('data', {})
            m = d.get('message', {}) or {}
            cid = m.get('toolCallId')
            text = json.dumps(m.get('content', ''), ensure_ascii=False)[:4000]
            ex = EXIT_RE.search(text)
            done[cid] = (o.get('time'), bool(m.get('isError')), int(ex.group(1)) if ex else None)
    rows = []
    for cid, (ts, name, args, turn) in calls.items():
        if cid not in done:
            continue
        end, is_err, exit_code = done[cid]
        rows.append((cid, ts, name, args, max(0, end - ts), is_err, exit_code))
    rows.sort(key=lambda r: r[1])
    return rows


def ingest(rows, st):
    """把新记录写进账本并返回新记录列表（持锁，避免守护与手动 scan 并发重复记账）"""
    os.makedirs(LOGDIR, exist_ok=True)
    lock = open(os.path.join(LOGDIR, 'ledger.lock'), 'w')
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        st.update(load_state())
        return _ingest_locked(rows, st)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


def _ingest_locked(rows, st):
    seen = set(st['seen'])
    new = []
    os.makedirs(LOGDIR, exist_ok=True)
    with open(COMMANDS, 'a') as f:
        for cid, ts, name, args, dur, is_err, exit_code in rows:
            if cid in seen:
                continue
            seen.add(cid)
            cat = classify(name, args)
            cmd = bash_cmd(args) if name == 'bash' else str(args)[:300]
            rec = {'callId': cid, 'ts': ts, 'tool': name, 'cat': cat,
                   'cmd': cmd[:300].replace('\n', ' ⏎ '),
                   'dur_ms': dur, 'is_error': is_err, 'exit': exit_code}
            f.write(json.dumps(rec, ensure_ascii=False) + '\n')
            new.append(rec)
        f.flush()
    st['seen'] = list(seen)
    return new


def detect(recs, recent_repeat_window_ms=600000, gui_window_ms=120000, gui_threshold=8):
    """对一批新记录做五条判据，返回 alert 列表"""
    alerts = []
    by_cmd = defaultdict(list)
    gui_ts = []
    for r in recs:
        if r['dur_ms'] >= SLOW_MS and r['cat'] != 'wait_human':
            alerts.append({'kind': 'slow', 'ts': r['ts'], 'dur_ms': r['dur_ms'],
                           'cat': r['cat'], 'cmd': r['cmd'][:160]})
        failed = r['is_error'] or (r['exit'] not in (None, 0))
        if failed:
            alerts.append({'kind': 'fail', 'ts': r['ts'], 'exit': r['exit'],
                           'cat': r['cat'], 'cmd': r['cmd'][:160]})
        if r['tool'] == 'bash' and SLEEP_RE.search(r['cmd']):
            alerts.append({'kind': 'sleep', 'ts': r['ts'], 'cat': r['cat'],
                           'cmd': r['cmd'][:160]})
        h = hashlib.md5(r['cmd'][:120].encode()).hexdigest()[:10]
        by_cmd[h].append(r)
        if r['cat'] == 'gui':
            gui_ts.append(r['ts'])
    for h, lst in by_cmd.items():
        if len(lst) >= 3 and (lst[-1]['ts'] - lst[0]['ts']) <= recent_repeat_window_ms:
            alerts.append({'kind': 'repeat', 'ts': lst[-1]['ts'], 'n': len(lst),
                           'span_s': round((lst[-1]['ts'] - lst[0]['ts']) / 1000),
                           'cmd': lst[-1]['cmd'][:160]})
    gui_ts.sort()
    for i in range(len(gui_ts)):
        j = i
        while j < len(gui_ts) and gui_ts[j] - gui_ts[i] <= gui_window_ms:
            j += 1
        if j - i >= gui_threshold:
            sample = next((x['cmd'][:80] for x in recs
                           if x['cat'] == 'gui' and x['ts'] >= gui_ts[i]), '')
            alerts.append({'kind': 'guistorm', 'ts': gui_ts[i], 'n': j - i,
                           'window_s': gui_window_ms // 1000, 'cmd': sample})
            break
    return alerts


def append_alerts(alerts):
    if not alerts:
        return
    os.makedirs(LOGDIR, exist_ok=True)
    with open(ALERTS, 'a') as f:
        for a in alerts:
            f.write(json.dumps(a, ensure_ascii=False) + '\n')
        f.flush()


def read_jsonl(path, since_ms=None):
    """读账本；按 callId 去重（防并发写入期重复）"""
    out = []
    seen = set()
    if not os.path.exists(path):
        return out
    with open(path, errors='replace') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            if since_ms and o.get('ts', 0) < since_ms:
                continue
            k = o.get('callId')
            if k in seen:
                continue
            seen.add(k)
            out.append(o)
    return out


def parse_since(s):
    if not s:
        return None
    m = re.match(r'^(\d+(?:\.\d+)?)([smhd])$', s)
    if not m:
        return None
    n = float(m.group(1))
    mul = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}[m.group(2)]
    return int((time.time() - n * mul) * 1000)


def fmt_ms(ms):
    if ms >= 60000:
        return f'{ms/60000:.1f}m'
    return f'{ms/1000:.1f}s'


def cmd_scan(args):
    path = args.session or latest_session(args.workspace)
    if not path:
        print('找不到会话文件', file=sys.stderr)
        return 2
    st = load_state()
    rows = parse_session(decode(path))
    new = ingest(rows, st)
    alerts = detect(new)
    append_alerts(alerts)
    st['path'] = path
    save_state(st)
    print(f'会话: {os.path.basename(os.path.dirname(path))}')
    print(f'扫描 {len(rows)} 次配对调用，新增 {len(new)} 条记录，报警 {len(alerts)} 条')
    return 0


def cmd_daemon(args):
    os.makedirs(LOGDIR, exist_ok=True)
    log = open(os.path.join(LOGDIR, 'daemon.log'), 'a', buffering=1)
    print(f'[{time.strftime("%H:%M:%S")}] cmdmon daemon 起 (interval={args.interval}s)', file=log)
    last_path = None
    # ── 教练卡自动生成（2026-10-18 用户点破的设计缺口）────────────────────────
    # 原设计的最后一步是「模型侧约定：每完成一个阶段自查一次 agent-coach」——
    # 把闭环的闭合交给了模型自觉。实测后果：injections.jsonl 从未创建，last-coach.md 停了一天，
    # 而当天那轮仍是仪器 57.4 分钟 / 人等待 59.2 分钟 / ≥30s 慢调用 25 次。
    # ⇒ 卡片写得再好，不被调用就等于没有。这里把它挂到**已经在跑的常驻循环**上，
    #   由设计保证而不是靠记得：daemon 每 coach_every 秒重算一次卡片并落盘。
    #   模型侧只要读 ~/.dsh/cmdlog/last-coach.md（AGENTS.md 里指了一次），就永远看到当下读数。
    coach_every = max(60, int(getattr(args, 'coach_every', 300) or 300))
    last_coach = 0.0
    try:
        while True:
            path = latest_session(args.workspace)
            if path:
                st = load_state()
                if path != last_path:
                    last_path = path
                    st['seen'] = st.get('seen', []) if st.get('path') == path else []
                    st['path'] = path
                    print(f'[{time.strftime("%H:%M:%S")}] 跟踪 {path}', file=log)
                new = ingest(parse_session(decode(path)), st)
                if new:
                    alerts = detect(new)
                    append_alerts(alerts)
                    save_state(st)
                    for a in alerts:
                        print(f'[{time.strftime("%H:%M:%S")}] ALERT {a}', file=log)
            # 教练卡：按时间节律重算（与 ingest 解耦，没有新调用也会刷新，保证读数不过期）
            if time.time() - last_coach >= coach_every:
                last_coach = time.time()
                coach = os.path.join(HERE, 'agent-coach')
                if os.path.exists(coach):
                    try:
                        p = subprocess.run([coach, '--window', '2h', '--format', 'text'],
                                           capture_output=True, text=True, timeout=60)
                        if p.returncode == 0 and (p.stdout or '').strip():
                            print(f'[{time.strftime("%H:%M:%S")}] COACH 已刷新 last-coach.md '
                                  f'({len(p.stdout)} 字节)', file=log)
                        else:
                            print(f'[{time.strftime("%H:%M:%S")}] COACH 生成失败 rc={p.returncode} '
                                  f'{(p.stderr or "")[:160]}', file=log)
                    except Exception as e:                       # noqa: BLE001
                        print(f'[{time.strftime("%H:%M:%S")}] COACH 异常 {type(e).__name__}: {e}',
                              file=log)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        print(f'[{time.strftime("%H:%M:%S")}] 退出', file=log)
    return 0


def cmd_report(args):
    since = parse_since(args.since)
    recs = read_jsonl(COMMANDS, since)
    if not recs:
        print('账本为空（先跑 tools/cmdmon scan）')
        return 0
    for r in recs:                     # 判据层单一源：分类在读取时重算，历史账本也跟新规则
        if r.get('tool') == 'ask_user_question':
            r['cat'] = 'wait_human'
    agg = defaultdict(lambda: [0, 0])
    for r in recs:
        agg[r['cat']][0] += 1
        agg[r['cat']][1] += r['dur_ms']
    human = agg.get('wait_human', [0, 0])[1]
    total = (sum(v[1] for v in agg.values()) or 1) - human
    print(f'记录 {len(recs)} 次调用   仪器耗时 {total/60000:.1f} 分钟'
          + (f'   人等待 {human/60000:.1f} 分钟（不计入仪器）' if human else '')
          + (f'   （since {args.since}）' if args.since else ''))
    print(f'{"类别":<12}{"次数":>6}{"耗时":>10}{"占比":>8}{"均时":>9}')
    print('-' * 46)
    for cat, (n, ms) in sorted(agg.items(), key=lambda kv: -kv[1][1]):
        share = 100 * ms / total if cat != 'wait_human' else 0
        print(f'{cat:<12}{n:>6}{fmt_ms(ms):>10}{share:>7.0f}%{fmt_ms(ms/n):>9}')
    slow = sorted(recs, key=lambda r: -r['dur_ms'])[:args.top]
    print(f'\n最慢 {len(slow)} 次:')
    for r in slow:
        print(f'  {fmt_ms(r["dur_ms"]):>7}  {r["cat"]:<9} {r["cmd"][:96]}')
    fails = [r for r in recs if r['is_error'] or r['exit'] not in (None, 0)]
    if fails:
        print(f'\n失败 {len(fails)} 次（最近 5）:')
        for r in fails[-5:]:
            print(f'  exit={r["exit"]}  {r["cat"]:<9} {r["cmd"][:96]}')
    dup = defaultdict(list)
    for r in recs:
        dup[hashlib.md5(r['cmd'][:120].encode()).hexdigest()[:10]].append(r)
    storms = sorted(((len(v), v) for v in dup.values() if len(v) >= 3), reverse=True)[:5]
    if storms:
        print(f'\n重复命令 {len(storms)} 组（≥3 次，重试风暴嫌疑）:')
        for n, v in storms:
            print(f'  ×{n:<3} {v[-1]["cmd"][:96]}')
    sleeps = [r for r in recs if r['tool'] == 'bash' and SLEEP_RE.search(r['cmd'])]
    if sleeps:
        print(f'\n裸 sleep {len(sleeps)} 处（应为 0）:')
        for r in sleeps[-5:]:
            print(f'  {r["cmd"][:100]}')
    return 0


def cmd_alerts(args):
    since = parse_since(args.since)
    al = read_jsonl(ALERTS, since)
    if not al:
        print('无报警')
        return 0
    cnt = defaultdict(int)
    for a in al:
        cnt[a['kind']] += 1
    print('报警统计: ' + '  '.join(f'{k}={v}' for k, v in sorted(cnt.items())))
    for a in al[-args.limit:]:
        t = time.strftime('%H:%M:%S', time.localtime(a['ts'] / 1000))
        tail = ' '.join(f'{k}={v}' for k, v in a.items() if k not in ('kind', 'ts', 'cmd'))
        print(f'  {t}  {a["kind"]:<9} {tail}  {a.get("cmd","")[:80]}')
    return 0


def cmd_status(args):
    st = load_state()
    print(f'账本: {COMMANDS} ({len(read_jsonl(COMMANDS))} 条)' if os.path.exists(COMMANDS)
          else '账本: 未建立')
    print(f'报警: {ALERTS} ({len(read_jsonl(ALERTS))} 条)' if os.path.exists(ALERTS)
          else '报警: 未建立')
    print(f'跟踪会话: {st.get("path")}')
    return 0


def iter_session_files(workspace=None, since_days=None):
    pat = os.path.join(HOME, '.dsh', 'sessions', '*', '*', 'session.v4.jsonl.zstd')
    cutoff = time.time() - since_days * 86400 if since_days else None
    out = []
    for f in glob.glob(pat):
        if workspace and workspace not in f:
            continue
        if cutoff and os.path.getmtime(f) < cutoff:
            continue
        out.append(f)
    out.sort(key=os.path.getmtime)
    return out


def stream_events(path):
    """流式解码一个会话文件，逐行 yield 事件（不整体读入内存）"""
    if path.endswith('.zstd'):
        p = subprocess.Popen(['zstd', '-dc', path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        f = p.stdout
    else:
        p = None
        f = open(path, 'rb')
    try:
        for raw in f:
            line = raw.decode('utf-8', 'replace').strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except Exception:
                continue
    finally:
        if p:
            p.stdout.close()
            p.wait()


def ws_name(path):
    parts = path.split(os.sep)
    for i, x in enumerate(parts):
        if x == 'sessions' and i + 1 < len(parts):
            return parts[i + 1].strip('-') or parts[i + 1]
    return '?'


def cmd_audit(args):
    files = iter_session_files(args.workspace, args.since_days)
    if not files:
        print('没有匹配的会话文件', file=sys.stderr)
        return 2
    ws_agg = defaultdict(lambda: [0, 0, 0])          # n, ms, fails
    ws_cat = defaultdict(lambda: defaultdict(lambda: [0, 0]))
    cat_agg = defaultdict(lambda: [0, 0])
    tool_agg = defaultdict(lambda: [0, 0])
    cmd_stat = defaultdict(lambda: [0, 0])            # 命令(前120字符) -> [次数, 耗时]
    alerts = defaultdict(int)
    sleeps = fails = 0
    slow_rows = []
    total_files = len(files)
    for idx, path in enumerate(files, 1):
        ws = ws_name(path)
        calls, done = {}, {}
        for o in stream_events(path):
            t = o.get('type')
            if t == 'tool/call':
                d = o.get('data', {})
                calls[d.get('callId')] = (o.get('time'), d.get('name', '?'), d.get('arguments', ''))
            elif t == 'tool/result':
                d = o.get('data', {})
                m = d.get('message', {}) or {}
                text = json.dumps(m.get('content', ''), ensure_ascii=False)[:4000]
                ex = EXIT_RE.search(text)
                done[m.get('toolCallId')] = (o.get('time'), bool(m.get('isError')),
                                             int(ex.group(1)) if ex else None)
        for cid, (ts, name, raw_args) in calls.items():
            if cid not in done:
                continue
            end, is_err, exit_code = done[cid]
            dur = max(0, end - ts)
            cat = classify(name, raw_args)
            if cat == 'wait_human':
                ws_agg[ws][0] += 1
                continue
            failed = is_err or exit_code not in (None, 0)
            ws_agg[ws][0] += 1; ws_agg[ws][1] += dur; ws_agg[ws][2] += 1 if failed else 0
            ws_cat[ws][cat][0] += 1; ws_cat[ws][cat][1] += dur
            cat_agg[cat][0] += 1; cat_agg[cat][1] += dur
            tool_agg[name][0] += 1; tool_agg[name][1] += dur
            cmd = (bash_cmd(raw_args) if name == 'bash' else str(raw_args))[:120].replace('\n', ' ')
            cmd_stat[cmd][0] += 1; cmd_stat[cmd][1] += dur
            if failed:
                fails += 1
            if name == 'bash' and SLEEP_RE.search(cmd):
                sleeps += 1
            if dur >= SLOW_MS:
                slow_rows.append((dur, ws, cat, cmd))
        if idx % 20 == 0:
            print(f'  …已扫 {idx}/{total_files} 个会话', file=sys.stderr)

    tot_ms = sum(v[1] for v in ws_agg.values()) or 1
    tot_n = sum(v[0] for v in ws_agg.values())
    print(f'=== 全项目审计：{total_files} 个会话 / {len(ws_agg)} 个工作区 / '
          f'{tot_n} 次调用 ===')
    print(f'仪器总耗时 {tot_ms/3600000:.1f} 小时    失败 {fails} 次    裸 sleep {sleeps} 处    慢调用(≥30s) {len(slow_rows)} 次\n')

    print(f'{"工作区":<34}{"调用":>7}{"耗时(h)":>10}{"占比":>7}{"失败":>7}')
    print('-' * 66)
    for ws, (n, ms, fl) in sorted(ws_agg.items(), key=lambda kv: -kv[1][1])[:args.top]:
        print(f'{ws[:33]:<34}{n:>7}{ms/3600000:>10.2f}{100*ms/tot_ms:>6.0f}%{fl:>7}')

    for ws, _ in sorted(ws_agg.items(), key=lambda kv: -kv[1][1])[:3]:
        top3 = sorted(ws_cat[ws].items(), key=lambda kv: -kv[1][1])[:3]
        line = '  '.join(f'{c} {100*m/ (ws_agg[ws][1] or 1):.0f}%/{fmt_ms(m)}' for c, (n, m) in top3)
        print(f'  画像 {ws[:28]:<29} {line}')

    print(f'\n{"类别":<12}{"次数":>8}{"耗时(h)":>10}{"占比":>7}{"均时":>8}')
    print('-' * 48)
    for cat, (n, ms) in sorted(cat_agg.items(), key=lambda kv: -kv[1][1])[:12]:
        print(f'{cat:<12}{n:>8}{ms/3600000:>10.2f}{100*ms/tot_ms:>6.0f}%{fmt_ms(ms/n):>8}')

    print(f'\n最慢 {args.top} 次（跨全项目）:')
    for dur, ws, cat, cmd in sorted(slow_rows, reverse=True)[:args.top]:
        print(f'  {fmt_ms(dur):>7}  {ws[:18]:<19}{cat:<9} {cmd[:70]}')

    print(f'\n重复最多的命令（≥5 次，跨会话聚合）:')
    for cmd, (n, ms) in sorted(cmd_stat.items(), key=lambda kv: -kv[1][0])[:8]:
        if n < 5:
            break
        print(f'  ×{n:<4} 合计 {fmt_ms(ms):>8}  {cmd[:80]}')

    if args.json:
        out = {'files': total_files, 'calls': tot_n, 'ms': tot_ms, 'fails': fails,
               'sleeps': sleeps, 'workspaces': {k: v for k, v in ws_agg.items()},
               'cats': {k: v for k, v in cat_agg.items()}}
        json.dump(out, open(args.json, 'w'), ensure_ascii=False, indent=1)
        print(f'\n汇总已写 {args.json}')
    return 0


def main():
    ap = argparse.ArgumentParser(prog='cmdmon', description='独立命令监控模块')
    sub = ap.add_subparsers(dest='cmd')
    p = sub.add_parser('scan', help='一次性采集当前会话')
    p.add_argument('--session')
    p.add_argument('--workspace')
    p = sub.add_parser('daemon', help='常驻增量采集 + 即时报警')
    p.add_argument('--interval', type=float, default=2.0)
    p.add_argument('--workspace')
    # 教练卡自动刷新间隔（秒）。设计意图见 cmd_daemon 里的注释：把「模型自查」换成
    # 「常驻循环保证」——卡片写得再好，不被调用就等于没有。
    p.add_argument('--coach-every', type=int, default=300, dest='coach_every')
    p = sub.add_parser('report', help='类别占比 / 最慢 / 失败 / 裸 sleep')
    p.add_argument('--since')
    p.add_argument('--top', type=int, default=10)
    p = sub.add_parser('alerts', help='异常清单')
    p.add_argument('--since')
    p.add_argument('--limit', type=int, default=30)
    p = sub.add_parser('audit', help='全项目抽样审计（跨工作区/跨会话直接扫会话文件）')
    p.add_argument('--since-days', type=float, default=None)
    p.add_argument('--workspace')
    p.add_argument('--top', type=int, default=12)
    p.add_argument('--json')
    sub.add_parser('status', help='账本状态')
    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        return 1
    return {'scan': cmd_scan, 'daemon': cmd_daemon, 'report': cmd_report,
            'alerts': cmd_alerts, 'audit': cmd_audit, 'status': cmd_status}[args.cmd](args)


if __name__ == '__main__':
    sys.exit(main())
