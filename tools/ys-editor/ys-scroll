#!/usr/bin/env python3
"""ys-scroll — 语义滚动原语（通用，任何 App 都成立）。

为什么需要：GUI AGI 的每次"翻列表"此前只能全帧 OCR + 手工找坐标；翻 173 项要 12 轮抓帧。
滚动本身是纯注入（毫秒级），贵的是验证。本工具把"滚 + 验证位移"做成一个原语。

用法：
  ys-scroll --at 850,500 --clicks 40 --dir down            # 在 (850,500) 处滚 40 格
  ys-scroll --at 850,500 --by page --dir down             # 滚一屏（items 由 --pitch 推断）
  ys-scroll --at 850,500 --by items=8 --pitch 166         # 按"项数"滚：8 项 × 166px
  ys-scroll ... --verify                                   # 前后各抓一帧，估内容位移（默认开）

输出（JSON）：{ok, clicks, at, dir, moved_px, shifted, ms, frame_before, frame_after}
  · moved_px = 内容竖直位移的估计（正=内容上移，即向下浏览）
  · 判据：|moved_px| < 3 ⇒ 没滚动（到底/焦点不在列表）

退出码：0 = 注入成功且（若验证开）画面确实变了；5 = 注入/归还失败；
        6 = **NO_MOVEMENT**（注入成功但前后帧逐像素一致 ⇒ 这次滚动没发生）。
        `verified=false`（--no-verify 或抓帧失败）时不给 0/6 的结论，`moved_confirmed=null`。

纪律：注入一律走 ys-gui-slot（焦点保证 + 自动还原），绝不裸调 xdotool/ydotool。
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
SNAP = os.path.join(os.path.dirname(HERE), "ys-snap")
SLOT = os.path.join(HERE, "ys-gui-slot")
PUT = os.path.join(HERE, "ys-kwin-put")


def _fast_grab(out):
    """优先走 ys-lookd 的 cmd=grab（XShm+JPEG，~0.5s）；失败回退 ys-snap（KWin，~4.8s）。"""
    try:
        import sys as _s
        _s.path.insert(0, os.path.join(os.path.dirname(HERE), "..", ".scratch", "gui-service"))
        import instruments as I
        r = I.daemon_rpc({"cmd": "grab", "out": out}, timeout=60)
        if r.get("path") and os.path.exists(r["path"]):
            return r["path"]
    except Exception:                                   # noqa: BLE001
        pass
    return None


def capture(win, out):
    fg = _fast_grab(out)
    if fg:
        return fg
    p = subprocess.run([SNAP, "--snap", "--window", win], capture_output=True, text=True, timeout=90)
    try:
        r = json.loads(p.stdout.strip().splitlines()[-1])
    except Exception:                                   # noqa: BLE001
        return None
    if not r.get("ok"):
        return None
    src = r.get("path")
    if out and src and os.path.exists(src):
        with open(src, "rb") as fh, open(out, "wb") as o:
            o.write(fh.read())
        return out
    return src


def shift_px(a, b, x0f=0.35, x1f=0.65):
    """估内容竖直位移：取中间竖条，逐位移相关（粗到细）。返回正=内容上移。"""
    try:
        import numpy as np
        from PIL import Image
    except Exception:                                   # noqa: BLE001
        return None
    A = np.asarray(Image.open(a).convert("L"), dtype=np.float32)
    B = np.asarray(Image.open(b).convert("L"), dtype=np.float32)
    h, w = A.shape
    x0, x1 = int(w * x0f), int(w * x1f)
    y0, y1 = int(h * 0.15), int(h * 0.85)
    ca = A[y0:y1, x0:x1].mean(axis=1)
    cb = B[y0:y1, x0:x1].mean(axis=1)
    ca = (ca - ca.mean()) / (ca.std() + 1e-6)
    cb = (cb - cb.mean()) / (cb.std() + 1e-6)
    best, bestv = 0, -2.0
    for s in range(-900, 901):
        if s >= 0:
            v = float((ca[s:] * cb[:len(cb) - s]).mean()) if s < len(ca) - 4 else -2
        else:
            v = float((ca[:len(ca) + s] * cb[-s:]).mean())
        if v > bestv:
            bestv, best = v, s
    return best


def exit_code(ok_inject, release_ok, moved_confirmed):
    """三态退出码（纯函数，便于离线自测）：0 / 5 INJECT_FAILED / 6 NO_MOVEMENT。

    `moved_confirmed is False` 必须在报错之前判——命令没报错但画面逐像素一致，
    语义是「这次滚动没有发生」，不是「成功」。
    """
    if not (ok_inject and release_ok):
        return 5
    if moved_confirmed is False:
        return 6
    return 0


def _resolve_win():
    """当前游戏窗 id（按 class 动态解析；禁止写死已过期的 id）。"""
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import ys_look
        return ys_look.WIN or ""
    except Exception:                                    # noqa: BLE001
        return ""


def frame_diff(a, b):
    """两帧的像素差异比例（0..1）。用于回答**「到底动没动」**这个二值问题。

    为什么不复用 `shift_px`：`shift_px` 只在 ±200px 内做相关，大步翻页时会给假读数
    （D410 实测：真实位移 3 行 ≈498px 却报 -19/147）。而「动没动」不需要估位移，
    只要一个对大步/小步都单调的差异量 ⇒ 直接比像素。

    2026-10-21（F-20261021-SCROLL-FALSE-SUCCESS）：事故形态是 ys-scroll 在画面
    **完全没变**时照样返回 `ok:true, shifted:false, rc=0`；调用方（我）连吃 3 次空滚，
    却以为「滚动失败但至少执行了」。没有差异量就分不清「动了但没测出来」与「真的没动」。
    """
    try:
        import numpy as np
        from PIL import Image
    except Exception:                                   # noqa: BLE001
        return None
    try:
        A = np.asarray(Image.open(a).convert("L"), dtype=np.float32)
        B = np.asarray(Image.open(b).convert("L"), dtype=np.float32)
        if A.shape != B.shape:
            return 1.0
        return float(np.mean(np.abs(A - B)) / 255.0)
    except Exception:                                   # noqa: BLE001
        return None


def _session():
    """活动占用会话（ys-session）。命中 ⇒ 直接注入（等价于已在 slot 内）。"""
    path = os.environ.get("YS_SESSION_PATH") or os.path.expanduser("~/.ys/session.json")
    try:
        d = json.load(open(path, encoding="utf-8"))
    except Exception:                                   # noqa: BLE001
        return None
    if d.get("state") == "active" and float(d.get("expires") or 0) > time.time() and not d.get("dry_run"):
        return d
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--at", required=True, help="滚动位置（窗口内逻辑坐标 x,y）")
    ap.add_argument("--clicks", type=int, default=40, help="滚轮格数")
    ap.add_argument("--rows", type=float, default=0.0,
                    help="目标行数（用 ~/.dsh/ys-scroll-calib.json 反查 clicks；扫描建议闭环再调）")
    ap.add_argument("--by", default="", help="page | items=N（与 --pitch 配合）")
    ap.add_argument("--pitch", type=float, default=0.0, help="单项节距（像素），用于 items=N")
    ap.add_argument("--dir", choices=["down", "up"], default="down")
    ap.add_argument("--window", default="auto")
    ap.add_argument("--no-verify", action="store_true")
    ap.add_argument("--lease", action="store_true", help="用焦点租约执行（无槽位开销：1.4s → ~30ms）")
    ap.add_argument("--drag", type=int, default=0, help="改用「拖动」滚动：拖动 N 像素（内容 1:1 跟手，比滚轮线性）")
    ap.add_argument("--delay", type=int, default=30, help="每格间隔 ms（慢速滚动保持线性；实测 8ms 会非线性加速）")
    ap.add_argument("--hint", action="store_true", default=True, help="执行后附带教练提示（默认开）")
    ap.add_argument("--no-hint", action="store_true", help="不跑 coach（省 ~88ms/次）")
    ap.add_argument("--settle-ms", type=int, default=600,
                    help="注入后固定等待 ms（缺省 600；会话扫描用 150–250）")
    ap.add_argument("--plan", action="store_true", help="只打印执行计划（in_slot/session/script），不注入")
    a = ap.parse_args()
    sess = _session()
    if sess:
        os.environ["YS_SLOT_ACTIVE"] = "1"
        os.environ["YS_SESSION_ID"] = str(sess.get("session_id") or "")

    t0 = time.time()
    clicks = a.clicks
    if a.rows > 0 and not a.by:
        # 2026-10-21 反馈轮：clicks→rows 非线性（calib: 10→3 / 20→3 / 40→6）。
        # 用标定点做最小二乘线性反查，clamp 5..80；单次调用仍可能因位置抖动偏，
        # 扫描驱动（scan_session.py）再用上一屏实际位移闭环修正。
        try:
            _c = json.load(open(os.path.expanduser("~/.dsh/ys-scroll-calib.json")))
            _pts = [(float(t["clicks"]), float(t["rows"])) for t in _c.get("tests", [])
                    if t.get("clicks") and t.get("rows")]
            if len(_pts) >= 2:
                _xs = [p[0] for p in _pts]
                _ys = [p[1] for p in _pts]
                _mx = sum(_xs) / len(_xs)
                _my = sum(_ys) / len(_ys)
                _var = sum((x - _mx) ** 2 for x in _xs)
                _m = (sum((x - _mx) * (y - _my) for x, y in _pts) / _var) if _var else 0.0
                _c0 = _my - _m * _mx
                if _m > 0:
                    clicks = int(round((a.rows - _c0) / _m))
                    # 2026-10-21 用户令：「就算单次移动有上限，那多执行一次不就行了吗。」
                    # 单次注入仍按 ~80 clicks 一批（避免一次 --repeat 过大被吞/超时），
                    # 但**总数不再被 clamp**：目标行数换算成总 clicks，由 main 分批循环执行。
                    clicks = max(5, clicks)
        except Exception:                                # noqa: BLE001
            pass
    # --by rows=N：用拖动（线性），按标定 px_per_row 换算（默认 200；标定见 ~/.dsh/ys-scroll-calib.json）
    if a.by.startswith("rows="):
        n = float(a.by.split("=", 1)[1])
        try:
            calib = json.load(open(os.path.expanduser("~/.dsh/ys-scroll-calib.json")))
            ppr = float(calib.get("px_per_row") or 200.0)
        except Exception:                                # noqa: BLE001
            ppr = 200.0
        a.drag = int(round(n * ppr))
    if a.by.startswith("items="):
        n = int(a.by.split("=", 1)[1])
        clicks = max(1, int(round(n * max(1.0, a.pitch) / 20.0)))   # 20px ≈ 1 格滚轮（经验值，可由调用方覆盖）
    elif a.by == "page":
        clicks = 120

    tmp = tempfile.mkdtemp(prefix="ys-scroll-")
    fa = fb = None
    if not a.no_verify:
        fa = capture(a.window, os.path.join(tmp, "a.png"))
    x, y = [int(v) for v in a.at.split(",")]
    btn = 5 if a.dir == "down" else 4
    FAST_DRAG = "FAST_DRAG"
    if a.drag:
        # 拖动滚动：内容随指针 1:1 移动（慢速拖动不触发惯性加速）
        dy = abs(a.drag)
        y1 = y + dy // 2 if a.dir == "down" else y - dy // 2
        y2 = y1 - dy if a.dir == "down" else y1 + dy
        # 人类拖动速度：约 400–600 px/s（200px ≈ 0.4s）。刻意放慢反而"看着难受"且拖长占用时间。
        steps = max(8, int(round(dy / 20.0)))
        hold = max(0.03, min(0.08, 0.05))
        if a.lease:
            # 租约内：xdotool 原生拖动（0.4s，vs ys-drag 的 3.3s —— 后者每步都走 KWin 绝对定位）
            inc = (y2 - y1) / float(steps)
            mv = "; ".join(f"xdotool mousemove_relative -- 0 {int(round(inc))}; sleep {hold}"
                           for _ in range(steps))
            script = (f"xdotool mousemove {x} {y1}; sleep 0.03; xdotool mousedown 1; sleep 0.03; "
                      f"{mv}; xdotool mouseup 1")
        else:
            script = (f"{PUT} {x} {y1} >/dev/null 2>&1; sleep 0.12; "
                      f"{os.path.join(HERE, 'ys-drag')} {x} {y1} {x} {y2} {steps} {hold}")
    else:
        # 一次调用滚完（--repeat），减少 N 次进程启停
        script = (f"{PUT} {x} {y} >/dev/null 2>&1; sleep 0.1; "
                  f"xdotool click --repeat {clicks} --delay {a.delay} {btn}")
    if a.plan:
        print(json.dumps({"plan": {"in_slot": os.environ.get("YS_SLOT_ACTIVE") == "1",
                                   "session_id": os.environ.get("YS_SESSION_ID"),
                                   "clicks": clicks, "settle_ms": a.settle_ms,
                                   "script": script}}, ensure_ascii=False))
        return 0
    # 2026-10-21：**单批上限 ≠ 总量上限**。把目标 clicks 拆成 ≤CHUNK 的多批依次注入，
    # 每批之间可选 verify；这样 --rows 48 不再是"被 clamp 成 80 clicks 只走 5 行"。
    CHUNK = int(os.environ.get("YS_SCROLL_CHUNK_CLICKS", "80"))
    MAX_CHUNKS = int(os.environ.get("YS_SCROLL_MAX_CHUNKS", "40"))
    if clicks > CHUNK and not a.drag:
        n_chunks = min(MAX_CHUNKS, (clicks + CHUNK - 1) // CHUNK)
        per = clicks // n_chunks
        _t0 = time.time()
        _done = 0
        _rc = 0
        _in_slot = os.environ.get("YS_SLOT_ACTIVE") == "1"
        _env = dict(os.environ, YS_SLOT_ACTIVE="1", DISPLAY=os.environ.get("DISPLAY", ":1"))
        for _i in range(n_chunks):
            _script = (PUT + " %d %d >/dev/null 2>&1; sleep 0.05; "
                       "xdotool click --repeat %d --delay %d %d" % (x, y, per, a.delay, 5))
            if _in_slot:
                _p = subprocess.run(["bash", "-c", _script], capture_output=True, text=True,
                                    env=_env, timeout=120)
            else:
                _p = subprocess.run([SLOT, (_resolve_win() or "auto"), "60", "bash", "-c", _script],
                                    capture_output=True, text=True, timeout=120)
            if _p.returncode != 0:
                _rc = _p.returncode
                break
            _done += per
        # 分批之后仍要**自证动了没有**（用户令：动作必须可验证，不许只看返回码）
        _fb, _moved, _diff = None, None, None
        if not a.no_verify:
            _fb = capture(a.window, os.path.join(tmp, "b.png"))
            if fa and _fb:
                _moved = shift_px(fa, _fb)
                _diff = frame_diff(fa, _fb)
        _mc = None if _diff is None else (_diff > 0.001)
        print(json.dumps({"ok": _rc == 0, "chunked": True, "chunks": n_chunks,
                          "per_chunk_clicks": per, "total_clicks": _done,
                          "target_rows": a.rows, "moved_px": _moved,
                          "frame_diff": (None if _diff is None else round(_diff, 6)),
                          "moved_confirmed": _mc,
                          "ms": round((time.time() - _t0) * 1000, 1)}, ensure_ascii=False))
        if _rc != 0:
            return 5
        return 6 if _mc is False else 0

    lease_ok = False
    made_lease = False          # 只归还本函数自己取的租约；别人的租约不动
    if a.lease:
        try:
            st = subprocess.run([os.path.join(HERE, "ys-lease"), "status"], capture_output=True, text=True, timeout=20)
            j = json.loads(st.stdout or "{}")
            if not (j.get("active") and j.get("target_focused")):
                acq = subprocess.run([os.path.join(HERE, "ys-lease"), "acquire", "--max", "30",
                                      "--owner-pid", str(os.getpid())],
                                     capture_output=True, text=True, timeout=40)
                made_lease = acq.returncode == 0
                st = subprocess.run([os.path.join(HERE, "ys-lease"), "status"], capture_output=True, text=True, timeout=20)
                j = json.loads(st.stdout or "{}")
            lease_ok = bool(j.get("active") and j.get("target_focused"))
            if made_lease and not lease_ok:
                rel = subprocess.run([os.path.join(HERE, "ys-lease"), "release", "--force"],
                                     capture_output=True, text=True, timeout=40)
                if rel.returncode != 0:
                    print(f"⚠️ ys-lease 清理归还失败（rc={rel.returncode}）："
                          f"{(rel.stdout or rel.stderr).strip()[:200]}", file=sys.stderr)
                made_lease = False
        except Exception:                                # noqa: BLE001
            lease_ok = False
    # 2026-10-21 真机吞吐修：已经在大租期的 ys-gui-slot 里（长扫描批）就**直接注入**，
    # 不再套一层 slot。嵌套 slot 每次多付 kwin-state/resolve/raise ~2s，60s 窗口只能扫 8 屏。
    in_slot = os.environ.get("YS_SLOT_ACTIVE") == "1"
    t_inj = time.time()
    if lease_ok or in_slot:
        env = dict(os.environ, YS_SLOT_ACTIVE="1", DISPLAY=os.environ.get("DISPLAY", ":1"))
        p = subprocess.run(["bash", "-c", script], capture_output=True, text=True, env=env, timeout=120)
    else:
        p = subprocess.run([SLOT, (_resolve_win() or "auto"), "60", "bash", "-c", script],
                           capture_output=True, text=True, timeout=120)
    ok_inject = p.returncode == 0
    inject_ms = round((time.time() - t_inj) * 1000, 1)
    t_set = time.time()
    time.sleep(max(0, a.settle_ms) / 1000.0)
    settle_ms = round((time.time() - t_set) * 1000, 1)
    moved = None
    diff = None
    t_ver = time.time()
    if not a.no_verify:
        fb = capture(a.window, os.path.join(tmp, "b.png"))
        if fa and fb:
            moved = shift_px(fa, fb)
            diff = frame_diff(fa, fb)
    verify_ms = round((time.time() - t_ver) * 1000, 1)
    hint = None
    if a.hint and not a.no_hint:
        try:
            hp = subprocess.run([os.path.join(os.path.dirname(HERE), "coach"), "--hint"],
                                capture_output=True, text=True, timeout=8)
            hint = hp.stdout.strip() or None
        except Exception:                                # noqa: BLE001
            hint = None
    _ms = round((time.time() - t0) * 1000, 1)
    _budget = {"target_ms": 500, "actual_ms": _ms, "over": _ms > 500}
    if _budget["over"]:
        print(f"⚠️ OVER BUDGET {_ms}ms > 500ms（动作+验证总时；用 --lease 可去掉槽位开销、--no-verify 去掉两次抓帧）",
              file=sys.stderr)
    release_ok = True
    if made_lease:
        rel = subprocess.run([os.path.join(HERE, "ys-lease"), "release", "--force"],
                             capture_output=True, text=True, timeout=40)
        release_ok = rel.returncode == 0
        if not release_ok:
            print(f"⚠️ ys-lease 归还失败（rc={rel.returncode}）：{(rel.stdout or rel.stderr).strip()[:300]}",
                  file=sys.stderr)
    # 「动没动」三态：None=没验（--no-verify 或抓帧失败）/ False=验了且没动 / True=动了。
    # 阈值 0.001（0.1% 像素）——实测光标抖动约 0.08%，滚动最少也在 0.5% 量级。
    moved_confirmed = None if diff is None else (diff > 0.001)
    out = {"ok": bool(ok_inject and release_ok), "release_ok": release_ok,
           "budget": _budget, "at": [x, y], "dir": a.dir, "clicks": clicks,
           "drag": a.drag or None, "lease": lease_ok, "hint": hint,
           "session_id": os.environ.get("YS_SESSION_ID") or None,
           "timing": {"inject_ms": inject_ms, "settle_ms": settle_ms,
                      "verify_ms": verify_ms, "total_ms": _ms},
           "moved_px": moved, "shifted": (moved is not None and abs(moved) >= 3),
           "frame_diff": (None if diff is None else round(diff, 6)),
           "moved_confirmed": moved_confirmed,
           "verified": diff is not None,
           "ms": round((time.time() - t0) * 1000, 1),
           "frame_before": fa, "frame_after": fb}
    print(json.dumps(out, ensure_ascii=False))
    return exit_code(ok_inject, release_ok, moved_confirmed)


if __name__ == "__main__":
    sys.exit(main())
