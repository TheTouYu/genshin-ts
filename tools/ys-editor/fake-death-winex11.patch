# 千星编辑器假死 —— winex11.drv 本地补丁（2026-10-20）
#
# 基线：wine 11.14 @ 1012f3d99507b80d4869eabf0853567660a7ecbb
#       （= NelloKudo/Wine-Builds tag spritz-wine-11.14-1 钉的那个 commit，
#         其上再叠加 wine-staging 3e0623e0 全量补丁 + 该 tag 的 63 个自有补丁）
# 用法：patch -p1 -d <wine 源码树> < 本文件
#
# 内容：
#   1) event.c focus_out()：**默认不在失焦时发送 WM_CANCELMODE**（切断
#      「失焦发消息 → 应用抢回前台 → 再失焦」的正反馈环；实测风暴 1526→4 次）。
#      开关：/tmp/.winex11-cancelmode-original  → 原始行为
#            /tmp/.winex11-cancelmode-ratelimit → 500ms 限速
#   2) 诊断埋点（可选、无行为影响）：
#      mouse.c 的 X11DRV_ButtonPress/ButtonRelease → /tmp/wine11-mouse.log
#      event.c 的 X11DRV_MapNotify/UnmapNotify     → /tmp/wine11-map.log
#      （用来区分「Wine 没送到」还是「应用不认」，见 docs/fake-death-2026-10-20.md）
#
--- a/dlls/winex11.drv/event.c	2026-10-20 16:34:03.450364292 +0800
+++ b/dlls/winex11.drv/event.c	2026-10-20 16:26:49.065561536 +0800
@@ -38,6 +38,11 @@
 #include <assert.h>
 #include <stdarg.h>
 #include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <time.h>
+#include <fcntl.h>
+#include <stdio.h>
 
 #include "x11drv.h"
 #include "shellapi.h"
@@ -747,7 +752,40 @@
     if (is_virtual_desktop()) return;
     if (hwnd != NtUserGetForegroundWindow()) return;
     if (!(NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_MINIMIZE))
-        send_message( hwnd, WM_CANCELMODE, 0, 0 );
+    {
+        /* --- local patch (2026-10-20, genshin fake-death) -------------------
+         * 根因（实测）：focus_out() 每失焦一次就向应用发 WM_CANCELMODE；编辑器（CEF）
+         * 收到后立刻 SetForegroundWindow 抢回焦点 -> 又触发 FocusOut -> 又发 WM_CANCELMODE …
+         * 形成 **焦点乒乓风暴**（修前实测：启动期 1526~6856 次 focus_out，两窗交替），
+         * 风暴过后该窗口的输入状态机卡死（点击照常投递到 HWND，应用不响应），
+         * 只有一次 ConfigureWindow 能复位。
+         * 修法：**默认不在失焦时发送 WM_CANCELMODE**（切断反馈环）。实测：修后同一会话
+         * 只剩 4 次 focus_out，风暴消失，点击正常。
+         * 开关（存在即生效）：
+         *   /tmp/.winex11-cancelmode-original   -> 恢复原始行为（每次失焦都发）
+         *   /tmp/.winex11-cancelmode-ratelimit  -> 折中：每 500ms 最多发一次
+         */
+        static ULONGLONG last_cancel;
+        struct timespec cts;
+        ULONGLONG cnow;
+
+        clock_gettime( CLOCK_MONOTONIC, &cts );
+        cnow = (ULONGLONG)cts.tv_sec * 1000 + cts.tv_nsec / 1000000;
+
+        if (access( "/tmp/.winex11-cancelmode-original", F_OK ) == 0)
+        {
+            send_message( hwnd, WM_CANCELMODE, 0, 0 );
+        }
+        else if (access( "/tmp/.winex11-cancelmode-ratelimit", F_OK ) == 0)
+        {
+            if (cnow - last_cancel >= 500)
+            {
+                last_cancel = cnow;
+                send_message( hwnd, WM_CANCELMODE, 0, 0 );
+            }
+        }
+        /* 默认：不发（切断 focus_out -> 应用抢焦点 -> 再 focus_out 的反馈环） */
+    }
 
     /* don't reset the foreground window, if the window which is
        getting the focus is a Wine window */
@@ -764,6 +802,29 @@
             NtUserSetForegroundWindowInternal( NtUserGetDesktopWindow() );
         }
     }
+
+    /* --- local patch (2026-10-20, genshin fake-death) ---------------------
+     * 实测（驱动埋点，6856 条）：编辑器两个窗口交替失焦，而**每一行都是 fg == 自己**——
+     * 即窗口已经失焦、Wine 仍把它当作前台窗口。KWin 支持 _NET_ACTIVE_WINDOW，
+     * 所以上面那段复位永远不执行 ⇒ 应用永远收不到 WM_KILLFOCUS/WM_ACTIVATE(INACTIVE)，
+     * 它的输入状态机（CEF 每窗一份）就一直停在"激活中"，之后所有点击被它自己吞掉。
+     * 修法：失焦时若前台仍指向本窗口，就把前台复位到桌面（带 200ms 防抖，避免风暴中反复设前台）。
+     * 开关：/tmp/.winex11-fg-reset-off 存在则关闭（默认开）。 */
+    if (hwnd == NtUserGetForegroundWindow() && access( "/tmp/.winex11-fg-reset-off", F_OK ))
+    {
+        static ULONGLONG last_reset;
+        struct timespec ts;
+        ULONGLONG now;
+
+        clock_gettime( CLOCK_MONOTONIC, &ts );
+        now = (ULONGLONG)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+        if (now - last_reset >= 200)
+        {
+            last_reset = now;
+            WARN( "fake-death: fg still %p after focus out, resetting to desktop\n", hwnd );
+            NtUserSetForegroundWindowInternal( NtUserGetDesktopWindow() );
+        }
+    }
  }
 
