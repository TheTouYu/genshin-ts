+/* local probe (2026-10-20): 记录 map/unmap —— 虚拟桌面切换在 KWin 下就是 unmap/remap */
+static void probe_map_log( const char *what, HWND hwnd )
+{
+    int fd = open( "/tmp/wine11-map.log", O_WRONLY | O_CREAT | O_APPEND, 0644 );
+    if (fd >= 0)
+    {
+        char buf[96]; int n = snprintf( buf, sizeof(buf), "%s hwnd=%p\n", what, hwnd );
+        if (n > 0) write( fd, buf, n );
+        close( fd );
+    }
+}
+
 static BOOL X11DRV_MapNotify( HWND hwnd, XEvent *event )
 {
+    probe_map_log( "map", hwnd );
     struct x11drv_win_data *data;
 
