#!/usr/bin/env python3
"""ys-fast — 薄封装：判据全部委托 `ys-state`（门槛⑤ 单一源），本文件不含任何坐标/阈值

保留的老接口（外部行为不变）：
  ys-fast state [--frame PNG] [--max-age-ms N]   打印 `MENU|SAVE|EDITOR`（SAVE = ys-state 的 SAVELIST；
                            其它态名原样透传，绝不改成别的态的名字 —— 旧词汇本就含 SETTLE/LOADING/UNKNOWN）
  ys-fast px X Y            打印该点 `r g b`（调试用）
  ys-fast settle [秒]       轮询到界面连续 3 次同态（即不再跳变）后返回该态
  ys-fast --frame PNG       对指定图片判定一次（离线）
  ys-fast --regress         跑 ys-state 的回归集（两通道）

为什么只剩转发（2026-10-17，验收契约 §1/§5）：
  旧的 ys-fast 自带一份「两个像素判三态」的判据副本。同屏两处判据可以给出**相反**答案
  （旧副本的取样点与 ys-state 的口径不同，同一界面两边判出不同结果），这正是要消灭的重复实现。
  现在判据、坐标、阈值、状态名只存在于 `tools/ys-editor/ys-state` 一处。
"""
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
YS_STATE = os.path.join(HERE, "ys-state")


def state(argv=()):
    """委托 ys-state（--compat 只把 SAVELIST 映射成 SAVE，其余原样）。"""
    r = subprocess.run([YS_STATE, "--print-state", "--compat", "ys-fast", *argv],
                       capture_output=True, text=True)
    out = (r.stdout or "").strip().splitlines()
    return (out[-1] if out else "UNKNOWN"), r.returncode


def settle(timeout=90, need=3):
    """轮询到状态连续 need 次相同（即界面不再跳变）后返回该状态。"""
    t0 = time.time()
    last, stable = None, 0
    while time.time() - t0 < timeout:
        s, _ = state()
        if s == last:
            stable += 1
            if stable >= need:
                return s
        else:
            last, stable = s, 1
        time.sleep(0.3)
    return last or "UNKNOWN"


def main():
    args = sys.argv[1:]
    if not args:
        sys.stderr.write("用法: ys-fast state [--frame PNG] [--max-age-ms N]|px X Y|"
                         "settle [秒]|--frame PNG|--regress\n")
        return 2
    if args[0] == "--frame":
        if len(args) < 2:
            sys.stderr.write("--frame 需要 PNG 路径\n")
            return 3
        s, _ = state(["--frame", args[1]])
        print(s)
        return 0
    if args[0] == "--regress":
        return subprocess.run([YS_STATE, "--regress", "--channel", "both"]).returncode
    cmd = args[0]
    if cmd == "state":
        s, rc = state(args[1:])          # 透传 --frame / --max-age-ms 等（旧实现把它们吞掉了）
        print(s)
        return rc
    if cmd == "px":
        if len(args) < 3:
            sys.stderr.write("px 需要 X Y\n")
            return 2
        r = subprocess.run([YS_STATE, "--pixel", args[1], args[2]],
                           capture_output=True, text=True)
        print((r.stdout or "").strip() or "FAIL")
        return r.returncode
    if cmd == "settle":
        print(settle(int(args[1]) if len(args) > 1 else 90))
        return 0
    sys.stderr.write(f"未知子命令 {cmd}\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
