#!/usr/bin/env python3
"""ys-fast — 廉价判据层：只取需要的像素，不做全屏抓图。

存在理由（2026-10-17 用户点破「重载资产存在巨大低效」）：
  实测 `ys-ui-state` 一次 11.2s、`ys-map where` 一次 13.5s，
  而它们要的信息只是屏幕上的**一两个像素**；`import -window root -crop` 只要 **30ms**（快 ~370 倍）。
  导航循环每轮判态 6 次 + 固定 sleep 35s ⇒ 一次 leave 撞满 300s 超时。

判据标定（物理像素 2560×1440，实测）：
  MENU    ⇔ px(300,300) 三通道 >200           （系统菜单面板浅灰 217,217,217）
  SAVE    ⇔ px(300,300) 暗且蓝主导 <60,<60,<90 （存档页深蓝紫 15,19,53）
  EDITOR  ⇔ 其余                                （摆放页 px(100,400) 草绿 72,92,60）

用法:
  ys-fast state            打印 MENU|SAVE|EDITOR
  ys-fast px X Y           打印该点 RGB（调试用）
  ys-fast settle           轮询到「地图载入完成」（编辑器 UI 稳定）后返回
"""
import subprocess
import sys
import time
import tempfile
import os

DISPLAY = os.environ.get("DISPLAY", ":1")


def crop(x, y, w=8, h=8):
    """取一块小区域的均值 RGB。30~80ms 量级。

    ⚠️ 2026-10-17 实测：`import -window root` 返回的是 **780×439 缩放图**（读数错），
    必须用**游戏窗 id**；`import -window <游戏窗> -crop` 与 spectacle 全屏抓图逐通道一致。
    """
    fd, path = tempfile.mkstemp(suffix=".png", prefix="ysfast-")
    os.close(fd)
    try:
        r = subprocess.run(
            ["import", "-window", os.environ.get("YS_WIN", "0x01400001"),
             "-crop", f"{w}x{h}+{x}+{y}", "+repage", path],
            capture_output=True, timeout=10,
            env=dict(os.environ, DISPLAY=DISPLAY),
        )
        if r.returncode != 0 or not os.path.getsize(path):
            return None
        r2 = subprocess.run(
            ["magick", path, "-format", "%[fx:int(255*mean.r)] %[fx:int(255*mean.g)] %[fx:int(255*mean.b)]", "info:"],
            capture_output=True, text=True, timeout=10,
        )
        if r2.returncode != 0:
            return None
        return tuple(int(v) for v in r2.stdout.split())
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


def state():
    # 系统菜单面板上的一个点
    p = crop(300, 300)
    if p and all(c > 200 for c in p):
        return "MENU"
    # 加载页：浅蓝（实测 128,186,223）——导航期间最常见，必须单独识别，
    # 否则会被当成 EDITOR 继续点，全部落空（这是 leave 空转到 300s 的直接原因之一）
    if p and p[2] > 180 and p[2] > p[1] + 20 and 100 < p[0] < 170:
        return "LOADING"
    q = crop(100, 400)
    # 存档页：深蓝紫，且蓝通道明显高于绿（草地阴影是绿主导，靠这个区分）
    if p and q and p[0] < 60 and p[1] < 60 and p[2] < 90 and p[2] > p[1] + 10 and q[0] < 60:
        return "SAVE"
    return "EDITOR"


def settle(timeout=90, need=3):
    """轮询到状态连续 need 次相同（即界面不再跳变）后返回该状态。"""
    t0 = time.time()
    last = None
    stable = 0
    while time.time() - t0 < timeout:
        s = state()
        if s == last:
            stable += 1
            if stable >= need:
                return s
        else:
            last, stable = s, 1
        time.sleep(0.3)
    return last or "UNKNOWN"


def main():
    if len(sys.argv) < 2:
        print("用法: ys-fast state|px X Y|settle", file=sys.stderr)
        return 2
    cmd = sys.argv[1]
    if cmd == "state":
        print(state())
        return 0
    if cmd == "px":
        p = crop(int(sys.argv[2]), int(sys.argv[3]), 4, 4)
        print(" ".join(str(v) for v in p) if p else "FAIL")
        return 0
    if cmd == "settle":
        to = int(sys.argv[2]) if len(sys.argv) > 2 else 90
        print(settle(to))
        return 0
    print("未知子命令", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
