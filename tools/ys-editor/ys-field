#!/usr/bin/env python3
"""ys-field —— 覆盖「设置项字段」这一类操作点（2026-10-19 建）

为什么单独做：分母里 **setting 类有 187 点（41%）**，它们不是"点一下就换界面"的菜单项，
而是面板里的开关/下拉/输入框。整帧帧差对它们不敏感（一个 checkbox 只占几百像素，
全帧差异约 0.0001），必须**按字段所在的小区域**取读数，否则永远判成"没变化"。

做法：从 look 的对象里按名字找到字段行 → 取该行右侧一条带（值区）→ 只对那条带做前后差 →
连续点 K 次（开关类来回切、下拉类展开）→ 每一次都记读数。

用法：
  ys-field --path "关卡设置 > 基础" --field 是否启用全额绽放伤害 [--clicks 1] [--dry]
退出码：0 该字段有可区分的帧差 / 1 点了但区域无变化（记为 failed）/ 2 找不到字段
"""
import argparse
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
WIN = os.environ.get("YS_OPS_WIN", "0x1800001")
WS = os.path.join(REPO, ".scratch/gui-service/worldsvc.py")
OPS = os.path.join(HERE, "ys-ops")
TMP = "/tmp/ys-field"


def env():
    e = dict(os.environ)
    e.setdefault("DISPLAY", ":1")
    return e


def look():
    os.makedirs(TMP, exist_ok=True)
    out = os.path.join(TMP, "look.json")
    if os.path.exists(out):
        os.remove(out)
    subprocess.run([sys.executable, WS, "look", "--live", "--backend", "daemon-world",
                    "--json-out", out], env=env(), capture_output=True, timeout=180)
    if not os.path.exists(out):
        return None
    return json.load(open(out)).get("objects") or []


def ocr_boxes(png):
    """自己跑一次全帧 OCR 拿文字框——用于「字段标签读到了但没被归属到任何对象」的情形。

    为什么需要：`look` 的 objects 只包含**被检测成对象**的东西；面板右侧的设置字段行
    常常只是一行字（没有外框、没被判成 row），于是 OCR 读到了、free_text 里也有，
    但 objects 里没有它 ⇒ 按名字找不到字段。
    实测证据：右侧裁剪后 OCR 能读出「实体离场时碰撞触发器检测优化」这类字段名。
    """
    try:
        r = subprocess.run([sys.executable, os.path.join(HERE, "ys_ocr.py"), "ocr", png, "--json"],
                           env=env(), capture_output=True, text=True, timeout=180)
        d = json.loads(r.stdout or "[]")
        if isinstance(d, list):
            return d
        # ys_ocr 的 JSON 用 **boxes** 键（不是 items/results）——按错键会稳定返回 0 条，
        # 读起来像"OCR 读不到"，实际是解析写错。2026-10-19 实测：同一帧正确解析出 38 条。
        return d.get("boxes") or []
    except Exception:
        return []


def grab(out):
    r = subprocess.run(["import", "-window", WIN, out], env=env(),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=25)
    return out if r.returncode == 0 and os.path.getsize(out) > 4096 else None


def region_diff(a, b, box):
    from PIL import Image, ImageChops
    x, y, w, h = [int(v) for v in box]
    ia = Image.open(a).convert("L").crop((x, y, x + w, y + h))
    ib = Image.open(b).convert("L").crop((x, y, x + w, y + h))
    d = ImageChops.difference(ia, ib)
    px = list(d.getdata())
    return round(sum(1 for v in px if v > 8) / max(len(px), 1), 4)


def main():
    ap = argparse.ArgumentParser(prog="ys-field")
    ap.add_argument("--path", default="", help="界面路径（进台账）")
    ap.add_argument("--field", required=True)
    ap.add_argument("--clicks", type=int, default=1)
    ap.add_argument("--dry", action="store_true")
    ap.add_argument("--probe", action="store_true",
                    help="只判「这一行右边有没有可操作控件」，不点击。用来把说明行从分母里剔出去")
    a = ap.parse_args()

    objs = look()
    if objs is None:
        print("[ys-field] look 失败（窗口不在栈顶？）", file=sys.stderr)
        return 2
    hit = None
    for o in objs:
        t = " ".join(o.get("text") or [])
        if t.startswith(a.field) or a.field in t:
            hit = o
            break
    if hit is None:
        png = grab(os.path.join(TMP, "ocr.png"))
        boxes = ocr_boxes(png) if png else []
        for b in boxes:
            t = (b.get("text") or b.get("txt") or "")
            if a.field in t:
                bb = b.get("bbox") or b.get("box") or []
                if len(bb) == 4 and all(isinstance(v, (int, float)) for v in bb):
                    x0, y0, x1, y1 = bb          # 已是 xyxy
                    rect = [x0, y0, x1 - x0, y1 - y0]
                elif len(bb) == 4 and isinstance(bb[0], (list, tuple)):
                    xs = [pt[0] for pt in bb]; ys = [pt[1] for pt in bb]
                    rect = [min(xs), min(ys), max(xs) - min(xs), max(ys) - min(ys)]
                else:
                    continue
                if True:
                    hit = {"bbox": rect, "text": [t], "kind": "ocr-text"}
                    print(f"[ys-field] 对象里没有，改从 OCR 框定位：{t!r}", file=sys.stderr)
                    break
    if hit is None:
        print(f"[ys-field] 屏上找不到字段 {a.field!r}（对象与 OCR 都没有）", file=sys.stderr)
        return 2
    x, y, w, h = hit["bbox"]
    # 值区 = **标签右边缘右侧的一条带**（不是从行中间切）。
    # 为什么改：从 45% 处切会把标签自身的文字含进来，方差被文字撑高，
    # 「说明行（右侧纯背景）」会被误判成"有控件"（实测 stdev 21，肉眼却明明没有控件）。
    vx = int(x + w + 10)
    vw = max(60, min(360, 2560 - vx))
    box = (vx, int(y - 4), vw, int(h + 8))
    cx, cy = int(vx + vw * 0.35), int(y + h / 2)
    print(f"[ys-field] {a.field}: bbox={[round(v) for v in hit['bbox']]} 值区={box} 点={cx},{cy}",
          file=sys.stderr)
    if a.probe or a.dry:
        # 可操作性判据：值区里有没有"控件样"的结构。
        # 说明行右侧是纯背景（亮度方差很小、也没有高对比团块）；开关/下拉/输入框会有边框或色块。
        png = grab(os.path.join(TMP, "probe.png"))
        if not png:
            print("[ys-field] 抓帧失败", file=sys.stderr)
            return 2
        import statistics
        from PIL import Image as _I
        x, y, w, h = box
        px = list(_I.open(png).convert("L").crop((x, y, x + w, y + h)).getdata())
        sd = round(statistics.pstdev(px), 2)
        rng = max(px) - min(px)
        operable = "yes" if (sd >= 6.0 or rng >= 60) else "no"
        print(json.dumps({"field": a.field, "value_region": [round(v) for v in box],
                          "stdev": sd, "range": rng, "operable": operable}, ensure_ascii=False))
        return 0 if operable == "yes" else 1

    ok = 0
    for i in range(1, a.clicks + 1):
        before = grab(os.path.join(TMP, f"f{i}-before.png"))
        if not before:
            print("[ys-field] 抓帧失败", file=sys.stderr)
            return 2
        subprocess.run([os.path.join(HERE, "ys-pointer-click"), str(cx), str(cy)],
                       env=env(), capture_output=True, timeout=60)
        time.sleep(1.0)
        after = grab(os.path.join(TMP, f"f{i}-after.png"))
        if not after:
            print("[ys-field] 动作后抓帧失败", file=sys.stderr)
            return 2
        d = region_diff(before, after, box)
        status = "covered" if d >= 0.01 else "failed"
        ok += status == "covered"
        subprocess.run([OPS, "add", "--id", f"F-{a.field[:14]}-{i}", "--path", a.path,
                        "--control", a.field, "--action", "observe", "--risk", "B",
                        "--note", f"region_diff={d} box={box}"], env=env(),
                       capture_output=True)
        print(json.dumps({"field": a.field, "round": i, "region_diff": d, "status": status},
                         ensure_ascii=False))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
