#!/bin/bash
# ys-shot <窗口id> <输出.png>        —— 指定 X11 窗口 id（先校验存在再截图）
# ys-shot -t <标题子串> <输出.png>   —— 按标题：经 KWin 取几何 → 截屏幕区域（逻辑坐标 ×1.5 = 物理）
# ys-shot -r x y w h <输出.png>      —— 直接截物理坐标区域
#
# 为什么要有它（2026-10-17 事故）：`import -window $(...)` 的子命令一旦失败就展开成空参，
# `import -window` 于是进入「等用户点窗口」的交互态 → 命令挂死 60s+。本工具**先校验后截图**，
# 窗口不存在直接退 3，绝不进交互态。
set -u
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
A1="${1:?用法: ys-shot <winid> <out.png> | -t <标题> <out.png> | -r x y w h <out.png>}"
case "$A1" in
  -t|-r) MODE="$A1"; shift ;;
  *)     MODE="id" ;;
esac
case "$MODE" in
  id)
    WIN="${1:?缺窗口 id}"; OUT="${2:?缺输出文件}"
    xdotool getwindowname "$WIN" >/dev/null 2>&1 || { echo "[ys-shot] 窗口 $WIN 不可读（不存在/已关闭）——拒绝截图" >&2; exit 3; }
    import -window "$WIN" "$OUT" 2>/dev/null || { echo "[ys-shot] import 失败：$WIN" >&2; exit 4; } ;;
  -t)
    T="${1:?缺标题子串}"; OUT="${2:?缺输出文件}"
    geo=$(timeout 8 "$(dirname "$0")/ys-kwin-geo" 2>/dev/null | awk -v q="$T" 'index($0,q){print $1,$2,$3,$4; exit}')
    [ -n "$geo" ] || { echo "[ys-shot] 未找到标题含 '$T' 的窗口——拒绝截图" >&2; exit 3; }
    set -- $geo; X=$(awk -v v="$1" 'BEGIN{printf "%d", v*1.5}'); Y=$(awk -v v="$2" 'BEGIN{printf "%d", v*1.5}')
    W=$(awk -v v="$3" 'BEGIN{printf "%d", v*1.5}'); H=$(awk -v v="$4" 'BEGIN{printf "%d", v*1.5}')
    import -window root -crop "${W}x${H}+${X}+${Y}" +repage "$OUT" 2>/dev/null || { echo "[ys-shot] 区域截图失败" >&2; exit 4; } ;;
  -r)
    X="${1:?}"; Y="${2:?}"; W="${3:?}"; H="${4:?}"; OUT="${5:?缺输出文件}"
    import -window root -crop "${W}x${H}+${X}+${Y}" +repage "$OUT" 2>/dev/null || { echo "[ys-shot] 区域截图失败" >&2; exit 4; } ;;
esac
identify -format '%wx%h %b' "$OUT" 2>/dev/null && echo "  → $OUT" || { echo "[ys-shot] 产物不可读" >&2; exit 5; }
