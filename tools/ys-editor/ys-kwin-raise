#!/bin/bash
# ys-kwin-raise <标题子串> — 用 KWin 脚本把窗口提到前台并激活（wmctrl 对 Wine 窗会静默失败，D136）
# 回读验证：打印激活后的 activeWindow 标题；成功=含目标子串
set -u
T="${1:?用法: ys-kwin-raise <标题子串>}"
JS=/tmp/ys-kwin-raise.js
cat > "$JS" << JS
var list = workspace.windowList(), t = null;
for (var i = 0; i < list.length; i++) { if (String(list[i].caption||"").indexOf("$T") >= 0) { t = list[i]; break; } }
if (t) { try { workspace.activeWindow = t; } catch (e) {} if (workspace.activeWindow !== t) { try { t.activate(); } catch (e) {} } }
var a = workspace.activeWindow;
console.info("YS-RAISE " + (a ? String(a.caption) : "NONE"));
JS
gdbus call --session --dest org.kde.KWin --object-path /Scripting --method org.kde.kwin.Scripting.loadScript "$JS" "ysraise$RANDOM" >/dev/null 2>&1
gdbus call --session --dest org.kde.KWin --object-path /Scripting --method org.kde.kwin.Scripting.start >/dev/null 2>&1
sleep 0.8
journalctl --user --since "2 seconds ago" 2>/dev/null | grep -o "YS-RAISE .*" | tail -1 | sed 's/^YS-RAISE //'
