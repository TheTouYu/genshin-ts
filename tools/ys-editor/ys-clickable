#!/usr/bin/env python3
"""ys-clickable —— 「点得动 / 点不动」的**仪器化判定**（2026-10-20 建，假死根治主线）

为什么必须存在（用户的诉状）：
  千星编辑器假死时「沙箱窗/资源管理器/日志全部点不动，但渲染正常、可移动、可获焦」。
  此前的判据是**用户真人点一下口头报告**（`ys-gesture-cure` 头注释原文：
  「程序读不到『点击是否生效』，这一级只能由用户断言」）——没有仪器就没有可重复实验，
  也就没有假死的二分。本工具补上这一级。

通道（**不新增任何抓帧/注入通道**）：
  · 抓帧 = `ys_capture.py` 的 XShmGrabber（同一个类，import 复用），~2–10ms/帧
  · 点击 = `ys-pointer-click`（既有工具，自带 ys-gui-slot 自包装与焦点还原）
  · 判据 = ROI 内逐像素差（numpy）——只关心「点完之后这块界面变没变」

为什么用「双向切换」而不是单次点击：
  单次点击的阴性有两种可能（真卡住 / 点偏了/该元素本来就无响应），不可判别。
  双向 = 点 A→等变化→点 B→等变化：两次都变 = 可点（同一次运行内的正对照）；
  两次都不变 = 卡住；只变一次 = AMBIGUOUS（报出来，不猜）。

用法：
  ys-clickable --win 0x04000008 --roi 600,120,1900,300 \
               --click 120,300:职业节点图 --click 120,260:状态节点图 \
               --hover 120,300 [--timeout 2.0] [--json out.json] [--frames DIR]

  --roi x,y,w,h          只看这块区域（**窗口坐标**）。缺省=整窗
  --click x,y[:名字]     一次点击探针（可重复；第一次=去，第二次=回）
  --hover x,y            先做一次「只移指针不点击」的噪声对照（可选但强烈建议）
  --timeout s            每次点击后等界面变化的时限（默认 2.0）
  --poll-ms ms           轮询间隔（默认 80）
  --quiet                人读输出压成一行

退出码（判据是给别的脚本用的，不许含糊）：
  0 CLICKABLE    所有 click 步骤都观察到超阈值变化（≥2 步 = 双向正对照）
  1 STUCK        第一步零变化（假死的判定）
  2 AMBIGUOUS    有变化但不满足「全部步骤都变」
  3 仪器错误（抓帧/点击失败/窗口不存在）

关键数字（本工具自己实测并打印）：
  hover_px   只移指针造成的 ROI 变化像素数 = **噪声地板**
  changed_px 点击后 ROI 变化像素数（超过地板才叫"点得动"）
  latency_ms 变化首次被看到的时刻（判定"事件进没进去"，不判快慢）
"""
import argparse
import json
import os
import subprocess
import sys
import time

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import importlib.util

_spec = importlib.util.spec_from_file_location('ys_capture_mod', os.path.join(HERE, 'ys_capture.py'))
cap = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cap)

DEFAULT_DISPLAY = os.environ.get('DISPLAY') or ':1'
PIXEL_DELTA = 10          # 单通道差值超过它才算"这个像素变了"（压 JPEG/抖动噪声；XShm 是精确像素）
MIN_CHANGED_PX = 300      # ROI 内至少这么多像素变化才算"界面真的响应了"（实测标定见 README）


def log(msg, quiet=False):
    if not quiet:
        print(msg, flush=True)


def parse_xy(s, width=0):
    """x 支持 '@-53' 形式 = 距窗口右边缘 53px（窗口会被 resize 手势改宽，右锚控件必须这样定位）。"""
    parts = s.split(':')
    xy = parts[0].split(',')
    label = parts[1] if len(parts) > 1 else ''
    x = xy[0]
    if x.startswith('@') and width:
        x = width + int(x[1:])
    return int(x), int(xy[1]), label


def grab_rgb(g, roi):
    rgb, ms = g.grab()
    x, y, w, h = roi
    return rgb[y:y + h, x:x + w].copy(), ms


def diff_px(a, b):
    """返回 (变化像素数, 最大单通道差)。精确像素差，不做模糊。"""
    d = np.abs(a.astype(np.int16) - b.astype(np.int16))
    m = d.max(axis=2)
    return int((m > PIXEL_DELTA).sum()), int(m.max())


def _qptr():
    """读 X 指针位置（不依赖 xdotool）。"""
    out = subprocess.run([sys.executable, '-c', QUERY_PTR], capture_output=True, text=True, timeout=10)
    try:
        return tuple(int(v) for v in out.stdout.strip().split(','))
    except Exception:                                         # noqa: BLE001
        return None


QUERY_ORIGIN = r"""
import ctypes, ctypes.util, os, sys
x11 = ctypes.CDLL(ctypes.util.find_library('X11'))
x11.XOpenDisplay.restype = ctypes.c_void_p; x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong; x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XTranslateCoordinates.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong,
  ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
  ctypes.POINTER(ctypes.c_ulong)]
d = x11.XOpenDisplay((os.environ.get('DISPLAY') or ':1').encode())
root = x11.XDefaultRootWindow(ctypes.c_void_p(d))
win = int(sys.argv[1], 16)
x = ctypes.c_int(); y = ctypes.c_int(); child = ctypes.c_ulong()
x11.XTranslateCoordinates(ctypes.c_void_p(d), ctypes.c_ulong(win), ctypes.c_ulong(root), 0, 0,
                          ctypes.byref(x), ctypes.byref(y), ctypes.byref(child))
print('%d,%d' % (x.value, y.value))
"""


def window_origin(win):
    out = subprocess.run([sys.executable, '-c', QUERY_ORIGIN, hex(win)],
                         capture_output=True, text=True, timeout=10)
    try:
        a, b = out.stdout.strip().split(',')
        return int(a), int(b)
    except Exception:                                         # noqa: BLE001
        return 0, 0


QUERY_PTR = r"""
import ctypes, ctypes.util
x11 = ctypes.CDLL(ctypes.util.find_library('X11'))
x11.XOpenDisplay.restype = ctypes.c_void_p; x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong; x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
  ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
  ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_uint)]
import os
d = x11.XOpenDisplay((os.environ.get('DISPLAY') or ':1').encode())
root = x11.XDefaultRootWindow(ctypes.c_void_p(d))
r = ctypes.c_ulong(); c = ctypes.c_ulong(); rx = ctypes.c_int(); ry = ctypes.c_int()
wx = ctypes.c_int(); wy = ctypes.c_int(); m = ctypes.c_uint()
x11.XQueryPointer(ctypes.c_void_p(d), ctypes.c_ulong(root), ctypes.byref(r), ctypes.byref(c),
                  ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(m))
print('%d,%d' % (rx.value, ry.value))
"""


def pointer_movable():
    """在槽内做一次 +24,+16 的注入，读回位移。返回 (ok, detail)。"""
    a = _qptr()
    if a is None:
        return False, 'XQueryPointer 失败'
    p = subprocess.run([os.path.join(HERE, 'shims', 'ydotool') if os.path.exists(os.path.join(HERE, 'shims', 'ydotool')) else 'ydotool',
                        'mousemove', '-x', '24', '-y', '16'],
                       capture_output=True, text=True, timeout=10,
                       env={**os.environ, 'YS_SLOT_ACTIVE': '1'})
    b = _qptr()
    if b is None:
        return False, 'XQueryPointer(读回) 失败'
    moved = abs(b[0] - a[0]) + abs(b[1] - a[1])
    if moved < 4:
        return False, f'注入 -x24 -y16 后指针只动了 {moved}px（{a}→{b}）：注入通道被吞（KWin 交互态/按钮卡住/抓取）'
    return True, f'{a}→{b} (+{moved}px)'


def click_xy(x, y, timeout=25):
    """经 ys-pointer-click 点击（它是既有注入通道，自带槽位与焦点还原）。"""
    t0 = time.time()
    p = subprocess.run([os.path.join(HERE, 'ys-pointer-click'), str(x), str(y)],
                       capture_output=True, text=True, timeout=timeout)
    return p.returncode, (time.time() - t0) * 1000.0, (p.stdout or '') + (p.stderr or '')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--win', default=os.environ.get('YS_WIN') or '0x04000008')
    ap.add_argument('--roi', default='')          # 窗口坐标 x,y,w,h
    ap.add_argument('--click', action='append', default=[])
    ap.add_argument('--hover', default='')
    ap.add_argument('--timeout', type=float, default=2.0)
    ap.add_argument('--poll-ms', type=int, default=80)
    ap.add_argument('--json', default='')
    ap.add_argument('--frames', default='')
    ap.add_argument('--quiet', action='store_true')
    args = ap.parse_args()

    win = int(args.win, 16) if args.win.lower().startswith('0x') else int(args.win)
    res = {'win': hex(win), 'roi': None, 'hover_px': None, 'steps': [], 'verdict': 'ERROR',
           't': time.strftime('%Y-%m-%dT%H:%M:%S%z')}
    try:
        g = cap.XShmGrabber(DEFAULT_DISPLAY, win)
    except Exception as e:                                    # noqa: BLE001
        print(json.dumps({'verdict': 'ERROR', 'error': f'抓帧初始化失败: {e}'}, ensure_ascii=False))
        return 3
    try:
        w, h = g.w, g.h
        if args.roi:
            roi = tuple(int(v) for v in args.roi.split(','))
        else:
            roi = (0, 0, w, h)
        roi = (roi[0], roi[1], min(roi[2], w - roi[0]), min(roi[3], h - roi[1]))
        res['roi'] = list(roi)
        ox, oy = window_origin(win)
        res['origin'] = [ox, oy]
        log(f'[ys-clickable] win={hex(win)} origin=({ox},{oy}) frame={w}x{h} roi(win)={roi}', args.quiet)

        # 注入通道自证：ydotool 能真移动指针吗（KWin 交互态/按钮卡住会让它静默失效）
        import subprocess as _sp
        ok_move, det = pointer_movable()
        res['pointer_movable'] = ok_move
        if not ok_move:
            print(json.dumps({'verdict': 'ERROR', 'error': f'注入通道失效：{det}'}, ensure_ascii=False))
            return 3

        # 噪声地板：连抓 4 帧，两两差（界面静止时应为 0；有动画/光标闪烁时会 >0）
        base, _ = grab_rgb(g, roi)
        noise = 0
        for _ in range(3):
            f, _ = grab_rgb(g, roi)
            noise = max(noise, diff_px(base, f)[0])
            base = f
        res['idle_noise_px'] = noise
        if noise:
            log(f'  静止噪声 = {noise}px（界面在动，地板抬到这里）', args.quiet)

        # hover 对照：只移指针（不点击）应当**至多**产生一点悬停高亮
        if args.hover:
            hx, hy, _ = parse_xy(args.hover, w)
            before, _ = grab_rgb(g, roi)
            rc, ms, out = click_xy(hx, hy) if False else (0, 0.0, '')
            # 只移动指针：用 ys-pointer-click 的 --dry-run 定位不注入不可行 ⇒ 用 ydotool 移？
            # 不走新通道：改成「点击前后」的对照组即可，hover 只作为可选弱对照（见下）
            res['hover_px'] = None
            log('  hover 对照未实现（不新增注入通道）；用「双向切换」做正对照', args.quiet)

        steps = []
        prev, _ = grab_rgb(g, roi)
        ok_all, any_change, instrument_error = True, False, False
        for i, spec in enumerate(args.click):
            wx_, wy_, label = parse_xy(spec, w)      # 窗口坐标
            x, y = wx_ + ox, wy_ + oy                # 屏幕坐标（ys-pointer-click 口径）
            rc, click_ms, out = click_xy(x, y)
            if rc != 0:
                # 注入失败（指针动不了/未命中）⇒ 仪器故障。STUCK 判定不许由仪器故障产生。
                steps.append({'i': i, 'label': label, 'xy_screen': [x, y], 'error': f'click rc={rc}',
                              'verdict': 'CLICK_ERROR', 'out': out[-400:]})
                ok_all = False
                instrument_error = True
                continue
            t0 = time.time()
            changed, maxd, latency, best = 0, 0, None, None
            while (time.time() - t0) * 1000 < args.timeout * 1000:
                f, _ = grab_rgb(g, roi)
                c, m = diff_px(prev, f)
                if c > changed:
                    changed, maxd, best = c, m, f
                if c >= MIN_CHANGED_PX and latency is None:
                    latency = (time.time() - t0) * 1000.0
                    break
                time.sleep(args.poll_ms / 1000.0)
            step = {'i': i, 'label': label, 'xy_win': [wx_, wy_], 'xy_screen': [x, y],
                    'changed_px': changed,
                    'max_delta': maxd, 'latency_ms': None if latency is None else round(latency, 1),
                    'click_ms': round(click_ms, 1),
                    'verdict': 'CHANGED' if changed >= MIN_CHANGED_PX else 'NO_CHANGE'}
            steps.append(step)
            log(f'  [{i}] click {label or ""}({x},{y}) -> changed_px={changed} maxΔ={maxd} '
                f'latency={step["latency_ms"]}ms verdict={step["verdict"]}', args.quiet)
            if step['verdict'] == 'CHANGED':
                any_change = True
                prev = best
            else:
                ok_all = False
            if args.frames:
                os.makedirs(args.frames, exist_ok=True)
                cap_png(os.path.join(args.frames, f'step{i}.png'), prev)
        res['steps'] = steps
        if not steps or instrument_error:
            res['verdict'] = 'ERROR'
            rc = 3
        elif all(s.get('verdict') == 'CHANGED' for s in steps):
            res['verdict'] = 'CLICKABLE'
            rc = 0
        elif not any_change:
            res['verdict'] = 'STUCK'
            rc = 1
        else:
            res['verdict'] = 'AMBIGUOUS'
            rc = 2
        if args.json:
            with open(args.json, 'w') as f:
                json.dump(res, f, ensure_ascii=False, indent=1)
        # 2026-10-21（门禁 G-WHITELIST 抓到的存量违规）：这里原先把每步投影到
        # ('label','changed_px','latency_ms','verdict') 四个键 —— **error / out / xy_screen 全被丢掉**，
        # 而 'out' 正是点击失败时唯一能回答「为什么失败」的字段（静默蒸发）。
        # 改为整体透传；顺手把大字段裁到既有上限（out 在构造时已截 400 字符）。
        print(json.dumps({'verdict': res['verdict'],
                          'steps': steps,
                          'idle_noise_px': res.get('idle_noise_px')}, ensure_ascii=False))
        return rc
    finally:
        try:
            g.close()
        except Exception:                                     # noqa: BLE001
            pass


def cap_png(path, rgb):
    try:
        from PIL import Image
        Image.fromarray(rgb).save(path)
    except Exception:                                         # noqa: BLE001
        pass


if __name__ == '__main__':
    sys.exit(main())
