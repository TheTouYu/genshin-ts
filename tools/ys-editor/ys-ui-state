#!/bin/bash
# ys-ui-state — 薄封装：判据全部委托 ys-state（门槛⑤ 单一源，本文件不含坐标/阈值）
#
# 打印 MENU|SAVE|EDITOR（SAVE = ys-state 的 SAVELIST；其它态名原样透传，绝不改名成别的态）。
#   ys-ui-state          # 判一次
#   ys-ui-state --nav    # 先导航到存档页再打印（返回后一定在 SAVE 或尽力而为）
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
YS_STATE="$HERE/ys-state"
judge() { "$YS_STATE" --print-state --compat ys-fast 2>/dev/null | tail -1; }

if [ "${1:-}" = "--nav" ]; then
  for _ in 1 2 3 4 5 6; do
    S=$(judge)
    [ "$S" = SAVE ] && { echo SAVE; exit 0; }
    if [ "$S" = MENU ]; then "$HERE/ys-pointer-click" 39 170 >/dev/null 2>&1; sleep 5
    else "$HERE/ys-esc" >/dev/null 2>&1 || true; sleep 3; fi
  done
  judge; exit 0
fi
judge
