#!/bin/bash
# ys-ui-state — 三态判定（实测标定 2026-10-17）：
#   MENU   ⇔ px(300,300) 三通道 >200（系统菜单面板浅灰 217,217,217）
#   SAVE   ⇔ px(300,300) 暗（<60,<60,<90）且 px(100,400) 暗（存档页深蓝紫 15,19,53）
#   EDITOR ⇔ 其余（摆放页 px(100,400) 草绿 72,92,60）
# 用法: ys-ui-state          # 打印 MENU|SAVE|EDITOR
#       ys-ui-state --nav  # 先导航到存档页再打印（返回后一定在 SAVE 或尽力而为）
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
SHOT=/tmp/ys-ui-state.png
px() { magick "$SHOT" -format "%[fx:int(255*p{$1,$2}.r)] %[fx:int(255*p{$1,$2}.g)] %[fx:int(255*p{$1,$2}.b)]" info: 2>/dev/null; }
grab() { "$HERE/ys-peek" "$SHOT" >/dev/null 2>&1; }
judge() {
  local r g b r2 g2 b2
  read -r r g b <<<"$(px 300 300)"
  if [ "${r:-0}" -gt 200 ] && [ "${g:-0}" -gt 200 ] && [ "${b:-0}" -gt 200 ]; then echo MENU; return; fi
  read -r r2 g2 b2 <<<"$(px 100 400)"
  if [ "${r:-0}" -lt 60 ] && [ "${g:-0}" -lt 60 ] && [ "${b:-0}" -lt 90 ] && [ "${r2:-0}" -lt 60 ]; then echo SAVE; return; fi
  echo EDITOR
}
if [ "${1:-}" = "--nav" ]; then
  for i in 1 2 3 4 5 6; do
    grab; S=$(judge)
    [ "$S" = SAVE ] && { echo SAVE; exit 0; }
    if [ "$S" = MENU ]; then "$HERE/ys-pointer-click" 39 170 >/dev/null 2>&1; sleep 5
    else "$HERE/ys-esc" >/dev/null 2>&1 || true; sleep 3; fi
  done
  grab; judge; exit 0
fi
grab; judge
