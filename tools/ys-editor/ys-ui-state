#!/bin/bash
# ys-ui-state — 薄封装：判据全部委托 ys-state（门槛⑤ 单一源，本文件不含坐标/阈值）
#
# 打印 MENU|SAVE|EDITOR（SAVE = ys-state 的 SAVELIST；其它态名原样透传，绝不改名成别的态）。
#   ys-ui-state          # 判一次
#   ys-ui-state --nav    # 先导航到存档页再打印（返回后一定在 SAVE 或尽力而为）
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
YS_STATE="$HERE/ys-state"
# 判态：失败要**出声**（2026-10-17 教训：旧写法把 stderr 丢掉，取帧失败时打印空行，
# 调用方会把"空"当成"不是 SAVE"，于是导航空转到超时——仪器静默降级）
judge() {
  local out rc errf
  errf="$(mktemp -t ys-ui-state-XXXXXX.err)"
  out=$("$YS_STATE" --print-state --compat ys-fast 2>"$errf"); rc=$?
  [ -s "$errf" ] && cat "$errf" >&2
  rm -f "$errf"
  if [ -n "$out" ]; then printf '%s\n' "$out" | tail -1; else echo UNKNOWN; fi
  return "$rc"
}

if [ "${1:-}" = "--nav" ]; then
  for _ in 1 2 3 4 5 6; do
    S=$(judge)
    [ "$S" = SAVE ] && { echo SAVE; exit 0; }
    if [ "$S" = MENU ]; then "$HERE/ys-pointer-click" 39 170 >/dev/null 2>&1; "$HERE/ys-wait" --until "$HERE/ys-state --fast" --expect MENU --timeout 20 --label ui-state || true
    else "$HERE/ys-esc" >/dev/null 2>&1 || true; sleep 3; fi
  done
  judge; exit 0
fi
judge
