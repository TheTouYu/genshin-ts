#!/usr/bin/env python3
"""ys-focus-guard — 焦点租约看门狗：**防止代理占用桌面后不归还**。

为什么要有它（2026-10-19 用户投诉）：
  跑基准时我为了"动作项"取了焦点租约，跑完**没有归还**，用户在旁边干等，还怕打断我。
  用户的原话：「不是记住，而是工程落地来保障」。
  ⇒ 归还这件事不能靠"我记得 release"，必须有一条独立进程盯着租约，超时或持有者死了就自动还原。

2026-10-19 重做（用户投诉「无论做什么都强制切回原神桌面」后加的四条硬约束）：
  ① **不无限重试**：同一租约连续失败 **3 次** ⇒ 标记 `abandoned`（写回租约文件留证据）、
     打印 ALERT、**从此不再对它做任何窗口操作**；退避 0.5→1（→2→4→8 若还有下次）。
  ② **no-op 租约**：acquire 时目标已在焦点 ⇒ 租约带 `noop`，release 只删文件、不做任何窗口操作。
  ③ **失败路径不反复 raise**：`ys-lease release` 内部只有第一次尝试 raise，后续只重读验证。
  ④ **全程失败自愈保险**：连续 **5 次**无法恢复任何租约 ⇒ 写 CRITICAL 并
     `systemctl --user stop ys-focus-guard`（干净退出；unit 的 Restart=on-failure 不会重启）。
  判据：**守护在无法恢复时必须"安静地失败"，绝不能持续干扰用户。**

机制：
  · 每 0.5s 读租约文件；
  · 判定「该归还」：① 租约过期 ② 持有者 pid 不存在/已退出；
  · 归还 = ys-lease release --force --fast（KWin activate+raise+堆叠验证；失败非零）；
  · prev 不可用（面板/幽灵窗/已消失）时回落 firefox，回落同样要过堆叠验证；
  · 失败保留租约并按上面的 ①②③④ 收敛，绝不静默留在游戏窗、也不反复抢屏。

用法：
  ys-focus-guard              # 前台跑（调试）
  ys-focus-guard --daemon     # 后台常驻（setsid）
  ys-focus-guard --check      # 只检查一次（退出码 1 = 有该归还的租约，或归还失败；不做自停）

环境变量（测试/注入用；存在的理由就是让回归**不碰真实屏幕**）：
  YS_LEASE             租约路径
  YS_FOCUS_GUARD_LOG   日志路径
  YS_LEASE_BIN         覆盖 ys-lease 可执行（失败路径注入用假 bin，不碰焦点）
  YS_FOCUS_GUARD_STOP  覆盖自停命令（注入用例用 `touch <file>`，不碰真实服务）
  YS_SCREEN_GRANT_PATH 屏幕租期凭据路径（缺省 ~/.ys/screen-grant.json）
  YS_SESSION_PATH      会话文件路径（缺省 ~/.ys/session.json）
  YS_HAND_BACK_BIN     覆盖"交还屏幕"可执行——过期交还与空闲交还**共用这一处缝**，
                       测试指假脚本即可验证"到期归还"而完全不碰窗口
"""
import argparse
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
LEASE_BIN = os.environ.get("YS_LEASE_BIN") or os.path.join(HERE, "ys-lease")
LEASE = os.environ.get("YS_LEASE") or "/tmp/ys-lease.json"
LOG = os.environ.get("YS_FOCUS_GUARD_LOG") or os.path.expanduser(
    "~/.dsh/cmdlog/ys-focus-guard.log")
STOP_CMD = os.environ.get("YS_FOCUS_GUARD_STOP") or "systemctl --user stop ys-focus-guard"
MAX_LEASE_ATTEMPTS = 3          # 同一租约连续失败 3 次 ⇒ abandoned
GLOBAL_FAIL_LIMIT = 5           # 连续 5 次无法恢复任何租约 ⇒ CRITICAL + 自停
LEASE_STATE = {}                # key -> {"attempts": n, "next_ts": t}
GLOBAL_FAILS = 0
SEEN_ABANDONED = set()


def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n"
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
    except Exception:                                    # noqa: BLE001
        pass
    try:
        with open(LOG, "a") as fh:
            fh.write(line)
    except Exception:                                    # noqa: BLE001
        pass


def release_via_lease():
    """委托 ys-lease 做 KWin 权威归还；返回 (ok, result)。"""
    env = dict(os.environ, YS_LEASE=LEASE)
    try:
        p = subprocess.run([sys.executable, LEASE_BIN, "release", "--force", "--fast"],
                           capture_output=True, text=True, env=env, timeout=30)
    except Exception as e:                               # noqa: BLE001
        return False, {"ok": False, "error": f"SPAWN_FAILED: {type(e).__name__}"}
    out = (p.stdout or "").strip().splitlines()
    res = {}
    for line in reversed(out):
        try:
            res = json.loads(line)
            break
        except Exception:                                # noqa: BLE001
            continue
    if not res:
        res = {"ok": False, "error": "BAD_OUTPUT", "detail": (p.stderr or "")[-300:]}
    return (p.returncode == 0 and bool(res.get("ok"))), res


def should_release(lease):
    now = time.time()
    if lease.get("expires", 0) < now:
        return "expired"
    pid = lease.get("owner_pid")
    if pid:
        try:
            os.kill(int(pid), 0)
        except OSError:
            return "owner-dead"
    return None


def mark_abandoned(lease, attempts, res):
    """把租约标记为 abandoned（保留文件作证据），此后守护不再对它做任何窗口操作。"""
    lease = dict(lease)
    lease["abandoned"] = {"at": time.time(), "attempts": attempts,
                          "error": res.get("error"), "problems": res.get("problems")}
    tmp = f"{LEASE}.tmp.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(lease, fh, ensure_ascii=False)
        os.chmod(tmp, 0o600)
        os.replace(tmp, LEASE)
        return True
    except Exception:                                    # noqa: BLE001
        return False


def lease_key(lease):
    prev = lease.get("prev")
    pid = prev.get("internalId") if isinstance(prev, dict) else prev
    return "%s|%s|%s" % (lease.get("acquired_at"), lease.get("owner_pid"), pid)


GRANT = os.environ.get("YS_SCREEN_GRANT_PATH", os.path.expanduser("~/.ys/screen-grant.json"))
HAND_BACK_BIN = os.environ.get("YS_HAND_BACK_BIN") or os.path.join(HERE, "ys-hand-back")


def enforce_grant_expiry(verbose=False):
    """**租期到期必须由机制归还**（用户 2026-10-21 第三次强调）：
    「不能靠模型自觉，要做成机制——我给了 120s，几分钟都没把窗口切回来」。

    旧设计只在有人调 `ys-screen-grant status/revoke` 时才交还；没人调 = 屏幕永久被占。
    这里让常驻守护（0.5s 轮询）**自己**发现过期并交还，不依赖调用方记得。
    返回 1 = 本次做了交还动作。
    """
    try:
        if not os.path.exists(GRANT):
            return 0
        rec = json.load(open(GRANT))
    except Exception:                                    # noqa: BLE001
        return 0
    left = float(rec.get("expires", 0)) - time.time()
    if left > 0:
        return 0
    # 已过期：交还一次，然后清凭据（幂等）。
    # 交还入口必须与 _hand_back_once 共用 HAND_BACK_BIN（模块级定义在函数之后，
    # 调用时才解析，不影响行为）：原先这里硬编码同目录的 ys-hand-back，
    # 导致"到期归还"这条机制**没有离线判据**——测试要么真把屏幕切回 firefox，
    # 要么只能等常驻守护在真机上跑（账本 F-20261021-60 因此长期无回归）。
    try:
        p = subprocess.run([HAND_BACK_BIN], capture_output=True, text=True, timeout=45)
        log(f"GRANT_EXPIRED hand_back rc={p.returncode} out={(p.stdout or p.stderr).strip()[:160]}")
    except Exception as e:                               # noqa: BLE001
        log(f"GRANT_EXPIRED hand_back EXC {type(e).__name__}: {e}")
    try:
        os.unlink(GRANT)
    except OSError:
        pass
    return 1


SESSION = os.environ.get("YS_SESSION_PATH") or os.path.expanduser("~/.ys/session.json")
GAME_MARKS = ("yuanshen", "genshin", "原神")


def _read_json(p):
    try:
        with open(p, encoding="utf-8") as f:
            return json.load(f)
    except Exception:                                    # noqa: BLE001
        return None


def _write_json(p, d):
    tmp = "%s.tmp.%d" % (p, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False, indent=1)
        os.replace(tmp, p)
        return True
    except Exception:                                    # noqa: BLE001
        return False


def _hand_back_once(why):
    try:
        p = subprocess.run([HAND_BACK_BIN], capture_output=True, text=True, timeout=45)
        log("%s hand_back rc=%d out=%s" % (why, p.returncode, (p.stdout or p.stderr or "").strip()[:140]))
        return p.returncode == 0
    except Exception as e:                               # noqa: BLE001
        log("%s hand_back EXC %s: %s" % (why, type(e).__name__, e))
        return False


def _kwin_active():
    try:
        p = subprocess.run([LEASE_BIN, "kwin-state"], capture_output=True, text=True, timeout=20)
        d = json.loads((p.stdout or "").strip().splitlines()[-1])
        return (d or {}).get("active") or {}
    except Exception:                                    # noqa: BLE001
        return {}


def _is_game(cls):
    c = str(cls or "").lower()
    return any(k in c for k in GAME_MARKS)


def _orphan_probe(s):
    """记录"屏幕在游戏上、但所有权已释放"的孤儿状态（只观测，不抢画面）。

    判据：每 ≥2s 探一次（kwin-state 是子进程，别在 0.5s 循环里裸调）：
      · 游戏是活动窗 且 尚未记录 ⇒ 记 `orphan_since = now`
      · 否则 ⇒ 清掉标记
    之所以不自动收回：用户自己切到游戏时，系统**无法区分**那是不是我们的动作；
    真正能区分的是 claim（抬窗路径登记所有权）。孤儿读数用于暴露漏登记的路径。
    """
    now = time.time()
    if now - float(s.get("orphan_probe_ts") or 0) < 2.0:
        return
    act = _kwin_active()
    on_game = _is_game(act.get("class"))
    s2 = _read_json(SESSION)
    if not s2:
        return
    s2["orphan_probe_ts"] = now
    if on_game:
        s2.setdefault("orphan_since", now)
        s2["orphan_active"] = act.get("class")
    else:
        s2.pop("orphan_since", None)
        s2.pop("orphan_active", None)
    _write_json(SESSION, s2)


def enforce_session_idle(verbose=False):
    """会话空闲 ⇒ 把屏幕交还用户（层 2，2026-10-21 用户令）。

    用户原话：「我希望模型在思考的时候，不要白白等待，会自动切换回来；模型思考结束了、
    执行下一个动作的时候，自动切到游戏，不干扰模型的执行，不给模型增加额外负担。」

    判据 = **距上次动作的静默时长**（不依赖模型做任何事）：
      · 静默 > idle_ms（缺省 8s，`YS_SESSION_IDLE_MS` 可调）且尚未交还 ⇒ 交还一次，记 released；
      · 下一个动作到来时由 `ys-session focus` 自动重取焦点（模型无感，仍调同一个动作工具）。
    安全：①已交还过就不再动窗口（幂等）；②屏幕已被用户切走时不抢；
          ③决策前后各读一次会话文件，动作刚发生（ts / 持有窗口变了）就放弃本次交还。
    返回 1 = 本次对会话做了交还动作。
    """
    s = _read_json(SESSION)
    if not s or s.get("state") != "active" or s.get("dry_run"):
        return 0
    now = time.time()
    if float(s.get("expires") or 0) <= now:
        if s.get("released"):
            return 0
        _hand_back_once("SESSION_EXPIRED")
        s.update({"released": True, "released_at": now, "release_reason": "expired"})
        _write_json(SESSION, s)
        return 1
    if s.get("released"):
        # 2026-10-21 事故（D485）：交还是一道单向闩锁，只防"重复交还"。
        # 释放之后若**有人（手工 ys-follow-win / 未经 claim 的抬窗路径）又把屏幕拿走**，
        # 没有任何角色负责收回 —— 屏幕会一直停在游戏上。
        # 修法不是"无条件再抢回来"（那会和用户自己切过去打架），而是**把孤儿状态记下来**：
        # 所有权由 claim 登记，没登记的抬窗在这里显形，`ys-session status` 会报 orphan。
        _orphan_probe(s)
        return 0
    if now < float(s.get("holding_until") or 0):
        return 0
    idle_s = int(s.get("idle_ms") or os.environ.get("YS_SESSION_IDLE_MS") or 3000) / 1000.0
    last = float(s.get("last_action_ts") or s.get("created") or 0)
    if now - last < idle_s:
        return 0
    # 动作可能已经开始：再读一次，ts / 持有窗口都没变才动手（避免把刚抬起的窗又推走）
    s2 = _read_json(SESSION)
    if (not s2 or s2.get("released")
            or float(s2.get("last_action_ts") or 0) != last
            or time.time() < float(s2.get("holding_until") or 0)):
        return 0
    act = _kwin_active()
    if not _is_game(act.get("class")):
        s2.update({"released": True, "released_at": now,
                   "release_reason": "idle(not-ours:%s)" % (act.get("class") or "")})
        _write_json(SESSION, s2)
        return 0
    ok = _hand_back_once("SESSION_IDLE")
    s2.update({"released": True, "released_at": now, "release_ok": ok,
               "release_reason": "idle" if ok else "idle(handback-failed)"})
    _write_json(SESSION, s2)
    if verbose:
        print("[ys-focus-guard] 会话空闲交还 → ok=%s" % ok)
    return 1


def check_once(verbose=False, allow_stop=False):
    """返回 1 = 本应有租约要归还（已处理或失败）；0 = 无该归还的租约。"""
    global GLOBAL_FAILS
    if enforce_grant_expiry(verbose):                    # 先执行"租期到期归还"这条机制
        return 1
    if enforce_session_idle(verbose):                    # 再执行"会话空闲 ⇒ 交还用户"（层 2）
        return 1
    if not os.path.exists(LEASE):
        return 0
    try:
        lease = json.load(open(LEASE))
    except Exception:                                    # noqa: BLE001
        return 0
    if lease.get("abandoned"):
        key = lease_key(lease)
        if key not in SEEN_ABANDONED:
            SEEN_ABANDONED.add(key)
            log(f"跳过 abandoned 租约（{key}，不再做任何窗口操作）")
        return 1
    why = should_release(lease)
    if not why:
        return 0
    key = lease_key(lease)
    st = LEASE_STATE.setdefault(key, {"attempts": 0, "next_ts": 0.0})
    now = time.time()
    if now < st["next_ts"]:
        return 1                                   # 退避中：仍算"有该归还的租约"，但不动焦点
    ok, res = release_via_lease()
    if ok or res.get("noop") or res.get("error") == "NO_LEASE":
        LEASE_STATE.pop(key, None)
        GLOBAL_FAILS = 0
        if res.get("noop"):
            log(f"no-op 租约（{why}）→ 直接清除，未做任何窗口操作")
            if verbose:
                print("[ys-focus-guard] no-op 租约 → 清除")
        else:
            log(f"归还焦点（{why}）→ OK restored={res.get('restored')} "
                f"target_idx={res.get('target_index')} game_idx={res.get('game_index')} "
                f"attempts={res.get('attempts')}")
            if verbose:
                print(f"[ys-focus-guard] 归还焦点（{why}）→ OK {res.get('restored')}")
        return 1

    GLOBAL_FAILS += 1
    st["attempts"] += 1
    if st["attempts"] >= MAX_LEASE_ATTEMPTS:
        marked = mark_abandoned(lease, st["attempts"], res)
        LEASE_STATE.pop(key, None)
        log(f"ALERT 租约连续失败 {st['attempts']} 次 → 标记 abandoned（{marked}），"
            f"此后不再做任何窗口操作：{json.dumps(res, ensure_ascii=False)[:400]}")
        if verbose:
            print(f"[ys-focus-guard] ALERT 租约 abandoned（{st['attempts']} 次失败）")
    else:
        delay = min(8.0, 0.5 * (2 ** (st["attempts"] - 1)))   # 0.5 → 1 → 2 → 4 → 8
        st["next_ts"] = now + delay
        log(f"归还失败（{why}，第 {st['attempts']} 次，退避 {delay:.1f}s）→ "
            f"{json.dumps(res, ensure_ascii=False)[:400]}")
        if verbose:
            print(f"[ys-focus-guard] 归还失败（{why}，第 {st['attempts']} 次，退避 {delay:.1f}s）")

    if allow_stop and GLOBAL_FAILS >= GLOBAL_FAIL_LIMIT:
        log(f"CRITICAL 连续 {GLOBAL_FAILS} 次无法恢复任何租约 —— 停止 ys-focus-guard 自身（不再干扰用户）")
        try:
            subprocess.run(STOP_CMD, shell=True, timeout=10)
        except Exception as e:                           # noqa: BLE001
            log(f"CRITICAL 自停命令失败：{type(e).__name__}: {e}")
        sys.exit(0)
    return 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--daemon", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--interval", type=float, default=0.5)
    a = ap.parse_args()
    if a.check:
        return check_once(verbose=True, allow_stop=False)
    if a.daemon:
        if os.fork():
            return 0
        os.setsid()
    while True:
        try:
            check_once(verbose=a.daemon, allow_stop=True)
        except SystemExit:
            raise
        except Exception as e:                           # noqa: BLE001
            log(f"error {type(e).__name__}: {e}")
        time.sleep(a.interval)


if __name__ == "__main__":
    sys.exit(main())
