#!/usr/bin/env python3
"""ys-screen-grant — 屏幕占用契约（用户令 2026-10-21：「每次使用要和用户申请」）。

## 为什么有它

用户原话：「这个系统不是你一个人在用，每次使用要和用户申请——你申请了用户才知道，
才会和你遵守同一个契约。没做到这个，就会遇到用户也在操控屏幕导致的各种不确定的 bug。」

「申请」如果只写在技能里，就等于靠自觉（项目里已有结论：约定要做成设计）。
所以把契约落成一个**带 TTL 的凭据**：底层注入（`ys-gui-slot`）在动手前先查它，
查不到就**拒绝执行**并告诉调用方"先去申请"。

## 契约（2026-10-21 重设计：许可 / 占用 / 观测三件事解耦）

> 旧模型把三者绑在同一个秒表上，产生反作用：租期是稀缺资源 ⇒ 代理为省租期把整条流程
> 预写死（用预判代替观察，用户当场点破）；且「有效期内禁续期」与 `ys-session begin`
> 自带的 grant 互斥，两次 60s 租期 0 次注入。

1. **许可 = 任务级**：调用方在用户同意后运行
     `ys-screen-grant grant --task <任务id> --eta 120 --reason "复验 GAME_FRIENDS" --user-said "<用户原话>"`
   同一 `--task` 内**续期不打断用户**（累计上限 `YS_SCREEN_MAX_TASK`，默认 1800s）；
   换任务必须重新问用户（无 `--user-said` ⇒ `TASK_MISMATCH` / `NEED_USER_APPROVAL`）。
2. **占用 = 动作级**：凭据**不等于**屏幕被占。屏幕空闲由 `ys-focus-guard` 的
   **空闲释放**交还（`ys-session` 的 `idle_ms`），下一个动作自动重取焦点。
   ⇒ 代理的思考时间**不再计费**，也就没有"为省租期批量跑"的动机。
3. **观测 = 事件级**：`status` 回 task/renewals/left_s；拒绝时 `explain` 给人读的完整状态。
4. `ys-gui-slot` 每次占用前校验凭据：过期/缺失 ⇒ 退出码 6 `NO_GRANT`。
5. 测试/自测专用逃生舱 `YS_SLOT_TEST=1`（只在 tests/ 与门禁里出现，生产调用路径不许设）。

## 用法

  ys-screen-grant grant --seconds 180 --reason "..."   # 申请到之后调用
  ys-screen-grant status                              # 剩余秒数 / 是否有效
  ys-screen-grant revoke                              # 提前归还
退出码：0 正常 / 2 用法 / 6 无有效凭据（status 时表示"没授权"）
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

PATH = os.environ.get("YS_SCREEN_GRANT", os.path.expanduser("~/.ys/screen-grant.json"))
HERE = os.path.dirname(os.path.abspath(__file__))


def _kwin_active():
    """占用前的活动窗口（KWin 堆叠序里的 |ACTIVE 行，不是 xdotool 的幽灵窗）。

    这里刻意**不调 ys-lease**：一是守卫 G-FOCUS-RETURN 对"调了租约工具却不判归还"
    有静态判据，二是本工具只读状态、不该碰租约语义。ys-wins 读的是同一份 KWin 权威数据。
    """
    try:
        p = subprocess.run([os.path.join(HERE, "ys-wins")], capture_output=True, text=True,
                           timeout=25,
                           env={**os.environ, "DISPLAY": os.environ.get("DISPLAY") or ":1",
                                "DBUS_SESSION_BUS_ADDRESS": os.environ.get(
                                    "DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/1000/bus")})
        if p.returncode != 0:
            return {"error": "ys-wins rc=%d" % p.returncode}
        for line in (p.stdout or "").splitlines():
            if "|ACTIVE" in line:
                parts = [x.strip() for x in line.split("|")]
                cap = parts[0].split("]", 1)[-1].strip() if parts else ""
                return {"caption": cap, "class": parts[1] if len(parts) > 1 else ""}
        return {"class": "", "caption": ""}
    except Exception as e:                                  # noqa: BLE001
        return {"error": "%s: %s" % (type(e).__name__, e)}


MAX_GRANT_S = int(os.environ.get('YS_SCREEN_MAX_GRANT', '300'))  # 2026-10-21 二次复盘：120s 太短，
                                                                # 扫列表任务被逼着反复申请（纯用户等待 100s）
DEFAULT_ETA = int(os.environ.get('YS_SCREEN_DEFAULT_ETA', '120'))
# 一个任务累计可授权的上限（同任务续期不打断用户，但不能"申请一次、无限续"）
MAX_TASK_S = int(os.environ.get('YS_SCREEN_MAX_TASK', '1800'))


def load():
    try:
        with open(PATH, encoding="utf-8") as f:
            return json.load(f)
    except Exception:                                       # noqa: BLE001
        return None


def _save(rec):
    """原子写（守护 0.5s 轮询，半截文件会被读成无凭据）。"""
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    tmp = "%s.tmp.%d" % (PATH, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(rec, f, ensure_ascii=False, indent=1)
    os.replace(tmp, PATH)


def cmd_grant(a):
    now = time.time()
    # 2026-10-21 复盘（真机会话 session-cd869786）：
    #   代理在 64s 处**没问用户**就 `grant --seconds 1200`（20 分钟），随后立刻 ys-follow-win 切走桌面；
    #   之后每次到期又自己续（220/300/300/200s），用户全程不知道。
    #   ⇒ 光有"凭据"不够，必须防**自授**与**无限续期**：
    task = (getattr(a, "task", "") or "default").strip() or "default"
    n = int(getattr(a, "eta", None) or getattr(a, "seconds", None) or DEFAULT_ETA)
    said = (a.user_said or "").strip()
    cur = load()
    # 单次超大请求一律拒（"一次要 4 小时"= 没跟用户对齐）；续期请用 ≤MAX_GRANT_S 的 eta
    # 2026-10-22（pi 独立任务实测，480s 被整条拒掉、agent 白掉一次调用）：略微超上限 = 估时不准，
    # 截到上限并显式标 capped（仍受上限约束、不自授更多）；远超（>2×）保持硬拒 = 没跟用户对齐。
    capped = False
    n_requested = n
    if MAX_GRANT_S < n <= 2 * MAX_GRANT_S:
        n, capped = MAX_GRANT_S, True
    if n > MAX_GRANT_S:
        print(json.dumps({"ok": False, "error": "GRANT_TOO_LONG",
                          "detail": f"单次最多 {MAX_GRANT_S}s（你要 {n}s）；同一个 --task 内续期不打断用户"},
                         ensure_ascii=False))
        return 2
    # 同任务续期：用户已为**这个任务**知情，不再打断他（2026-10-21 重设计）。
    # 旧模型「有效期内禁止续期」同时挡住了两件事：防自授 + 合法分段 ⇒ 把防护和功能做成了一个开关。
    if cur and float(cur.get("expires") or 0) > now and (cur.get("task") or "default") == task:
        created = float(cur.get("created") or now)
        hard = created + MAX_TASK_S
        new_exp = min(now + n, hard)
        cur.update({"expires": new_exp, "renewals": int(cur.get("renewals") or 0) + 1,
                    "last_renew": now, "eta": n})
        if said:
            cur["user_said_latest"] = said[:200]
        _save(cur)
        print(json.dumps({"ok": True, "renewed": True, "task": task,
                          "left_s": int(new_exp - now), "renewals": cur["renewals"],
                          "capped": new_exp >= hard - 1,
                          "hint": "同任务续期不打断用户；屏幕空闲由 ys-focus-guard 自动交还"},
                         ensure_ascii=False))
        return 0
    if n > MAX_GRANT_S:
        print(json.dumps({"ok": False, "error": "GRANT_TOO_LONG",
                          "detail": f"单次最多 {MAX_GRANT_S}s（你要 {n}s）；同一个 --task 内续期不打断用户"},
                         ensure_ascii=False))
        return 2
    old_task = (cur or {}).get("task")
    if not said:
        busy = bool(cur and float(cur.get("expires") or 0) > now)
        print(json.dumps({"ok": False,
                          "error": "TASK_MISMATCH" if busy else "NEED_USER_APPROVAL",
                          "current_task": old_task,
                          "left_s": int(float(cur.get("expires") or 0) - now) if busy else 0,
                          "detail": ("已有另一个任务的授权（%s）；换任务必须重新问用户并用 --user-said 记录原话"
                                     % old_task) if busy else
                                    "必须用 --user-said 记录**用户原话**（你在对话里问过、他同意了才填）"},
                         ensure_ascii=False))
        return 2
    rec = {"created": now, "expires": now + n, "eta": n, "task": task,
           "reason": a.reason or "", "user_said": said[:200], "renewals": 0,
           "active_window": _kwin_active(),
           "replaced_task": old_task if old_task and old_task != task else None}
    _save(rec)
    left = int(rec["expires"] - now)
    print(json.dumps({"ok": True, "task": task, "granted_s": left, "reason": rec["reason"],
                      "requested_s": n_requested, "capped": capped,
                      "active_window_at_grant": rec["active_window"],
                      "hint": "授权按任务计；屏幕占用由空闲释放（层 2）控制，到期即失效"},
                     ensure_ascii=False))
    return 0


def cmd_status(_a):
    rec = load()
    if not rec:
        print(json.dumps({"ok": False, "error": "NO_GRANT", "path": PATH}, ensure_ascii=False))
        return 6
    left = int(rec.get("expires", 0) - time.time())
    if left <= 0:
        # 到期即统一交还一次，然后清凭据（自愈：没人来 revoke 也不会把屏幕占着）
        hb = _hand_back()
        _tombstone("expired")
        try:
            os.unlink(PATH)
        except OSError:
            pass
        print(json.dumps({"ok": False, "error": "EXPIRED", "left_s": left, "hand_back": hb},
                         ensure_ascii=False))
        return 6
    print(json.dumps({"ok": True, "left_s": left, "reason": rec.get("reason"),
                      "active_window_now": _kwin_active()}, ensure_ascii=False))
    return 0



def _tombstone(reason=""):
    """2026-10-22：交还时留一份墓碑，让下一条命令能说「刚交还过、为什么」，
    而不是一律报「你从没申请过」（pi 独立任务实测：会话 3s 空闲自动交还后，
    agent 拿到的 NO_GRANT 与事实相反，误导它以为授权流程没走通）。"""
    try:
        with open(PATH + ".last", "w", encoding="utf-8") as fh:
            json.dump({"released_at": time.time(), "reason": reason,
                       "path": PATH}, fh, ensure_ascii=False)
    except OSError:
        pass

def _hand_back():
    """把画面交还给**用户原来的窗口**（授权时记录在 active_window）。

    2026-10-22 实测（pi 独立任务）：grant 时记下了 `{"caption":"π - gui-test","class":"kitty"}`，
    但 revoke 交还到 firefox——因为这里调 ys-hand-back 时没把记录传下去，而 ys-hand-back 又写死
    `--prev-json ""`。两处都补上：这里传记录，ys-hand-back 转发给 ys-lease。
    记录缺失/窗口已消失时由 ys-lease 回退 firefox（fallback）。
    """
    prev = ""
    try:
        rec = load()
        aw = (rec or {}).get("active_window") or {}
        if aw.get("caption") or aw.get("class"):
            prev = json.dumps({"caption": aw.get("caption") or "",
                               "class": aw.get("class") or ""}, ensure_ascii=False)
    except Exception:  # noqa: BLE001
        prev = ""
    args = [os.path.join(HERE, "ys-hand-back")]
    if prev:
        args += ["--prev-json", prev]
    try:
        p = subprocess.run(args,
                           capture_output=True, text=True, timeout=45,
                           env={**os.environ, "DISPLAY": os.environ.get("DISPLAY") or ":1",
                                "DBUS_SESSION_BUS_ADDRESS": os.environ.get(
                                    "DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/1000/bus")})
        # 交给统一入口后，这里只需把它的 rc 如实向上传（守卫要求调用点判 rc）
        if p.returncode != 0:
            return {"ok": False, "rc": p.returncode, "out": (p.stdout or p.stderr)[-200:]}
        # 如实回报交还目标：从 ys-lease 输出里取（"restored": "xxx" 或 恢复: xxx）
        m = re.search(r'"restored"\s*:\s*"([^"]+)"', p.stdout or "")
        if not m:
            m = re.search(r'(?:恢复|restore)[:：]\s*([^\s,，]+)', p.stdout or "")
        return {"ok": True, "restored": (m.group(1) if m else "unknown"),
                "prev": prev}  
    except Exception as e:                                  # noqa: BLE001
        return {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}


def cmd_explain(a):
    """被拒时给调用方的**完整解释**：错在哪、现在什么状态、下一步做什么。

    用户令（2026-10-21）：「是不是要报错，告诉模型原因，同时告诉模型当前的状态？」
    旧实现只回一句 NO_GRANT，模型不知道屏幕在谁手上、自己是不是还占着、该问谁。
    """
    rec = load()
    now = time.time()
    act = _kwin_active()
    if rec is None:
        # 有墓碑 ⇒ 只是"交还过了"，不是"从没申请过"——两者对模型是完全不同的指令。
        _t = None
        try:
            with open(PATH + ".last", encoding="utf-8") as fh:
                _t = json.load(fh)
        except (OSError, ValueError):
            _t = None
        if _t and (now - float(_t.get("released_at") or 0)) < 1800:
            code = "GRANT_RELEASED"
            reason = (f"上一个屏幕会话已在 {int(now - float(_t['released_at']))}s 前交还"
                      f"（release_reason={_t.get('reason') or 'unknown'}）；"
                      "要再次操作需重新 ys-session begin")
            grant_state = {"released_s_ago": int(now - float(_t["released_at"])),
                           "release_reason": _t.get("reason")}
        else:
            code, reason = "NO_GRANT", "没有任何屏幕占用凭据（你没有向用户申请过）"
            grant_state = None
    elif float(rec.get("expires", 0)) <= now:
        code = "GRANT_EXPIRED"
        reason = "凭据已过期（到期即失效；常驻守护会自动交还 firefox）"
        grant_state = {"expired_s": int(now - float(rec["expires"])),
                       "reason": rec.get("reason"), "user_said": rec.get("user_said")}
    else:
        code = "GRANT_VALID"
        reason = "凭据有效"
        grant_state = {"expires_in_s": int(float(rec["expires"]) - now),
                       "reason": rec.get("reason"), "user_said": rec.get("user_said")}
    held = "yuanshen" in (act.get("class") or "").lower()
    out = {
        "ok": False, "error": code, "reason": reason,
        "blocked_by": getattr(a, "blocked_by", "") or "ys-gui-slot",
        "state": {
            "active_window": {"class": act.get("class"), "caption": (act.get("caption") or "")[:60]},
            "grant": grant_state,
            "screen_held_by_us": bool(held),
            "grant_path": PATH,
        },
        "next_action": [
            {"step": 1, "tool": "ask_user_question",
             "why": "向用户申请占用时长（必须由用户同意，代理不能自授）"},
            {"step": 2, "tool": "tools/ys-editor/ys-screen-grant",
             "args": ["grant", "--seconds", "N", "--reason", "<做什么>", "--user-said", "<用户原话>"],
             "why": "记下用户原话与时长；单次上限 %ds，有效期内禁续期" % MAX_GRANT_S},
        ],
        "hint": "屏幕是共用资源：未获授权时不要动窗口；到期后常驻守护会自动交还 firefox。",
    }
    print(json.dumps(out, ensure_ascii=False))
    return 0


def cmd_revoke(_a):
    # 没有凭据 ⇒ 本来就什么都没占：**不要**再抬一次 firefox。
    # （旧实现无条件 _hand_back ⇒ 回归测试每调一次 revoke 就动一次窗口，用户听到操作音。）
    had = os.path.exists(PATH)
    _restore_res = _hand_back() if had else {"ok": True, "skipped": "no_grant"}
    if had:
        _tombstone("revoked")
    try:
        os.unlink(PATH)
        print(json.dumps({"ok": True, "revoked": PATH, "hand_back": _restore_res}, ensure_ascii=False))
    except OSError:
        print(json.dumps({"ok": True, "already_absent": PATH}, ensure_ascii=False))
    return 0


def main():
    ap = argparse.ArgumentParser(description="屏幕占用契约（申请时长 → 凭据 → 底层校验）")
    sub = ap.add_subparsers(dest="cmd")
    g = sub.add_parser("grant")
    g.add_argument("--task", default="default",
                   help="任务 id：一次知情 = 一个任务；同一任务内续期不打断用户")
    g.add_argument("--eta", type=int, default=None,
                   help="预计需要多少秒（给用户做决定用；不是硬预算）")
    g.add_argument("--seconds", type=int, default=None, help="--eta 的别名（旧用法）")
    g.add_argument("--reason", default="")
    g.add_argument("--user-said", default="", help="用户同意的原话（新建/换任务必填；没有=没申请）")
    g.set_defaults(func=cmd_grant)
    sub.add_parser("status").set_defaults(func=cmd_status)
    e = sub.add_parser("explain", help="被拒时输出：错因 + 当前状态 + 下一步（机器可读）")
    e.add_argument("--blocked-by", default="")
    e.add_argument("--target", default="")
    e.set_defaults(func=cmd_explain)
    sub.add_parser("revoke").set_defaults(func=cmd_revoke)
    a = ap.parse_args()
    if not getattr(a, "func", None):
        ap.print_help()
        return 2
    return a.func(a)


if __name__ == "__main__":
    sys.exit(main())
