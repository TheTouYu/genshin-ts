#!/bin/bash
# ys-playtest-stop — 退出千星试玩（判据全部走 ys-state 的具名探针，本文件不含坐标阈值）
# 退出码：0 已退出 / 5 未见结算页「离开」/ 4 未见暂停菜单（与旧版一致，ys-round 依赖）
set -u
DISPLAY="${DISPLAY:-:1}"; export DISPLAY
YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-/run/user/1000/.ydotool_socket}"; export YDOTOOL_SOCKET
HERE="$(cd "$(dirname "$0")" && pwd)"
WIN="${1:-0x01400001}"; export YS_WIN="$WIN"
if [ "${YS_SLOT_ACTIVE:-0}" != "1" ]; then exec "$HERE/ys-gui-slot" "$WIN" 30 env YS_SLOT_ACTIVE=1 bash "$0" "$WIN"; fi
. "$HERE/_ys-ui.sh"
# ⚠️ 不许吞退出码：rc=5「12 轮未命中」是定位失败的关键诊断（2026-10-17 复盘）
click() { local rc=0; "$HERE/ys-pointer-click" "$1" "$2" 12 1.7 >/dev/null || rc=$?; [ "$rc" -eq 0 ] || echo "[ys-playtest-stop] ⚠️ 点击($1,$2)未命中 rc=$rc" >&2; return $rc; }

echo "[stop] ① ESC"; ydotool key 1:1 1:0
if wait_probe pause_menu 60; then            # ≤ ~15s
  echo "[stop] ② 中断挑战"; click 1280 880
  if wait_probe settle_leave 60; then
    echo "[stop] ③ 离开"; click 1833 1365; echo "[stop] ✓ 已退出"
  else echo "[stop] ⚠️ 未见结算页「离开」" >&2; exit 5; fi
else echo "[stop] ⚠️ 未见暂停菜单（可能不在试玩中）" >&2; exit 4; fi
