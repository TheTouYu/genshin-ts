#!/bin/bash
# ys-kwin-cursor — 读指针位置（**X11/EWMH 通道**：`xdotool getmouselocation`）
# 用法: ys-kwin-cursor            输出 "x y"（**物理像素**，X11/Xwayland 空间，本机 2560×1440）
# 退出码: 0 读到 / 3 **读不到**（X 不可用）—— 禁止「空输出 + rc=0」
#
# 2026-10-26 GNOME 适配：旧实现从 KWin 合成器读 `workspace.cursorPos`=**逻辑**坐标
#   （1707×960）；`org.kde.KWin` 在本机不存在 ⇒ 恒空输出 rc=0，调用方（ys-kwin-move）
#   把"读不到"当成"在动"，闭环永远不收敛。现在读数与 `ys-put` / `ys-pointer-click`
#   同一空间（物理），相对移动（ydotool）也以物理像素计入。
#   ⚠️ 旧用法把 KWin 逻辑坐标当"权威指针"，改了通道后数值 ×1.5 —— 调用方若是
#   逻辑坐标，请先自己换算，不要把逻辑值直接和本工具的输出比较。
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/ys-env.sh" >/dev/null 2>&1 || true

OUT=$(python3 - "$HERE" <<'PY'
import re
import subprocess
import sys

sys.path.insert(0, sys.argv[1])
import ys_env            # noqa: E402  X 会话环境唯一入口（DISPLAY/XAUTHORITY 解析）

try:
    r = subprocess.run(["xdotool", "getmouselocation", "--shell"],
                       capture_output=True, text=True, timeout=5, env=ys_env.env())
except Exception as e:                                   # noqa: BLE001
    print(f"xdotool 启动失败：{type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(3)
if r.returncode != 0:
    print("xdotool getmouselocation 失败：%s" % ((r.stderr or "").strip()[:160]), file=sys.stderr)
    sys.exit(3)
mx = re.search(r"^X=(-?\d+)$", r.stdout, re.M)
my = re.search(r"^Y=(-?\d+)$", r.stdout, re.M)
if not mx or not my:
    print("xdotool 输出里没有 X=/Y=（读不到指针）", file=sys.stderr)
    sys.exit(3)
print("%s %s" % (mx.group(1), my.group(1)))
PY
)
RC=$?
if [ "$RC" -ne 0 ] || [ -z "${OUT:-}" ]; then
  echo "[ys-kwin-cursor] 读不到指针位置（X11 不可用）rc=$RC" >&2
  exit 3
fi
printf '%s\n' "$OUT"
