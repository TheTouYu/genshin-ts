#!/bin/bash
# ys-fakedeath-fix —— 假死根治件的安装/回滚/开关
#
# 治的是什么：千星编辑器（Wine 应用）输入假死。判据链与读数见
#   docs/fake-death-2026-10-20.md（形态 A：点击进了应用但应用不认）
#   docs/fake-death-HANDOFF-2026-10-25.md（形态 B：主线程在 XCheckIfEvent 里 72% CPU 空转）
#
# 本版（2026-10-25 原型构建）只装三样东西，**不带 marker 时与上游 wine 11.14 逐条等价**：
#   ① 中性仪表：每 ~1s 一行 /tmp/wine11-proc.log（calls/scans/events/matched/idle/max/mask/drain）
#      —— scans/calls 就是「平均每次调用扫过多少 X 事件」，O(N²) 的直接读数。
#   ② 修法 A（默认关）：/tmp/.winex11-drain 存在 → X11DRV_ProcessEvents 排空整个 X 队列。
#   ③ 三个历史补丁的 A/B 开关（默认关 = 原件行为，见下）。
#
# marker（都存在即生效，删掉即恢复原件行为；运行时切换，不用重启进程）：
#   /tmp/.winex11-drain                修法 A：排空队列（本次候选修复）
#   /tmp/.winex11-suppress-cancelmode  失焦不发 WM_CANCELMODE（2026-10-20 F2 版行为）
#   /tmp/.winex11-cancelmode-ratelimit 失焦时每 500ms 最多发一次 WM_CANCELMODE
#   /tmp/.winex11-fg-reset             失焦且前台仍指向本窗时，把前台复位到桌面（带 200ms 防抖）
#
# 用法：
#   ys-fakedeath-fix status                # 装没装、哪些 marker 在、探针日志新鲜度
#   ys-fakedeath-fix install [SRC]         # 备份 runner 原件（已有备份则保留）→ 装补丁 .so
#   ys-fakedeath-fix revert                # 从备份还原原件
#   ys-fakedeath-fix drain-on|drain-off    # 修法 A 开/关（= on/off）
#   ys-fakedeath-fix suppress|ratelimit|original   # WM_CANCELMODE 三态（original=原件行为）
#   ys-fakedeath-fix fg-reset-on|fg-reset-off
#   ys-fakedeath-fix default               # 清掉全部 marker（= 原件行为 + 仪表）
#   ys-fakedeath-fix probe [N]             # 看探针日志尾部（默认 12 行）
#   ys-fakedeath-fix log-clear             # 清空 /tmp/wine11-*.log（重新计数用）
# 退出码：0 成功 / 1 无备份或无需回滚 / 2 用法错误 / 3 前置条件不满足
set -u
RUNNER="${RUNNER:-/home/h/.local/share/anime-game-launcher/runners/spritz-wine-tkg-staging-wow64-11.14-1}"
REPO="${REPO:-$(cd "$(dirname "$0")/../.." && pwd)}"   # 本仓根（wine-build 产物在 .scratch/fake-death/wine-build）
TARGET="$RUNNER/lib/wine/x86_64-unix/winex11.so"
BACKUP="$TARGET.bak-fakedeath-20261020"
SRC="${SRC:-/home/h/genshin-ts/.scratch/fake-death/wine-build/dlls/winex11.drv/winex11.so}"
M_DRAIN=/tmp/.winex11-drain
M_SUPPRESS=/tmp/.winex11-suppress-cancelmode
M_RATE=/tmp/.winex11-cancelmode-ratelimit
M_FG=/tmp/.winex11-fg-reset
PROC_LOG=/tmp/wine11-proc.log

marker_state() {  # $1=路径 → "on"/"off"
  [ -f "$1" ] && echo on || echo off
}

status() {
  echo "runner   : $RUNNER"
  echo "target   : $TARGET ($(stat -c%s "$TARGET" 2>/dev/null || echo missing) bytes)"
  if [ -f "$BACKUP" ]; then
    echo "backup   : 有 ($(stat -c%s "$BACKUP") bytes)"
    cmp -s "$TARGET" "$BACKUP" 2>/dev/null && echo "identity : 与原件**字节相同**（= 原件在役）" || echo "identity : 与原件不同（补丁 .so 在役）"
  else echo "backup   : 无（未安装过）"; fi
  if grep -qaE "wine11-proc|winex11-drain" "$TARGET" 2>/dev/null; then
    echo "patched  : 是（含仪表/修法A 标记）"
  elif grep -qaE "cancelmode-original|wine11-focusin|wine11-mouse|keep-capture" "$TARGET" 2>/dev/null; then
    echo "patched  : 是（旧版 2026-10-20 补丁，没有 10-25 仪表）"
  else echo "patched  : 否"; fi
  echo "markers  : drain=$(marker_state $M_DRAIN)  suppress-cancelmode=$(marker_state $M_SUPPRESS)  ratelimit=$(marker_state $M_RATE)  fg-reset=$(marker_state $M_FG)"
  if [ -f "$PROC_LOG" ]; then
    echo "probe    : $PROC_LOG  $(stat -c%s "$PROC_LOG") bytes, mtime $(stat -c%y "$PROC_LOG" | cut -c1-19)"
    tail -1 "$PROC_LOG" | sed 's/^/           /'
  else echo "probe    : 无 $PROC_LOG（说明没有进程加载过带仪表的 .so）"; fi
  ls -la "$TARGET" "$BACKUP" 2>/dev/null | sed 's/^/           /'
}

ARTIFACTS="${YS_FAKEDEATH_ARTIFACTS:-/home/h/.local/share/ys-fakedeath/artifacts}"
UNIXDIR="$RUNNER/lib/wine/x86_64-unix"

art_verify() { # 只读：比对 runner 当前 .so 与工件哈希；漂移返回 1
  local fail=0
  for pair in "winex11.so winex11.so.patched" "win32u.so win32u.so.patched" "ntdll.so ntdll.so.patched"; do
    local live="${pair%% *}" want="${pair##* }"
    [ -f "$ARTIFACTS/$want" ] || { echo "✗ 缺工件 $ARTIFACTS/$want"; fail=1; continue; }
    if [ ! -f "$UNIXDIR/$live" ]; then echo "✗ runner 无 $live"; fail=1; continue; fi
    local h1 h2; h1=$(sha256sum "$UNIXDIR/$live" | cut -d' ' -f1); h2=$(sha256sum "$ARTIFACTS/$want" | cut -d' ' -f1)
    if [ "$h1" = "$h2" ]; then echo "✓ $live 与工件一致（补丁在役）"
    else echo "✗ $live 漂移（runner 当前 ${h1:0:12}…，工件 ${h2:0:12}…）"; fail=1; fi
  done
  return $fail
}

case "${1:-}" in
  status) status ;;

  install)
    src="${2:-$SRC}"
    [ -f "$src" ] || { echo "✗ 找不到构建产物 $src"; exit 3; }
    [ -f "$TARGET" ] || { echo "✗ 找不到 runner 原件 $TARGET"; exit 3; }
    [ -f "$BACKUP" ] || cp -a "$TARGET" "$BACKUP"
    install -m 755 "$src" "$TARGET"
    echo "已安装: $src -> $TARGET"
    echo "备份  : $BACKUP"
    if grep -qa "wine11-proc" "$TARGET"; then echo "✓ 校验：目标 .so 含 10-25 仪表标记"
    else echo "✗ 校验失败：目标 .so 不含 wine11-proc 标记"; exit 3; fi
    ;;

  win32u-status)
    W="$RUNNER/lib/wine/x86_64-unix/win32u.so"; WB="$W.bak-fakedeath-20261025"
    echo "win32u   : $W ($(stat -c%s "$W" 2>/dev/null || echo missing) bytes)"
    echo "backup   : $([ -f "$WB" ] && echo "有 ($(stat -c%s "$WB") bytes)" || echo 无)"
    if [ -f "$WB" ]; then
      cmp -s "$W" "$WB" && echo "identity : 与原件**字节相同**（= 原件在役）" || echo "identity : 与原件不同（补丁 win32u 在役）"
    fi
    grep -qa "shared desktop object" "$W" 2>/dev/null && echo "patched  : 是（含共享会话指针校验 + 落盘探针）" || echo "patched  : 否"
    [ -f /tmp/wine32u-shared-fix.log ] && { echo "探针     : /tmp/wine32u-shared-fix.log ($(wc -l < /tmp/wine32u-shared-fix.log) 行)"; tail -5 /tmp/wine32u-shared-fix.log | sed 's/^/           /'; } || echo "探针     : 无（尚未触发过缓存失效）"
    ;;
  win32u-install)
    W="$RUNNER/lib/wine/x86_64-unix/win32u.so"; WB="$W.bak-fakedeath-20261025"
    src="$REPO/.scratch/fake-death/wine-build/dlls/win32u/win32u.so"
    [ -f "$src" ] || src="$ARTIFACTS/win32u.so.patched"
    [ -f "$src" ] || { echo "✗ 找不到构建产物 $src"; exit 3; }
    [ -f "$WB" ] || cp -a "$W" "$WB"
    install -m 755 "$src" "$W"
    echo "已安装: $src -> $W"
    echo "备份  : $WB ($(stat -c%s "$WB") bytes)"
    grep -qa "shared desktop object" "$W" && echo "✓ 校验：目标 .so 含共享会话校验标记"
    ;;
  win32u-revert)
    W="$RUNNER/lib/wine/x86_64-unix/win32u.so"; WB="$W.bak-fakedeath-20261025"
    [ -f "$WB" ] || { echo "✗ 没有备份，无法还原"; exit 3; }
    install -m 755 "$WB" "$W"
    cmp -s "$W" "$WB" && echo "已从备份还原（字节相同）: $WB -> $W" || { echo "✗ 还原后字节不一致"; exit 3; }
    rm -f /tmp/wine32u-shared-fix.log
    echo "提示：已加载旧 .so 的进程需重启才生效"
    ;;
  apply-all)
    "$0" install >/dev/null && "$0" win32u-install >/dev/null
    echo "—— apply-all 完成，校验："
    art_verify && echo "✓ 两件补丁均在役"
    ;;
  ntdll-install)
    U="$UNIXDIR/ntdll.so"; B="$U.bak-fakedeath-20261025"
    src="$REPO/.scratch/fake-death/wine-build/dlls/ntdll/ntdll.so"
    [ -f "$src" ] || src="$ARTIFACTS/ntdll.so.patched"
    [ -f "$src" ] || { echo "✗ 找不到 ntdll 构建产物"; exit 3; }
    [ -f "$B" ] || cp -a "$U" "$B"
    install -m 755 "$src" "$U"
    echo "已安装 ntdll: $src -> $U（备份 $B）"
    grep -qa "multi-infinite" "$U" && echo "✓ 校验：含无限等待探针"
    ;;
  ntdll-revert)
    U="$UNIXDIR/ntdll.so"; B="$U.bak-fakedeath-20261025"
    [ -f "$B" ] || { echo "✗ 无备份"; exit 3; }
    install -m 755 "$B" "$U"
    cmp -s "$U" "$B" && echo "已还原 ntdll（字节相同）" || { echo "✗ 还原后不一致"; exit 3; }
    rm -f /tmp/wine-ntdll-wait.log
    ;;
  revert-all)
    "$0" revert && "$0" win32u-revert && "$0" ntdll-revert
    ;;
  verify)
    art_verify; rc=$?
    if [ $rc -ne 0 ]; then
      echo "修复：tools/ys-editor/ys-fakedeath-fix apply-all"
      [ "${2:-}" = "--notify" ] && command -v dsh-notify >/dev/null && \
        dsh-notify -u critical -t 8000 -a "ys-fakedeath" -h string:x-dunst-stack-tag:ys-fakedeath \
        "Wine 补丁已漂移（runner 被更新？）" "执行：~/genshin-ts/tools/ys-editor/ys-fakedeath-fix apply-all" >/dev/null 2>&1
    fi
    exit $rc
    ;;
  revert)
    [ -f "$BACKUP" ] || { echo "✗ 没有备份可还原"; exit 1; }
    install -m 755 "$BACKUP" "$TARGET"
    cmp -s "$TARGET" "$BACKUP" && echo "已从备份还原（字节相同）: $BACKUP -> $TARGET" || { echo "✗ 还原后字节不一致"; exit 3; }
    ;;

  drain-on|on)   : > "$M_DRAIN"; echo "✓ 修法 A 开（$M_DRAIN）——排空 X 队列；新事件即刻生效" ;;
  drain-off|off) rm -f "$M_DRAIN"; echo "✓ 修法 A 关（回原件扫描行为）" ;;

  suppress)      : > "$M_SUPPRESS"; rm -f "$M_RATE"; echo "✓ 失焦不发 WM_CANCELMODE（$M_SUPPRESS）" ;;
  ratelimit)     : > "$M_RATE"; rm -f "$M_SUPPRESS"; echo "✓ WM_CANCELMODE 限速 500ms（$M_RATE）" ;;
  original)      rm -f "$M_SUPPRESS" "$M_RATE"; echo "✓ WM_CANCELMODE 回原件行为（每次失焦都发）" ;;

  fg-reset-on)   : > "$M_FG"; echo "✓ 失焦前台复位 开（$M_FG）" ;;
  fg-reset-off)  rm -f "$M_FG"; echo "✓ 失焦前台复位 关（原件行为）" ;;

  default)       rm -f "$M_DRAIN" "$M_SUPPRESS" "$M_RATE" "$M_FG"; echo "✓ 全部 marker 清空 = 原件行为 + 仪表" ;;

  probe)         n="${2:-12}"; [ -f "$PROC_LOG" ] || { echo "✗ 无 $PROC_LOG"; exit 3; }; tail -n "$n" "$PROC_LOG" ;;

  log-clear)     rm -f /tmp/wine11-proc.log /tmp/wine11-focusin.log /tmp/wine11-mouse.log /tmp/wine11-map.log /tmp/wine11-reset.log; echo "✓ 已清空 /tmp/wine11-*.log" ;;

  *) echo "用法: $0 {status|install [SRC]|revert|drain-on|drain-off|on|off|suppress|ratelimit|original|fg-reset-on|fg-reset-off|default|probe [N]|log-clear}"; exit 2 ;;
esac
