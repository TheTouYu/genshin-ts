#!/bin/bash
# ys-unstick-win —— 单窗口「假死」的**几何重配**解卡（2026-10-20 实证）
#
# 机制依据（都是本会话实测，见 docs/fake-death-2026-10-20.md）：
#   · 假死是**每个窗口各自一份**的状态：主窗恢复可点后，另一个窗（资源管理器）仍然点不动；
#   · 解卡只需要对该窗口发一次 **ConfigureWindow（几何 ±1px 再还原）**——
#     **不需要** KWin 的 Meta+拖动、**不需要**切焦点、**不需要**移动窗口位置；
#   · 用户的手势（Meta+右键拖动）之所以有效，是因为 KWin 的 resize 会向客户端连发 ConfigureWindow。
#
# 为什么不用「拖窗口/切焦点」：窗口位置会被挪、焦点会被抢（本仓 2026-10-17 事故），
# 而 ±1px 重配是幂等的：**执行完窗口几何与执行前逐字段相同**（脚本自己核对，不一致就恢复）。
#
# 用法：
#   ys-unstick-win <win-hex|win-dec>          # 解卡（±1px 重配 → 还原 → 校验几何）
#   ys-unstick-win --all-editor               # 对编辑器所有顶层窗逐个解卡（按 WM_CLASS 找）
#   ys-unstick-win --dry <win>                # 只打印计划
# 退出码：0 已重配且几何已还原 / 1 几何还原失败 / 2 用法错误 / 3 前置不满足
set -u
DRY=0
ALL=0
ARGS=()
for a in "$@"; do
  case "$a" in
    --dry) DRY=1 ;;
    --all-editor) ALL=1 ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}
# X 会话环境只走统一入口；原先写死的 xauth_oypYEi 是上一次会话的文件名（重启/换会话后必失效）。
. "$(dirname "$(readlink -f "$0")")/ys-env.sh" >/dev/null 2>&1 || true

UNSTICK_LOG="${UNSTICK_LOG:-/tmp/ys-unstick.log}"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$UNSTICK_LOG" 2>/dev/null || true; }

geom() { wmctrl -l -G | awk -v id="$1" 'tolower($1)==tolower(id){print $3" "$4" "$5" "$6; exit}'; }

unstick() {
  local win="$1" g x y w h
  g="$(geom "$win")"
  [ -n "$g" ] || { echo "✗ 找不到窗口 $win（wmctrl 列表里没有）"; return 3; }
  read -r x y w h <<<"$g"
  echo "窗口 $win 当前几何 ${w}x${h}+${x}+${y}"
  if [ "$DRY" = 1 ]; then
    echo "  [dry] xdotool windowsize $win $((w+3)) $h   # 改宽（高度被 maximized_vert 约束）"
    echo "  [dry] xdotool windowsize $win $w $h          # 还原尺寸（x 一次性漂移 ≤6px，不还原）"
    return 0
  fi
  # 2026-10-24 修：原来只改**高度** ±1px —— 编辑器主窗带 _NET_WM_STATE_MAXIMIZED_VERT，
  # KWin 把高度立刻弹回（实测 10 次采样恒 1371，日志 saw_plus1=0）⇒ **新尺寸的 ConfigureNotify
  # 从没到过客户端** ⇒ 解卡无效（用户实测「执行了还是假死」）。
  # 改为改**宽度**（不受 maximized_vert 约束，实测 50–120ms 内生效，saw=1）；默认只挪 1px（减闪烁）。
  # 注意两个实测坑：
  #   · 宽度变更后 KWin 会把 x 顺带左移 ≤6px，**且只发生一次**（连按 3 次 x 稳定不动）；
  #   · 用 `xdotool windowmove` 还原 x 是**相对**语义（实测 764→1528 翻倍），绝不能用；
  #     必须用 `wmctrl -e`（绝对，但对 x 有 2× 映射，实测 384→768）。因此这里**不还原 x**，
  #     只在日志里记下漂移量（一次性、≤6px，用户无感）。
  local dw=${UNSTICK_DW:-1} saw=0 x1
  YS_ALLOW_RAW=1 xdotool windowsize "$win" $((w+dw)) "$h" 2>/dev/null
  for i in $(seq 1 12); do
    [ "$(geom "$win" | cut -d' ' -f3)" = "$((w+dw))" ] && { saw=1; break; }
    sleep 0.05
  done
  YS_ALLOW_RAW=1 xdotool windowsize "$win" "$w" "$h" 2>/dev/null
  for i in $(seq 1 12); do [ "$(geom "$win" | cut -d' ' -f3)" = "$w" ] && break; sleep 0.05; done
  x1=$(geom "$win" | cut -d' ' -f1)
  if [ "$saw" = 0 ]; then
    echo "  ✗ 宽度未生效（WM 可能拒绝），本次重配无效"
    log "unstick NOWIDTH win=$win geom=${w}x${h}+${x}+${y}"
    return 1
  fi
  if [ "$(geom "$win" | cut -d' ' -f3-4)" = "$w $h" ]; then
    echo "  ✓ 已发重配（宽 ${w}→$((w+dw))→${w}），尺寸已还原；x ${x}→${x1}（一次性漂移）"
    log "unstick ok win=$win size=${w}x${h} x=$x->$x1 saw=1"
    return 0
  else
    echo "  ✗ 尺寸未还原：现在 $(geom "$win")，执行前 ${w}x${h}+${x}+${y}"
    log "unstick FAIL win=$win now=$(geom "$win") want=${w}x${h}+${x}+${y}"
    return 1
  fi
}

if [ "$ALL" = 1 ]; then
  mapfile -t wins < <(wmctrl -l -x | awk 'tolower($0) ~ /beyondeditor/ {print $1}')
  [ ${#wins[@]} -gt 0 ] || { echo "✗ 没找到 beyondeditor 的窗口"; exit 3; }
  rc=0
  for w in "${wins[@]}"; do unstick "$w" || rc=$?; done
  exit $rc
fi

[ $# -ge 1 ] || { echo "用法: $0 <win> | --all-editor | --dry <win>"; exit 2; }
case "$1" in 0x*|0X*) W="$1" ;; *) W="$(printf '0x%08x' "$1")" ;; esac
unstick "$W"
