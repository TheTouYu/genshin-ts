def load_env():
    """DISPLAY / XAUTHORITY 每次会话随机名 ⇒ 一律**覆盖**读自 ys-env.sh（setdefault 会被空串挡住）。

    惰性调用：只有**本地取数**（抓屏/裁块/模板抓取）才需要；走常驻服务的路径不需要，
    而这一步要 spawn 一次 ys-env.sh（实测 ~35ms），在 <150ms 预算里不能白付。
    """
    global _ENV_READY
    if _ENV_READY:
        return
    envsh = os.path.join(HERE, "ys-env.sh")
    _ENV_READY = True
    if not os.path.exists(envsh):
        return
    _ENV_READY = True
    r = subprocess.run([envsh, "--print"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            if v and v != "<none>":
                os.environ[k] = v


def win_id():
    return os.environ.get("YS_WIN", "0x01400001")


def observe_frame():
    """活体取帧唯一入口（ys-observe：校验窗口存在 + 栈顶 + 新鲜度）。返回 (path, meta) 或 (None, meta)。"""
    load_env()
    r = subprocess.run([os.path.join(HERE, "ys-observe"), "frame"],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        return None, {"error": "observe 取帧失败"}
    try:
        d = json.loads((r.stdout or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        return None, {"error": "observe 输出不是 JSON"}
    return d.get("path"), d


def frame_geom(path):
    """读帧尺寸（identify）。失败抛 RuntimeError —— 仪器故障要出声，不许静默当黑图。"""
    r = subprocess.run(["identify", "-format", "%w %h", path], capture_output=True, text=True)
    dim = (r.stdout or "").split()
    if len(dim) < 2:
        raise RuntimeError(f"identify 读不出尺寸（帧损坏/0 字节？）: {path} :: {r.stderr.strip()[:120]}")
    return int(dim[0]), int(dim[1])


def geom_ok(w, h):
    """字节级几何校验：只接受 2560×1440 及更宽的整帧（游戏窗 2561 宽也收）。
    缩放帧（如 1024×576 / 1106×964 / 780×439）与半截帧在这里就被挡掉 —— 像素坐标不再可信。"""
    return w >= FRAME_W and h >= FRAME_H and abs(w - FRAME_W) <= 1


def sha16(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()[:16]


def fresh_obj(path, meta):
    """新鲜度证明：活体带 atop/ts；离线帧没有 atop，用文件 mtime + sha256 定位。"""
    if meta is not None:
        return {"atop": meta.get("atop"), "ts": meta.get("at"), "sha": sha16(path)}
    return {"atop": None, "ts": int(os.path.getmtime(path)), "sha": sha16(path)}


