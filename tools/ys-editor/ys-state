# 像素取样（两个通道各自的取数方式，判据只有一份）
# ══════════════════════════════════════════════════════════════════
class ProbePixels:
    """fast 通道：**一次** ImageMagick 多点取样（不把整帧读进 python）。"""

    def __init__(self, path, points):
        self.w, self.h = frame_geom(path)
        pts = [(x, y) for x, y in points if x < self.w and y < self.h]
        if not pts:
            self.val = {}
            return
        fmt = " ".join("%[pixel:p{" + str(x) + "," + str(y) + "}]" for x, y in pts)
        r = subprocess.run(["magick", path, "-format", fmt, "info:"],
                           capture_output=True, text=True)
        out = (r.stdout or "").split()
        if len(out) != len(pts):
            raise RuntimeError(f"多点取样失败（{len(out)}/{len(pts)}）: {r.stderr.strip()[:120]}")
        self.val = {p: parse_pixel(s) for p, s in zip(pts, out)}

    def px(self, x, y):
        return self.val.get((x, y))


class ArrayPixels:
    """已解码的整帧（numpy uint8 HxWx3）。full 与 fast 两个通道都用它 —— 判据只读这里。"""

    def __init__(self, arr, source=None):
        self.a = arr
        self.h, self.w = int(arr.shape[0]), int(arr.shape[1])
        self.source = source
        self._tpl_cache = {}

    def px(self, x, y):
        if x >= self.w or y >= self.h:
            return None
        return tuple(int(v) for v in self.a[y, x])

    def image(self):
        return self.a


def decode_frame(path):
    """离线帧解码：PIL（约 110~130ms；PIL 是 ys_lookd 的既有依赖，不算新增依赖）。
    尺寸直接从解码结果取 —— 少一次 `identify` 子进程（实测省 ~20ms）。"""
    import numpy as np
    from PIL import Image
    if not os.path.exists(path):
        raise RuntimeError(f"帧不存在: {path}")
    arr = np.asarray(Image.open(path).convert("RGB"))
    return arr


def raw_frame_bin(pix):
    """把整帧写成原始 RGB 落盘，交给 ys-lookd 的 frame_bin 快路径（省掉它再解码一次 PNG）。

    ⚠️ 每次用**唯一临时文件**：固定路径在「两个进程同时判帧」时会互相覆盖，
    于是某一次拿到的是别人的帧 —— 症状是回归里偶发单帧判错（实测踩过一次）。
    """
    import tempfile
    fd, path = tempfile.mkstemp(prefix="ys-state-fast-", suffix=".bin")
    with os.fdopen(fd, "wb") as f:
        f.write(pix.a.tobytes())
    return path, [pix.h, pix.w, 3]


def parse_pixel(s):
    """`srgb(217,217,217)` / `srgba(117,168,81,1)` / `gray(50)` → (r,g,b)。"""
    s = s.strip()
    i = s.find("(")
    if i < 0:
        return None
    nums = s[i + 1:].rstrip(")").split(",")
    try:
        v = [float(x) for x in nums[:3]]
    except ValueError:
        return None
    if len(v) == 1:
        v = v * 3
    return tuple(int(round(c)) for c in v)


class CellsPixels:
    """只持有「判据需要的那几十个点」的像素（daemon 侧用：从 GPU 张量取点，不拷整帧）。"""

    def __init__(self, cells, w, h):
        self.cells = cells
        self.w, self.h = w, h

    def px(self, x, y):
        if x >= self.w or y >= self.h:
            return None
        return self.cells.get((x, y))


def all_probe_points():
    pts = set(PTS.values()) | set(GRID) | set(PANEL_L) | set(PANEL_M)
    return sorted(pts)


# ══════════════════════════════════════════════════════════════════
# 判据（唯一一份）—— 输入是「取数器」，输出是 readings
# ══════════════════════════════════════════════════════════════════
def _spread(pix):
    """中央区域无纹理：16 点亮度极差。实测：LOADING 纯色页 ~0；编辑器/游戏 100~190。"""
    lum = []
    for x, y in GRID:
        p = pix.px(x, y)
        if p is None:
            return None
        lum.append(sum(p) / 3.0)
    return max(lum) - min(lum) if lum else None


def _panel_diff(pix):
    """左面板存在：左列与中列均值之差的最大值。实测 EDITOR 68.9 / MENU 76.2 / SAVELIST 26.2 /
    PLAYTEST 6.2~6.9 / PAUSE 0.6 / SETTLE 3.8~5.6（阈值 40）——菜单底下就是草地，两条都会亮，
    由「EDITOR 是兜底态」消解。"""
    def col_mean(pts):
        acc = [0.0, 0.0, 0.0]
        n = 0
        for x, y in pts:
            p = pix.px(x, y)
            if p is None:
                return None
            for i in range(3):
                acc[i] += p[i]
            n += 1
        return [a / n for a in acc]
    l, m = col_mean(PANEL_L), col_mean(PANEL_M)
    if l is None or m is None:
        return None
    return max(abs(a - b) for a, b in zip(l, m))


def pixel_readings(pix):
    """像素判据（两个通道共用）。返回 {判据名: {value, passed, kind}}。"""
    p = {k: pix.px(*v) for k, v in PTS.items()}
    if any(v is None for v in p.values()):
        return {}
    bg, grass, bar, top, sbg = p["bg"], p["grass"], p["bottombar"], p["cardtop"], p["settle_bg"]
    spread, pdiff = _spread(pix), _panel_diff(pix)
    R = {}

    def put(name, passed, value):
        R[name] = {"value": value, "passed": bool(passed), "kind": "pixel"}

    # MENU：系统菜单面板是浅灰 217,217,217（实测其它态该点 ≤157）
    put("MENU/A px(300,300) 三通道>200", all(v > 200 for v in bg), str(bg))
    # SAVELIST：亮蓝底栏 + 整屏暗 + 无白卡。三个条件缺一不可：
    #   只看亮蓝会被游戏内天空骗（playtest3 底栏 82,181,232）；只看整屏暗会被草地阴影骗。
    put("SAVELIST/A 亮蓝底栏+整屏暗+无白卡",
        bar[2] > 200 and bar[2] > bar[0] + 80 and max(bg) < 70 and max(top) < 200,
        f"底栏{bar} 背景{bg} 卡顶{top}")
    # PLAYTEST/B：沙箱天空蓝主导且够亮（存档页/结算页的暗蓝 G<100 被排除）
    put("PLAYTEST/B px(100,400) 蓝主导且亮", grass[2] > grass[1] and grass[1] > 100, str(grass))
    # PLAYTEST/C：亮蓝天（主游戏 (114,142,155) 不过 b>180；过渡帧 (72,74,148) 也不过）
    put("PLAYTEST/C px(300,300) 亮蓝天", bg[2] > 180 and bg[2] > bg[1], str(bg))
    # SETTLE：唯一纯白卡顶 + 深蓝底（排除同为深蓝的存档页：存档页 (47,49,74) 不满足 r<40）
    put("SETTLE/A px(1280,100) 纯白卡顶", all(v > 250 for v in top), str(top))
    put("SETTLE/B px(1280,500) 深蓝且不偏紫", sbg[0] < 40 and sbg[2] < 60, str(sbg))
    # LOADING：浅蓝底色（与沙箱天空重叠 ⇒ 必须配 B 的无纹理）
    put("LOADING/A px(300,300) 浅蓝底色",
        bg[2] > 180 and bg[2] > bg[1] + 20 and 100 < bg[0] < 170, str(bg))
    if spread is not None:
        put("LOADING/B 中央无纹理(采样极差)", spread < FLAT_SPREAD, f"spread={spread:.1f}")
    # EDITOR：草地绿主导（菜单/存档页下也成立，靠兜底态 + B 消解）
    put("EDITOR/A px(100,400) 绿主导", grass[1] > grass[0] and grass[1] > grass[2], str(grass))
    if pdiff is not None:
        put("EDITOR/B 左面板存在(列差)", pdiff > PANEL_DIFF, f"diff={pdiff:.1f}")
    return R


def template_readings(pix):
    """full 通道：模板匹配。

    **优先走常驻服务 ys-lookd**（2026-10-18 性能实测后改）：
    进程内做这 5 次匹配要 `import torch` + 建 CUDA context = **2528ms**，占 full 通道 3301ms 的 77%；
    同样这 5 个模板，常驻服务预热后一次 batch 只要 **147ms**（实测 246/147/157）——同一任务差 **22 倍**。
    判据（TPL_THRESHOLD / 状态名 / 投票）仍只在本文件，服务只负责算 NCC，不回传任何判定。

    服务不可用时**回退进程内**（慢 22 倍但结果一致），并**出声**——静默降级会让
    "为什么今天这么慢"永远查不出来（D344 的六条静默失败教训）。
    """
    import numpy as np
    R, jobs, want = {}, [], {}
    for st, fn in TPL:
        path = os.path.join(TPL_DIR, fn)
        label = f"{st}/template {fn}"
        if not os.path.exists(path):
            R[label] = {"value": f"模板缺失 {fn}", "passed": False, "kind": "template"}
            continue
        jobs.append({"id": label, "tpl": path})
        want[label] = fn

    scores, why = {}, None
    if jobs and os.environ.get("YS_STATE_NO_DAEMON_TPL") != "1":
        bin_path = None
        try:
            bin_path, shape = raw_frame_bin(pix)
            r = daemon_call({"cmd": "batch", "jobs": jobs,
                             "frame_bin": bin_path, "frame_shape": shape}, timeout=60)
            if r and isinstance(r.get("results"), list):
                for x in r["results"]:
                    best = x.get("best") or {}
                    if best.get("score") is not None:
                        scores[x.get("id")] = float(best["score"])
            else:
                why = "daemon 响应无 results"
        except Exception as e:                              # noqa: BLE001
            why = f"{type(e).__name__}: {e}"
        finally:
            if bin_path:
                try:
                    os.unlink(bin_path)                     # 唯一临时文件，用完即删
                except OSError:
                    pass
    if why or (jobs and not scores):
        sys.stderr.write(f"[ys-state] ⚠ 模板匹配回退进程内（{why or 'daemon 未返回分数'}）"
                         f"——本次会多花约 2.5s；排查 daemon 或设 YS_STATE_NO_DAEMON_TPL=1 显式关闭\n")

    img = None
    for label, fn in want.items():
        score = scores.get(label)
        if score is None:                                   # 回退：才付 torch/CPU 成本
            if img is None:
                sys.path.insert(0, HERE)
                from ys_look import ncc
                img = pix.image().astype("float32") / 255.0
            if fn not in pix._tpl_cache:
                w, h = frame_geom(os.path.join(TPL_DIR, fn))
                raw = subprocess.run(["magick", os.path.join(TPL_DIR, fn), "-depth", "8", "rgb:-"],
                                     capture_output=True).stdout
                pix._tpl_cache[fn] = (raw, w, h)
            raw, tw, th = pix._tpl_cache[fn]
            t = np.frombuffer(raw, dtype=np.uint8).reshape(th, tw, 3).astype("float32") / 255.0
            if t.shape[0] > img.shape[0] or t.shape[1] > img.shape[1]:
                R[label] = {"value": "模板大于画面", "passed": False, "kind": "template"}
                continue
            _, _, score, _ = ncc(img, t)
        R[label] = {"value": f"score={score:.3f}",
                    "passed": score >= TPL_THRESHOLD, "kind": "template"}
    return R


# ── GPU 锚点（fast 通道；匹配数学在 ys_lookd 里，本文件只发请求）──────
def load_profile(path):
    if not os.path.exists(path):
        raise RuntimeError(f"锚点 profile 不存在: {path}（缺省应为 .scratch/gui-profiles/qianxing.json）")
    with open(path, encoding="utf-8") as f:
        prof = json.load(f)
    if not prof.get("anchors"):
        raise RuntimeError(f"profile 没有 anchors: {path}")
    return prof


def anchor_tier1(profile):
    """每态取 margin 最大的 ANCHORS_PER_STATE 个锚点（worst-case 挖的，不是 best-case）。"""
    by = {}
    for a in profile["anchors"]:
        by.setdefault(a["state"], []).append(a)
    out = {}
    for st, lst in by.items():
        out[st] = sorted(lst, key=lambda a: -a.get("margin", 0))[:ANCHORS_PER_STATE]
    return out


def anchor_jobs(profile):
    """每态取 margin 最大的前 N 个锚点 → (jobs, state_of)。纯函数，daemon 也调它。"""
    tier1 = anchor_tier1(profile)
    jobs, state_of = [], {}
    for st, lst in tier1.items():
        for a in lst:
            pad, psz = 200, a.get("patch", 96)
            jobs.append({"id": a["name"], "tpl": os.path.abspath(a["tpl"]), "scales": [1.0],
                         "roi": [max(0, a["x"] - pad), max(0, a["y"] - pad), psz + 2 * pad, psz + 2 * pad]})
            state_of[a["name"]] = st
    return jobs, state_of


def anchor_readings_from_scores(scores, state_of):
    """锚点分数 → readings（阈值只在本文件）。daemon 侧只负责给出分数。"""
    R = {}
    for name, st in state_of.items():
        s = scores.get(name, -1.0)
        R[f"{st}/anchor {name}"] = {"value": f"score={s:.3f}", "passed": s >= ANCHOR_THRESHOLD,
                                    "kind": "anchor"}
    return R


def anchor_scores_local(profile, pix):
    """daemon 不可用时的**本地兜底**：用 ys_look.ncc（CPU）在本地帧上算锚点分数。

    慢（12 锚点约数秒级）—— 这是兜底不是常态，调用方必须往 stderr 出声。
    数学仍是 ys_look 那一份（不重写 matcher），阈值仍是本文件的 ANCHOR_THRESHOLD。
    """
    sys.path.insert(0, HERE)
    import numpy as np
    from ys_look import ncc
    img = pix.image().astype("float32") / 255.0
    jobs, state_of = anchor_jobs(profile)
    scores = {}
    for job in jobs:
        x, y, w, h = job["roi"]
        sub = img[y:y + h, x:x + w]
        tw, th = frame_geom(job["tpl"])
        raw = subprocess.run(["magick", job["tpl"], "-depth", "8", "rgb:-"],
                             capture_output=True).stdout
        if len(raw) != tw * th * 3 or tw > sub.shape[1] or th > sub.shape[0]:
            scores[job["id"]] = -1.0
            continue
        T = np.frombuffer(raw, dtype=np.uint8).reshape(th, tw, 3).astype("float32") / 255.0
        _, _, score, _ = ncc(sub, T)
        scores[job["id"]] = float(score)
    return scores, state_of


def fast_roi(profile):
    """fast 通道**一次抓帧**需要的最小外接框（锚点 ROI ∪ 判据取样点）。

    实测（2026-10-17，2560×1440，12 锚点 + 39 取样点）：(0,0) 1400×1440
    = **54.7% 面积**（5.77MB 原始 RGB，全帧 10.5MB）。锚点集中在左半屏、取样点右扩到 x=1400，
    所以并集注定不可能只有几百 KB —— 除非砍锚点数量或缩小锚点搜索半径（都动判据，不在此改）。
    """
    jobs, _ = anchor_jobs(profile)
    xs, ys, x2, y2 = [], [], [], []
    for j in jobs:
        x, y, w, h = j["roi"]
        xs.append(x); ys.append(y); x2.append(x + w); y2.append(y + h)
    for x, y in all_probe_points():
        xs.append(x); ys.append(y); x2.append(x + 1); y2.append(y + 1)
    x0, y0 = max(0, min(xs)), max(0, min(ys))
    x1, y1 = min(FRAME_W, max(x2)), min(FRAME_H, max(y2))
    return x0, y0, max(1, x1 - x0), max(1, y1 - y0)


def anchor_readings(profile, frame_path=None, frame_bin=None, shape=None):
    """客户端取数：把锚点 jobs 交给 ys-lookd，拿分数再走同一份判据。"""
    sys.path.insert(0, HERE)
    import ys_look
    jobs, state_of = anchor_jobs(profile)
    req = {"cmd": "batch", "jobs": jobs}
    if frame_bin:
        req.update({"frame_bin": frame_bin, "frame_shape": shape})
    else:
        req["frame"] = os.path.abspath(frame_path)
    r = ys_look.daemon(req, timeout=30)
    if not r:                                   # 冷启动 / 服务刚重启：重试一次再判仪器故障
        time.sleep(1.0)
        r = ys_look.daemon(req, timeout=60)
    if not r:
        raise RuntimeError(f"ys-lookd 不可用（{ys_look.LAST_DAEMON_ERROR or '连接失败'}）")
    scores = {x["id"]: (x["best"]["score"] if x.get("best") else -1.0) for x in r["results"]}
    return anchor_readings_from_scores(scores, state_of)


# ══════════════════════════════════════════════════════════════════
# 判定（唯一一份投票规则）
# ══════════════════════════════════════════════════════════════════
def decide(readings):
    """按态聚合 readings。返回 dict(state, confidence, ambiguous, margin, verdicts)。

    - 每态 = 该态前缀下的全部判据；`RULE` 缺省 "all"（全中），PLAYTEST 是 "any2"（2/3 多数）
    - 判据条数 < MIN_CRITERIA 的态不算成立（避免单点误报冒充判定）
    - 子态（PAUSE/SETTLE）压过父态（PLAYTEST）；EDITOR 是兜底态
    - 多个非同层态同时成立 ⇒ AMBIGUOUS（不猜）；全不成立 ⇒ UNKNOWN（不猜）
    """
    per = {}
    for name, r in readings.items():
        st = name.split("/")[0]
        if st not in STATES or st == "UNKNOWN":
            continue
        per.setdefault(st, []).append(r)
    verdicts, support = {}, {}
    for st, items in per.items():
        n = len(items)
        p = sum(1 for i in items if i["passed"])
        rule = RULE.get(st, "all")
        ok = (p >= 2) if rule == "any2" else (p == n)
        if n < MIN_CRITERIA:
            ok = False
        verdicts[st] = bool(ok and n >= MIN_CRITERIA)
        support[st] = (p / n) if n else 0.0
    cands = [st for st, ok in verdicts.items() if ok]
    for sub, sup in SUBSTATE_OF.items():
        if sub in cands and sup in cands:
            cands.remove(sup)
    if FALLBACK_STATE in cands and len(cands) > 1:
        cands.remove(FALLBACK_STATE)
    ranked = sorted(per, key=lambda st: -support[st])
    if len(cands) == 1:
        st = cands[0]
        rest = [support[s] for s in ranked if s != st]
        return {"state": st, "confidence": round(support[st], 3), "ambiguous": False,
                "margin": round(support[st] - (max(rest) if rest else 0.0), 3), "verdicts": verdicts}
    if len(cands) > 1:
        return {"state": "AMBIGUOUS", "confidence": 0.0, "ambiguous": True,
                "margin": 0.0, "verdicts": verdicts, "candidates": sorted(cands)}
    best = support[ranked[0]] if ranked else 0.0
    return {"state": "UNKNOWN", "confidence": round(best, 3), "ambiguous": False,
            "margin": round(-best, 3), "verdicts": verdicts}


# ══════════════════════════════════════════════════════════════════
# 两个通道的端到端
# ══════════════════════════════════════════════════════════════════
def run_full(frame=None):
    """full 通道：全帧进内存 → 像素判据 + 全帧模板匹配。返回 (result, frame_path, fresh)。"""
    meta = None
    if not frame:
        frame, meta = observe_frame()
        if not frame:
            return {"state": "UNKNOWN", "channel": "full", "error": "取帧失败（ys-observe）"}, None, None
    t0 = time.time()
    try:
        pix = ArrayPixels(decode_frame(frame), source=frame)
    except (RuntimeError, OSError) as e:
        return {"state": "UNKNOWN", "channel": "full", "error": str(e),
                "ms": round((time.time() - t0) * 1000)}, frame, fresh_obj(frame, meta)
    readings = {}
    if geom_ok(pix.w, pix.h):
        readings.update(pixel_readings(pix))
        readings.update(template_readings(pix))
    else:
        # 缩放帧/半截帧：像素坐标不可信 —— 直接拒绝，绝不拿错位像素当判据
        readings["GEOM/frame 尺寸 2560x1440"] = {
            "value": f"实际 {pix.w}x{pix.h}（缩放帧/抓帧失败态）", "passed": False, "kind": "pixel"}
    res = decide(readings)
    res.update({"channel": "full", "readings": readings, "ms": round((time.time() - t0) * 1000)})
    return res, frame, fresh_obj(frame, meta)


# ── 常驻判定（ys-lookd）：把导入/解码摊掉，单次调用才可能进 150ms ──────────
LOOKD_SOCK = os.environ.get("YS_LOOKD_SOCK", f"/run/user/{os.getuid()}/ys-lookd.sock")


def daemon_call(req, timeout=30, retry=True):
    """轻 socket 客户端（与 ys_look.daemon 同一协议、同一个 socket）。

    为什么不直接 import ys_look.daemon：`ys_look` 模块顶层 import numpy（~90ms），
    这笔开销会落进每次 CLI 调用的 <150ms 预算里。这里只用 stdlib。
    """
    import socket

    def once():
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.settimeout(timeout)
            c.connect(LOOKD_SOCK)
            c.sendall((json.dumps(req) + "\n").encode())
            data = b""
            while not data.endswith(b"\n"):
                ch = c.recv(65536)
                if not ch:
                    break
                data += ch
            c.close()
            return json.loads(data.decode())
        except Exception:                                  # noqa: BLE001 —— 连不上就回退本地
            return None

    if not os.path.exists(LOOKD_SOCK):
        return None
    r = once()
    if r is None and retry:                                # 冷启动/服务刚重启：重试一次
        time.sleep(0.8)
        r = once()
    return r


DAEMON_ERROR = None      # 最近一次常驻服务失败原因（回退时**必须**打印出来）


def _daemon_fail(why):
    """记录并返回失败原因（调用方负责往 stderr 出声）。"""
    global DAEMON_ERROR
    DAEMON_ERROR = why
    return None


def daemon_state(frame=None, profile=None, max_age_ms=None):
    """向常驻服务要一次 fast 判定；服务不可用/报错返回 None（由调用方回退本地）。

    `max_age_ms` = **帧复用窗口**：>0 时若常驻服务最近一次抓帧的年龄小于它，就复用那张帧
    （省掉 ~105ms 抓帧）。默认不传 = 每次新抓 —— 用过期帧判态是静默错误，必须显式开启。
    """
    req = {"cmd": "state", "channel": "fast",
           "profile": profile or os.environ.get("YS_PROFILE") or PROFILE_DEFAULT}
    if max_age_ms:
        req["max_age_ms"] = float(max_age_ms)
    if frame:
        req["frame"] = os.path.abspath(frame)
    r = daemon_call(req, timeout=60)
    if not r:
        return _daemon_fail(f"连不上 {LOOKD_SOCK} 或无响应")
    if r.get("error"):
        return _daemon_fail(f"daemon 报错: {str(r['error'])[:200]}")
    if "state" not in r:
        return _daemon_fail(f"daemon 响应缺 state 字段: {str(r)[:120]}")
    return r


def daemon_probe(name, frame=None):
    """向常驻服务要一次具名探针判定；不可用返回 None（回退本地）。"""
    req = {"cmd": "probe", "name": PROBE_ALIAS.get(name, name)}
    if frame:
        req["frame"] = os.path.abspath(frame)
    r = daemon_call(req, timeout=30)
    if not r:
        return _daemon_fail(f"连不上 {LOOKD_SOCK} 或无响应")
    if r.get("error"):
        return _daemon_fail(f"daemon 报错: {str(r['error'])[:200]}")
    if "visible" not in r:
        return _daemon_fail(f"daemon 响应缺 visible 字段: {str(r)[:120]}")
    return r


def warn_fallback(what, t0):
    """回退本地时往 stderr 打一行（铁律：仪器出错要出声，见 D310 仪器自证陷阱）。"""
    sys.stderr.write(
        f"[ys-state] ⚠ daemon 不可用，{what}已回退本地"
        f"（本机实测约多花 200~450ms）：{DAEMON_ERROR}\n")


def run_fast(frame=None, profile_path=None, max_age_ms=None):
    """fast 通道：一次取帧（离线解码 / 活体原始抓取）→ 像素判据 + GPU 锚点（ys-lookd）。

    成本链（实测 2026-10-17，2560×1440）：解码 110~130ms ／ 落盘 frame_bin 7ms ／
    GPU 12 锚点 60ms ⇒ 端到端 180~200ms（抓帧与解码主导，匹配只占 1/3）。
    """
    prof_path = profile_path or os.environ.get("YS_PROFILE") or PROFILE_DEFAULT
    meta = None
    t0 = time.time()
    try:
        profile = load_profile(prof_path)
    except RuntimeError as e:
        return {"state": "UNKNOWN", "channel": "fast", "error": str(e),
                "ms": round((time.time() - t0) * 1000)}, frame, None

    # ① 常驻通道优先：ys-lookd 一次抓原始像素（无 PNG 编解码）+ 在服务内跑同一份判据
    tried_daemon = False
    if os.environ.get("YS_STATE_LOCAL") != "1":
        tried_daemon = True
        d = daemon_state(frame=frame, profile=prof_path, max_age_ms=max_age_ms)
        if d:
            res = {k: d[k] for k in ("state", "confidence", "ambiguous", "margin", "verdicts",
                                     "readings", "roi", "frame_bytes", "load_ms", "judge_ms",
                                     "cache_hit", "reused", "frame_age_ms") if k in d}
            res["channel"] = "fast"
            res["ms"] = int(d.get("ms") or round((time.time() - t0) * 1000))
            res["via"] = "daemon"
            fresh = d.get("fresh")
            if not fresh and frame:
                fresh = fresh_obj(frame, None)
            return res, frame, fresh

    # ② 回退本地（服务没起/旧版本/报错）——判据仍是同一份代码，但**必须出声**
    if tried_daemon:
        warn_fallback("判态", t0)
    if frame:
        try:
            pix = ArrayPixels(decode_frame(frame), source=frame)
        except (RuntimeError, OSError) as e:
            return {"state": "UNKNOWN", "channel": "fast", "error": str(e),
                    "ms": round((time.time() - t0) * 1000)}, frame, None
    else:
        # 活体：一次原始 RGB 抓取（ys_look.grab，管道），既供像素判据也供 GPU 锚点（省一次解码）
        load_env()
        sys.path.insert(0, HERE)
        import ys_look
        try:
            arr = ys_look.grab(0, 0, FRAME_W, FRAME_H)
        except Exception as e:                          # noqa: BLE001 —— 取帧失败必须报错不兜底
            return {"state": "UNKNOWN", "channel": "fast", "error": f"抓帧失败: {e}",
                    "ms": round((time.time() - t0) * 1000)}, None, None
        pix = ArrayPixels((arr * 255).round().astype("uint8"))
    readings = {}
    if geom_ok(pix.w, pix.h):
        readings.update(pixel_readings(pix))
    else:
        readings["GEOM/frame 尺寸 2560x1440"] = {
            "value": f"实际 {pix.w}x{pix.h}（缩放帧/抓帧失败态）", "passed": False, "kind": "pixel"}
    bin_path = None
    fallback_note = None
    try:
        if geom_ok(pix.w, pix.h):
            try:
                bin_path, shape = raw_frame_bin(pix)
                readings.update(anchor_readings(profile, frame_bin=bin_path, shape=shape))
            except (RuntimeError, OSError) as e:
                # 兜底：本地 CPU NCC（同一份数学，慢但正确）——铁律是「仪器出错要出声」
                sys.stderr.write(f"[ys-state] ⚠ 锚点走本地 CPU 兜底（慢，12 锚点数秒级）：{e}\n")
                scores, state_of = anchor_scores_local(profile, pix)
                readings.update(anchor_readings_from_scores(scores, state_of))
                fallback_note = f"锚点本地 CPU 兜底：{e}"
    finally:
        if bin_path:
            try:
                os.unlink(bin_path)
            except OSError:
                pass
    res = decide(readings)
    res.update({"channel": "fast", "readings": readings, "via": "local",
                "daemon_error": DAEMON_ERROR, "ms": round((time.time() - t0) * 1000)})
    if fallback_note:
        res["fallback_note"] = fallback_note
    if frame:
        return res, frame, fresh_obj(frame, meta)
    # 活体：fast 通道不做堆叠序校验（<150ms 预算内塞不下 ys-atop），用抓帧时刻 + 原始帧 sha 定位
    fresh = {"atop": None, "ts": int(time.time()),
             "sha": hashlib.sha256(pix.a.tobytes()).hexdigest()[:16],
             "note": "fast 通道不校验堆叠序；需要新鲜度证明请用 full 通道"}
    return res, None, fresh


def execute(channel, frame=None, profile=None, max_age_ms=None):
    if channel == "fast":
        return run_fast(frame=frame, profile_path=profile, max_age_ms=max_age_ms)
    return run_full(frame=frame)


def exit_code(state):
    return 2 if state == "AMBIGUOUS" else 4 if state == "UNKNOWN" else 0


# ══════════════════════════════════════════════════════════════════
# 具名控件探针（供 _ys-ui.sh / ys-playtest-start / ys-playtest-stop 转发）
# ══════════════════════════════════════════════════════════════════
def _probe_points(spec):
    out = []
    for _label, pt, _kind in spec["readings"]:
        if isinstance(pt, tuple):
            out.append(pt)
    return out


def _probe_bbox(spec, pad=PROBE_CROP):
    pts = _probe_points(spec) + [p for p, _ in _panel_pts(spec)]
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    return (max(0, min(xs) - pad), max(0, min(ys) - pad),
            max(xs) - min(xs) + 2 * pad, max(ys) - min(ys) + 2 * pad)


def _panel_pts(spec):
    for _label, pt, kind in spec["readings"]:
        if kind == "panel":
            return [(p, "L") for p in PANEL_L] + [(p, "M") for p in PANEL_M]
    return []


def _eval_panel(cells):
    l = [cells[p] for p in PANEL_L if p in cells]
    m = [cells[p] for p in PANEL_M if p in cells]
    if not l or not m:
        return None
    lm = [sum(c[i] for c in l) / len(l) for i in range(3)]
    mm = [sum(c[i] for c in m) / len(m) for i in range(3)]
    return max(abs(a - b) for a, b in zip(lm, mm))


def probe_readings(name, frame=None, grabbed=None):
    """取数并算一条探针的全部判据。返回 (readings 列表, cells 字典)。

    grabbed = (arr_uint8, ox, oy)：调用方已经把该探针外接框抓好了（daemon 用，省一次抓帧）。
    """
    import numpy as np                      # 本文件只在函数内用 numpy（daemon 以模块加载时也一样）
    spec = PROBES[name]
    if grabbed is not None:
        arr, ox, oy = grabbed
        arr = np.asarray(arr)
        # 单位护栏：判据全部按 0..255 写死，0..1 浮点进来会让**每一条判据都假**（且不报错）。
        # 2026-10-17 事故：daemon 活体把 `ys_look.grab` 的 0..1 浮点直接传进来 ⇒ 探针永远"不可见"。
        if arr.dtype.kind == "f":
            arr = (arr * 255.0).round().astype("uint8") if (arr.size and float(arr.max()) <= 1.0) \
                else arr.round().astype("uint8")
        elif arr.dtype != np.uint8:
            arr = arr.astype("uint8")
        cells = {}
        for x, y in _probe_points(spec) + [p for p, _ in _panel_pts(spec)]:
            rx, ry = x - ox, y - oy
            if 0 <= ry < arr.shape[0] and 0 <= rx < arr.shape[1]:
                cells[(x, y)] = tuple(int(v) for v in arr[ry, rx])
    elif frame:
        w, h = frame_geom(frame)
        pts = sorted(set(_probe_points(spec) + [p for p, _ in _panel_pts(spec)]))
        bad = [p for p in pts if p[0] >= w or p[1] >= h]
        if bad:
            # 画面尺寸不符（缩放帧/抓帧失败态）⇒ 该控件**确定不可见**，不该抛错让调用方
            # 去猜"是错误还是不可见"：判据全标 false + 读数写明尺寸（fail closed，可审计）。
            return ([{"name": lbl, "value": f"画面 {w}x{h} 越界（缩放帧/抓帧失败态）",
                      "passed": False, "kind": kind}
                     for lbl, _pt, kind in spec["readings"]], {})
        pix = ProbePixels(frame, pts)
        cells = {p: pix.px(*p) for p in pts}
    else:
        load_env()
        sys.path.insert(0, HERE)
        import ys_look
        ox, oy, bw, bh = _probe_bbox(spec)
        if bw * bh > 1000 * 1000:                      # 点太分散：整帧一次抓（比多次裁切便宜）
            ox, oy, bw, bh = 0, 0, FRAME_W, FRAME_H
        try:
            arr = ys_look.grab(ox, oy, bw, bh)
        except Exception as e:                         # noqa: BLE001
            raise RuntimeError(f"探针 {name} 抓不到像素: {e}")
        a = (arr * 255).round().astype("uint8")
        cells = {}
        for x, y in _probe_points(spec) + [p for p, _ in _panel_pts(spec)]:
            rx, ry = x - ox, y - oy
            if 0 <= rx < bw and 0 <= ry < bh:
                cells[(x, y)] = tuple(int(v) for v in a[ry, rx])
    readings = []
    for label, pt, kind in spec["readings"]:
        if kind == "panel":
            d = _eval_panel(cells)
            ok = d is not None and d > PANEL_DIFF
            readings.append({"name": label, "value": f"diff={d:.1f}" if d is not None else "取数失败",
                             "passed": bool(ok), "kind": "pixel"})
        else:
            c = cells.get(pt)
            ok = c is not None and PROBE_RULES[kind](c)
            readings.append({"name": label, "value": str(c) if c is not None else "取数失败",
                             "passed": bool(ok), "kind": "pixel"})
    return readings, cells


def probe_once(name, frame=None):
    """一次探针判定：常驻服务优先，回退本地（判据都在本文件）。"""
    if os.environ.get("YS_STATE_LOCAL") != "1":
        d = daemon_probe(name, frame=frame)
        if d:
            d["via"] = "daemon"
            return d
        warn_fallback(f"探针 {name} ", time.time())
    out = probe(name, frame=frame)
    out.update({"via": "local", "daemon_error": DAEMON_ERROR})
    return out


def read_point(x, y, frame=None):
    """读一个点的 RGB（活体：常驻服务优先；离线：直接读 `--frame`）。

    活体走 daemon 的 `cmd=px`（服务内 1x1 抓取，省掉一次 python 进程与导入）。
    """
    if not frame and os.environ.get("YS_STATE_LOCAL") != "1":
        d = daemon_call({"cmd": "px", "x": x, "y": y, "win": win_id()}, timeout=20)
        if d and "v" not in d:
            sys.stderr.write(f"[ys-state] ⚠ daemon px 失败，已回退本地：{str(d)[:160]}\n")
        if d and "v" in d:
            try:
                return tuple(int(v) for v in str(d["v"]).split())
            except ValueError:
                pass
    if frame:
        w, h = frame_geom(frame)
        if x >= w or y >= h:
            raise RuntimeError(f"取样点 ({x},{y}) 超出画面 {w}x{h}（缩放帧/抓帧失败态）")
        r = subprocess.run(["magick", frame, "-format",
                            "%[pixel:p{" + str(x) + "," + str(y) + "}]", "info:"],
                           capture_output=True, text=True)
        rgb = parse_pixel((r.stdout or "").strip())
        if rgb is None:
            raise RuntimeError(f"({x},{y}) 取不到像素: {(r.stderr or '').strip()[:120]}")
        return rgb
    load_env()
    sys.path.insert(0, HERE)
    import ys_look
    half = PROBE_CROP // 2
    try:
        arr = ys_look.grab(max(0, x - half), max(0, y - half), PROBE_CROP, PROBE_CROP)
    except Exception as e:                             # noqa: BLE001
        raise RuntimeError(f"({x},{y}) 抓不到像素: {e}")
    a = (arr * 255).round().astype("uint8")
    return tuple(int(v) for v in a[half, half])


def probe(name, frame=None, grabbed=None):
    """判一个具名控件是否可见。返回 dict(probe, visible, readings, ms, desc, rule)。

    grabbed = (arr_uint8, ox, oy)：调用方已抓好的本探针外接框（daemon 用）。
    """
    name = PROBE_ALIAS.get(name, name)
    if name not in PROBES:
        raise RuntimeError(f"未知探针 {name!r}；可用: {sorted(PROBES)}")
    t0 = time.time()
    spec = PROBES[name]
    items, _cells = probe_readings(name, frame=frame, grabbed=grabbed)
    n = len(items)
    passed = sum(1 for r in items if r["passed"])
    visible = (passed >= 2) if spec["rule"] == "any2" else (passed == n)
    # `must`：除 rule 之外**必须一并成立**的判据（用于挡假阳性）。
    # 典型：结算页【离开】/暂停菜单的亮块判据，在系统菜单面板上也会亮
    # （实测 menu.png / live-menu-back4.png 两帧假阳性）⇒ 用「画面不是菜单浅灰」当 must。
    must = spec.get("must") or []
    if must:
        by_name = {r["name"]: r["passed"] for r in items}
        visible = visible and all(by_name.get(m, False) for m in must)
    if n < 2:                                          # 契约 §6：每探针 ≥2 判据
        visible = False
    return {"probe": name, "visible": bool(visible),
            "readings": {r["name"]: {"value": r["value"], "passed": r["passed"], "kind": r["kind"]}
                         for r in items},
            "criteria": n, "passed_criteria": passed,
            "ms": round((time.time() - t0) * 1000), "desc": spec["desc"],
            "rule": spec["rule"], "validated": spec.get("validated", True)}


# ══════════════════════════════════════════════════════════════════
# 回归（契约 §2）：负数样本 = 期望 UNKNOWN
# ══════════════════════════════════════════════════════════════════
def read_manifest():
    if not os.path.exists(MANIFEST):
        sys.stderr.write(f"缺少回归清单 {MANIFEST}\n")
        sys.exit(3)
    rows = []
    with open(MANIFEST, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            cols = line.split("\t")
            fn, want = cols[0].strip(), (cols[1].strip() if len(cols) > 1 else "")
            desc = cols[2].strip() if len(cols) > 2 else ""
            rows.append((fn, want, desc))
    return rows


def regress(channels, as_json=False):
    rows = read_manifest()
    total = len(rows)
    negs = sum(1 for _, w, _ in rows if w == "UNKNOWN")
    short_total = max(0, REG_MIN_TOTAL - total)
    short_neg = max(0, REG_MIN_NEG - negs)
    fails = {ch: [] for ch in channels}
    lines = []
    if not as_json:
        print(f"══ ys-state 回归（{MANIFEST}）══")
        print(f"样本总数={total}  负样本数={negs}"
              f"（门槛 ≥{REG_MIN_TOTAL} / 负样本 ≥{REG_MIN_NEG}）")
        if short_total or short_neg:
            print(f"✗ 样本数不达标：总数差 {short_total} 张（{total}<{REG_MIN_TOTAL}）；"
                  f"负样本差 {short_neg} 张（{negs}<{REG_MIN_NEG}）")
        else:
            print("✓ 样本数达标")
    for fn, want, desc in rows:
        path = os.path.join(REG_DIR, fn)
        got = {}
        if not os.path.exists(path):
            for ch in channels:
                fails[ch].append(fn)
                got[ch] = "样本缺失"
        else:
            for ch in channels:
                try:
                    res, _, _ = execute(ch, frame=path)
                except Exception as e:                  # noqa: BLE001 —— 回归里任何异常都算失败
                    res = {"state": "ERROR", "error": f"{type(e).__name__}: {e}"}
                st = res.get("state", "ERROR")
                if res.get("error") and st != want:
                    st = f"ERROR({res['error'][:40]})"
                got[ch] = st
                if st != want:
                    fails[ch].append(fn)
        if not as_json:
            marks = " ".join(f"{ch}={'✓' if got[ch] == want else '✗'}" for ch in channels)
            tag = "负样本" if want == "UNKNOWN" else "正样本"
            detail = "" if all(got[ch] == want for ch in channels) else \
                "  " + " ".join(f"{ch}→{got[ch]}" for ch in channels if got[ch] != want)
            print(f"  [{tag}] {fn:32s} 期望 {want:9s} {marks}{detail}  ({desc})")
        lines.append({"sample": fn, "want": want, "got": got, "desc": desc})
    rate = {}
    for ch in channels:
        okc = total - len(fails[ch])
        rate[ch] = round(100.0 * okc / total, 1) if total else 0.0
        if not as_json:
            print(f"── 通道 {ch:4s} 通过 {okc}/{total} = {rate[ch]:.1f}%"
                  + ("" if not fails[ch] else f"  失败: {fails[ch]}"))
    bad = any(fails[ch] for ch in channels) or short_total or short_neg
    if as_json:
        print(json.dumps({
            "total": total, "negatives": negs,
            "channels": {ch: {"percent": rate[ch], "passed": total - len(fails[ch]),
                              "total": total, "failed": fails[ch]} for ch in channels},
            "min_total": REG_MIN_TOTAL, "min_negatives": REG_MIN_NEG,
            "short_total": short_total, "short_negatives": short_neg,
            "samples": lines, "ok": not bad}, ensure_ascii=False))
    else:
        print("─" * 62)
        if bad:
            for ch in channels:
                if fails[ch]:
                    print(f"✗ {ch} 通道 {len(fails[ch])}/{total} 失败: {fails[ch]}")
            if short_total or short_neg:
                print(f"✗ 回归集规模不达标（总数 {total}，负样本 {negs}）")
            print("✗ 回归失败")
        else:
            print(f"✓ 回归全绿：{total}/{total} 样本，负样本 {negs} 张，"
                  f"通道 {' / '.join(f'{ch} {rate[ch]:.1f}%' for ch in channels)}")
    return 1 if bad else 0


