# CLI
# ══════════════════════════════════════════════════════════════════
def main(argv):
    args = list(argv)
    as_json = "--json" in args
    print_state = "--print-state" in args
    compat = opt(args, "--compat")
    frame = opt(args, "--frame")
    profile = opt(args, "--profile")
    channel = opt(args, "--channel") or "full"
    if "--fast" in args:
        channel = "fast"
    max_age = None
    if "--max-age-ms" in args:
        try:
            max_age = float(args[args.index("--max-age-ms") + 1])
        except (IndexError, ValueError):
            sys.stderr.write("--max-age-ms 需要一个数字（毫秒）\n")
            return 3

    # ── 原语转发（给 `_ys-ui.sh` 的 judge / is_light / is_dark 用）：坐标与阈值仍在**本文件**
    # `--pixel X Y` 打印 `r g b`（judge）；`--pred light|dark X Y` 打印 1/0（is_light / is_dark）
    if "--pixel" in args or "--pred" in args:
        try:
            if "--pixel" in args:
                i = args.index("--pixel")
                x, y = int(args[i + 1]), int(args[i + 2])
                rgb = read_point(x, y, frame=frame)
                print(" ".join(str(v) for v in rgb))
                return 0
            i = args.index("--pred")
            kind = args[i + 1]
            x, y = int(args[i + 2]), int(args[i + 3])
            if kind not in PROBE_RULES:
                sys.stderr.write(f"--pred 只接受 {sorted(PROBE_RULES)}（收到 {kind}）\n")
                return 3
            rgb = read_point(x, y, frame=frame)
            ok = PROBE_RULES[kind](rgb)
            if as_json:
                print(json.dumps({"pred": kind, "xy": [x, y], "value": list(rgb),
                                  "passed": bool(ok)}, ensure_ascii=False))
            else:
                print("1" if ok else "0")
            return 0 if ok else 1
        except (RuntimeError, ValueError, IndexError) as e:
            sys.stderr.write(f"[ys-state] {e}\n")
            return 3

    # ── 探针注册表（契约 §6）：--probes 列表 / --probe 判一条 / --wait 谓词等待 ──
    if "--probes" in args:
        rows = []
        for name, spec in PROBES.items():
            rows.append({"probe": name, "desc": spec["desc"], "rule": spec["rule"],
                         "criteria": len(spec["readings"]),
                         "validated": spec.get("validated", True)})
        if as_json:
            print(json.dumps({"probes": rows}, ensure_ascii=False))
        else:
            for r in rows:
                print(f"{r['probe']:18s} 判据 {r['criteria']} 条  {r['rule']:5s} "
                      f"{'已验证' if r['validated'] else '未验证(无离线帧)'}  {r['desc']}")
        for r in rows:
            if r["criteria"] < 2:
                sys.stderr.write(f"[ys-state] 探针 {r['probe']} 判据不足 2 条\n")
                return 1
        return 0

    # ── 状态轮询原语（②ESC 生效有延迟：按完立刻判会读旧态，必须轮询到目标态）──
    wait_state_name = opt(args, "--wait-state")
    if wait_state_name:
        want = wait_state_name.upper()
        if want not in STATES:
            sys.stderr.write(f"--wait-state 只接受 {STATES}（收到 {wait_state_name}）\n")
            return 3
        try:
            timeout = float(opt(args, "--timeout") or 20)
            poll = float(opt(args, "--poll") or 0.2)
        except ValueError:
            sys.stderr.write("--timeout/--poll 需要数字\n")
            return 3
        t0 = time.time()
        seen = []
        cur = None
        while True:
            res, _path, _fresh = execute(channel, frame=frame, profile=profile)
            cur = res.get("state", "UNKNOWN")
            if not seen or seen[-1] != cur:
                seen.append(cur)
            if cur == want:
                if as_json:
                    print(json.dumps({"state": cur, "reached": True, "want": want,
                                      "ms": round((time.time() - t0) * 1000), "polls": len(seen),
                                      "seen": seen, "channel": channel}, ensure_ascii=False))
                else:
                    print(cur)
                return 0
            if time.time() - t0 >= timeout:
                break
            time.sleep(poll)
        sys.stderr.write(f"[ys-state] --wait-state {want} 超时 {timeout:.1f}s，"
                         f"见到序列 {seen}（按键后状态有延迟，别立刻判）\n")
        if as_json:
            print(json.dumps({"state": cur, "reached": False, "want": want,
                              "ms": round((time.time() - t0) * 1000), "seen": seen,
                              "channel": channel}, ensure_ascii=False))
        else:
            print(cur)
        return 1

    probe_name = opt(args, "--probe")
    wait_name = opt(args, "--wait")
    if probe_name or wait_name:
        name = wait_name or probe_name
        try:
            if wait_name:
                expect = (opt(args, "--expect") or "visible").lower()
                if expect not in ("visible", "hidden"):
                    sys.stderr.write("--expect 只接受 visible|hidden\n")
                    return 3
                timeout = float(opt(args, "--timeout") or 15)
                poll = float(opt(args, "--poll") or 0.2)
                t0 = time.time()
                ok_wait = False
                while True:
                    out = probe_once(name, frame=frame)
                    if bool(out["visible"]) == (expect == "visible"):
                        out["waited_ms"] = round((time.time() - t0) * 1000)
                        out["expect"] = expect
                        ok_wait = True
                        break
                    if time.time() - t0 >= timeout:
                        out["waited_ms"] = round((time.time() - t0) * 1000)
                        out["expect"] = expect
                        out["timeout"] = True
                        if as_json:
                            print(json.dumps(out, ensure_ascii=False))
                        else:
                            sys.stderr.write(
                                f"[ys-state] 等待探针 {name} {expect} 超时 {timeout}s"
                                f"（最后判据={ {k: v['passed'] for k, v in out['readings'].items()} }）\n")
                        return 1
                    time.sleep(poll)
            else:
                out = probe_once(name, frame=frame)
        except RuntimeError as e:
            sys.stderr.write(f"[ys-state] {e}\n")
            if as_json:
                print(json.dumps({"probe": name, "error": str(e)}, ensure_ascii=False))
            return 3
        if as_json:
            print(json.dumps(out, ensure_ascii=False))
        else:
            print(f"{out['probe']} {'1' if out['visible'] else '0'}"
                  + (f" {out['waited_ms']}ms" if "waited_ms" in out else "")
                  + f" ({out['desc']})")
        if wait_name:
            return 0 if ok_wait else 1
        return 0 if out["visible"] else 1

    # ── 回归 ──
    if "--regress" in args:
        chans = ["full", "fast"]                        # 缺省两通道都跑（契约 §2 要「每通道通过率」）
        if "--channel" in args:
            val = opt(args, "--channel")
            if val == "both":
                chans = ["full", "fast"]
            elif val in ("fast", "full"):
                chans = [val]
            else:
                sys.stderr.write(f"--channel 只接受 fast|full|both（收到 {val}）\n")
                return 3
        return 5 if regress(chans, as_json=as_json) else 0

    if "--channel" in args and channel == "both":
        sys.stderr.write("--channel both 只用于 --regress；单个判定只接受 fast|full\n")
        return 3

    # ── 单次判定 ──
    if frame and not os.path.exists(frame):
        sys.stderr.write(f"帧不存在: {frame}\n")
        return 3
    try:
        res, path, fresh = execute(channel, frame=frame, profile=profile,
                                   max_age_ms=max_age)
    except Exception as e:                              # noqa: BLE001 —— 仪器故障要出声
        sys.stderr.write(f"[ys-state] {type(e).__name__}: {e}\n")
        return 3
    if res.get("error") and res.get("state") == "UNKNOWN" and "readings" not in res:
        # 取帧失败：stderr **必出声**，JSON 里显式 ok=false / frame=null / 原始原因
        # （2026-10-17 事故：full 通道在槽内取帧失败，调用方拿到 frame:null 差点复制旧帧下结论）
        sys.stderr.write(f"[ys-state] 取帧失败：{res['error']}"
                         f"{('（' + str(res.get('detail'))[:200] + '）') if res.get('detail') else ''}\n")
        if as_json:
            err = dict(res)
            err.update({"ok": False, "frame": None, "state": "UNKNOWN", "channel": channel,
                        "fresh": {"ok": False, "atop": False, "ts": int(time.time()),
                                  "sha": None, "reason": res.get("detail") or res["error"]}})
            print(json.dumps(err, ensure_ascii=False))
        return 3
    out = dict(res)
    if isinstance(fresh, dict):
        fresh = dict(fresh, ok=True)
    out.update({"frame": path, "fresh": fresh, "ok": True})
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    elif print_state:
        st = out["state"]
        if compat == "ys-fast":
            st = COMPAT.get(st, st)                     # SAVELIST→SAVE；其余原样（绝不给别的态的名字）
        print(st)
    else:
        print(out["state"])
        if out["state"] in ("AMBIGUOUS", "UNKNOWN"):
            sys.stderr.write(f"  {out.get('candidates') or '无状态成立'}  判据={out.get('verdicts')}\n")
    return exit_code(out["state"])


def opt(args, name):
    """取 `--name VALUE` 的 VALUE（缺省 None）。"""
    if name not in args:
        return None
    i = args.index(name)
    return args[i + 1] if len(args) > i + 1 else None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
