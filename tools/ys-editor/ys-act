#!/bin/bash
# ys-act — 「真抬升 → 执行动作 → 抓新鲜图 → 还原焦点」一条龙（本机 GUI 的主力工作单元）
#
# 存在理由（2026-10-17 连续踩坑）：
#   `ys-gui-slot` 只做 `workspace.activeWindow = t`，**不改堆叠顺序**；窗口被压住时
#   `import -silent -window` 返回**陈旧 backing store**。实测：点击已生效（菜单确实开了），
#   但抓图返回旧帧 ⇒ 我据此误判了 5+ 轮（以为 ESC 没反应、以为点击没命中）。
#   ⇒ 任何「动作 + 看结果」必须 **先 ys-kwin-raise 真抬升**。
#
# 用法: ys-act <动作脚本.sh> [输出.png] [窗口id]
#   动作脚本在硬通道内执行，可用环境：YS_SLOT_ACTIVE=1、DISPLAY、YDOTOOL_SOCKET
#   脚本内可用 $HERE 指向 tools/ys-editor
# 例: ys-act /tmp/my-action.sh /tmp/out.png
set -u
SCRIPT="${1:?用法: ys-act <动作脚本.sh> [输出.png] [窗口id]}"
OUT="${2:-/tmp/ys-act.png}"
WIN="${3:-${YS_WIN:?YS_WIN 未解析，见 ys-env.sh}}"
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
export YS_WIN="$WIN"

RAISE=$("$HERE/ys-kwin-raise" "原神" 2>&1 | tail -1)
echo "[ys-act] raise: $RAISE"

SLOT_OUT=$(set -o pipefail; "$HERE/ys-gui-slot" "$WIN" "${YS_MAX:-120}" bash -c "
  export HERE='$HERE'
  bash '$SCRIPT'
  sleep 0.8
  import -silent -window '$WIN' '$OUT' 2>/dev/null
" 2>&1 | grep -v '^[0-9]* [0-9]*$' | tail -12); SLOT_RC=$?
printf '%s\n' "$SLOT_OUT"
if [ "$SLOT_RC" -ne 0 ]; then
  echo "[ys-act] ys-gui-slot 失败 rc=$SLOT_RC（焦点/归还未验证）" >&2
  exit "$SLOT_RC"
fi

[ -s "$OUT" ] || { echo "[ys-act] 未取到图 $OUT" >&2; exit 3; }
SMALL="${OUT%.png}-s.png"
magick "$OUT" -resize 1500x "$SMALL" 2>/dev/null || convert "$OUT" -resize 1500x "$SMALL" 2>/dev/null
echo "[ys-act] $OUT → $SMALL"
