#!/usr/bin/env python3
"""ys-kill —— 安全地按模式杀进程（不杀自己、不杀祖先进程），2026-10-20 建

为什么要有它（本会话内我**连续三次**被自己的命令杀掉）：
  `pkill -f "ys-snap --gui"` 与 `pgrep -f "..." | xargs kill` 都会匹配到**发起它的那个 shell**，
  因为 shell 自己的命令行里就含着这段字符串 ⇒ 自杀。
  三次都发生在「清理旧实例」这种看似无害的收尾动作上，代价是整条调用链被打断。

本工具的判据（三条都要过才杀）：
  ① 匹配到的 pid 不等于自身 pid
  ② 不等于**任何祖先进程**（读 /proc/<pid>/stat 的 ppid 一路向上）
  ③ 其 cmdline **不包含本工具的路径**（防止把包装脚本自己也算进去）

用法：
  ys-kill "ys-snap --gui"              # 只列不杀（缺省 dry-run）
  ys-kill "ys-snap --gui" --yes        # 真杀
  ys-kill -x ys_lookd.py --yes         # -x = 精确匹配进程名，按名字不按整条命令行
退出码：0 有命中且（已杀 或 dry-run）/ 1 无命中 / 2 用法错误
"""
import argparse
import os
import subprocess
import sys

SELF = os.path.realpath(__file__)


def ancestors(pid):
    """返回 {自身 pid} ∪ 祖先 pid 集合。"""
    out, cur = set(), pid
    for _ in range(64):
        if cur <= 1:
            break
        out.add(cur)
        try:
            with open(f"/proc/{cur}/stat", "rb") as f:
                fields = f.read().split()
            cur = int(fields[3])          # ppid 是第 4 个字段
        except Exception:
            break
    return out


def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().replace(b"\0", b" ").decode("utf-8", "replace").strip()
    except Exception:
        return ""


def main():
    ap = argparse.ArgumentParser(prog="ys-kill")
    ap.add_argument("pattern")
    ap.add_argument("-x", "--exact", action="store_true", help="按进程名精确匹配（pgrep -x）")
    ap.add_argument("--yes", action="store_true", help="真的杀（缺省只列）")
    a = ap.parse_args()

    flag = "-x" if a.exact else "-f"
    r = subprocess.run(["pgrep", flag, a.pattern], capture_output=True, text=True)
    pids = [int(x) for x in r.stdout.split() if x.strip().isdigit()]
    if not pids:
        print(f"[ys-kill] 没有进程匹配 {a.pattern!r}", file=sys.stderr)
        return 1

    skip = ancestors(os.getpid())
    keep, drop = [], []
    for p in pids:
        cl = cmdline(p)
        if p in skip or SELF in cl:
            drop.append((p, cl, "自身或祖先进程"))
        else:
            keep.append((p, cl, ""))

    for p, cl, why in keep:
        print(f"  kill {p:7d}  {cl[:90]}")
    for p, cl, why in drop:
        print(f"  skip {p:7d}  [{why}] {cl[:70]}", file=sys.stderr)

    if not keep:
        print("[ys-kill] 命中的全是自身/祖先，什么都不做", file=sys.stderr)
        return 1
    if not a.yes:
        print(f"[ys-kill] dry-run：将杀 {len(keep)} 个进程；加 --yes 执行", file=sys.stderr)
        return 0

    for p, _, _ in keep:
        try:
            os.kill(p, 15)
        except ProcessLookupError:
            pass
        except PermissionError as e:
            print(f"[ys-kill] {p} 权限不足：{e}", file=sys.stderr)
    print(f"[ys-kill] 已发 SIGTERM 给 {len(keep)} 个进程", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
