#!/bin/bash
# ys-gui-slot — 共享桌面的「申请制窗口占用」包装器
# （2026-10-16 用户令：约定不能只写在技能里，要做成设计，自动保证「用完就还」）
#
# 用法: ys-gui-slot.sh <win> <max-seconds> <command...>
#   <win> 窗口 id：wmctrl 十六进制(0x01400001) 或 xdotool 十进制(20971521) 均可
#   环境: YS_GUI_SLOT_FALLBACK_CLASS = 缺省回落窗口的 WM_CLASS 子串（缺省 "firefox"，即 DSH 页面）
#
# 硬不变量（用户 2026-10-16 定义）：
#   **执行前是什么窗口，执行后就必须是什么窗口**（exact）。
#
# 2026-10-19 重做（用户第二次投诉：执行完画面没还）：
#   旧版三处底层缺陷（与 ys-lease 旧版同病）：
#     ① 记录/还原用 xdotool getwindowfocus + windowactivate —— 本机 KWin/Wayland 下
#        `0x01400001`/`0x1800001` 是 **1×1 幽灵窗**，`getactivewindow` 返回 0x200000；
#     ② 只 activate 不 raise，也不验证堆叠 ⇒ 焦点回去、画面被原神压着；
#     ③ trap 里设置 RESTORE_RC=9，但显式退出码检查在 trap 之前执行 ⇒ 失败仍退出 0。
#   现在：
#     · 目标窗解析走 `ys-lease resolve-window`（KWin pid/name/class；幽灵 id 免疫）；
#     · 取焦点 = `ys-lease kwin-raise`（activate + raise + 验证 activeWindow）；
#     · 归还 = `ys-lease restore --prev-json …`（KWin internalId + stackingOrder 验证
#       `idx(prev) > idx(游戏)`，3 次重试；失败非零）；
#     · 还原失败 ⇒ **退出码 9**（显式调用 restore，trap 只兜异常路径）。
#
# 规矩: 所有对用户桌面的注入类操作（ydotool / 坐标点击 / 截图轮询）都必须经由此脚本。
set -u

export YS_SLOT_ACTIVE=1   # 槽内标记：shims 只放行槽内的注入（见 tools/ys-editor/shims/）
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-/run/user/1000/.ydotool_socket}"
FALLBACK_CLASS="${YS_GUI_SLOT_FALLBACK_CLASS:-firefox}"
LEASE_BIN="$YS_HOME/ys-lease"

if [ $# -lt 3 ]; then echo "用法: $0 <win> <max-seconds> <command...>" >&2; exit 2; fi
WIN_RAW="$1"; MAX="$2"; shift 2
case "$WIN_RAW" in
  0x*|0X*) WIN_HEX="$WIN_RAW"; WIN_DEC=$(( WIN_RAW )) ;;
  *)       WIN_DEC="$WIN_RAW"; WIN_HEX=$(printf '0x%08x' "$WIN_RAW") ;;
esac

name_of() { xdotool getwindowname "$1" 2>/dev/null || true; }
pid_of()  { xdotool getwindowpid "$1" 2>/dev/null || echo 0; }
geom_of() {
  local g w h
  g=$(xdotool getwindowgeometry --shell "$1" 2>/dev/null || true)
  w=$(printf '%s\n' "$g" | awk -F= '/^WIDTH=/{print $2}')
  h=$(printf '%s\n' "$g" | awk -F= '/^HEIGHT=/{print $2}')
  printf '%sx%s' "${w:-0}" "${h:-0}"
}
json_get() {  # json_get <json> <python-expr over d>
  printf '%s' "$1" | python3 -c "import json,sys
try: d=json.load(sys.stdin)
except Exception: print(''); raise SystemExit
print($2)" 2>/dev/null || true
}

# ── 1) KWin 权威状态：记录 prev + 解析目标（幽灵 id 免疫） ────────────────────
STATE0=$("$LEASE_BIN" kwin-state 2>/dev/null) || {
  echo "[ys-gui-slot] KWin 权威通道不可用（拒绝用 xdotool 猜焦点）" >&2; exit 3; }
PREV_JSON=$(json_get "$STATE0" "json.dumps(d.get('active') or None, ensure_ascii=False)")
PREV_DESC=$(json_get "$PREV_JSON" "((d or {}).get('caption') or '(无题)') + ' [' + ((d or {}).get('class') or '?') + ']' if d else 'none'")
CUR_ID=$(json_get "$STATE0" "(d.get('active') or {}).get('internalId','')")

TARGET=$( "$LEASE_BIN" resolve-window --id "$WIN_RAW" --name "$(name_of "$WIN_DEC")" \
          --pid "$(pid_of "$WIN_DEC")" --geom "$(geom_of "$WIN_DEC")" 2>/dev/null)
TARGET_ID=$(json_get "$TARGET" "(d.get('target') or {}).get('internalId','') if d.get('ok') else ''")
TARGET_DESC=$(json_get "$TARGET" "((d.get('target') or {}).get('caption') or '(无题)') + ' [' + ((d.get('target') or {}).get('class') or '?') + ']' if d.get('ok') else ''")
if [ -z "$TARGET_ID" ]; then
  echo "[ys-gui-slot] 目标窗无法解析到 KWin（win=$WIN_RAW name=$(name_of "$WIN_DEC") geom=$(geom_of "$WIN_DEC")）：$TARGET" >&2
  exit 3
fi

ALREADY_FOCUSED=0
[ "$CUR_ID" = "$TARGET_ID" ] && ALREADY_FOCUSED=1
START=$(date +%s); CMD_RC=0; RESTORE_RC=0; RESTORED=0

restore() {
  [ "$RESTORED" = "1" ] && return
  RESTORED=1
  if [ "$ALREADY_FOCUSED" = "1" ]; then
    echo "[ys-gui-slot] 占用 $(( $(date +%s) - START ))s｜焦点本就在目标窗，未改动"
    return
  fi
  local out rc ti gi desc
  out=$("$LEASE_BIN" restore --prev-json "$PREV_JSON" --fallback "$FALLBACK_CLASS" 2>&1); rc=$?
  ti=$(json_get "$out" "d.get('target_index')")
  gi=$(json_get "$out" "d.get('game_index')")
  if [ "$rc" -eq 0 ]; then
    desc=$(json_get "$out" "d.get('restored','')")
    echo "[ys-gui-slot] 占用 $(( $(date +%s) - START ))s｜焦点已还原：$desc（idx $ti > game $gi）"
    return
  fi
  echo "[ys-gui-slot] ⚠️ 还原失败（KWin 堆叠验证未通过，重试 3 次；前焦=${PREV_DESC}）：$out" >&2
  RESTORE_RC=9
}
trap restore EXIT INT TERM HUP

# ── 2) 取焦点（KWin activate+raise+验证；不是 xdotool）───────────────────────
if [ "$ALREADY_FOCUSED" != "1" ]; then
  RAISE=$("$LEASE_BIN" kwin-raise --id "$TARGET_ID" 2>/dev/null)
  ROK=$(json_get "$RAISE" "1 if d.get('ok') else 0")
  if [ "${ROK:-0}" != "1" ]; then
    echo "[ys-gui-slot] 焦点核验失败（KWin 未能 activate+raise 目标 $TARGET_DESC）：$RAISE" >&2
    RESTORED=1   # 没改过焦点，不必归还（避免多动一次）
    exit 3
  fi
fi
echo "[ys-gui-slot] 已取得 $WIN_HEX（$TARGET_DESC）焦点｜时限 ${MAX}s"

# ── 3) 执行（硬时限）→ 显式归还（失败 9）─────────────────────────────────────
timeout --signal=TERM "$MAX" "$@"; CMD_RC=$?
restore
trap - EXIT INT TERM HUP
[ "$RESTORE_RC" != "0" ] && exit "$RESTORE_RC"
exit "$CMD_RC"
