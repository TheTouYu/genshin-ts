#!/bin/bash
# ys-gui-slot — 共享桌面的「申请制窗口占用」包装器
# （2026-10-16 用户令：约定不能只写在技能里，要做成设计，自动保证「用完就还」）
#
# 用法: ys-gui-slot.sh <win> <max-seconds> <command...>
#       ys-gui-slot.sh --plan [win]   # 只算不干：打印一行 JSON（离线判据，见 §0）
#   <win> 窗口 id：wmctrl 十六进制(0x01400001) 或 xdotool 十进制(20971521) 均可
#   环境: YS_GUI_SLOT_FALLBACK_CLASS = 缺省回落窗口的 WM_CLASS 子串（缺省 "firefox"，即 DSH 页面）
#
# 硬不变量（用户 2026-10-16 定义）：
#   **执行前是什么窗口，执行后就必须是什么窗口**（exact）。
#
# 2026-10-19 重做（用户第二次投诉：执行完画面没还）：
#   旧版三处底层缺陷（与 ys-lease 旧版同病）：
#     ① 记录/还原用 xdotool getwindowfocus + windowactivate —— 本机 KWin/Wayland 下
#        `0x01400001`/`0x1800001` 是 **1×1 幽灵窗**，`getactivewindow` 返回 0x200000；
#     ② 只 activate 不 raise，也不验证堆叠 ⇒ 焦点回去、画面被原神压着；
#     ③ trap 里设置 RESTORE_RC=9，但显式退出码检查在 trap 之前执行 ⇒ 失败仍退出 0。
#   现在：
#     · 目标窗解析走 `ys-lease resolve-window`（KWin pid/name/class；幽灵 id 免疫）；
#     · 取焦点 = `ys-lease kwin-raise`（activate + raise + 验证 activeWindow）；
#     · 归还 = `ys-lease restore --prev-json …`（KWin internalId + stackingOrder 验证
#       `idx(prev) > idx(游戏)`，3 次重试；失败非零）；
#     · 还原失败 ⇒ **退出码 9**（显式调用 restore，trap 只兜异常路径）。
#
# 规矩: 所有对用户桌面的注入类操作（ydotool / 坐标点击 / 截图轮询）都必须经由此脚本。
set -u

export YS_SLOT_ACTIVE=1   # 槽内标记：shims 只放行槽内的注入（见 tools/ys-editor/shims/）
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
FALLBACK_CLASS="${YS_GUI_SLOT_FALLBACK_CLASS:-firefox}"
LEASE_BIN="$YS_HOME/ys-lease"

# ── 只读小工具 ───────────────────────────────────────────────────────────────
# 定义位置在用法校验与 `--plan` 分发**之前**：`--plan` 只有 1~2 个参数，必须先于
# `[ $# -lt 3 ]` 的用法检查分发出去（plan 不是执行，不适用那条检查）。
name_of() { xdotool getwindowname "$1" 2>/dev/null || true; }
pid_of()  { xdotool getwindowpid "$1" 2>/dev/null || echo 0; }
geom_of() {
  local g w h
  g=$(xdotool getwindowgeometry --shell "$1" 2>/dev/null || true)
  w=$(printf '%s\n' "$g" | awk -F= '/^WIDTH=/{print $2}')
  h=$(printf '%s\n' "$g" | awk -F= '/^HEIGHT=/{print $2}')
  printf '%sx%s' "${w:-0}" "${h:-0}"
}
json_get() {  # json_get <json> <python-expr over d>
  printf '%s' "$1" | python3 -c "import json,sys
try: d=json.load(sys.stdin)
except Exception: print(''); raise SystemExit
print($2)" 2>/dev/null || true
}

# ── 0) 租期判据（唯一源）+ `--plan`：只算不干 ────────────────────────────────
# 为什么有 --plan（账本 F-20261021-53 的修法是租期模型：有有效凭据时占用结束不归还）：
#   这条修复的唯一回归判据原本只有 screen-grant.selftest.sh 的 T6，而 T6 要 YS_ALLOW_SCREEN_TEST=1
#   且会真的抬窗 ⇒ 修复没有**离线**判据，账本只能挂 unproven（prevented 但判不了）。
#   --plan 把「这一次会怎么判」变成一行可机检的 JSON：只读 ys-screen-grant status /
#   ys-lease kwin-state / resolve-window 与 YS_SLOT_TEST，**不抬窗、不取焦点、不注入、
#   不响铃（不调 ys-bell）、不 sleep**，也绝不调 kwin-raise / restore。
#   退出码恒 0：plan 不是执行——契约不通过也只把 contract_ok=false 如实报出来，
#   绝不复用拒绝路径的 6、也不复用解析失败的 3（那些行为一字不动）。
#
# 凭据状态缓存：--plan 既要「观测」（lease_active / lease_left_s）又要「判据」（hold），
# restore() 也要判一次；status 每次 ~0.9s（内含用 ys-wins 取 KWin 活动窗），同一进程只读一次。
GRANT_JSON=""; GRANT_RC=""
grant_status() {   # 只读 ys-screen-grant status（结果缓存；rc 原样返回）
  if [ -z "$GRANT_RC" ]; then
    GRANT_JSON=$("$YS_HOME/ys-screen-grant" status 2>/dev/null); GRANT_RC=$?
  fi
  return "$GRANT_RC"
}
# 租期判据**只此一处**（restore() 与 --plan 共用）：有有效凭据且非测试模式 ⇒ 占用结束不归还。
# 「关掉租期模型」的注入用例只改这个函数体 ⇒ 真实归还行为与 plan 的 hold 同时翻转；
# 若 plan 自己另写一份判据，注入后 T13 仍会绿，那就成了空转断言（本仓库踩过：断言绿但没在判）。
lease_hold_active() {
  [ "${YS_SLOT_TEST:-0}" != "1" ] || return 1
  grant_status
}

plan_mode() {   # $1 = 窗口 id（可省略；沿用 tests/ 里既有的默认 0x1600001）
  local win_raw="${1:-${YS_WIN_TEST:-}}" win_dec win_hex
  case "$win_raw" in
    0x*|0X*) win_hex="$win_raw"; win_dec=$(printf '%d' "$win_raw" 2>/dev/null || echo 0) ;;
    ''|*[!0-9]*) win_dec=0; win_hex="" ;;          # 非法 id：不猜，按「解析不到目标」处理
    *) win_dec="$win_raw"; win_hex=$(printf '0x%08x' "$win_raw" 2>/dev/null || true) ;;
  esac

  # ① 契约（与下面 exit 6 同一判据）：测试模式放行，否则必须有有效凭据
  local test_mode=0; [ "${YS_SLOT_TEST:-0}" = "1" ] && test_mode=1
  local grant_ok=0; grant_status && grant_ok=1
  local contract=0
  if [ "$test_mode" = "1" ] || [ "$grant_ok" = "1" ]; then contract=1; fi
  local left="null"
  [ "$grant_ok" = "1" ] && left=$(printf '%s' "$GRANT_JSON" | python3 -c \
    "import sys,json;print(json.load(sys.stdin).get('left_s'))" 2>/dev/null)
  [ -n "$left" ] || left="null"

  # ② 租期分支：hold 只来自 lease_hold_active（唯一源，与 restore() 同一判据）
  local hold=0; lease_hold_active && hold=1

  # ③ 焦点归属（只读；与执行路径同一套 kwin-state / resolve-window，幽灵 id 免疫）
  local cur_id="" cur_desc="" target_id="" target_desc="" target=""
  local state0=""; state0=$("$LEASE_BIN" kwin-state 2>/dev/null) || state0=""
  if [ -n "$state0" ]; then
    cur_id=$(json_get "$state0" "(d.get('active') or {}).get('internalId','')")
    cur_desc=$(json_get "$state0" "(((d.get('active') or {}).get('class') or '?') + ' / ' + ((d.get('active') or {}).get('caption') or '(无题)'))[:60]")
  fi
  if [ -n "$win_hex" ]; then
    target=$( "$LEASE_BIN" resolve-window --id "$win_raw" --name "$(name_of "$win_dec")" \
               --pid "$(pid_of "$win_dec")" --geom "$(geom_of "$win_dec")" 2>/dev/null) || target=""
    target_id=$(json_get "$target" "(d.get('target') or {}).get('internalId','') if d.get('ok') else ''")
    target_desc=$(json_get "$target" "((d.get('target') or {}).get('class') or '?') + ' / ' + ((d.get('target') or {}).get('caption') or '(无题)') if d.get('ok') else ''")
  fi
  local focused=0 target_ok=0
  [ -n "$target_id" ] && target_ok=1
  [ "$target_ok" = "1" ] && [ "$cur_id" = "$target_id" ] && focused=1

  # ④ 决策：hold（租期模型）优先；契约不过 ⇒ 什么都不做（不碰窗口，也就没有可归还的东西）
  local would=0 mode="none"
  if [ "$contract" = "1" ] && [ "$hold" != "1" ]; then
    would=1
    if [ "$focused" = "1" ]; then mode="restore_already_focused"
    else mode="restore_prev"; fi
  fi
  local reason
  if [ "$contract" != "1" ]; then
    reason="NO_GRANT：没有有效屏幕凭据 ⇒ 会拒绝执行（rc=6），不碰任何窗口"
  elif [ "$hold" = "1" ]; then
    reason="LEASE_HOLD：租期内不归还（凭据剩 ${left}s），到期或 revoke 时统一交还"
  elif [ "$mode" = "restore_already_focused" ]; then
    reason="RESTORE_ALREADY_FOCUSED：目标本就在焦点 ⇒ 结束后切回默认屏 ${FALLBACK_CLASS}"
  else
    reason="RESTORE_PREV：结束后按 KWin 回执归还占用前的窗口"
  fi

  python3 - "$win_hex" "$contract" "$focused" "$grant_ok" "$left" "$hold" "$would" \
           "$reason" "$mode" "$test_mode" "$target_ok" "$cur_desc" "$target_desc" \
           "$FALLBACK_CLASS" <<'PY'
import json, sys
(a_win, a_contract, a_focused, a_lease, a_left, a_hold, a_would,
 a_reason, a_mode, a_test, a_target_ok, a_cur, a_target, a_fallback) = sys.argv[1:15]
def b(x):
    return x == "1"
print(json.dumps({
    "plan": True,
    "contract_ok": b(a_contract),
    "already_focused": b(a_focused),
    "lease_active": b(a_lease),
    "lease_left_s": None if a_left == "null" else int(a_left),
    "hold": b(a_hold),
    "would_restore": b(a_would),
    "reason": a_reason,
    "restore_mode": a_mode,
    "test_mode": b(a_test),
    "window": a_win,
    "target_ok": b(a_target_ok),
    "cur": a_cur,
    "target": a_target,
    "fallback": a_fallback,
}, ensure_ascii=False))
PY
}

# `--plan` 分发：必须在这里——早于用法校验、早于 ys-bell / 契约拒绝 / kwin-raise / restore，
# 走这条分支就保证 plan 碰不到任何会动屏幕的路径。
if [ "${1:-}" = "--plan" ]; then plan_mode "${2:-}"; exit 0; fi

if [ $# -lt 3 ]; then echo "用法: $0 <win> <max-seconds> <command...>" >&2; exit 2; fi
WIN_RAW="$1"; MAX="$2"; shift 2
case "$WIN_RAW" in
  0x*|0X*) WIN_HEX="$WIN_RAW"; WIN_DEC=$(( WIN_RAW )) ;;
  *)       WIN_DEC="$WIN_RAW"; WIN_HEX=$(printf '0x%08x' "$WIN_RAW") ;;
esac

# ── 1) KWin 权威状态：记录 prev + 解析目标（幽灵 id 免疫） ────────────────────
STATE0=$("$LEASE_BIN" kwin-state 2>/dev/null) || {
  echo "[ys-gui-slot] KWin 权威通道不可用（拒绝用 xdotool 猜焦点）" >&2; exit 3; }
PREV_JSON=$(json_get "$STATE0" "json.dumps(d.get('active') or None, ensure_ascii=False)")
PREV_DESC=$(json_get "$PREV_JSON" "((d or {}).get('caption') or '(无题)') + ' [' + ((d or {}).get('class') or '?') + ']' if d else 'none'")
CUR_ID=$(json_get "$STATE0" "(d.get('active') or {}).get('internalId','')")

TARGET=$( "$LEASE_BIN" resolve-window --id "$WIN_RAW" --name "$(name_of "$WIN_DEC")" \
          --pid "$(pid_of "$WIN_DEC")" --geom "$(geom_of "$WIN_DEC")" 2>/dev/null)
TARGET_ID=$(json_get "$TARGET" "(d.get('target') or {}).get('internalId','') if d.get('ok') else ''")
TARGET_DESC=$(json_get "$TARGET" "((d.get('target') or {}).get('caption') or '(无题)') + ' [' + ((d.get('target') or {}).get('class') or '?') + ']' if d.get('ok') else ''")
if [ -z "$TARGET_ID" ]; then
  echo "[ys-gui-slot] 目标窗无法解析到 KWin（win=$WIN_RAW name=$(name_of "$WIN_DEC") geom=$(geom_of "$WIN_DEC")）：$TARGET" >&2
  "$YS_HOME/ys-lease" kwin-state 2>/dev/null | python3 -c "
import sys, json
d = json.load(sys.stdin); a = d.get('active_window') or {}
wins = [w for w in (d.get('wins') or []) if 'yuanshen' in (w.get('class') or '').lower()]
print(json.dumps({'ok': False, 'error': 'TARGET_UNRESOLVED',
 'reason': '目标窗在 KWin 里找不到（id/标题/几何都对不上）',
 'state': {'active_window': {'class': a.get('class'), 'caption': (a.get('caption') or '')[:40]},
           'yuanshen_candidates': [{'internalId': w.get('internalId'), 'geom': w.get('geom')} for w in wins[:5]],
           'desktop': d.get('desktop')},
 'next_action': [{'step': 1, 'tool': 'tools/ys-editor/ys-wins', 'args': ['--attrib'],
                  'why': '看当前 KWin 真实窗口表（id 随游戏重启而变）'},
                 {'step': 2, 'tool': 'tools/ys-editor/ys-capture', 'args': ['status'],
                  'why': '确认抓帧守护认到的窗口 id'}],
 'hint': '用 caption/class 解析窗口，别硬编码窗口 id。'}, ensure_ascii=False))
" >&2 || true
  exit 3
fi

ALREADY_FOCUSED=0
[ "$CUR_ID" = "$TARGET_ID" ] && ALREADY_FOCUSED=1

# ── 屏幕占用契约（用户令 2026-10-21）────────────────────────────────────────
# 「这个系统不是你一个人在用」：动手前先看清屏幕在谁手上，并校验**用户批准过的时长凭据**。
# 没有凭据就拒绝——把"每次使用都要申请"做成设计，而不是靠调用方自觉。
echo "[ys-gui-slot] 占用前活动窗口：${PREV_DESC}"
if [ "${YS_SLOT_TEST:-0}" != "1" ]; then
  if ! "$YS_HOME/ys-screen-grant" status >/dev/null 2>&1; then
    # 失败必须自解释（用户令 2026-10-21）：**报错 + 原因 + 当前状态 + 下一步**，缺一不可。
    # 模型看不到"为什么被拒、屏幕现在在哪、我是不是还占着"，就会乱试或干等。
    "$YS_HOME/ys-screen-grant" explain --blocked-by ys-gui-slot --target "${WIN_HEX}" >&2
    exit 6
  fi
  # 2026-10-22：响铃必须**在契约之后**——铃是"我现在真的要占你屏幕"的听觉提示。
  # 原先铃在契约检查之前，于是「无凭据被拒绝」也会响一声：用户跑门禁时听到莫名操作音，
  # 而我实际一步都没动。拒绝路径（exit 6）与测试模式（YS_SLOT_TEST=1）一律不响。
  "$YS_HOME/ys-bell" 2>/dev/null || true
fi
START=$(date +%s); CMD_RC=0; RESTORE_RC=0; RESTORED=0

restore() {
  [ "$RESTORED" = "1" ] && return
  RESTORED=1
  # 2026-10-23（.03/.04 采集零归还事故）：槽结束第一件事 = 解除 hold。
  # claim 把 holding_until 设成整个槽时限；不清掉 ⇒ 警卫被 hold 挡到时限尽头。
  # hold-done 后空闲计时从**槽结束时刻**起算：idle_ms 内下一槽 claim 刷新（不闪切），
  # 超过即由警卫交还用户。归还不再依赖凭据过期那条 290s 粗路径。
  if [ "${YS_SLOT_TEST:-0}" != "1" ] && [ -x "$YS_HOME/ys-session" ]; then
    "$YS_HOME/ys-session" hold-done --reason slot-end >/dev/null 2>&1 || true
  fi
  # 2026-10-21（用户批准的设计改）：**一次授权 = 一段租期**。
  # 旧设计每次动作后都归还 ⇒ 下一次 look --live 必然 NOT_ATOP（账本 F-20261021-53），
  # 多步任务每步都要重新申请。租期内不**主动**归还——但归还责任已交给空闲层：
  # 上面的 hold-done + claim 登记的 auto-session 保证空闲 idle_ms 后警卫必还。
  # 判据走 lease_hold_active（唯一源；`--plan` 判的是同一个函数，注入用例改它 ⇒ T13 必红）。
  if lease_hold_active; then
    _left=$(printf '%s' "$GRANT_JSON" | python3 -c "import sys,json;print(json.load(sys.stdin).get('left_s'))" 2>/dev/null)
    echo "[ys-gui-slot] 租期内不主动归还（凭据剩 ${_left}s）——空闲 10s 后由 ys-focus-guard 交还（auto-session 已登记）"
    return
  fi
  if [ "$ALREADY_FOCUSED" = "1" ]; then
    # 2026-10-21（用户口径）：占用时目标已在焦点 ≠ 无需归还。旧行为直接 return，
    # 结果是用户仍盯着游戏、而这里打「未改动」。正确语义 = 切回默认屏（firefox）并验证堆叠。
    local out2 rc2 ti2 gi2
    out2=$("$LEASE_BIN" restore --prev-json "" --fallback "$FALLBACK_CLASS" 2>&1); rc2=$?
    ti2=$(json_get "$out2" "d.get('target_index')")
    gi2=$(json_get "$out2" "d.get('game_index')")
    if [ "$rc2" -eq 0 ]; then
      echo "[ys-gui-slot] 占用 $(( $(date +%s) - START ))s｜焦点本就在目标窗 ⇒ 已切回默认屏：$(json_get "$out2" "d.get('restored','')")（idx $ti2 > game $gi2）"
      return
    fi
    echo "[ys-gui-slot] ⚠️ 切回默认屏失败（$FALLBACK_CLASS）：$out2" >&2
    RESTORE_RC=9
    return
  fi
  local out rc ti gi desc
  out=$("$LEASE_BIN" restore --prev-json "$PREV_JSON" --fallback "$FALLBACK_CLASS" 2>&1); rc=$?
  ti=$(json_get "$out" "d.get('target_index')")
  gi=$(json_get "$out" "d.get('game_index')")
  if [ "$rc" -eq 0 ]; then
    desc=$(json_get "$out" "d.get('restored','')")
    echo "[ys-gui-slot] 占用 $(( $(date +%s) - START ))s｜焦点已还原：$desc（idx $ti > game $gi）"
    return
  fi
  echo "[ys-gui-slot] ⚠️ 还原失败（KWin 堆叠验证未通过，重试 3 次；前焦=${PREV_DESC}）：$out" >&2
  RESTORE_RC=9
}
trap restore EXIT INT TERM HUP

# ── 2) 取焦点（KWin activate+raise+验证；不是 xdotool）───────────────────────
if [ "$ALREADY_FOCUSED" != "1" ]; then
  RAISE=$("$LEASE_BIN" kwin-raise --id "$TARGET_ID" 2>/dev/null)
  ROK=$(json_get "$RAISE" "1 if d.get('ok') else 0")
  if [ "${ROK:-0}" != "1" ]; then
    echo "[ys-gui-slot] 焦点核验失败（KWin 未能 activate+raise 目标 $TARGET_DESC）：$RAISE" >&2
    RESTORED=1   # 没改过焦点，不必归还（避免多动一次）
    exit 3
  fi
fi
# 2026-10-21：占用窗口后登记所有权，免得会话闩锁让警卫永远不管这块屏幕。
# hold = 槽位时限：这段时间里警卫不插手，槽位结束后按空闲规则交还。
# 2026-10-23：--prev-json 让"无活动会话"的 claim 自动建立 auto-session（交还目标=槽启动时
# 的真实前台窗）——空闲交还层从此对槽式流程生效（.03/.04 零归还事故的根因正是这层没武装）。
if [ "${YS_SLOT_TEST:-0}" != "1" ] && [ -x "$YS_HOME/ys-session" ]; then
  "$YS_HOME/ys-session" claim --hold-seconds "$MAX" --reason gui-slot --prev-json "$PREV_JSON" >/dev/null 2>&1 || true
fi
echo "[ys-gui-slot] 已取得 $WIN_HEX（$TARGET_DESC）焦点｜时限 ${MAX}s"

# ── 3) 执行（硬时限）→ 显式归还（失败 9）─────────────────────────────────────
timeout --signal=TERM "$MAX" "$@"; CMD_RC=$?
restore
trap - EXIT INT TERM HUP
[ "$RESTORE_RC" != "0" ] && exit "$RESTORE_RC"
exit "$CMD_RC"
