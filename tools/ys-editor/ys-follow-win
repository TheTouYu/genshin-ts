#!/usr/bin/env python3
"""ys-follow-win — 把「当前虚拟桌面」切到目标窗口所在桌面（KWin 权威通道）。

为什么需要（2026-10-20 实测）：
  · 原神窗口在 KWin 的**另一个虚拟桌面**上时，`ys-capture latest` 直接 fail-closed 报
    `OTHER_DESKTOP`（守卫是对的：拿不到可信帧就不给）。旧做法是**回去问用户切桌面** ——
    这是把系统能力缺口转嫁给用户，与 AGI 目标相反。
  · EWMH `_NET_WM_DESKTOP` 在这台机器上**不可信**（报 0 而 KWin 报别的桌面，见 D34），
    所以必须走 KWin Scripting 读 `windowList()[].desktop`。

用法：
  ys-follow-win yuanshen.exe          # 切到该窗口所在桌面（已在则 no-op）
  ys-follow-win yuanshen.exe --dry    # 只报窗口在哪个桌面，不切换

退出码：0 已在该桌面/切换成功｜2 找不到窗口｜3 KWin Scripting 不可用
"""
import os
import json
import subprocess
import sys
import tempfile
import time

TAG_PREFIX = "ys-follow-win"


def _run(cmd, timeout=15):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def _gdbus(method, *args):
    return _run(["gdbus", "call", "--session", "--dest", "org.kde.KWin",
                 "--object-path", "/Scripting",
                 "--method", f"org.kde.kwin.Scripting.{method}", *args])


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    dry = "--dry" in sys.argv
    # 2026-10-21 复盘：真机会话里代理在**没问用户**的情况下 65s 就切走了用户的虚拟桌面，
    # 用户 177s 才发现。切桌面是比点击更重的动作（用户眼前整屏被换掉），必须单独授权。
    if not dry:
        grant_ok = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                                "ys-screen-grant"), "status"],
                                  capture_output=True).returncode == 0
        if not (grant_ok and os.environ.get("YS_ALLOW_DESKTOP_SWITCH") == "1"):
            print(json.dumps({"ok": False, "error": "DESKTOP_SWITCH_NOT_APPROVED",
                              "detail": "切虚拟桌面要单独授权：先向用户申请，并显式设置 "
                                        "YS_ALLOW_DESKTOP_SWITCH=1 再执行；只看不切请加 --dry"},
                             ensure_ascii=False))
            return 7
    if not args:
        print("用法: ys-follow-win <resourceClass> [--dry]", file=sys.stderr)
        return 2
    cls = args[0]

    # KWin 脚本：读窗口桌面并（非 dry 时）切过去；结果用 print 落 journal
    js = f'''
const cls = "{cls}";
const dry = {"true" if dry else "false"};
let wins = [];
try {{ wins = workspace.windowList(); }} catch (e) {{ wins = workspace.clientList(); }}
let target = null;
for (let i = 0; i < wins.length; i++) {{
    const w = wins[i];
    const rc = (w.resourceClass || "").toString();
    if (rc === cls) {{ target = w; break; }}
}}
if (!target) {{ print("FOLLOWWIN notfound"); }}
else {{
    // 2026-10-21 真机实证：X11 窗口 _NET_WM_DESKTOP=3，但 KWin 的 w.desktop 为 null
    // （老 API 语义下 null = "在所有桌面"），旧代码据此打印 already 并**从不切桌面**，
    // 而下游 look 用 attrib 的 cur= 判归属 ⇒ 会话报 success、感知层报 OTHER_DESKTOP，两边打架。
    // 退到 desktops[] 列表取第一个真实桌面；仍判不出就 fail-closed，不再冒充 already。
    let d = target.desktop;
    let src = "desktop";
    if (!d && target.desktops && target.desktops.length > 0) {{ d = target.desktops[0]; src = "desktops[0]"; }}
    const cur = workspace.currentDesktop;
    print("FOLLOWWIN found desktop=" + (d ? d.id : "unknown") + " src=" + src + " current=" + cur.id);
    if (!dry) {{
        if (!d) {{
            print("FOLLOWWIN nodekstop");   // 判不出在哪张桌面：宁可报错，不冒充成功
        }} else if (d.id !== cur.id) {{
            workspace.currentDesktop = d;
            const after = workspace.currentDesktop;
            print("FOLLOWWIN switched to " + d.id + " now=" + after.id + (after.id === d.id ? " verified" : " MISMATCH"));
        }} else {{
            print("FOLLOWWIN already");
        }}
    }}
}}
'''
    fd, path = tempfile.mkstemp(suffix=".js", prefix="ysfollow-")
    with os.fdopen(fd, "w") as f:
        f.write(js)
    tag = f"{TAG_PREFIX}-{int(time.time()*1000)}"
    try:
        r = _gdbus("loadScript", path, tag)
        if r.returncode != 0 or "Error" in (r.stderr or ""):
            print(f"[ys-follow-win] KWin Scripting 不可用：{(r.stderr or '').strip()[:160]}", file=sys.stderr)
            return 3
        _gdbus("start")
        time.sleep(0.6)
        j = _run(["journalctl", "--user", "--since", "5 seconds ago", "--no-pager"], timeout=15)
        lines = [ln for ln in (j.stdout or "").splitlines() if "FOLLOWWIN" in ln]
        for ln in lines:
            print("[ys-follow-win]", ln.split("FOLLOWWIN", 1)[1].strip())
        if any("notfound" in ln for ln in lines):
            return 2
        # fail-closed：判不出桌面（nodekstop）或切换后回读不一致（MISMATCH）都不许返回 0，
        # 否则上游（ys-session）会把"没切"记成"已切"。
        if any("nodekstop" in ln for ln in lines):
            return 8
        if any("MISMATCH" in ln for ln in lines):
            return 9
        # 2026-10-21 事故回灌：抬窗/切桌面**必须登记所有权**。否则会话的 released 闩锁
        # 仍为 True，ys-focus-guard 开头 `if s.get("released"): return 0` ⇒ 没人负责
        # 把屏幕收回，画面会一直停在游戏上（真机实测 21:30:52 切过去后无人交还）。
        try:
            subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                                         "ys-session"),
                            "claim", "--reason", "follow-win"],
                           capture_output=True, timeout=15)
        except Exception:                                    # noqa: BLE001
            pass
        return 0
    finally:
        _gdbus("unloadScript", tag)
        try:
            os.unlink(path)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
