def acquire(name="原神", max_s=30, owner_pid=None):
    t0 = time.time()
    state = kwin_state()
    if state is None:
        return {"ok": False, "error": "KWIN_UNAVAILABLE",
                "hint": "KWin Scripting 不可用——拒绝用 xdotool 猜焦点（fail-closed）"}
    prev = _record(state.get("active_window"))
    # EWMH 回退下 active 可能是"栈顶代理"（Mutter 的 _NET_ACTIVE_WINDOW 恒为幽灵窗 0x200003），
    # 代理不等于真焦点 ⇒ 此时绝不能判 noop，必须真去激活一次（2026-10-26 实测：否则以为已在前台、
    # 实际用户盯着 firefox，后续所有点击都落在 firefox 上）。
    if state.get("active_proxy"):
        prev = None
    # 代理态 = 用户当时在看一个**非 X11 窗口**（本机就是 Wayland 原生的 firefox）。
    # X11 层没有它的地址，但键盘层（Alt+Tab）够得到 ⇒ 记下这个事实，交还时走键盘通道。
    prev_wayland = bool(state.get("active_proxy"))
    # 桥在时能知道那个 Wayland 窗**是谁**（id/wm_class）——交还时就能精确激活它，
    # 而不是 Alt+Tab 盲切。桥不在，这段为空，行为与原来一致。
    _fc = state.get("focused") or {}
    prev_wayland_key = ""
    if prev_wayland and _fc and not _fc.get("x11"):
        prev_wayland_key = str(_fc.get("id") or _fc.get("wm_class") or "")
    if prev_wayland_key:
        prev = {"internalId": "", "caption": (str(_fc.get("title") or "")[:60] or "(Wayland 原生窗)"),
                "class": str(_fc.get("wm_class") or ""), "geom": "", "index": None,
                "usable": True, "wayland_key": prev_wayland_key}
    prev_is_target = bool(prev and GAME_CLASS in (prev.get("class") or "").lower())
    game = _game(state)
    if prev_is_target and game is not None:
        # 目标已在焦点：这是 no-op 租约（2026-10-19 事故：prev==target 的租约永远恢复不了，
        # 守护会无限重试并把用户反复拖回游戏桌面）。记下 noop 标志，release 直接清文件、不做任何窗口操作。
        d = {"win": WIN, "name": name, "prev": None, "prev_is_target": True, "noop": True,
             "prev_wayland": prev_wayland,
             "acquired_at": time.time(), "expires": time.time() + max_s, "max_s": max_s,
             "owner_pid": int(owner_pid or os.getppid()), "version": 2}
        _save(d)
        _lease_log("acquire.noop", win=WIN, reason="target-already-focused")
        return {"ok": True, "noop": True,
                "lease": {"win": WIN, "prev": "(no-op: 目标已在焦点)", "prev_info": None, "max_s": max_s},
                "ms": round((time.time() - t0) * 1000, 1)}
    if prev_is_target:
        prev = None          # acquire 时游戏已在前台但找不到游戏窗：没有"用户窗"可还
    if game is None:
        return {"ok": False, "error": "GAME_NOT_FOUND"}
    want = {"id": game.get("id") or "", "pid": int(game.get("pid") or 0),
            "cls": (game.get("cls") or "").lower(), "c": game.get("c") or "",
            "geom": f"{game.get('x', 0)},{game.get('y', 0)} {game.get('w', 0)}x{game.get('h', 0)}"}
    state2 = _raise_once(want)
    ok, problems, _target = _verify_active(state2, _want_record(want))
    _lease_log("acquire.verify", want=want.get("id"), ok=ok, problems=problems)
    if not ok:
        state2 = _raise_once(want)          # 再试一次（去掉最小化后首次激活偶尔慢一拍）
        ok, problems, _target = _verify_active(state2, _want_record(want))
    if not ok:
        return {"ok": False, "error": "RAISE_NOT_VERIFIED", "problems": problems,
                "detail": "KWin 未能把游戏窗置为 activeWindow（拒绝写租约）"}
    d = {"win": WIN, "name": name,
         "prev": prev, "prev_is_target": prev_is_target, "prev_wayland": prev_wayland,
         "acquired_at": time.time(), "expires": time.time() + max_s,
         "max_s": max_s, "owner_pid": int(owner_pid or os.getppid()), "version": 2}
    _save(d)
    return {"ok": True,
            "lease": {"win": WIN, "prev": _display(prev), "prev_info": prev, "max_s": max_s},
            "ms": round((time.time() - t0) * 1000, 1)}


def _fallback(state, cls=FALLBACK_CLASS):
    return next((w for w in state.get("wins", [])
                 if (w.get("cls") or "").lower() == cls.lower() and not w.get("min")), None)


def _parse_prev(prev_json):
    """--prev-json 字符串 → dict/None（唯一解析：真实 restore 与 --dry-run 共用）。"""
    try:
        return json.loads(prev_json) if (prev_json or "").strip() else None
    except Exception:                                    # noqa: BLE001
        return None


def _resolve_target(state0, prev, fallback_class=FALLBACK_CLASS):
    """**交还目标解析的唯一实现**：`_restore()`（真实路径）与 `restore --dry-run` 共用。

    规则（2026-10-22 用户实测纠错）：授权时记录的用户窗优先；只有记录缺失/窗已消失才回退
    `fallback_class`（缺省 firefox）。**dry-run 绝不能另写一份判据**——否则注入后门禁仍绿、
    真实路径照旧交还 firefox（原理由见账目 F-20261022-77）。
    返回 (want, want_rec, rec, fallback_reason, fallback_win)；找不到回落窗时 want=None。
    """
    fallback_reason = None
    if isinstance(prev, dict):
        rec = prev
    elif isinstance(prev, str) and prev:
        rec = {"internalId": "", "caption": "", "class": "", "geom": "", "index": None,
               "usable": False, "legacy": prev}
        fallback_reason = "LEGACY_PREV"
    else:
        rec = None
        fallback_reason = "NO_PREV"
    want = None
    if rec and rec.get("usable", True) and fallback_reason is None:
        if _pick(state0, rec) is not None:
            want = _selector(rec)
        else:
            fallback_reason = "PREV_GONE"
    fb = None
    if want is None:
        fb = _fallback(state0, fallback_class)
        if fb is not None:
            # KWin 记录里的字段名是 internalId / caption，不是 id / c
            want = {"id": fb.get("internalId") or fb.get("id") or "",
                    "cls": fallback_class.lower(),
                    "c": fb.get("caption") or fb.get("c") or "",
                    "geom": f"{fb.get('x', 0)},{fb.get('y', 0)} {fb.get('w', 0)}x{fb.get('h', 0)}"}
    return want, (_want_record(want) if want else None), rec, fallback_reason, fb


def dry_restore(prev_json, fallback_class=FALLBACK_CLASS):
    """只算不做：回答「这次交还会回到哪个窗」。不 activate / 不 raise / 不碰租约文件。"""
    state0 = kwin_state()
    if state0 is None:
        return {"ok": False, "dry_run": True, "error": "KWIN_UNAVAILABLE"}
    prev = _parse_prev(prev_json)
    want, want_rec, rec, fr, fb = _resolve_target(state0, prev, fallback_class)
    if want is None:
        return {"ok": False, "dry_run": True, "error": "FALLBACK_NOT_FOUND",
                "fallback_reason": fr, "fallback_class": fallback_class}
    return {"ok": True, "dry_run": True,
            "source": "prev" if fr is None else "fallback",
            "fallback_reason": fr,
            "target": {"class": want_rec.get("class") or "",
                       "caption": want_rec.get("caption") or "",
                       "internalId": want_rec.get("internalId") or ""},
            "prev": _display(rec) if rec else "",
            "fallback_class": fallback_class,
            "touched_windows": False}


def _kbd_return(win_id="", tries=3, settle=0.55):
    """把画面交还给 **Wayland 原生窗**：Alt+Tab（键盘层不需要窗口 id）。

    2026-10-26 实测（本机）：firefox 是 Wayland 原生窗，X11 里**没有地址**
    （`_NET_CLIENT_LIST_STACKING` 只有 4 个 X11 客户端：3×beyondeditor + 1×yuanshen），
    `wmctrl -i -a` / `xdotool windowactivate` 都够不到它；但 `Alt+Tab` 由合成器自己处理，
    实测能在「原神(X11) ↔ firefox(Wayland)」之间来回：
        active 0x1000003（原神） → Alt+Tab → 0x200003（幽灵=没有 X11 窗持焦点）+ 指针下变 root。
    验证判据就是这个 `active_proxy=True`（比"画面看起来变了"可靠）。
    前置：目标 X11 窗当前必须是前台 —— 否则会把用户正在看的窗口切走（这条是硬闸门）。
    """
    if not win_id:
        return {"ok": False, "error": "NO_WIN"}
    st0 = _state_ewmh() or {}
    cur = (st0.get("active_window") or {}).get("id")
    if st0.get("active_proxy") or not cur or cur != win_id:
        return {"ok": False, "error": "NOT_FRONT",
                "detail": f"当前 active={cur} proxy={st0.get('active_proxy')}（只在目标窗确为前台时才动键盘）"}
    env = ys_env.env()
    for attempt in range(1, tries + 1):
        try:
            for ev in ("56:1", "15:1", "15:0", "56:0"):   # LeftAlt↓ Tab↓ Tab↑ LeftAlt↑
                subprocess.run(["/usr/bin/ydotool", "key", ev], capture_output=True,
                               timeout=5, env=env)
                time.sleep(0.12)
        except Exception as e:                     # noqa: BLE001
            return {"ok": False, "error": "KBD_ERROR", "detail": f"{type(e).__name__}: {e}"}
        time.sleep(settle)
        st = _state_ewmh() or {}
        actual = st.get("active") or (st.get("active_window") or {}).get("id")
        _lease_log("release.kbd", attempt=attempt, active=actual,
                   proxy=bool(st.get("active_proxy")), ok=bool(st.get("active_proxy")))
        if st.get("active_proxy"):
            return {"ok": True, "via": "alt-tab", "attempts": attempt,
                    "restored": "(Wayland 原生窗；经键盘层 Alt+Tab 交还)",
                    "verify": "active_proxy=True（无任何 X11 窗持焦点）"}
    return {"ok": False, "error": "KBD_RETURN_NOT_VERIFIED", "attempts": tries,
            "detail": "Alt+Tab 后仍有 X11 窗持焦点"}


def _restore(prev, fast=False, fallback_class=FALLBACK_CLASS, recover=False):
    """按 KWin 权威记录归还：activate + raise + 堆叠验证（重试 3 次）。

    prev 可以是旧格式字符串（兼容旧租约）或记录 dict。**不碰租约文件**——
    ys-lease release 与 ys-gui-slot restore 共用这一份验证逻辑。
    """
    state0 = kwin_state()
    if state0 is None:
        return {"ok": False, "error": "KWIN_UNAVAILABLE"}
    # 目标解析只有一处实现（dry-run 与真实路径共用，注入后不会脱钩）
    want, want_rec, rec, fallback_reason, fb = _resolve_target(state0, prev, fallback_class)
    # 2026-10-26：prev 记录可能被污染成游戏自己（会话 begin 在游戏已前台时记录的就是它）。
    # 那种情况下"把游戏抬到游戏之上"必然 STACKING_NOT_RESTORED（真机三次全红就是这么来的）⇒
    # 当"没有用户窗"处理，走键盘层 Alt+Tab / 回退，而不是硬撞三次。
    _g0 = _game(state0)
    if want and _g0 and str(want.get("id") or "").lower() == str(_g0.get("id") or "").lower():
        want, fallback_reason = None, "PREV_IS_GAME"
    if want is None:
        # ① 精确通道：桥（gnome-shell 扩展）可用且知道那个 Wayland 窗是谁 ⇒ 直接激活它。
        _wk = str((prev or {}).get("wayland_key") or "") if isinstance(prev, dict) else ""
        if _wk:
            _act = _ysfocus("activate", _wk)
            if _act.get("available") and _act.get("ok"):
                _fw = (_ysfocus("focused").get("window") or {})
                if _fw and not _fw.get("x11"):
                    _lease_log("release.shell", key=_wk, ok=True,
                               focused=str(_fw.get("title") or "")[:40])
                    return {"ok": True, "noop": False, "via": "shell-activate",
                            "restored": "(Wayland 原生窗；经 gnome-shell 桥精确激活)",
                            "verify": f"focused={_fw.get('wm_class')} x11=False",
                            "attempts": 1, "fallback_reason": fallback_reason,
                            "target_index": None, "game_index": None,
                            "cross_check": "n/a(shell)"}
        # ② 键盘层兜底（Alt+Tab）——不依赖任何身份信息，但只能"回上一个应用"。
        _kr = _kbd_return((_game(state0) or {}).get("id") or "")
        if _kr.get("ok"):
            return {"ok": True, "noop": False, "via": _kr["via"],
                    "restored": _kr["restored"], "verify": _kr["verify"],
                    "attempts": _kr["attempts"], "fallback_reason": fallback_reason,
                    "target_index": None, "game_index": None,
                    "cross_check": "n/a(kbd)"}
        # 2026-10-26（GNOME 回退轮）：本机 firefox 是 **Wayland 原生窗**，不出现在 X11 的
        # _NET_CLIENT_LIST_STACKING 里（本机列表只有 3 个 beyondeditor + 1 个 yuanshen），
        # 而 GNOME Shell 的 Eval 在 41+ 默认被禁用（实测 `gdbus … org.gnome.Shell.Eval` → (false, '')）
        # ⇒ 拿不到 Wayland 窗口，也就永远"找不到回落窗"。
        # 处置：此时"不动任何窗口"就是最安全的结果（比误激活别的窗好）；**保留租约反而更糟**——
        # 屏幕会被租约钉住、guard 回收不了（用户已投诉过"执行完不记得归还画面"）。
        # 语义用 ok+noop 明示"没还，因为没有可还的"，而不是伪装成成功归还。
        return {"ok": True, "noop": True, "fallback_reason": fallback_reason,
                "kbd_return": {k: _kr.get(k) for k in ("error", "detail") if _kr.get(k)},
                "detail": ("无可归还目标（%s；回退窗 %s 不在 X11 客户端列表，通常是 Wayland 原生应用；"
                           "键盘层 Alt+Tab 也没成：%s） ⇒ 未改动任何窗口"
                           % (fallback_reason, fallback_class,
                              _kr.get("error") or _kr.get("detail") or "未知"))}
    if False:
        return {"ok": False, "error": "FALLBACK_NOT_FOUND",
                "fallback_reason": fallback_reason,
                "detail": f"原焦点不可用（{fallback_reason}），且找不到回落窗 {fallback_class}"}

    # 2026-10-21（用户反馈「还是听到操作提示音，但画面没切换」）：
    # 目标**已经是活动窗**时，旧实现仍会 activate+raise 一次 —— 画面看不出变化，
    # 但 KWin 会执行一次窗口激活（用户听到"操作声"）。这里先做一次零操作检查：
    # 已在活动且堆叠合法 ⇒ 直接返回，不碰窗口。
    # kwin_state() 的契约：`active` 是 **internalId 字符串**，完整记录在 `active_window`。
    # （早先按 dict 读，导致「目标已是活动窗」的判定永远为假 ⇒ 每次都多一次 activate/raise）
    _act_raw = state0.get("active")
    _act = state0.get("active_window") or next(
        (w for w in (state0.get("wins") or [])
         if (w.get("internalId") or w.get("id")) == _act_raw), {}) or {}
    _act_id = (_act_raw if isinstance(_act_raw, str) else (_act.get("internalId") or "")).strip()
    _want_id = (want_rec.get("internalId") or "").strip()
    _already = bool(_act_id) and (
        (_want_id and _act_id == _want_id)
        or ((_act.get("class") or "").lower() == (want.get("cls") or "").lower()
            and (not want.get("c") or (_act.get("caption") or "") == want.get("c"))))
    if _already:
        _gi = (_game(state0) or {}).get("i")
        # 窗口记录里堆叠序字段是 `i`（与 _game 一致），不是 `index`
        _ti = _act.get("index", _act.get("i"))
        if _ti is not None and (_gi is None or _ti > _gi):
            return {"ok": True, "noop": True, "attempts": 0,
                    "restored": _display(_record(_act)),
                    "restored_info": _record(_act),
                    "target_index": _ti, "game_index": _gi,
                    "note": "目标已是活动窗且堆叠合法 ⇒ 零窗口操作（不再 activate/raise）"}

    problems = []
    target = game = None
    for attempt in range(1, RETRIES + 1):
        if attempt == 1:
            state = _raise_once(want)
        else:
            # 重试**不再 raise**（失败路径的处理动作比故障本身更扰民时，必须先停手）。
            time.sleep(0.3)
            state = kwin_state()          # 只重读 KWin 状态并验证
        ok, problems, target, game = _verify(state, want_rec)
        cross = None
        if ok and not fast:
            # 独立通道复核（ys-wins --attrib；与账本/自测同一权威读数）
            wstate = ys_wins_state()
            cross = "ok" if wstate is not None else "unavailable(ys-wins 无读数)"
            wok, wproblems, wtarget, wgame = _verify(wstate, want_rec)
            if not wok:
                ok, problems, target, game = False, [f"ys-wins:{p}" for p in wproblems], wtarget, wgame
        if ok:
            if fallback_reason == "PREV_GONE":
                return {"ok": False, "error": "PREV_GONE",
                        "detail": f"原焦点窗已消失（{_display(rec)}）；已回落 {fallback_class} 并验证堆叠",
                        "fallback_verified": True, "attempts": attempt,
                        "restored": _display(_record(target))}
            out = {"ok": True, "attempts": attempt,
                   "restored": _display(_record(target)),
                   "restored_info": _record(target),
                   "game_index": game.get("i") if game else None,
                   "target_index": target.get("i") if target else None}
            if cross:
                out["cross_check"] = cross      # 独立通道复核是否真的跑到了（GNOME 下可能不可用）
            if fallback_reason:
                out["fallback_reason"] = fallback_reason
            return out
        time.sleep(0.2)

    tail = []
    try:
        st = kwin_state()
        if st:
            for w in st.get("wins", [])[-4:]:
                tail.append(f"[{w.get('i')}] {w.get('c') or '(无题)'} | {w.get('cls')}"
                            + (" |ACTIVE" if w.get("active") else ""))
    except Exception:                                    # noqa: BLE001
        pass
    return {"ok": False, "error": "RESTORE_FAILED", "problems": problems,
            "attempts": RETRIES, "stacking_tail": tail,
            "hint": "堆叠验证未通过：焦点/画面不保证已归还"}


def release(force=False, fast=False, discard=False, fallback_class=FALLBACK_CLASS, recover=False):
    d = _load_raw()
    if not d:
        return {"ok": False, "error": "NO_LEASE"}
    if d.get("abandoned"):
        return {"ok": False, "error": "ABANDONED",
                "hint": "守门已放弃这条租约（连续失败 3 次），不再做任何窗口操作"}
    prev = d.get("prev")
    prev_is_game = isinstance(prev, dict) and GAME_CLASS in (prev.get("class") or "").lower()
    # 2026-10-26 修：这一行原来引用未定义变量 `prev_is_target` ⇒ 任何 noop 租约走到 release 都
    # NameError 直接崩（跨桌面都存在，不只是 GNOME）。判据就是分支条件本身。
    prev_is_target = bool(d.get("noop") or d.get("prev_is_target") or prev_is_game)
    if d.get("noop") or d.get("prev_is_target") or prev_is_game:
        # 2026-10-21（用户口径；D424/D428 的补充）：没有"用户窗"可还时**不是什么都不做**。
        # 事故：我拿屏幕时游戏已在焦点 ⇒ noop 租约 ⇒ release 零窗口操作 ⇒ 用户仍盯着游戏，
        # 而回执是 ok:true，我还对外报「屏幕已还」。正确语义 = **主动切回默认屏（firefox）并验证堆叠**。
        _lease_log("release.begin", prev_is_target=prev_is_target, has_prev=False, branch="noop")
        res = _restore(None, fast=fast, fallback_class=fallback_class, recover=recover)
        res["fallback_reason"] = res.get("fallback_reason") or "PREV_IS_TARGET"
        if res.get("ok") or discard:
            _remove()
        res["lease_kept"] = os.path.exists(LEASE)
        _lease_log("release.done", branch="noop", ok=res.get("ok"), noop=res.get("noop"),
                   lease_kept=res.get("lease_kept"), restored=res.get("restored"),
                   fallback_reason=res.get("fallback_reason"),
                   detail=str(res.get("detail"))[:140])
        return res
    if not force and d.get("expires", 0) < time.time():
        return {"ok": False, "error": "EXPIRED",
                "hint": "租约已过期；归还得用 --force（看门狗就是这么做的）"}
    _lease_log("release.begin", prev_is_target=prev_is_target, has_prev=bool(prev))
    res = _restore(prev, fast=fast, fallback_class=fallback_class, recover=recover)
    if res.get("ok") or res.get("error") == "PREV_GONE" or discard:
        _remove()
    res["lease_kept"] = os.path.exists(LEASE)
    _lease_log("release.done", ok=res.get("ok"), error=res.get("error"),
               noop=res.get("noop"), lease_kept=res.get("lease_kept"),
               restored=res.get("restored"), detail=str(res.get("detail"))[:140])
    return res


def restore_prev(prev_json, fast=False, fallback_class=FALLBACK_CLASS, recover=False):
    try:
        prev = json.loads(prev_json) if prev_json.strip() else None
    except Exception:                                    # noqa: BLE001
        return {"ok": False, "error": "BAD_PREV_JSON"}
    return _restore(prev, fast=fast, fallback_class=fallback_class, recover=recover)


def _best_window(cands):
    vis = [w for w in cands if not w.get("min")] or cands
    return sorted(vis, key=lambda w: (w.get("i", 0), (w.get("w") or 0) * (w.get("h") or 0)))[-1]


def _cross_desktop_hint(default_class=GAME_CLASS):
    """扫**所有桌面**的窗口，报告游戏窗在哪张桌面、当前在哪张（kwin-state 只给当前桌面）。

    读 ys-wins --attrib 的文本行（它用的是 windowList()，能跨桌面）：
        [7] 原神 | yuanshen.exe | 0,0 1707x960 | min=0 | ds=3 | cur=2 | idx=8 | act=1
    """
    import subprocess as _sp
    out = {"found": False}
    try:
        here = os.path.dirname(os.path.abspath(__file__))
        r = _sp.run([os.path.join(here, "ys-wins"), "--attrib"], capture_output=True,
                    text=True, timeout=15, env={**os.environ})
        for line in (r.stdout or "").splitlines():
            if default_class.split(".")[0].lower() not in line.lower():
                continue
            d = {}
            for part in line.split("|"):
                for key in ("ds", "cur", "idx", "min"):
                    if part.strip().startswith(key + "="):
                        d[key] = part.split("=", 1)[1].strip()
            out.update({"found": True, "window_desktop": d.get("ds"),
                        "current_desktop": d.get("cur"), "minimized": d.get("min"),
                        "caption": line.split("|")[0].strip()[:40]})
            break
    except Exception:                                    # noqa: BLE001
        pass
    return out


def resolve_window(win_id="", name="", x11_pid=0, geom="", default_class=GAME_CLASS):
    """把调用方给的 X11 窗口线索映射到 KWin 权威窗口。

    为什么不能直接信 `<win>`（2026-10-19 实测）：本机 `0x01400001`/`0x1800001` 在 X11 里是
    **1×1 幽灵窗**（xdotool geometry 1x1），KWin 的真实游戏窗是 Wayland/XWayland 窗
    （caption=原神 / class=yuanshen.exe，pid 与 xdotool getwindowpid 也不一致）。
    解析优先级：KWin pid == x11 pid > caption/class 包含 name > 幽灵窗/已知游戏 id ⇒ 游戏 class。
    """
    state = kwin_state()
    if state is None:
        return {"ok": False, "error": "KWIN_UNAVAILABLE"}
    wins = state.get("wins", [])
    if not wins:
        return {"ok": False, "error": "NO_WINDOWS"}
    try:
        wid = int(str(win_id), 0) if str(win_id).strip() else 0
    except Exception:                                    # noqa: BLE001
        wid = 0
    pid = int(x11_pid or 0)
    if pid > 0:
        cands = [w for w in wins if int(w.get("pid") or 0) == pid]
        if cands:
            return {"ok": True, "reason": "pid", "target": _record(_best_window(cands))}
    nm = (name or "").strip().lower()
    if nm:
        cands = [w for w in wins
                 if nm in (w.get("c") or "").lower() or nm in (w.get("cls") or "").lower()]
        if cands:
            return {"ok": True, "reason": "name", "target": _record(_best_window(cands))}
    phantom = False
    try:
        m = re.match(r"\s*(\d+)\s*[xX]\s*(\d+)", geom or "")
        phantom = bool(m and (int(m.group(1)) <= 1 or int(m.group(2)) <= 1))
    except Exception:                                    # noqa: BLE001
        pass
    if wid in (0x01400001, 20971521, 0x01800001, 25165825) or phantom:  # noqa: phantom-id 幽灵窗识别，不是使用
        cands = [w for w in wins if default_class in (w.get("cls") or "").lower()]
        if cands:
            return {"ok": True, "reason": "game-class", "target": _record(_best_window(cands))}
    # 2026-10-21（F-20261021-61）：kwin-state 只列**当前桌面**的窗口，游戏在别的桌面时这里必然落空。
    # 失败要回答三个问题：它在哪张桌面 / 你在哪张 / 下一步做什么（今天第 3 次撞这个）。
    _xd = _cross_desktop_hint(default_class)
    return {"ok": False, "error": "TARGET_NOT_FOUND",
            "reason": ("目标窗在**另一个虚拟桌面**：KWin 当前桌面窗口表里没有它"
                       if _xd.get("found") else "目标窗在任何桌面都找不到（可能已关闭）"),
            "detail": f"win_id={win_id!r} name={name!r} pid={pid} geom={geom!r}",
            "state": _xd,
            "next_action": ([
                {"step": 1, "tool": "tools/ys-editor/ys-follow-win", "args": ["yuanshen.exe", "--dry"],
                 "why": "先确认它在哪张桌面（只读）"},
                {"step": 2, "tool": "tools/ys-editor/ys-follow-win", "args": ["yuanshen.exe"],
                 "why": "切过去会换掉用户整屏：先向用户申请，再设 YS_ALLOW_DESKTOP_SWITCH=1"},
                {"step": 3, "tool": "(user)", "why": "或请用户手动把窗口拖到当前桌面"},
            ] if _xd.get("found") else [
                {"step": 1, "tool": "tools/ys-editor/ys-wins", "args": ["--attrib"],
                 "why": "列出全部窗口，确认游戏是否还在跑"},
            ])}


def kwin_state_cmd():
    state = kwin_state()
    if state is None:
        return {"ok": False, "error": "KWIN_UNAVAILABLE"}
    act = state.get("active_window")
    return {"ok": True,
            "desktop": state.get("desktop"),
            "source": state.get("source"),
            # 2026-10-26：这条必须透出。幽灵 active 被代理成栈顶窗时，调用方（ys-gui-slot）
            # 靠它区分"真的在焦点"与"其实没有 X11 窗持焦点"；不透出 ⇒ 槽误判"已在焦点"⇒ 从不抬窗。
            "active_proxy": bool(state.get("active_proxy")),
            "focused": state.get("focused"),      # 桥可用时=真前台窗（含 Wayland 原生窗）
            "active": _record(act),
            "wins": [dict(_record(w), active=(w.get("id") == (act or {}).get("id")))
                     for w in state.get("wins", [])]}


def _verify_active(state, rec):
    """只验证 active == 目标（raise 目标用；不要求它在游戏之上）。"""
    if state is None:
        return False, ["KWIN_UNAVAILABLE"], None
    fw = state.get("focused")
    if fw is not None:
        # 桥在：直接问 mutter"谁在前台"（含 Wayland 原生窗），比 X11 代理态精确得多。
        t = _pick(state, rec)
        if not fw:
            return False, ["SHELL_FOCUS_NONE(桥说没有前台窗)"], t
        if t is None:
            return False, ["TARGET_NOT_FOUND"], None
        if not fw.get("x11"):
            return False, [f"SHELL_FOCUS_WAYLAND({fw.get('wm_class')})"], t
        fwid = "0x%x" % int(fw["id"]) if str(fw.get("id", "")).isdigit() else str(fw.get("id"))
        if fwid != str(t.get("id")):
            return False, [f"SHELL_FOCUS_MISMATCH(active={fwid})"], t
        return True, [], t
    if state.get("active_proxy"):
        # 幽灵 active 被代理成栈顶窗时，"active==目标"只说明目标在最上面，不能证明焦点真的过去了
        return False, ["ACTIVE_IS_PROXY(无法证明焦点落到目标)"], _pick(state, rec)
    target = _pick(state, rec)
    active = state.get("active_window")
    if active is None:
        return False, ["NO_ACTIVE"], target
    if target is None or active.get("i") != target.get("i"):
        return False, [f"ACTIVE_MISMATCH(active={_display(_record(active))})"], target
    return True, [], target


def kwin_raise_cmd(caption="", cls="", internal_id="", pid=0):
    selector = {"id": internal_id, "pid": int(pid or 0), "cls": (cls or "").lower(), "c": caption, "geom": ""}
    want_rec = _want_record(selector)
    problems = []
    state = None
    for _ in range(2):
        state = _raise_once(selector)
        ok, problems, target = _verify_active(state, want_rec)
        if ok:
            return {"ok": True, "active": _display(_record(target)),
                    "target_index": target.get("i")}
        time.sleep(0.2)
    return {"ok": False, "error": "RAISE_NOT_VERIFIED", "problems": problems,
            "active": _display(_record(state.get("active_window"))) if state else "none"}


def status():
    d = _load_valid()
    if not d:
        return {"ok": False, "active": False}
    state = kwin_state()
    if state is None:
        return {"ok": False, "active": False, "error": "KWIN_UNAVAILABLE"}
    active = state.get("active_window")
    game = _game(state)
    prev = d.get("prev")
    return {"ok": True, "active": True,
            "expires_in": round(d["expires"] - time.time(), 1),
            "target_focused": bool(active and game and active.get("id") == game.get("id")),
            "desktop": state.get("desktop"),
            "active_window": _display(_record(active)),
            "game_index": game.get("i") if game else None,
            "prev": _display(prev) if isinstance(prev, dict) else str(prev),
            "owner_pid": d.get("owner_pid")}


def run_in_lease(spec):
    if not spec:
        return {"ok": False, "error": "NO_SPEC"}
    d = _load_valid()
    made = False
    if not d:
        a = acquire(max_s=30, owner_pid=os.getpid())   # run 期间持有者是本进程：死了看门狗能立刻回收
        if not a.get("ok"):
            return a
        made = True
    env = dict(os.environ, YS_SLOT_ACTIVE="1")           # 免 shim 拦截（租约已保证焦点）
    t0 = time.time()
    p = _run(spec, timeout=60)
    out = {"ok": p.returncode == 0, "rc": p.returncode, "ms": round((time.time() - t0) * 1000, 1),
           "stdout": (p.stdout or "")[-400:], "stderr": (p.stderr or "")[-400:]}
    if made:
        rel = release(force=True)   # run 自己持有：命令跑过 timebox 也要强制归还并验证
        out["released"] = rel
        if not rel.get("ok"):
            out["ok"] = False
    return out


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    a1 = sub.add_parser("acquire")
    a1.add_argument("--win", default="原神")
    a1.add_argument("--max", type=int, default=30)
    a1.add_argument("--owner-pid", type=int, default=None,
                    help="租约归属进程（默认父进程；看门狗会回收已死归属者的租约）")
    sub.add_parser("status")
    a3 = sub.add_parser("release")
    a3.add_argument("--force", action="store_true", help="过期租约也归还（看门狗用）")
    a3.add_argument("--fast", action="store_true", help="跳过 ys-wins 独立复核（看门狗用，仍做 KWin 堆叠验证）")
    a3.add_argument("--discard", action="store_true", help="验证失败也删租约（清理用）")
    a3.add_argument("--fallback", default=FALLBACK_CLASS, help="原焦点不可用时的回落窗 class")
    a3.add_argument("--recover", action="store_true", help="最后失败时最小化独占全屏游戏再归还（看门狗用）")
    a4 = sub.add_parser("run")
    a4.add_argument("spec", nargs=argparse.REMAINDER)
    sub.add_parser("kwin-state", help="KWin 权威状态（active + 堆叠序），ys-gui-slot 用")
    a7 = sub.add_parser("resolve-window", help="把 X11 窗口线索映射到 KWin 窗口（幽灵窗免疫）")
    a7.add_argument("--id", default="")
    a7.add_argument("--name", default="")
    a7.add_argument("--pid", type=int, default=0)
    a7.add_argument("--cls", default=GAME_CLASS,
                    help="目标窗口 class（默认游戏）；负例用不存在 class 验证失败路径")
    a7.add_argument("--geom", default="")
    a7.add_argument("--class", dest="cls", default=GAME_CLASS)
    a5 = sub.add_parser("kwin-raise", help="按 id/class/caption activate+raise+验证，ys-gui-slot 用")
    a5.add_argument("--id", default="")
    a5.add_argument("--class", dest="cls", default="")
    a5.add_argument("--caption", default="")
    a5.add_argument("--pid", type=int, default=0)
    a6 = sub.add_parser("restore", help="按已记录的 prev JSON 归还（ys-gui-slot trap 用）")
    a6.add_argument("--prev-json", required=True)
    a6.add_argument("--dry-run", action="store_true", help="只算不做：只回答会回到哪个窗")
    a6.add_argument("--fast", action="store_true")
    a6.add_argument("--fallback", default=FALLBACK_CLASS)
    a6.add_argument("--recover", action="store_true")
    a = ap.parse_args()
    if a.cmd == "acquire":
        res = acquire(a.win, a.max, a.owner_pid)
    elif a.cmd == "status":
        res = status()
    elif a.cmd == "release":
        res = release(force=a.force, fast=a.fast, discard=a.discard, fallback_class=a.fallback, recover=a.recover)
    elif a.cmd == "kwin-state":
        res = kwin_state_cmd()
    elif a.cmd == "resolve-window":
        res = resolve_window(win_id=a.id, name=a.name, x11_pid=a.pid, geom=a.geom, default_class=a.cls)
    elif a.cmd == "kwin-raise":
        res = kwin_raise_cmd(caption=a.caption, cls=a.cls, internal_id=a.id, pid=a.pid)
    elif a.cmd == "restore":
        if a.dry_run:
            res = dry_restore(a.prev_json, fallback_class=a.fallback)
        else:
            res = restore_prev(a.prev_json, fast=a.fast, fallback_class=a.fallback,
                               recover=a.recover)
    else:
        spec = a.spec[1:] if a.spec and a.spec[0] == "--" else a.spec
        res = run_in_lease(spec)
    print(json.dumps(res, ensure_ascii=False))
    return 0 if res.get("ok") else 1


