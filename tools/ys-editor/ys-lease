def _load_raw():
    try:
        with open(LEASE, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:                                    # noqa: BLE001
        return None


def _load_valid():
    d = _load_raw()
    if not d:
        return None
    if d.get("expires", 0) < time.time():
        return None
    return d


def _save(d):
    tmp = f"{LEASE}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False)
    os.chmod(tmp, 0o600)
    os.replace(tmp, LEASE)


def _remove():
    try:
        os.remove(LEASE)
    except Exception:                                    # noqa: BLE001
        pass


