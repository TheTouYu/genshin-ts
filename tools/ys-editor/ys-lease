#!/usr/bin/env python3
"""ys-lease — 焦点租约（focus lease）：**一次取焦点，期间所有动作零槽位开销**。

为什么（2026-10-19 标准复核）：
  每次 ys-gui-slot 要 1.38–2.31s（取焦点+核验+还原）。AGI 的操作要被重复 1e4 次，
  按单次 2s 算就是 5.5 小时纯开销。租约把这份成本摊成「一次 ~1s + 每个动作 ~50ms」。

**2026-10-19 重做（用户投诉：租约释放后画面没还给我）**：
  旧实现有三个底层缺陷，各自都能单独造成「焦点回去了、画面没回去」：
    1. 记录原焦点用 `xdotool getactivewindow` —— 本机 KWin/Wayland 下返回 0x200000（1×1 幽灵窗），
       于是每次 release 都在“恢复”一个不存在的窗；
    2. 归还只做 `windowactivate`，不做 `raiseWindow`，也不验证堆叠 —— 焦点回到 Firefox 但它被原神压着；
    3. 归还失败仍退出 0（`{"ok": false, "restored": "…"}` 被调用方忽略）。
  现在：
    · **记录/校验一律走 KWin 权威通道**：`stackingOrder` + `activeWindow`（与 `ys-wins` 同源）；
      窗口身份用 KWin `internalId`（标题会变、id 不会）；
    · **归还 = activate + raise + 验证**：`activeWindow == prev` **且** `idx(prev) > idx(目标游戏)`；
    · 验证不过 → 重试（默认 3 次）→ 仍不过则**非零退出**并打印“谁还压在上面”（堆叠尾部）；
    · 原焦点是面板/1×1 幽灵窗/无名窗时回落 firefox，**回落同样要过堆叠验证**；
    · 归还失败**保留租约**（除非 `--discard`），让 ys-focus-guard 下一轮继续回收。

契约（安全边界，不可放宽）：
  · 租约必须记录「原焦点」并在 release 时精确还原 + 验证；
  · 租约有时限（默认 30s，上限 `--max`，与项目"单次占用 ≤30s"一致）；
  · 每次动作前 `ensure()` 校验：窗户还在最上层、租约未过期；任一不成立 → 拒执行（fail-closed）；
  · 进程退出/异常 → 由调用方 `release`；看门狗在 status 时发现过期会提示可回收。

用法：
  ys-lease acquire --win yuanshen --max 30 [--owner-pid $$]   # 取租约（记录 KWin 原焦点 + 核验游戏置顶）
  ys-lease status                                             # 是否有效 + 游戏是否 ACTIVE
  ys-lease release [--force] [--fast] [--discard]             # activate+raise+验证；失败非零退出
  ys-lease run -- cmd...                                      # 在租约内跑命令（无租约则临时取一次，跑完释放）

退出码：
  acquire  0=已取并核验 / 1=失败（KWin 不可用、置顶核验失败）
  release  0=已归还且堆叠验证通过 / 1=没归还（含 NO_LEASE / EXPIRED / PREV_GONE / RESTORE_FAILED）
  run      0=命令成功**且**归还验证通过 / 1=其余
  status   0=租约有效 / 1=无有效租约

环境变量（测试/注入用）：
  YS_LEASE  租约文件路径（默认 /tmp/ys-lease.json）
  YS_WINS   ys-wins 路径覆盖（默认同目录）
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import ys_env  # noqa: E402  —— X 会话环境唯一入口；xdotool 子进程必须带它（门禁 env-single-source）
RAISE = os.path.join(HERE, "ys-kwin-raise")

# ── 可观测性（2026-10-26 用户要求："窗口适配完成了也没加日志，连自己出问题了都不知道"）
# 每次 raise / acquire / release 决策都落一行 JSON 到 ~/.ys/ys-lease.log。
# 关：YS_LEASE_LOG=0；改路径：YS_LEASE_LOG_PATH=/path
LEASE_LOG = os.environ.get("YS_LEASE_LOG_PATH") or os.path.expanduser("~/.ys/ys-lease.log")


def _lease_log(evt, **kw):
    if os.environ.get("YS_LEASE_LOG") == "0":
        return
    try:
        d = os.path.dirname(LEASE_LOG)
        if d:
            os.makedirs(d, exist_ok=True)
        rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "pid": os.getpid(), "evt": evt}
        rec.update(kw)
        with open(LEASE_LOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception:                                    # noqa: BLE001
        pass
# 测试缝（2026-10-21，F-20261021-55）：「目标已是活动窗 ⇒ 零窗口操作」这条判据原本无法离线判定——
# 回执里的 attempts 要真跑一次 KWin 才看得见，而真跑就会动用户屏幕。
# 下面两个缝只在显式设置时生效，生产路径永远走真 KWin。
KWIN_FIXTURE = os.environ.get("YS_KWIN_JS_FIXTURE") or ""   # {"probe": {...}, "raise": {...}}
RAISE_LOG = os.environ.get("YS_RAISE_LOG") or ""             # 每次真 raise 追加一行
WINS = os.environ.get("YS_WINS") or os.path.join(HERE, "ys-wins")
LEASE = os.environ.get("YS_LEASE") or "/tmp/ys-lease.json"
WIN = os.environ.get("YS_WIN") or ""            # 由 resolve-window 按 class 解析；禁止写死窗 id
GAME_CLASS = "yuanshen"
FALLBACK_CLASS = "firefox"
UNUSABLE_CLASSES = {"plasmashell", "kwin_wayland", "ksmserver", "ksplashqml"}
RETRIES = 3


# ── KWin 权威通道 ───────────────────────────────────────────────────────────

def _run(cmd, timeout=20):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def _kwin_js(js_fn, tag_prefix, timeout=2.0):
    """跑一段 KWin 脚本，返回它 console.info 出来的那一行（去掉 "YS-FOCUS-<tag> " 前缀）。

    js_fn(tag) 必须返回打印 `YS-FOCUS-<tag> <payload>` 的脚本正文。
    """
    if KWIN_FIXTURE and os.path.isfile(KWIN_FIXTURE):
        try:
            fx = json.load(open(KWIN_FIXTURE, encoding="utf-8"))
            if isinstance(fx, dict) and tag_prefix in fx:
                v = fx[tag_prefix]
                return v if isinstance(v, str) else json.dumps(v)
        except Exception:                        # noqa: BLE001 —— 缝坏了就走真通道
            pass
    tag = f"{tag_prefix}{os.getpid()}{int(time.time() * 1000) % 100000}"
    path = os.path.join(HERE, f".ys-focus-{tag}.js")
    marker = f"YS-FOCUS-{tag} "
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(js_fn(tag))
        _run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path",
              "/Scripting", "--method", "org.kde.kwin.Scripting.loadScript", path, tag], timeout=5)
        _run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path",
              "/Scripting", "--method", "org.kde.kwin.Scripting.start"], timeout=5)
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                j = _run(["journalctl", "--user", "--since", "3 seconds ago", "--no-pager"], timeout=5)
                for line in (j.stdout or "").splitlines():
                    pos = line.find(marker)
                    if pos >= 0:
                        return line[pos + len(marker):].strip()
            except Exception:                            # noqa: BLE001
                pass
            time.sleep(0.05)
        return None
    finally:
        try:
            _run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path",
                  "/Scripting", "--method", "org.kde.kwin.Scripting.unloadScript", tag], timeout=5)
        except Exception:                                # noqa: BLE001
            pass
        try:
            os.remove(path)
        except Exception:                                # noqa: BLE001
            pass


_PROBE_BODY = """
var ord = workspace.stackingOrder, act = workspace.activeWindow, out = [];
for (var i = 0; i < ord.length; i++) {
  var w = ord[i], g = w.frameGeometry;
  out.push({ i: i, id: String(w.internalId || ""), pid: w.pid || 0, c: String(w.caption || ""),
    cls: String(w.resourceClass || ""), x: Math.round(g.x), y: Math.round(g.y),
    w: Math.round(g.width), h: Math.round(g.height),
    min: w.minimized ? 1 : 0, active: w === act ? 1 : 0 });
}
var cd = workspace.currentDesktop;
var cdn = (cd && typeof cd.x11DesktopNumber !== "undefined") ? cd.x11DesktopNumber
        : (typeof cd === "number" ? cd : -1);
console.info("MARK " + JSON.stringify({ active: act ? String(act.internalId || "") : null,
  desktop: cdn, wins: out }));
"""


FOCUS_BIN = os.environ.get("YS_FOCUS_BIN") or os.path.join(HERE, "ys-focus")


def _ysfocus(method, *args, timeout=8):
    """问 gnome-shell 扩展（ys-focus@local）：窗口表 / 焦点 / 精确激活。

    **可选增强**：桥不在（GNOME 51 要重登才扫描新扩展，或别的桌面）时返回
    {"available": False}，调用方必须退回 X11/EWMH 路径——模型不需要知道当前有没有桥。
    """
    try:
        r = subprocess.run([FOCUS_BIN, method, *args], capture_output=True,
                           text=True, timeout=timeout, env=ys_env.env())
        out = (r.stdout or "").strip().splitlines()
        d = json.loads(out[-1]) if out else {}
        d.setdefault("available", False)
        return d
    except Exception as e:                                # noqa: BLE001
        return {"available": False, "error": f"{type(e).__name__}: {e}"}


def _sync_focus(state):
    """用桥纠正"谁是前台"：X11 侧拿不到 Wayland 焦点，只有 mutter 知道。

    桥可用时：X11 窗在前台 ⇒ active 用真值、proxy=False；Wayland 窗在前台 ⇒
    active=None、proxy=True，但把 focused 记下来（交还时按它精确激活）。
    """
    got = _ysfocus("focused")
    if not got.get("available"):
        return state
    w = got.get("window") or None
    state["focused"] = w
    state["source"] = (state.get("source") or "") + "+shell"
    if w is None:
        return state
    if w.get("x11"):
        wid = "0x%x" % int(w["id"]) if str(w.get("id", "")).isdigit() else str(w.get("id"))
        match = next((r for r in state.get("wins", []) if r.get("id") == wid), None)
        if match is not None:
            state["active"] = wid
            state["active_proxy"] = False
            state["active_window"] = match
            for r in state.get("wins", []):
                r["active"] = 1 if r.get("id") == wid else 0
    else:
        # Wayland 原生窗在前台：X11 里没有它 ⇒ 不能把"栈顶 X11 窗"当焦点
        state["active"] = None
        state["active_proxy"] = True
        state["active_window"] = None
        for r in state.get("wins", []):
            r["active"] = 0
    return state


def _state_ewmh(timeout=5.0):
    """EWMH 回退通道（2026-10-26 新增）：GNOME/Mutter 或任何支持 _NET_CLIENT_LIST_STACKING 的 WM。

    背景：本机桌面换成 GNOME（gnome-shell + mutter-x11-frame）后 KWin Scripting 不存在，
    kwin_state() 恒返回 None ⇒ ys-lease / ys-gui-slot 全部 fail-closed（KWIN_UNAVAILABLE），
    而 dsh-guard 的 L1-FOCUS 规则又强制必须走它们 ⇒ 死锁。

    返回与 kwin_state() 同结构：{active, desktop, wins:[{i,id,c,cls,x,y,w,h,min,active}], active_window}
    读数来源（三条都是 EWMH 标准，GNOME 全支持）：
      - 堆叠序 : xprop -root _NET_CLIENT_LIST_STACKING（底→顶）
      - 几何/类: wmctrl -lGx（一行全拿，不逐窗起进程）
      - 活动窗 : xprop -root _NET_ACTIVE_WINDOW（xdotool getactivewindow 在 Mutter 下会给幽灵窗 0x200003）
    """
    import subprocess as sp

    def q(args, t=timeout):
        try:
            r = sp.run(args, capture_output=True, text=True, timeout=t, env=ys_env.env())
            return r.stdout if r.returncode == 0 else ""
        except Exception:                                # noqa: BLE001
            return ""

    ids = []
    raw_stack = q(["xprop", "-root", "_NET_CLIENT_LIST_STACKING"])
    # 注意格式差异：xprop 对 _NET_CLIENT_LIST_STACKING 输出 "…(WINDOW): window id # 0x…, 0x…"
    # （冒号 + #，**没有等号**）；早先按 "=" 切分会得到空列表 ⇒ 整个回退恒 None。
    m_stack = re.search(r"window id #(.*)$", raw_stack, re.M)
    if m_stack:
        ids = [x.lower() for x in re.findall(r"0x[0-9a-fA-F]+", m_stack.group(1))]
    elif "=" in raw_stack:
        ids = [x.lower() for x in re.findall(r"0x[0-9a-fA-F]+", raw_stack.split("=", 1)[1])]
    if not ids:
        return None

    geo = {}
    # 不用 wmctrl（在本机被 ys-shim 拦，rc=77）；xdotool getwindowgeometry 可用且不经 shim
    for wid in ids:
        out = q(["xdotool", "getwindowgeometry", wid])
        pm = re.search(r"Position:\s*(-?\d+),(-?\d+)", out)
        gm = re.search(r"Geometry:\s*(\d+)x(\d+)", out)
        if not pm or not gm:
            continue
        cl = q(["xprop", "-id", wid, "WM_CLASS"])
        cm = re.findall(r'"([^"]*)"', cl)
        # caption 必须抓：ys-gui-slot / _resolve_target 按 caption/class 解析目标窗，
        # 留空会让 TARGET_UNRESOLVED（2026-10-26 实测：候选已找到但匹配不上）
        nm = q(["xprop", "-id", wid, "_NET_WM_NAME"])
        nm2 = q(["xprop", "-id", wid, "WM_NAME"])
        cap = ""
        for raw_nm in (nm, nm2):
            m_nm = re.search(r'=\s*"([^"]*)"', raw_nm)
            if m_nm and m_nm.group(1):
                cap = m_nm.group(1)
                break
        geo[wid] = {"x": int(pm.group(1)), "y": int(pm.group(2)),
                    "w": int(gm.group(1)), "h": int(gm.group(2)),
                    "cls": (cm[1] if len(cm) > 1 else (cm[0] if cm else "")),
                    "c": cap}

    act = None
    raw_act = q(["xprop", "-root", "_NET_ACTIVE_WINDOW"])
    m_act = re.search(r"window id #\s*(0x[0-9a-fA-F]+)", raw_act)
    if m_act:
        act = m_act.group(1).lower()
    elif "=" in raw_act:
        m2 = re.search(r"0x[0-9a-fA-F]+", raw_act.split("=", 1)[1])
        act = m2.group(0).lower() if m2 else None

    if act and act not in ids:
        act = ids[-1] if ids else None        # Mutter 下 _NET_ACTIVE_WINDOW 可能是幽灵窗 0x200003
        proxy = True
    else:
        proxy = False
    wins = []
    for i, wid in enumerate(ids):
        g = geo.get(wid)
        if not g:
            continue
        # 2026-10-26：这三项原先是**常量**（min=0 / 无 pid）或恒 -1（desktop），
        # 于是"最小化窗被当成可见""按 pid 匹配的分支永不命中""桌面判据恒真/恒假"
        # （队友在 ys-session 里踩到过：每次 begin 白跑一趟切桌面）。
        # 一次 xprop 全量读回，别逐属性起进程。实测 mutter 最小化会置 _NET_WM_STATE_HIDDEN。
        allp = q(["xprop", "-id", wid])
        mn = 1 if "_NET_WM_STATE_HIDDEN" in allp else 0
        mds = re.search(r"_NET_WM_DESKTOP\(CARDINAL\) = (\d+)", allp)
        mpid = re.search(r"_NET_WM_PID\(CARDINAL\) = (\d+)", allp)
        wins.append({"i": i, "id": wid, "c": g["c"], "cls": g["cls"],
                     "x": g["x"], "y": g["y"], "w": g["w"], "h": g["h"],
                     "min": mn, "pid": int(mpid.group(1)) if mpid else 0,
                     "ds": int(mds.group(1)) if mds else None,
                     "active": 1 if wid == act else 0})
    if not wins:
        return None
    mcur = re.search(r"= (\d+)", q(["xprop", "-root", "_NET_CURRENT_DESKTOP"]))
    state = {"active": act, "desktop": int(mcur.group(1)) if mcur else -1,
             "wins": wins, "source": "ewmh", "active_proxy": proxy}
    state["active_window"] = next((w for w in wins if w["id"] == act), None)
    return _sync_focus(state)      # 桥在就用 mutter 的真值纠正（Wayland 前台也认得出来）


def kwin_state(timeout=2.0):
    """KWin stackingOrder + activeWindow（权威；与 ys-wins 同源）。"""
    raw = _kwin_js(lambda tag: _PROBE_BODY.replace("MARK", f"YS-FOCUS-{tag}"), "probe", timeout)
    if not raw:
        return _state_ewmh()          # GNOME/Mutter 回退（无 KWin Scripting 时）
    try:
        state = json.loads(raw)
    except Exception:                                    # noqa: BLE001
        return _state_ewmh()          # KWin 返回非 JSON（或脚本未装载）⇒ 回退 EWMH
    act = state.get("active")
    # 窗口记录的键是 internalId（不是 id）——写错会让 active_window 恒为 None，
    # 于是所有"目标是否已是活动窗"的判定全部失真（2026-10-21 用户听到多余操作音的根因）。
    state["active_window"] = next(
        (w for w in state.get("wins", [])
         if (w.get("internalId") or w.get("id")) == act), None)
    return state


def ys_wins_state(timeout=20):
    """用 ys-wins --attrib 读同一份权威状态（独立通道，自测/账本用）。"""
    try:
        r = _run([WINS, "--attrib"], timeout=timeout)
    except Exception:                                    # noqa: BLE001
        return None
    wins = []
    for line in (r.stdout or "").splitlines():
        m = re.match(r"\s*\[(\d+)\]\s+(.*)$", line)
        if not m:
            continue
        parts = m.group(2).split(" | ")
        if len(parts) < 3:
            continue
        caption, cls, geom = parts[0], parts[1], parts[2]
        rest = " | ".join(parts[3:])
        idxm = re.search(r"idx=(\d+)", rest)
        wins.append({
            "i": int(idxm.group(1)) if idxm else int(m.group(1)),
            "c": caption,
            "cls": cls,
            "geom": geom,
            "min": 1 if "min=1" in rest else 0,
            "active": 1 if ("ACTIVE" in rest or re.search(r"act=1", rest)) else 0,
        })
    if not wins:
        return None
    active = next((w for w in wins if w.get("active")), None)
    return {"wins": wins, "active_window": active}


# ── 窗口身份 / 匹配 / 验证 ──────────────────────────────────────────────────

def _is_unusable(w):
    if not w:
        return True
    cls = str(w.get("cls") or w.get("class") or "").lower()
    if cls in UNUSABLE_CLASSES:
        return True
    try:
        if w.get("w") is not None and int(w.get("w")) <= 4:
            return True
        if w.get("h") is not None and int(w.get("h")) <= 4:
            return True
    except Exception:                                    # noqa: BLE001
        pass
    return False


def _record(w):
    """KWin 状态里的窗口 → 可持久化的身份记录。"""
    if not w:
        return None
    geom = w.get("geom")
    if not geom:
        geom = f"{w.get('x', 0)},{w.get('y', 0)} {w.get('w', 0)}x{w.get('h', 0)}"
    return {
        "internalId": w.get("id") or w.get("internalId") or "",
        "pid": int(w.get("pid") or 0),
        "caption": w.get("c") or w.get("caption") or "",
        "class": w.get("cls") or w.get("class") or "",
        "geom": geom,
        "index": w.get("i", w.get("index")),
        # 2026-10-26：最小化/桌面也要透出（原先只有 index/usable，调用方拿不到"这窗是不是隐藏的"）
        "min": int(w.get("min") or 0),
        "desktop": w.get("ds", w.get("desktop")),
        "usable": not _is_unusable(w),
    }


def _display(rec):
    if not rec:
        return "none"
    cls = rec.get("class") or rec.get("cls") or "?"
    cap = rec.get("caption") or rec.get("c") or "(无题)"
    return f"{cap[:40]} [{cls}]"


def _pick(state, rec):
    """在权威状态里找 rec 对应的窗口；找不到返回 None。"""
    if not rec or state is None:
        return None
    wins = state.get("wins", [])
    exact = [w for w in wins if rec.get("internalId") and w.get("id") == rec["internalId"]]
    if exact:
        return exact[0]
    pid = int(rec.get("pid") or 0)
    if pid > 0:
        by_pid = [w for w in wins if int(w.get("pid") or 0) == pid and not w.get("min")]
        if by_pid:
            return by_pid[-1]
    cls = (rec.get("class") or "").lower()
    if not cls:
        return None
    cands = [w for w in wins if (w.get("cls") or "").lower() == cls and not w.get("min")]
    if not cands:
        cands = [w for w in wins if (w.get("cls") or "").lower() == cls]
    if not cands:
        return None
    cap = rec.get("caption") or ""
    same_cap = [w for w in cands if cap and w.get("c") == cap]
    if same_cap:
        return same_cap[-1]
    geom = rec.get("geom") or ""
    same_geom = [w for w in cands
                 if geom and f"{w.get('x', 0)},{w.get('y', 0)} {w.get('w', 0)}x{w.get('h', 0)}" == geom]
    if same_geom:
        return same_geom[-1]
    return cands[-1]


def _game(state):
    return next((w for w in state.get("wins", []) if GAME_CLASS in (w.get("cls") or "").lower()), None)


def _fallback(state):
    return next((w for w in state.get("wins", [])
                 if (w.get("cls") or "").lower() == FALLBACK_CLASS and not w.get("min")), None)


def _verify(state, rec):
    """验证：active 是 rec 对应窗，且它的堆叠序高于游戏。返回 (ok, problems, target, game)。"""
    if state is None:
        return False, ["KWIN_UNAVAILABLE"], None, None
    target = _pick(state, rec)
    game = _game(state)
    active = state.get("active_window")
    problems = []
    fw = state.get("focused")
    if fw is not None:
        target = _pick(state, rec)
        game = _game(state)
        problems = []
        wid = ("0x%x" % int(fw["id"])) if str(fw.get("id", "")).isdigit() else str(fw.get("id"))
        if fw and fw.get("x11") and target is not None and wid == str(target.get("id")):
            if game is not None and (target.get("i") or 0) <= (game.get("i") or 0):
                problems.append(f"STACKING_NOT_RESTORED(target_idx={target.get('i')} game_idx={game.get('i')})")
        else:
            problems.append(f"SHELL_FOCUS_NOT_TARGET(focused={fw.get('wm_class') if fw else None})")
        return (not problems), problems, target, game
    if state.get("active_proxy"):
        # EWMH 回退时，幽灵 active（Mutter 的 0x200003 焦点代理窗）会被代理成**栈顶窗**。
        # 于是「active == 目标」在代理态下只证明"目标此刻在最上面"，**不证明**任何激活动作发生过
        # （旧实现据此报告抬窗成功，而真正抬窗的 xdotool 调用被 shim 拦掉了 —— 自证陷阱）。
        problems.append("ACTIVE_IS_PROXY(无法证明焦点落到目标)")
    same = False
    if active is not None and target is not None:
        if active.get("i") is not None and target.get("i") is not None:
            same = active.get("i") == target.get("i")      # probe 与 ys-wins 都有堆叠序
        else:
            same = active.get("id") == target.get("id")
    if active is None:
        problems.append("NO_ACTIVE")
    elif not same:
        problems.append(f"ACTIVE_MISMATCH(active={_display(_record(active))})")
    if game is None:
        problems.append("GAME_NOT_FOUND")
    elif target is None:
        problems.append("TARGET_NOT_FOUND")
    elif target.get("i", 0) <= game.get("i", 0):
        problems.append(f"STACKING_NOT_RESTORED(target_idx={target.get('i')} game_idx={game.get('i')})")
    return (not problems), problems, target, game


_RAISE_BODY = """
var want = WANT_JSON, minGame = MIN_GAME;
var ord = workspace.stackingOrder;
function clsOf(w) { return String(w.resourceClass || "").toLowerCase(); }
function capOf(w) { return String(w.caption || ""); }
function geomOf(w) { var g = w.frameGeometry; return Math.round(g.x)+","+Math.round(g.y)+" "+Math.round(g.width)+"x"+Math.round(g.height); }
var cands = [], i, w;
if (minGame) {
  for (i = 0; i < ord.length; i++) {
    if (String(ord[i].resourceClass || "").toLowerCase().indexOf("yuanshen") >= 0) {
      try { ord[i].fullScreen = false; } catch (e) {}
      try { ord[i].minimized = true; } catch (e) {}
    }
  }
}
for (i = 0; i < ord.length; i++) {
  w = ord[i];
  if (want.id && String(w.internalId || "") === want.id) { cands = [w]; break; }
}
if (!cands.length && want.pid) {
  for (i = 0; i < ord.length; i++) { if ((ord[i].pid || 0) === want.pid) cands.push(ord[i]); }
  if (cands.length > 1) {
    var vis = [];
    for (i = 0; i < cands.length; i++) { if (!cands[i].minimized) vis.push(cands[i]); }
    if (vis.length) { t = vis[vis.length - 1]; cands = [t]; t = null; }
  }
}
if (!cands.length && want.cls) {
  for (i = 0; i < ord.length; i++) { if (clsOf(ord[i]) === want.cls.toLowerCase()) cands.push(ord[i]); }
}
if (!cands.length && want.hint) {
  var h = String(want.hint).toLowerCase();
  for (i = 0; i < ord.length; i++) {
    if (capOf(ord[i]).toLowerCase().indexOf(h) >= 0 || clsOf(ord[i]).indexOf(h) >= 0) cands.push(ord[i]);
  }
}
var t = null;
if (cands.length === 1) t = cands[0];
else if (cands.length > 1) {
  for (i = 0; i < cands.length; i++) { if (want.c && capOf(cands[i]) === want.c) { t = cands[i]; break; } }
  if (!t) { for (i = 0; i < cands.length; i++) { if (want.geom && geomOf(cands[i]) === want.geom) { t = cands[i]; break; } } }
  if (!t) { for (i = 0; i < cands.length; i++) { if (!cands[i].minimized && (!t || ord.indexOf(cands[i]) > ord.indexOf(t))) t = cands[i]; } }
}
if (t) {
  try { if (t.minimized) t.minimized = false; } catch (e) {}
  try { workspace.activeWindow = t; } catch (e) {}
  try { workspace.raiseWindow(t); } catch (e) {}
}
var act = workspace.activeWindow, out = [];
for (i = 0; i < ord.length; i++) {
  w = ord[i];
  out.push({ i: i, id: String(w.internalId || ""), pid: w.pid || 0, c: String(w.caption || ""),
    cls: String(w.resourceClass || ""), x: Math.round(w.frameGeometry.x), y: Math.round(w.frameGeometry.y),
    w: Math.round(w.frameGeometry.width), h: Math.round(w.frameGeometry.height),
    min: w.minimized ? 1 : 0, active: w === act ? 1 : 0 });
}
console.info("MARK " + JSON.stringify({ raised: t ? String(t.internalId || "") : null,
  active: act ? String(act.internalId || "") : null, wins: out }));
"""


def _raise_once(want, timeout=2.0, minimize_game=False):
    """activate + raise（可选把独占全屏的游戏最小化），返回同一轮 KWin 状态（权威）。"""
    _st0 = _state_ewmh() or {}
    _aw = _st0.get("active_window") or {}
    _lease_log("raise.begin", target=(want or {}).get("id"), active=_aw.get("id"),
               source=_st0.get("source"), proxy=_st0.get("active_proxy"))
    if RAISE_LOG:
        try:
            with open(RAISE_LOG, "a", encoding="utf-8") as fh:
                fh.write("raise\n")
        except OSError:
            pass
    raw = _kwin_js(lambda tag: _RAISE_BODY.replace("WANT_JSON", json.dumps(want, ensure_ascii=False))
                   .replace("MIN_GAME", "true" if minimize_game else "false")
                   .replace("MARK", f"YS-FOCUS-{tag}"), "raise", timeout)
    if not raw:
        # GNOME/Mutter 回退（2026-10-26 实测更正）：
        #   · `xdotool windowactivate` 返回 0 但**无效**（_NET_ACTIVE_WINDOW 仍是幽灵窗）；
        #   · `xdotool windowraise/windowfocus` 走 PATH ⇒ 命中 tools/ys-editor/shims/xdotool，
        #     白名单里没有这两个子命令 ⇒ **rc=77 被拦**，而旧代码不查 rc ⇒ 抬窗静默无效，
        #     随后又被 active_proxy（栈顶代理）判成"成功"（本轮最贵的自证陷阱）。
        #   · 唯一实测有效的通道是 `/usr/bin/wmctrl -i -a <wid>`（绝对路径绕开 shim）。
        wid = (want or {}).get("id") or ""
        if not re.match(r"^0x[0-9a-fA-F]+$", wid):
            return None
        try:
            import subprocess as _sp
            _r = _sp.run(["/usr/bin/wmctrl", "-i", "-a", wid],
                         capture_output=True, text=True, timeout=5)
            _rc, _err = _r.returncode, ((_r.stderr or "").strip()[:200])
        except Exception as e:                       # noqa: BLE001
            _lease_log("raise.wmctrl-error", target=wid, err=f"{type(e).__name__}: {e}")
            return None
        time.sleep(0.25)
        _st1 = _state_ewmh() or {}
        _aw1 = _st1.get("active_window") or {}
        _lease_log("raise.ewmh", target=wid, active=_aw1.get("id"), rc=_rc, err=_err,
                   ok=(_rc == 0 and not _st1.get("active_proxy")), via="wmctrl -i -a")
        if _rc != 0:
            return None                              # 抬窗没做成 ⇒ 不返回"成功状态"，让上层硬失败
        return _st1
    try:
        state = json.loads(raw)
    except Exception:                                    # noqa: BLE001
        return None
    act = state.get("active")
    state["active_window"] = next((w for w in state.get("wins", []) if w.get("id") == act), None)
    return state


def _selector(rec):
    if not rec:
        return {"cls": FALLBACK_CLASS, "hint": FALLBACK_CLASS}
    return {"id": rec.get("internalId") or "", "pid": int(rec.get("pid") or 0),
            "cls": (rec.get("class") or "").lower(),
            "c": rec.get("caption") or "", "geom": rec.get("geom") or ""}


def _want_record(want):
    return {"internalId": want.get("id") or "", "pid": int(want.get("pid") or 0),
            "class": want.get("cls") or "", "caption": want.get("c") or "",
            "geom": want.get("geom") or ""}


