#!/bin/bash
# ys-capture — 常驻抓帧 + 只取最新帧（票 25/33；独立工具，**不改 ys-observe**）
#
# 为什么存在（2026-10-18 实测，见 .scratch/gui-perf/capture-bench.md）：
#   现行 `ys-observe frame`（spectacle 全屏 PNG）**546–971ms**，且票 34 实测它抓的是
#   **当前虚拟桌面的窗口**（原神在别的桌面时抓到浏览器）。而进程内 XShmGetImage
#   读回一帧只要 **1.5–8ms**（11MB RGB），按窗口 id 抓图天然不会抓错对象。
#
# 分工：
#   `ys-capture serve`  常驻守护（Python，tools/ys-editor/ys_capture.py）：XShm 抓帧 →
#                       /dev/shm 环形缓冲 + 预编码，两路归属校验（X11 快 + KWin 权威）
#   `ys-capture latest` **热路径客户端（本文件的 bash 段，~5–15ms）**：读状态 → 四道 fail-closed
#                       闸门 → 硬链/拷贝已编码文件。**不解析图像**，所以不需要 numpy/PIL 启动。
#
# fail-closed 退出码（票 34 红线：拿不到可信帧就拒绝，绝不返回别的窗口/旧帧）：
#   0  OK          2  NOT_ATOP/NOT_FOUND   4  OTHER_DESKTOP（目标窗不在当前桌面）
#   5  OCCLUDED    7  DAEMON_DOWN          8  STALE_FRAME（帧太旧）
#   9  STRICT_UNAVAILABLE（KWin 权威通道不可用/结论过旧）
#   10 FORMAT_NOT_READY（请求的预编码格式与当前帧内容不符）
#   11 COPY_FAILED
#   12 BACKGROUND_NOT_ALLOWED（守护是 window 模式/帧是后台帧，但调用方没带 --allow-background）
#   13 CONTENT_NOT_ADVANCED（--min-content-id N：画面内容还没推进到 N；帧是新的、内容没变）
#   15 CHANNEL_UNAVAILABLE（窗口看不见 + 快通道还没被替换成合成器通道 ⇒ 画面可能滞后，
#                          拒绝交付"可能错的像素"；后台帧请显式 --allow-background）
#   唯一例外：显式 `--allow-background`（只供离线分析目标窗口自身缓冲，**不得用于动作**）。
#
# 用法：
#   ys-capture serve [--fps 10] [--ring 4] [--pre bmp,png] [--dir DIR] [--win auto|0xID]
#   ys-capture latest [--out FILE] [--format bmp|png|jpg|raw] [--max-age-ms 1000]
#                     [--strict-ttl-ms 6000] [--allow-background] [--encode-if-needed]
#   ys-capture status|stop|selftest|bench
#
# 环境：YS_CAPTURE_DIR（状态目录，默认 /dev/shm/ys-capture）、YS_CAPTURE_STATE（覆盖 state.tsv 路径）、
#       YS_CAPTURE_SKIP_DAEMON_CHECK=1（只给 selftest 用）、YS_WIN / YS_WIN_CLASS。
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
DIR="${YS_CAPTURE_DIR:-/dev/shm/ys-capture}"
STATE="${YS_CAPTURE_STATE:-$DIR/state.tsv}"
T0=$(date +%s%N)
PY="$(command -v python3 || echo /usr/bin/python3)"
CMD="${1:-}"; [ $# -gt 0 ] && shift || true

recheck_desktop() {  # 0 = 目标窗确实在当前桌面（**只在结论过期时**才做，别为主路径付 931ms）
  # 2026-10-21 实测：会话空闲交还 → 桌面切回用户那张 → 动作工具重取焦点切回游戏，
  # 但抓帧守护的 strict 结论还停在上一张桌面（sage 可到 2s）⇒ 连 --live 读屏都读不到。
  # 2026-10-21 性能：ys-wins --attrib 实测 931ms（qdbus 才 39ms，但 xprop 的 _NET_WM_DESKTOP
  # 与 KWin 的 ds= 实测不一致，不能用它做判据）⇒ 只在结论确实过期时才付这 0.9s。
  [ "${sage:-0}" -gt 800 ] || return 1
  local line ds cur
  line=$("$HERE/ys-wins" --attrib 2>/dev/null | grep -i "${klass:-yuanshen}" | head -1)
  [ -n "$line" ] || return 1
  ds=$(printf '%s' "$line" | sed -n 's/.*ds=\([0-9]*\).*/\1/p')
  cur=$(printf '%s' "$line" | sed -n 's/.*cur=\([0-9]*\).*/\1/p')
  [ -n "$ds" ] && [ -n "$cur" ] && [ "$ds" = "$cur" ]
}

content_json() {  # 回执片段：内容身份 + 通道 + 稽核读数（v1 状态给 null/unknown，不猜）
  local id="null" st="null" aud="null"
  case "${content_seq:-}" in ''|*[!0-9]*) ;; *) id="$content_seq";; esac
  case "${static_ms:-}" in ''|*[!0-9]*) ;; *) st="$static_ms";; esac
  case "${audage:-}" in ''|*[!0-9]*) ;; *) aud="$audage";; esac
  local lp="null"
  case "${loop_ms:-}" in ''|*[!0-9]*) ;; *) lp="$loop_ms";; esac
  printf '"content":{"id":%s,"static_ms":%s},"channel":"%s","demand_wait_ms":%s,"daemon":{"loop_ms":%s},"audit":{"verdict":"%s","stale_events":%s,"age_ms":%s}' \
    "$id" "$st" "${fsrc:-unknown}" "${demand_wait_ms:-0}" "$lp" "${audit_verdict:-unknown}" "${stale_events:-0}" "$aud"
}

read_state() {  # 读 state.tsv → 变量（v1 只有 26 列，v2 追加 8 列；缺的给空串）
  IFS=$'\x1f' read -r ver seq wall_ns wall_iso fw fh crc rgb bmp bcrc png pcrc jpg jcrc \
    fast fage strict sage ssrc win klass _pid dpid mode fsrc visible \
    content_seq static_ms stale_events audit_ok audit_stale audit_verdict \
    audage kwin_fallback loop_ms < "$STATE"
  content_seq="${content_seq:-}"; static_ms="${static_ms:-}"; audage="${audage:-}"; loop_ms="${loop_ms:-}"
}

deny() {  # deny <exit> <code> <detail>
  local ms=$(( ($(date +%s%N) - T0) / 1000000 ))
  local extra=""
  if [ "$2" = "OTHER_DESKTOP" ]; then
    extra=',"next_action":[{"step":1,"tool":"tools/ys-editor/ys-follow-win","args":["yuanshen.exe","--dry"],"why":"先看窗口在哪张桌面（只读）"},{"step":2,"tool":"tools/ys-editor/ys-follow-win","args":["yuanshen.exe"],"why":"切过去要单独授权：先向用户申请，再设 YS_ALLOW_DESKTOP_SWITCH=1"}]'
  fi
  printf '{"ok":false,"error":"%s","detail":"%s","ms":%s,"pixels_returned":false%s}\n' \
    "$2" "$3" "$ms" "$extra"
  exit "$1"
}

cmd_latest() {
  "$HERE/ys-bell" 2>/dev/null || true
  local OUT="" FMT="" ALLOW_BG=0 MAX_AGE_MS="${YS_CAPTURE_MAX_AGE_MS:-1000}"
  # 2026-10-22 用户裁决：**感知默认自动跨桌面**。理由：这些工具是给 AI 用的，AI 不该为了
  # "读一眼屏幕"先学会切虚拟桌面/加参数；而且 XShm 读的是窗口 pixmap，桌面归属不影响速度
  # （实测跨桌面 34ms，与同桌面同级）。"用户看不见"只对**动作**构成风险，对**读取**不构成。
  # 需要"必须与用户所见一致"的调用方（动作前校验）显式带 --require-current-desktop。
  local STRICT_TTL_MS="${YS_CAPTURE_STRICT_TTL_MS:-6000}" ENC_IF=0 WAIT_ENC=0 ALLOW_OD=1
  local MIN_CONTENT_ID=
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) OUT="${2:?--out 需要路径}"; shift 2;;
      --format) FMT="${2:?}"; shift 2;;
      --max-age-ms) MAX_AGE_MS="${2:?}"; shift 2;;
      --strict-ttl-ms) STRICT_TTL_MS="${2:?}"; shift 2;;
      --allow-background) ALLOW_BG=1; shift;;
      # 兼容旧调用（默认就是允许，显式写也无害）
      --allow-other-desktop) ALLOW_OD=1; shift;;
      # 动作类调用：要求帧与「用户当前所见」一致，跨桌面即拒
      --require-current-desktop) ALLOW_OD=0; shift;;
      --encode-if-needed) ENC_IF=1; shift;;
      --wait-encode-ms) WAIT_ENC="${2:?}"; shift 2;;
      # 内容推进闸门（帧停滞修复）：消费者声明「我至少要 content_id >= N」。
      # 比"自己轮询 src 路径有没有变"可靠——src 在内容不变时**本来就该**保持不变。
      --min-content-id) MIN_CONTENT_ID="${2:?--min-content-id 需要整数}"; shift 2;;
      --json) shift;;
      *) deny 1 BAD_ARG "未知参数 $1";;
    esac
  done
  T0=$(date +%s%N)
  [ -r "$STATE" ] || deny 7 DAEMON_DOWN "状态文件不存在：$STATE（先跑 ys-capture serve）"
  # 23 字段（\x1f 分隔；tab 会被 read 折叠，别改回 tab）：v1 seq wall_ns wall_iso w h crc rgb bmp bcrc png pcrc jpg jcrc
  #          fast fast_age strict strict_age strict_src win class pid dpid
  # 「点单」：告诉守护"有人在看"，它才愿意付合成器抓帧（240–570ms/帧）
  : > "$DIR/demand" 2>/dev/null || true
  read_state
  case "${ver:-}" in
    v1|v2) ;;
    *) deny 9 STRICT_UNAVAILABLE "状态文件版本不认识：${ver:-空}" ;;
  esac
  if [ "${YS_CAPTURE_SKIP_DAEMON_CHECK:-0}" != "1" ]; then
    [ -n "${dpid:-}" ] && kill -0 "$dpid" 2>/dev/null || deny 7 DAEMON_DOWN "守护进程 ${dpid:-?} 不在"
  fi
  # ── 帧停滞（客户端半边）：窗口看不见（被遮挡/别的虚拟桌面）时 XShm 读回实测滞后
  #    0.3–2.23s。已点单，这里**等守护把通道切到合成器**（kwin-ss2）再交付像素，
  #    最多 YS_CAPTURE_DEMAND_WAIT_MS（默认 1500ms）；看得见/已切换则零等待。
  local demand_wait_ms=0
  # 调用方显式要后台帧（--allow-background）时不切通道、不等待：它已经接受"看不见"的语义
  if [ "${ver:-v1}" = "v2" ] && [ "${visible:-1}" != "1" ] && [ "${fsrc:-}" = "xshm-window" ] \
     && [ "$ALLOW_BG" != "1" ]; then
    local dw="${YS_CAPTURE_DEMAND_WAIT_MS:-1500}" dl t_dw0
    t_dw0=$(date +%s%N); dl=$(( t_dw0 + dw * 1000000 ))
    while [ "$(date +%s%N)" -lt "$dl" ]; do
      sleep 0.01
      read_state
      [ "${fsrc:-}" != "xshm-window" ] && break
    done
    demand_wait_ms=$(( ($(date +%s%N) - t_dw0) / 1000000 ))
  fi
  # ── 闸门①.5（帧停滞最后一层）：窗口看不见、却仍由 XShm 快通道供图 ⇒ 画面可能滞后
  #    0.3–2.7s（实测）。「拿到错画面」的代价远高于多等一次，所以这里 **fail-closed**：
  #    不交付像素并点名原因；重试一次通常就已经切到合成器通道了。
  if [ "${ver:-v1}" = "v2" ] && [ "${visible:-1}" != "1" ] && [ "${fsrc:-}" = "xshm-window" ] \
     && [ "$ALLOW_BG" != "1" ]; then
    deny 15 CHANNEL_UNAVAILABLE \
      "窗口看不见（visible=${visible:-?}，KWin 判定 ${strict:-?}）且快通道尚未切到合成器通道：画面可能滞后 0.3–2.7s，拒绝交付。重试一次；持续出现说明 KWin 通道不可用（或确认要后台帧就带 --allow-background）"
  fi
  local now age_ms
  now=$(date +%s%N)
  age_ms=$(( (now - wall_ns) / 1000000 ))
  [ -n "${rgb:-}" ] && [ -s "$rgb" ] || deny 8 STALE_FRAME "环形缓冲里没有可读帧（rgb=${rgb:-空}）"
  # 帧文件必须**整帧完整**（2026-10-21：写帧改原子后这是第二道保险；
  # 长度不等于 w*h*3 说明拿到的是半帧/回收中的文件，重读一次状态再判）。
  _want=$(( fw * fh * 3 ))
  _have=$(stat -c %s "$rgb" 2>/dev/null || echo 0)
  if [ "$_have" != "$_want" ]; then
    sleep 0.05
    read_state
    _want=$(( fw * fh * 3 ))
    _have=$(stat -c %s "$rgb" 2>/dev/null || echo 0)
    [ -n "${rgb:-}" ] && [ "$_have" = "$_want" ] || deny 8 FRAME_RACE \
      "帧文件不完整（${_have:-0} 字节，应为 ${_want}）：半帧/正在回收，重读一次仍不行"
  fi
  [ "$age_ms" -le "$MAX_AGE_MS" ] || deny 8 STALE_FRAME "最新帧已 ${age_ms}ms 旧（> --max-age-ms=$MAX_AGE_MS）"
  # ── 闸门③：内容推进（帧停滞修复）。age_ms 只说明「抓过帧」，不说明「画面变了」；
  #    要"等画面推进"的调用方用 --min-content-id，别自己比对 src 路径（内容不变时它本就该不变）。
  if [ -n "${MIN_CONTENT_ID:-}" ]; then
    case "${content_seq:-}" in
      ''|*[!0-9]*) deny 13 CONTENT_NOT_ADVANCED \
        "守护状态是 ${ver}，没有 content_id —— 重启守护（ys-capture serve）后再用 --min-content-id" ;;
    esac
    if [ "$content_seq" -lt "$MIN_CONTENT_ID" ]; then
      deny 13 CONTENT_NOT_ADVANCED "内容未推进：content_id=$content_seq（要求 ≥$MIN_CONTENT_ID；已静止 ${static_ms:-?}ms，通道 ${fsrc:-?}）"
    fi
  fi
  # ── background 模式（--source window）：**按窗口抓，不要求可见**；只查身份与新鲜度。
  #    绝不冒充「在栈顶」：输出固定带 capture_mode=background 与 visible/src。
  if [ "${mode:-screen}" = "background" ]; then
    # 「后台」必须是**调用方显式声明**：守护是 window 模式时，上层不带 --allow-background
    # 一律拒绝（exit 12）——否则上层会以为自己拿的是可见画面，动作照做就会点错（票 34 同族）。
    [ "$ALLOW_BG" = "1" ] || deny 12 BACKGROUND_NOT_ALLOWED \
      "这是后台帧（capture_mode=background，窗口 visible=${visible:-0}）：调用方必须显式 --allow-background 才返回像素"
    case "${fast:-UNKNOWN}" in
      NOT_FOUND|UNKNOWN) deny 2 NOT_FOUND "窗口身份不可信（background 模式仍需身份校验；fast=${fast:-空}）";;
    esac
    [ -n "${klass:-}" ] || deny 2 NOT_FOUND "状态里没有窗口 class（身份不可信）"
  else
  # ── 闸门①：X11/EWMH 快路径（廉价次级信号；它会把桌面说错，所以只用来「更保守地拒」）
  case "$fast" in
    OK) ;;
    OTHER_DESKTOP) if [ "$ALLOW_OD" = 1 ]; then
                     [ "${YS_CAPTURE_VERBOSE:-0}" = "1" ] && echo "[note] 窗口在其他虚拟桌面（感知默认跨桌面读取；动作请加 --require-current-desktop）" >&2
                   else
                     recheck_desktop || deny 4 OTHER_DESKTOP "窗口不在当前虚拟桌面（EWMH：${fage}ms 前判定）"
                   fi;;
    OCCLUDED)      deny 5 OCCLUDED "窗口被遮挡/最小化（EWMH：${fage}ms 前判定）";;
    NOT_FOUND)     deny 2 NOT_FOUND "窗口身份不匹配（EWMH：${fage}ms 前判定）";;
    NOT_ATOP)      deny 2 NOT_ATOP "窗口不在栈顶（EWMH：${fage}ms 前判定）";;
    *)             deny 9 STRICT_UNAVAILABLE "EWMH 快路径结论未知（${fast:-空}）";;
  esac
  # ── 闸门②：KWin 权威通道（票 34 的教训：KWin 脚本静默失效时绝不拿 X11 冒充）
  if [ "$ALLOW_BG" = "1" ]; then
    :
  else
    [ "$ssrc" = "kwin" ] || deny 9 STRICT_UNAVAILABLE \
      "KWin 权威通道不可用（strict_src=${ssrc:-空}）——拒绝用 X11 快路径冒充（票 34）"
    case "$strict" in
      OK) ;;
      OTHER_DESKTOP) if [ "$ALLOW_OD" = 1 ]; then
                       [ "${YS_CAPTURE_VERBOSE:-0}" = "1" ] && echo "[note] KWin：窗口在其他虚拟桌面（感知默认跨桌面读取）" >&2
                     else
                       recheck_desktop || deny 4 OTHER_DESKTOP "KWin：窗口不在当前虚拟桌面"
                     fi;;
      OCCLUDED)      deny 5 OCCLUDED "KWin：窗口被遮挡";;
      NOT_FOUND)     deny 2 NOT_FOUND "KWin：找不到目标窗口";;
      NOT_ATOP)      deny 2 NOT_ATOP "KWin：窗口不在栈顶";;
      *)             deny 9 STRICT_UNAVAILABLE "KWin 归属结论未知（${strict:-空}）";;
    esac
    [ "$sage" -le "$STRICT_TTL_MS" ] || deny 9 STRICT_UNAVAILABLE \
      "KWin 归属结论已 ${sage}ms 旧（> --strict-ttl-ms=$STRICT_TTL_MS）"
  fi
  fi  # end screen-mode gates
  # ── 选格式（按 --out 后缀，其次 --format；无 --out 则只回源路径）
  if [ -z "$OUT" ]; then
    local ms=$(( ($(date +%s%N) - T0) / 1000000 ))
    printf '{"ok":true,"copied":false,"capture_mode":"%s","visible":%s,"src":"%s","format":"raw","path":"%s","ms":%s,"frame":{"seq":%s,"age_ms":%s,"crc32":"%s","w":%s,"h":%s},"attribution":{"fast":"%s","fast_age_ms":%s,"strict":"%s","strict_src":"%s","strict_age_ms":%s,"allow_background":%s},"win":"%s","class":"%s",%s}\n' \
      "${mode:-screen}" "${visible:-0}" "${fsrc:-xshm}" "$rgb" "$ms" "$seq" "$age_ms" "$crc" "$fw" "$fh" "$fast" "$fage" "$strict" "$ssrc" "$sage" "$ALLOW_BG" "$win" "$klass" "$(content_json)"
    return 0
  fi
  case "$OUT" in
    *.png) FMT="${FMT:-png}";; *.bmp) FMT="${FMT:-bmp}";;
    *.jpg|*.jpeg) FMT="${FMT:-jpg}";; *.rgb) FMT="${FMT:-raw}";;
  esac
  FMT="${FMT:-bmp}"
  local src="" src_crc=""
  case "$FMT" in
    raw) src="$rgb"; src_crc="$crc";;
    bmp) src="$bmp"; src_crc="$bcrc";;
    png) src="$png"; src_crc="$pcrc";;
    jpg) src="$jpg"; src_crc="$jcrc";;
    *) deny 1 BAD_ARG "未知 --format $FMT（bmp|png|jpg|raw）";;
  esac
  if { [ -z "${src:-}" ] || [ "$src_crc" != "$crc" ]; } && [ "$WAIT_ENC" -gt 0 ]; then
    # 后台预编码（png/jpg）可能落后当前帧几毫秒：显式允许等待时轮询 state，不返回旧图
    local deadline=$(( $(date +%s%N) + WAIT_ENC * 1000000 ))
    while [ "$(date +%s%N)" -lt "$deadline" ]; do
      sleep 0.005
      read_state
      case "$FMT" in
        png) src="$png"; src_crc="$pcrc";; jpg) src="$jpg"; src_crc="$jcrc";;
        bmp) src="$bmp"; src_crc="$bcrc";; raw) src="$rgb"; src_crc="$crc";;
      esac
      [ "${src_crc:-}" = "$crc" ] && break
    done
  fi
  if [ -z "${src:-}" ] || [ "$src_crc" != "$crc" ]; then
    # 2026-10-21 修（用户报「--format png 稳定报 FORMAT_NOT_READY」）：
    #   ① bmp/png 的按需编码改为**默认**：bmp 24ms / png 52ms（stored），且编码的就是当前帧，
    #      不存在"回旧图"风险；此前 png 必失败只是因为守护默认 `--pre bmp`、从不预编码 png。
    #   ② jpg 编码 1.8s，仍必须显式 --encode-if-needed（别让一次手滑把热路径拖垮）。
    #   ③ 逃生舱 YS_CAPTURE_NO_AUTOENC=1：恢复旧语义（不自动编码），注入用例靠它。
    [ "${YS_CAPTURE_NO_AUTOENC:-0}" = "1" ] && ENC_IF=0 && FMT_MANUAL=1
    if [ "$FMT" != "raw" ] && { [ "$ENC_IF" = "1" ] || { [ "${FMT_MANUAL:-0}" != "1" ] && { [ "$FMT" = "bmp" ] || [ "$FMT" = "png" ]; }; }; }; then
      # ③ 先硬链接保住数据再起子进程：ring=4@10fps 只留 ~400ms 历史，而子进程启动+import 约 250ms，
      #    直接传 $rgb 时该帧可能已被守护回收 ⇒ encode FileNotFound ⇒ 被误报成"按需编码失败"（实测踩过）。
      local keep="$DIR/.enc.$$.rgb" erc=0
      ln "$rgb" "$keep" 2>/dev/null || keep="$rgb"
      "$PY" "$HERE/ys_capture.py" encode "$keep" --format "$FMT" --out "$OUT" \
        --width "$fw" --height "$fh" >/dev/null 2>&1 || erc=$?
      [ "$keep" = "$rgb" ] || rm -f "$keep"
      [ "$erc" = "0" ] || deny 10 FORMAT_NOT_READY "按需编码 $FMT 失败（rc=$erc，源=$keep）"
      ms=$(( ($(date +%s%N) - T0) / 1000000 ))
      printf '{"ok":true,"copied":true,"encoded":true,"capture_mode":"%s","visible":%s,"format":"%s","out":"%s","src":"%s","ms":%s,"frame":{"seq":%s,"age_ms":%s,"crc32":"%s","w":%s,"h":%s},"attribution":{"fast":"%s","strict":"%s","strict_src":"%s","strict_age_ms":%s},%s}\n' \
        "${mode:-screen}" "${visible:-0}" "$FMT" "$OUT" "$rgb" "$ms" "$seq" "$age_ms" "$crc" "$fw" "$fh" "$fast" "$strict" "$ssrc" "$sage" "$(content_json)"
      return 0
    fi
    deny 10 FORMAT_NOT_READY \
      "预编码 $FMT 与当前帧内容不符（预编码 crc=${src_crc:-无} / 当前 crc=$crc）；bmp/png 会自动按需编码（~24/52ms），jpg 需显式 --encode-if-needed（~1.8s），或给 serve 加 --pre $FMT"
  fi
  # ── 交付：同文件系统用硬链（~1ms），跨设备回退拷贝；先删目标（覆盖语义）
  rm -f "$OUT" 2>/dev/null || true
  if ! ln "$src" "$OUT" 2>/dev/null; then
    cp --sparse=never "$src" "$OUT" 2>/dev/null || deny 11 COPY_FAILED "拷贝失败：$src -> $OUT"
  fi
  [ -s "$OUT" ] || deny 11 COPY_FAILED "输出为空：$OUT"
  local ms=$(( ($(date +%s%N) - T0) / 1000000 ))
  printf '{"ok":true,"copied":true,"capture_mode":"%s","visible":%s,"frame_source":"%s","format":"%s","out":"%s","src":"%s","ms":%s,"frame":{"seq":%s,"age_ms":%s,"crc32":"%s","w":%s,"h":%s},"attribution":{"fast":"%s","fast_age_ms":%s,"strict":"%s","strict_src":"%s","strict_age_ms":%s,"allow_background":%s},"win":"%s","class":"%s",%s}\n' \
    "${mode:-screen}" "${visible:-0}" "${fsrc:-xshm}" "$FMT" "$OUT" "$src" "$ms" "$seq" "$age_ms" "$crc" "$fw" "$fh" \
    "$fast" "$fage" "$strict" "$ssrc" "$sage" "$ALLOW_BG" "$win" "$klass" "$(content_json)"
  return 0
}

cmd_bench() {  # bench [--iters N] [--out FILE]：量 latest 热路径（含 bash 启动）
  local ITERS=10 OUT="" FMT="bmp"
  while [ $# -gt 0 ]; do
    case "$1" in --iters) ITERS="${2:?}"; shift 2;; --out) OUT="${2:?}"; shift 2;;
      --format) FMT="${2:?}"; shift 2;; *) shift;; esac
  done
  local f="${OUT:-/dev/shm/ys-capture/bench.out.$FMT}"
  local i t0 t1 ms ok=0 fails=0 last=""
  local -a samples=()
  for ((i=0;i<ITERS;i++)); do
    t0=$(date +%s%N)
    if "$HERE/ys-capture" latest --out "$f" --format "$FMT" ${YS_CAPTURE_BENCH_ARGS:-} >"$DIR/.yscap-bench.$$" 2>/dev/null; then
      ok=$((ok+1)); else fails=$((fails+1)); fi
    t1=$(date +%s%N); ms=$(( (t1-t0)/1000000 )); samples+=("$ms"); last=$(cat "$DIR/.yscap-bench.$$" 2>/dev/null)
  done
  rm -f "$DIR/.yscap-bench.$$"
  printf '%s\n' "${samples[@]}" | sort -n | awk -v n="$ITERS" -v ok="$ok" -v f="$fails" \
    -v fmt="$FMT" 'BEGIN{min=1e9;max=0} {a[NR]=$1; s+=$1; if($1<min)min=$1; if($1>max)max=$1}
    END {med=a[int((NR+1)/2)]; printf "{\"format\":\"%s\",\"iters\":%d,\"ok\":%d,\"fail\":%d,\"min_ms\":%d,\"median_ms\":%d,\"max_ms\":%d,\"mean_ms\":%.1f}\n", fmt, n, ok, f, min, med, max, s/NR}'
  [ -n "$last" ] && printf '# last: %s\n' "$last"
  return 0
}

case "$CMD" in
  serve)    exec "$PY" "$HERE/ys_capture.py" serve --dir "$DIR" "$@";;
  latest)   cmd_latest "$@";;
  status)   exec "$PY" "$HERE/ys_capture.py" status --dir "$DIR" "$@";;
  stop)     exec "$PY" "$HERE/ys_capture.py" stop --dir "$DIR" "$@";;
  audit)    exec "$PY" "$HERE/ys_capture.py" audit --dir "$DIR" "$@";;
  bench)    cmd_bench "$@";;
  selftest) exec "$PY" "$HERE/ys_capture.py" selftest --cli "$HERE/ys-capture" "$@";;
  ""|-h|--help|help)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//';;
  *) echo "{\"ok\":false,\"error\":\"BAD_CMD\",\"detail\":\"未知子命令 $CMD\"}"; exit 1;;
esac
