#!/bin/bash
# ys-peek — 把目标窗口**真正抬到最上层**再抓一张真值图，然后自动还原焦点
#
# 为什么要有它（2026-10-17 两次实测踩坑）：
#   ① `import -silent -window <id>` 在窗口被**遮挡**时返回陈旧 backing store（实测两张抓图 sha 完全相同，
#      而画面其实已变）；`spectacle` 全屏抓虽是真值，但**试玩全屏下会 core dump**。
#   ② `ys-gui-slot` 只做 `workspace.activeWindow = t`（**改焦点不改堆叠**）⇒ 窗口仍被压住，
#      于是「点完抓图看结果」的判断会全部失真（本轮为此在菜单/ESC 上反复误判）。
#   ⇒ 唯一可靠组合：**ys-kwin-raise 真抬升（带 stackingOrder 回读）→ 窗口内 import → 还原焦点**。
#
# 用法: ys-peek [输出.png] [窗口id] [标题子串]
#   缺省 /tmp/ys-peek.png · 0x01400001 · 原神
# 产物: <输出.png>（原尺寸）+ <输出>-s.png（1500 宽缩略，供视觉判读）
set -u
OUT="${1:-/tmp/ys-peek.png}"
WIN="${2:-${YS_WIN:?YS_WIN 未解析，见 ys-env.sh}}"
TITLE="${3:-原神}"
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"

RAISE=$("$HERE/ys-kwin-raise" "$TITLE" 2>&1 | tail -1)
echo "[ys-peek] raise: $RAISE"

"$HERE/ys-gui-slot" "$WIN" 60 bash -c "sleep 0.9; import -silent -window '$WIN' '$OUT'" >/dev/null 2>&1
rc=$?
if [ ! -s "$OUT" ]; then echo "[ys-peek] 抓图失败（rc=$rc）" >&2; exit 3; fi
SMALL="${OUT%.png}-s.png"
magick "$OUT" -resize 1500x "$SMALL" 2>/dev/null || convert "$OUT" -resize 1500x "$SMALL" 2>/dev/null
echo "[ys-peek] $OUT $(identify -format '%wx%h' "$OUT" 2>/dev/null) → $SMALL"
