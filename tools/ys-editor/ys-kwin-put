#!/bin/bash
# ys-kwin-put —— ⚠️ 已废弃（DEGRADED）：原实现走 KWin `workspace.cursorPos` 赋值 + 脚本内自证，
#   实测**不移动真实 X 指针**却回报 "OK"，且回读值常是 journalctl 里的陈旧行（2026-10-17 事故）。
#   现改为**委托给外部回读验证的 `ys-put`**，保留命令名只为不打断既有调用点。
#
# 用法: ys-kwin-put <x> <y>   （等价于 ys-put <x> <y>，验证失败即非零退出）
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
echo "[ys-kwin-put] 已废弃：转发到 ys-put（外部回读验证）" >&2
exec "$HERE/ys-put" "$@"
