#!/bin/bash
# ys-switch-save — 「我的图 ⇄ 最新别的图」之间切换一次（重载链路的正确原语）
#
# ⚠️ 为什么必须这样用（2026-10-17 实测，事故级）：
#   编辑器把地图常驻内存；**离开一张图时，编辑器会先把内存版写回磁盘**。
#   于是"切走再切回"式重载会亲手抹掉 CLI 刚写入的改动：
#     ① 内存=旧 ② CLI 写盘=新 ③ 切走 → 编辑器把旧写回盘（新被抹） ④ 切回 → 载入旧
#   实测铁证：CLI 写入 SHA d94f733d（实体 x=-6/3/13/23/34/46），
#             重载后磁盘变成 249af5c7（x=8/18/28/38/49/61 = 旧值），且**全程零报错**。
#
# ✅ 正确顺序：
#     ys-switch-save        # 先离开我的图（此时写回的是旧内存，反正我们要覆盖它）
#     <CLI 改 .gil / 注入 / 挂载>
#     ys-switch-save        # 再切回我的图 → 编辑器从磁盘载入【新】内容
#     → 然后才允许试玩
#
# 语义：存档列表排序 = 「当前打开」置顶 + 其余按时间倒序；我的图是最新的 ⇒
#   · 编辑器在我的图上 → 第 2 位 = 别的图 ⇒ 点它 = **离开**
#   · 编辑器在别图上   → 第 2 位 = 我的图 ⇒ 点它 = **回来**
#   两种情况都是"点第 2 位"，故同一动作自然成对。
#
# 2026-10-17 改造（S1/S2；实测一轮 426s 里本工具占 263s）：
#   · 判定收敛到 **ys-state**（唯一实现，--compat ys-fast 词汇）；本文件内联的 st() 判据副本已删除
#     （旧副本用的取样点与 ys-state 口径不一致——同一界面两处判据可能给出相反答案，
#      这正是要消灭的重复实现）。判据/坐标/阈值只存在 tools/ys-editor/ys-state。
#   · `sleep 22`（等地图重载）→ 谓词：**连续 6 次 EDITOR 且总时长 ≥9s**，超时 45s 失败退出。
#     快就是快；慢也不会假成功往下走。
#   · 导航 `sleep 4` → 等状态真的到 SAVE（ys-wait，超时 12s 失败）。
#   · 全窗截图 2893ms ×2 → 收尾只取 1 张裁切图（~166ms）。
#
# 用法: ys-switch-save        产物 /tmp/ys-switch-after.png
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"
[ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
export YS_WIN="${YS_WIN:-0x01400001}"

SAVE_ICON_X=39
SAVE_ICON_Y=176
CARD2_X=1737
CARD2_Y=386
CONFIRM_X=1439
CONFIRM_Y=812

"$HERE/ys-kwin-raise" "原神" >/dev/null 2>&1
"$HERE/ys-gui-slot" "$YS_WIN" 200 bash -c '
  set -u
  cd "$0"
  export YS_SLOT_ACTIVE=1
  W="${YS_WIN:-0x01400001}"
  ICON_X='"$SAVE_ICON_X"'; ICON_Y='"$SAVE_ICON_Y"'
  C2X='"$CARD2_X"'; C2Y='"$CARD2_Y"'
  CFX='"$CONFIRM_X"'; CFY='"$CONFIRM_Y"'
  # 注入原语一律包 timeout（Lead 2026-10-17 实测：裸调 ydotool 会挂住，把整步拖到 15s 上限）
  click() { timeout 20 ./ys-pointer-click "$1" "$2" >/dev/null 2>&1; }
  st() {
    local o
    o=$(./ys-state --print-state --compat ys-fast 2>/tmp/ys-switch-st.err | head -1)
    if [ -z "$o" ]; then
      o=UNKNOWN
      [ -s /tmp/ys-switch-st.err ] && echo "[st] ⚠ 判态失败：$(head -1 /tmp/ys-switch-st.err)" >&2
    fi
    echo "$o"
  }

  echo "起点 state=$(st)"

  # ① 进存档页：判据 = 状态真的变成 SAVE（旧写法：点一下然后 sleep 4）
  i=0
  while [ "$(st)" != "SAVE" ] && [ $i -lt 6 ]; do
    if [ "$(st)" = "MENU" ]; then click "$ICON_X" "$ICON_Y"
    else timeout 10 ydotool key 1:1 1:0 2>/dev/null; fi
    i=$((i+1))
    ./ys-wait --until "./ys-state --print-state --compat ys-fast" --expect SAVE --timeout 12 --poll 0.3 \
      --label "进存档页第${i}次" >/dev/null 2>&1
  done
  if [ "$(st)" != "SAVE" ]; then
    echo "✗ 进存档页失败（最后 state=$(st)）" >&2
    exit 3
  fi
  echo "到存档页 state=$(st)"

  # ② 点第 2 位卡 → 确认对话框弹出（对话框尚无稳定单点判据，只等最小物理延迟）
  click "$C2X" "$C2Y"
  sleep 0.8
  echo "  点第2位卡后 state=$(st)"

  # ③ 确认重载：谓词 = EDITOR 连续 6 次且总时长 ≥9s（旧写法：无条件 sleep 22）
  click "$CFX" "$CFY"
  T0=$(date +%s%3N)
  OKN=0
  while :; do
    S=$(st)
    if [ "$S" = "EDITOR" ]; then OKN=$((OKN+1)); else OKN=0; fi
    NOW=$(date +%s%3N)
    EL=$(( (NOW - T0) / 1000 ))
    if [ "$OKN" -ge 6 ] && [ "$EL" -ge 9 ]; then
      echo "[reload] ✓ ${EL}s 稳定 6 次（旧写法固定 22s）"
      break
    fi
    if [ "$EL" -ge 45 ]; then
      echo "[reload] ✗ 超时 45s（最后 state=$S）" >&2
      exit 4
    fi
    sleep 0.5
  done
  echo "切换后 state=$(st)"

  # ④ 证据：收尾只取一张裁切图（全窗 import 2893ms → 裁切 ~166ms）
  import -window "$W" -crop 900x520+0+0 +repage /tmp/ys-switch-after.png 2>/dev/null
' "$HERE" 2>&1 | grep -vE "^[0-9]+ [0-9]+$"
rc=${PIPESTATUS[0]}
if [ -s /tmp/ys-switch-after.png ]; then
  magick /tmp/ys-switch-after.png -resize 900x /tmp/ys-switch-after-s.png 2>/dev/null
fi
echo "[ys-switch-save] 证据图 /tmp/ys-switch-after-s.png  退出码 $rc"
exit "$rc"
