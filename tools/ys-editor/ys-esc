#!/bin/bash
# ys-esc — 发一次 ESC（走硬通道）
#
# 2026-10-21 真机反馈轮：
#  · 旧版经 ys-act 抓图，默认窗死 id ⇒ ESC 已发出但 rc=1；改为直接发键（无抓图）；
#  · 固定 sleep 2s 是 6.65s 里的 2.12s 大头 ⇒ 改 YS_ESC_SETTLE_MS（缺省 200ms）；
#  · 占用会话（ys-session）内直接注入，不再自建 slot。
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
export DISPLAY="${DISPLAY:-:1}"
YS_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"; [ -f "$YS_HOME/ys-env.sh" ] && . "$YS_HOME/ys-env.sh"
WIN="${YS_WIN:-}"
if [ -z "$WIN" ]; then
  WIN=$(python3 -c 'import sys; sys.path.insert(0, "'"$HERE"'"); import ys_look; print(ys_look.WIN or "")' 2>/dev/null)
fi
[ -n "$WIN" ] || WIN=auto
SETTLE_MS="${YS_ESC_SETTLE_MS:-200}"
SETTLE_S=$(awk -v m="$SETTLE_MS" 'BEGIN{printf "%.3f", m/1000}')
SESS=$(python3 - <<'PY' 2>/dev/null
import json, os, time
p = os.environ.get("YS_SESSION_PATH") or os.path.expanduser("~/.ys/session.json")
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    d = None
print("1" if (d and d.get("state") == "active" and float(d.get("expires") or 0) > time.time()
              and not d.get("dry_run")) else "0")
PY
)
if [ "${1:-}" = "--plan" ]; then
  echo "ESC-PLAN {\"session\": ${SESS}, \"settle_ms\": ${SETTLE_MS}, \"win\": \"${WIN}\"}"
  exit 0
fi
T0=$(date +%s%3N)
if [ "$SESS" = "1" ]; then
  # 层 2（2026-10-21）：空闲时守护已把屏幕交还用户 ⇒ 注入前自动重取焦点；取不回就不注入。
  "$HERE/ys-session" focus >/dev/null 2>&1; FRC=$?
  if [ "$FRC" -eq 3 ]; then
    SESS=0                       # 会话刚过期 ⇒ 回落 ys-gui-slot 路径
  elif [ "$FRC" -ne 0 ]; then
    echo "[ys-esc] 焦点取不回（rc=$FRC）⇒ 拒绝注入" >&2
    exit 7
  fi
fi
if [ "$SESS" = "1" ]; then
  # 会话内直注入也必须带 YS_SLOT_ACTIVE=1：ydotool 的 PATH shim 只认这个标记，
  # 否则按键被拦下、rc 仍可能为 0（2026-10-21 真机：ESC 没生效但状态仍 WORLD）。
  YS_SLOT_ACTIVE=1 bash -c "ydotool key 1:1; sleep 0.12; ydotool key 1:0; sleep ${SETTLE_S}"
  RC=$?
else
  "$HERE/ys-gui-slot" "$WIN" "${YS_MAX:-20}" bash -c \
    "ydotool key 1:1; sleep 0.12; ydotool key 1:0; sleep ${SETTLE_S}"
  RC=$?
fi
T1=$(date +%s%3N)
echo "ESC-TIMING {\"total_ms\": $((T1-T0)), \"settle_ms\": ${SETTLE_MS}, \"session\": ${SESS}}" >&2
exit "$RC"
