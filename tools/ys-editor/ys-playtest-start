#!/bin/bash
# ys-playtest-start — 开始千星试玩（判据全部走 ys-state 的具名探针，本文件不含坐标阈值）
# 设计要点（computer-use 技能「GUI 流程优化方法」）：
#   ① 判据成本 ∝ 面积（探针只裁控件外接框，不抓全窗）；
#   ② 先判后动；③ 轮询间隔≈判据成本；④ 整段只拿一次焦点（自我包装进 ys-gui-slot）。
# 退出码：0 已发出开始指令 / 4 找不到试玩磁贴（与旧版一致，ys-round 依赖）
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
# X 会话环境（DISPLAY/XAUTHORITY/YDOTOOL_SOCKET）只走统一入口
. "$HERE/ys-env.sh" >/dev/null 2>&1 || true
WIN="${1:-${YS_WIN:?YS_WIN 未解析：先 source tools/ys-editor/ys-env.sh}}"; export YS_WIN="$WIN"
if [ "${YS_SLOT_ACTIVE:-0}" != "1" ]; then exec "$HERE/ys-gui-slot" "$WIN" 40 env YS_SLOT_ACTIVE=1 bash "$0" "$WIN"; fi
. "$HERE/_ys-ui.sh"
# ⚠️ 不许吞退出码：rc=5「12 轮未命中」是定位失败的关键诊断（2026-10-17 复盘）
click() { local rc=0; "$HERE/ys-pointer-click" "$1" "$2" 12 1.7 >/dev/null || rc=$?; [ "$rc" -eq 0 ] || echo "[ys-playtest-start] ⚠️ 点击($1,$2)未命中 rc=$rc" >&2; return $rc; }

# ① 判页面：磁贴可见就直接点（退出试玩后通常就在这一页，不要先切页面）
if ! probe tile_visible; then
  echo "[start] 磁贴不可见 → ESC"; ydotool key 1:1 1:0; sleep 1
  probe tile_visible || { echo "[start] 再点首页图标(房子)"; click 60 20; sleep 1.5; }
  probe tile_visible || { echo "[start] ✗ 找不到试玩磁贴" >&2; exit 4; }
fi
echo "[start] ② 点「试玩」磁贴"; click 185 336

# ③ 轮询弹窗：烘焙网格体 → 试玩选项（每轮 ~0.35s）
i=0
while [ "$i" -lt 60 ]; do        # ≤ ~20s
  if probe bake_dialog; then
    echo "[start] ③ 烘焙网格体 → 直接上传"; click 1444 811; sleep 0.6
    wait_probe playtest_options 40
    break
  fi
  probe playtest_options && break
  sleep 0.25; i=$((i+1))
done
if probe playtest_options; then echo "[start] ④ 试玩选项 → 开始游戏"; click 1282 1051; fi
echo "[start] ✓ 已发出开始指令"
