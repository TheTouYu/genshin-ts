#!/bin/bash
# ys-playtest-start — 开始千星试玩（完整流程，2026-10-16 真机跑通）
#
# 实测流程与坐标（窗口 0x01400001，2560x1440；游戏内 UI 与窗口 1:1）：
#   ① 回首页：按 ESC（返回上一层；若在弹窗/面板上则先关它），最多 3 次，每次用像素判据验证
#      判据：首页「试玩」磁贴区域 (185,320) 为亮色(≈255,255,255)；摆放页同点为深蓝(45,71,138)
#   ② 点首页「试玩」磁贴 (185,336)
#   ③ 若弹「烘焙网格体」→ 点「直接上传」(1444,811)（纯 UI 地图无需烘焙）
#   ④ 若弹「试玩选项」→ 点「开始游戏」(1282,1051)
#   ⑤ 加载完成：画面出现「奇域试玩中…UID」水印
#
# 弹窗判据：弹窗面板=深色 (~45,47,58)，场景草地=绿色(G 明显大于 B)。
#
# 用法: ys-playtest-start [窗口id]
set -u
DISPLAY="${DISPLAY:-:1}"; export DISPLAY
YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-/run/user/1000/.ydotool_socket}"; export YDOTOOL_SOCKET
HERE="$(cd "$(dirname "$0")" && pwd)"
WIN="${1:-0x01400001}"

SNAP=/tmp/ys-playtest-start-snap.png
snap() { import -window "$WIN" "$SNAP" 2>/dev/null; }
sample() { snap; magick "$SNAP" -format "%[pixel:p{$1,$2}]" info: 2>/dev/null; }
rgb() { echo "$1" | sed -E 's/^[a-z]+\(([0-9]+),([0-9]+),([0-9]+).*/\1 \2 \3/'; }

is_home() {  # 首页判据：试玩磁贴区域为亮色
  local v r g b; v=$(sample 185 320); read -r r g b <<< "$(rgb "$v")"
  [ -n "${r:-}" ] && [ "$r" -gt 200 ] && [ "$g" -gt 200 ] && [ "$b" -gt 200 ]
}
is_dark_panel() {  # 弹窗判据：深色面板（草地则 G>>B）
  local v r g b; v=$(sample "$1" "$2"); read -r r g b <<< "$(rgb "$v")"
  [ -z "${r:-}" ] && return 1
  if [ "$g" -gt "$b" ] && [ $(( g - b )) -gt 25 ]; then return 1; else return 0; fi
}
press_esc() { "$HERE/ys-gui-slot" "$WIN" 6 bash -c 'ydotool key 1:1 1:0; sleep 1' >/dev/null 2>&1 || true; }
step_click() {
  echo "[ys-playtest-start] 点击 $3 @ ($1,$2)"
  "$HERE/ys-gui-slot" "$WIN" 20 bash -c "$HERE/ys-pointer-click $1 $2 12 1.7" >/dev/null 2>&1 || true
}

echo "[ys-playtest-start] ① 回首页（ESC 最多 3 次，像素判据验证）"
for i in 1 2 3; do
  is_home && { echo "  已在首页（第 $i 次判定）"; break; }
  echo "  第 $i 次：按 ESC"
  press_esc; sleep 3
done
is_home || { echo "[ys-playtest-start] ✗ 无法确认首页（判据 (185,320) 非亮色）" >&2; exit 4; }

echo "[ys-playtest-start] ② 点「试玩」磁贴"
step_click 185 336 "「试玩」磁贴"
sleep 7

if is_dark_panel 1000 600; then
  echo "[ys-playtest-start] ③ 检测到「烘焙网格体」→ 直接上传"
  step_click 1444 811 "「直接上传」"
  sleep 7
fi

if is_dark_panel 900 400; then
  echo "[ys-playtest-start] ④ 检测到「试玩选项」→ 开始游戏"
  step_click 1282 1051 "「开始游戏」"
  sleep 10
fi

echo "[ys-playtest-start] ⑤ 完成——请截图确认「奇域试玩中…UID」水印"
