def g_ledger_dedup():
    """G-LEDGER-DEDUP：命令遥测里同一 callId 只能记一次（账本 F-1-07 数字虚高 20 倍）。"""
    import collections
    path = os.environ.get("YS_GUARDS_CMDLOG") or os.path.expanduser("~/.dsh/cmdlog/commands.jsonl")
    if not os.path.exists(path):
        return True, [], ""
    ids = collections.Counter()
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            fh.seek(max(0, fh.tell() - 2_000_000))
            import time as _t
            cutoff = (int(_t.time()) - 1800) * 1000        # 只看近 30 分钟：历史重复是已知存量
            for line in fh.read().decode("utf-8", "replace").splitlines():
                if '"callId"' in line:
                    try:
                        o = json.loads(line)
                        if (o.get("ts") or 0) >= cutoff:
                            ids[o.get("callId")] += 1
                    except Exception:                    # noqa: BLE001
                        pass
    except Exception:                                    # noqa: BLE001
        return True, [], ""
    # 容差：偶发 1–2 次重复是写入竞态（不致命）；病态是"同一条重复 ≥3 次"或"重复组 > 5"
    dup = [(k, v) for k, v in ids.items() if v > 1]
    pathological = [d for d in dup if d[1] >= 3]
    bad = len(dup) > 5 or pathological
    return (not bad), ([f"重复 callId {len(dup)} 组（病态 {len(pathological)} 组，最多 {max(ids.values()) if ids else 0} 次）"]
                       if bad else []), \
        "写入端按 callId 去重；同一条重复 ≥3 次说明守护进程在重灌（查是否起了两份）"


