def gate1():
    """判定回归：期望 ys-state --regress --channel both --json 给出结构化读数。"""
    g = {'gate': 1, 'name': GATE_NAMES[1], 'status': BLOCKED, 'readings': {}, 'gaps': []}
    if not os.path.exists(YS_STATE):
        g['gaps'].append('ys-state 不存在')
        return g
    rc, out, err, ms = run([sys.executable, YS_STATE, '--regress', '--channel', 'both', '--json'],
                           timeout=300)
    g['ms'] = ms
    data = None
    try:
        data = json.loads(out[out.index('{'):out.rindex('}') + 1])
    except Exception:
        g['gaps'].append('--regress --json 无结构化输出（rc=%d）：%s' % (rc, tail(err or out, 200)))
        return g
    total = int(data.get('total') or 0)
    negs = int(data.get('negatives') or 0)
    chans = data.get('channels') or {}
    g['readings'] = {'total': total, 'negatives': negs,
                     'channels': {k: v.get('percent') if isinstance(v, dict) else v
                                  for k, v in chans.items()},
                     'rc': rc}
    if total < 16:
        g['gaps'].append('样本总数 %d < 16（差 %d）' % (total, 16 - total))
    if negs < 5:
        g['gaps'].append('负样本 %d < 5（差 %d）' % (negs, 5 - negs))
    for name, v in chans.items():
        pct = v.get('percent') if isinstance(v, dict) else v
        if pct is None or float(pct) < 100:
            g['gaps'].append('通道 %s 通过率 %s < 100%%' % (name, pct))
            if isinstance(v, dict):
                for c in (v.get('failed') or [])[:5]:
                    g['gaps'].append('  失败样本: %s' % (c if isinstance(c, str)
                                                        else json.dumps(c, ensure_ascii=False)))
    if rc != 0 and not g['gaps']:
        g['gaps'].append('ys-state --regress 退出码 %d' % rc)
    g['status'] = PASS if not g['gaps'] else FAIL
    return g


