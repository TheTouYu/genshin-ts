# 判据副本的**特征指纹**：状态名列表 / 像素探针字面量。
# 只允许出现在 ys-state（唯一实现）。calib/ 与 tests/ 是数据与测试，不计。
STATE_WORDS = ('EDITOR', 'MENU', 'SAVELIST', 'PLAYTEST', 'PAUSE', 'SETTLE', 'LOADING', 'UNKNOWN')
PROBE_PATTERNS = [
    (re.compile(r'\bpx\(\s*\d+\s*,\s*\d+\s*\)'), 'px(x,y)'),
    (re.compile(r'\bis_(?:light|dark)\s+\d+\s+\d+'), 'is_light/is_dark'),
    (re.compile(r'\bjudge\s+\d+\s+\d+'), 'judge'),
    (re.compile(r'\bwait_(?:light|dark)\s+\d+\s+\d+'), 'wait_light/wait_dark'),
]
SKIP_DIRS = {'node_modules', '.git', 'calib', 'tests', '__pycache__', '.scratch', 'dist'}
SELF = os.path.abspath(__file__)


def scan_duplicates():
    """两级判定，机械可判（不靠人给自己解释）：

    A 类（硬证据，必须清空）= 文件里出现坐标/像素探针字面量 —— 只有唯一实现可以持有坐标。
    B 类（候选，可自证）= ≥3 个状态名同现，且**没有**调用 ys-state —— 说明它自己在判，不是消费者。
    消费者（引用了 ys-state）即便提到状态名也不计，这是"委托"的机械判据。
    """
    a_hits, b_hits = {}, {}
    for base, dirs, files in os.walk(os.path.join(ROOT, 'tools')):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith('.')]
        for fn in files:
            path = os.path.join(base, fn)
            if not (fn.endswith(('.py', '.sh')) or '.' not in fn):
                continue          # 无扩展名的可执行脚本（ys-state/ys-round/…）必须一起扫
            if os.path.abspath(path) in (os.path.abspath(YS_STATE), SELF):
                continue
            try:
                text = open(path, encoding='utf-8', errors='replace').read()
            except Exception:
                continue
            rel = os.path.relpath(path, ROOT)
            probes = []
            for pat, label in PROBE_PATTERNS:
                n = len(pat.findall(text))
                if n:
                    probes.append('%s×%d' % (label, n))
            if probes:
                a_hits[rel] = probes
                continue
            words = [w for w in STATE_WORDS if re.search(r'\b%s\b' % w, text)]
            delegates = ('ys-state' in text) or ('ys_gates' in text)
            if len(words) >= 3 and not delegates:
                b_hits[rel] = sorted(words)
    return a_hits, b_hits


def gate5():
    g = {'gate': 5, 'name': GATE_NAMES[5], 'status': FAIL, 'readings': {}, 'gaps': []}
    if not os.path.exists(YS_STATE):
        g['gaps'].append('ys-state 不存在（唯一实现缺位）')
        g['status'] = BLOCKED
        return g
    a_hits, b_hits = scan_duplicates()
    g['readings'] = {'tierA': a_hits, 'tierB': b_hits, 'count': len(a_hits) + len(b_hits),
                     'canonical': os.path.relpath(YS_STATE, ROOT)}
    for path, what in sorted(a_hits.items()):
        g['gaps'].append('A 类判据副本 %s: %s（坐标/阈值必须只留在 ys-state）'
                         % (path, '; '.join(what)))
    for path, words in sorted(b_hits.items()):
        g['gaps'].append('B 类候选 %s: 状态名 %s 且未调用 ys-state（要么委托，要么删掉判定）'
                         % (path, ','.join(words)))
    g['status'] = PASS if not (a_hits or b_hits) else FAIL
    return g


