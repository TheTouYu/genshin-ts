def newest_round(explicit=None):
    if explicit:
        return explicit if os.path.isdir(explicit) else None
    if not os.path.isdir(ROUND_HOME):
        return None
    cands = []
    for name in os.listdir(ROUND_HOME):
        d = os.path.join(ROUND_HOME, name)
        if os.path.isdir(d) and os.path.exists(os.path.join(d, 'round.json')):
            cands.append((os.path.getmtime(os.path.join(d, 'round.json')), d))
    return max(cands)[1] if cands else None


def load_round(rdir):
    try:
        with open(os.path.join(rdir, 'round.json'), encoding='utf-8') as fh:
            return json.load(fh)
    except Exception as exc:
        return {'_error': str(exc)}


def gate3(rdir):
    """性能：只读 round.json.budget 与 duration_ms，不重跑。"""
    g = {'gate': 3, 'name': GATE_NAMES[3], 'status': BLOCKED, 'readings': {}, 'gaps': []}
    if not rdir:
        g['gaps'].append('没有含 round.json 的轮目录（先跑一轮，或 --round-dir 指定）')
        return g
    r = load_round(rdir)
    if '_error' in r:
        g['gaps'].append('round.json 不可解析：%s' % r['_error'])
        return g
    kind = r.get('kind') or r.get('type') or 'write'
    budget = r.get('budget') or {}
    dur = r.get('duration_ms')
    limit = 90000 if kind == 'write' else 40000
    g['readings'] = {'round': os.path.basename(rdir.rstrip('/')), 'kind': kind,
                     'duration_ms': dur, 'frames': budget.get('frames'),
                     'focus': budget.get('focus'), 'sleeps': budget.get('sleeps')}
    if dur is None:
        g['gaps'].append('round.json 缺 duration_ms（执行器没记时长）')
    elif dur > limit:
        g['gaps'].append('%s 轮 %dms > %dms' % (kind, dur, limit))
    for key, cap in (('frames', 12), ('focus', 1), ('sleeps', 0)):
        v = budget.get(key)
        if v is None:
            g['gaps'].append('round.json.budget 缺 %s' % key)
        elif v > cap:
            g['gaps'].append('budget.%s=%s > %d' % (key, v, cap))
    g['status'] = PASS if not g['gaps'] else FAIL
    return g


def gate4(rdir):
    """证据：调用 round-report --replay 只用落盘物重算；没证据必须报错而不是猜。"""
    g = {'gate': 4, 'name': GATE_NAMES[4], 'status': BLOCKED, 'readings': {}, 'gaps': []}
    if not rdir:
        g['gaps'].append('没有含 round.json 的轮目录')
        return g
    if not os.path.exists(ROUND_REPORT):
        g['gaps'].append('tools/round-report 不存在')
        return g
    rc, out, err, ms = run([sys.executable, ROUND_REPORT, '--replay', rdir], timeout=120)
    g['ms'] = ms
    res = None
    for line in (out + '\n' + err).splitlines():
        m = re.search(r'GATE4-RESULT\b(.*)$', line)
        if m:
            res = dict(re.findall(r'(\w+)=([\w]+)', m.group(1)))
    g['readings'] = {'rc': rc, 'round': os.path.basename(rdir.rstrip('/')),
                     'result': res, 'stdout_tail': tail(out, 300)}
    if rc != 0:
        g['gaps'].append('--replay 退出码 %d：%s' % (rc, tail(err or out, 240)))
    if res is None:
        if 'PASS' not in out:
            g['gaps'].append('--replay 输出里没有 PASS 判定')
        if 'DIFF' in out:
            g['gaps'].append('--replay 报 DIFF（证据与结论不一致）')
    else:
        if res.get('verdict') != 'PASS':
            g['gaps'].append('replay verdict=%s' % res.get('verdict'))
        for key in ('diff', 'error'):
            if int(res.get(key, 1) or 0) != 0:
                g['gaps'].append('replay %s=%s（应为 0）' % (key, res.get(key)))
    g['status'] = PASS if not g['gaps'] else FAIL
    return g


