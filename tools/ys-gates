def run(cmd, timeout=180, env=None, cwd=ROOT):
    """跑子进程，返回 (rc, out, err, ms)。超时按 rc=124 处理，不抛。"""
    e = dict(os.environ)
    if env:
        e.update(env)
    t0 = time.time()
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd, env=e)
        return p.returncode, p.stdout or '', p.stderr or '', int((time.time() - t0) * 1000)
    except subprocess.TimeoutExpired:
        return 124, '', 'timeout %ss' % timeout, int((time.time() - t0) * 1000)
    except FileNotFoundError as exc:
        return 127, '', str(exc), int((time.time() - t0) * 1000)


def tail(text, n=400):
    text = (text or '').strip()
    return text[-n:] if len(text) > n else text


