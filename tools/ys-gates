def gate2():
    """假成功：跑执行器级自测脚本，解析每类失败用例的耗时与退出码。"""
    g = {'gate': 2, 'name': GATE_NAMES[2], 'status': BLOCKED, 'readings': {}, 'gaps': []}
    if not os.path.exists(FAKE_SUCCESS):
        g['gaps'].append('缺执行器级自测：tools/ys-editor/tests/fake-success.selftest.sh')
        return g
    suites = {}
    for name, script, tmo in SUITES:
        sp = os.path.join(YS, 'tests', script)
        if not os.path.exists(sp):
            suites[name] = {'ok': False, 'note': '缺脚本'}
            g['gaps'].append('缺防护套件：%s' % script)
            continue
        # .py 套件用 python3 跑（2026-10-21：三个新套件是 Python，bash 跑会直接语法错）
        _argv = ['python3', sp] if sp.endswith('.py') else ['bash', sp]
        src, sout, serr, sms = run(_argv, timeout=tmo)
        last = [l for l in (sout + '\n' + serr).splitlines() if l.strip()]
        suites[name] = {'ok': src == 0, 'rc': src, 'ms': sms,
                        'last': (last[-1][:100] if last else '')}
        if src != 0:
            g['gaps'].append('套件 %s 失败（rc=%d）' % (name, src))
    rc, out, err, ms = run(['bash', FAKE_SUCCESS], timeout=300)
    g['ms'] = ms
    cases = {}
    verdict = None
    # 契约 §7 机读行：GATE2-RESULT f1=<ms>:<exit> f2=... f3=... verdict=PASS|FAIL
    for line in (out + '\n' + err).splitlines():
        m = re.search(r'GATE2-RESULT\b(.*)$', line)
        if m:
            body = m.group(1)
            for kind in ('f1', 'f2', 'f3', 'f4'):
                mm = re.search(kind + r'=(\d+):(\d+)', body)
                if mm:
                    cases[kind.upper()] = {'ms': int(mm.group(1)), 'exit': int(mm.group(2)),
                                           'ok': None}
            vm = re.search(r'verdict=(PASS|FAIL)', body)
            verdict = vm.group(1) if vm else None
    if not cases:
        # 兼容旧格式：PASS|FAIL <F1|F2|F3> ... ms=<n> ... exit=<n>
        for line in (out + '\n' + err).splitlines():
            m = re.match(r'\s*(PASS|FAIL)\s+(F[123])\b.*?ms=(\d+).*?exit=(\d+)', line)
            if m:
                cases[m.group(2)] = {'ok': m.group(1) == 'PASS', 'ms': int(m.group(3)),
                                     'exit': int(m.group(4))}
    g['readings'] = {'cases': cases, 'script_rc': rc, 'verdict': verdict, 'suites': suites}
    if not cases:
        g['gaps'].append('自测未给机读结果行 GATE2-RESULT（契约 §7）')
        return g
    if verdict == 'FAIL':
        g['gaps'].append('自测自报 verdict=FAIL')
    want_exit = {'F1': 3, 'F2': 4, 'F3': 3, 'F4': 4}
    for kind in ('F1', 'F2', 'F3', 'F4'):
        c = cases.get(kind)
        if not c:
            g['gaps'].append('缺少 %s 用例结果' % kind)
            continue
        if c['ok'] is False:
            g['gaps'].append('%s 自测判 FAIL' % kind)
        if c['ms'] > 10000:
            g['gaps'].append('%s 停止耗时 %dms > 10000ms' % (kind, c['ms']))
        if c['exit'] != want_exit[kind]:
            g['gaps'].append('%s 退出码 %d ≠ 期望 %d' % (kind, c['exit'], want_exit[kind]))
    g['status'] = PASS if not g['gaps'] else FAIL
    return g


