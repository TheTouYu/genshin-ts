#!/usr/bin/env python3
"""ys-annotate-apply — 把人工修复补丁应用到真值集。

补丁来源：`tools/ys-annotate` 导出的 `patch-<batch>-<ts>.json`
   {frames: {<stem>: {deleted:{id:true}, updated:{id:[x,y,w,h]}, added:[{id,bbox,kind}]}}}

用法：
  python3 tools/ys-annotate-apply --patch ~/Downloads/patch-truth-v5-*.json \
      --truth-dir .scratch/gui-corpus/truth-v5 [--dry-run] [--backup-dir .scratch/gui-corpus/_backups]

行为：
  · deleted  → 从 objects 移除（含其 parent 引用清理）
  · updated  → 覆盖 bbox
  · added    → 追加新对象（id 用 "h<n>" 前缀，标注来源 human）
  · 写回前把原 JSON 备份到 backup-dir/<ts>/；输出变更摘要
  · 自动把 patch 记录写进 truth 的 `_human_edits`（哪帧改了什么），方便agent按规律外推
"""
import argparse
import glob
import json
import os
import shutil
import sys
import time


def find_truth(truth_dir, stem):
    p = os.path.join(truth_dir, stem + ".json")
    return p if os.path.exists(p) else None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--patch", required=True)
    ap.add_argument("--truth-dir", required=True)
    ap.add_argument("--backup-dir", default=".scratch/gui-corpus/_backups")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()

    patch = json.load(open(os.path.expanduser(a.patch), encoding="utf-8"))
    frames = patch.get("frames") or {}
    ts = time.strftime("%Y%m%d-%H%M%S")
    bdir = os.path.join(a.backup_dir, ts)
    os.makedirs(bdir, exist_ok=True)

    total = {"del": 0, "upd": 0, "add": 0, "frames": 0}
    for stem, ops in frames.items():
        tf = find_truth(a.truth_dir, stem)
        if not tf:
            print(f"  ! 找不到真值 {stem}.json，跳过", file=sys.stderr)
            continue
        d = json.load(open(tf, encoding="utf-8"))
        objs = d.get("objects") or []
        before = {o.get("id"): list(o.get("bbox") or []) for o in objs}

        deleted = set(str(k) for k in (ops.get("deleted") or {}).keys())
        updated = ops.get("updated") or {}
        added = ops.get("added") or []

        keep = []
        for o in objs:
            oid = str(o.get("id"))
            if oid in deleted:
                total["del"] += 1
                continue
            if oid in updated:
                o["bbox"] = updated[oid]
                o["edited_by"] = "human"
                total["upd"] += 1
            keep.append(o)
        keep_ids = {str(o.get("id")) for o in keep}
        for i, x in enumerate(added, 1):
            nid = f"h{i}"
            while nid in keep_ids:
                nid += "x"
            keep.append({"id": nid, "parent": x.get("parent"), "bbox": x["bbox"],
                         "kind": x.get("kind") or "unknown", "text": x.get("text") or "",
                         "note": "human-added", "edited_by": "human"})
            keep_ids.add(nid)
            total["add"] += 1

        # 清理指向已删对象的 parent
        for o in keep:
            if o.get("parent") is not None and str(o["parent"]) in deleted:
                o["parent"] = None

        d["objects"] = keep
        d["units"] = len(keep)
        d.setdefault("_human_edits", []).append({
            "at": patch.get("at"), "patch": os.path.basename(a.patch),
            "deleted": sorted(deleted), "updated": sorted(updated),
            "added": [x.get("id") for x in added],
        })
        total["frames"] += 1

        if a.dry_run:
            print(f"  [dry] {stem}: -{len(deleted)} ~{len(updated)} +{len(added)}  (units {len(before)} -> {len(keep)})")
        else:
            shutil.copyfile(tf, os.path.join(bdir, os.path.basename(tf)))
            json.dump(d, open(tf, "w", encoding="utf-8"), ensure_ascii=False, indent=1)

    tag = "[dry-run] " if a.dry_run else ""
    print(f"{tag}应用完成：帧 {total['frames']}｜删除 {total['del']}｜更新 {total['upd']}｜新增 {total['add']}")
    if not a.dry_run:
        print(f"备份 -> {os.path.abspath(bdir)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
