RAPIDOCR_PY = os.environ.get(
    'YS_RAPIDOCR_PY',
    ('/usr/bin/python3' if os.path.exists('/usr/lib/python3.14/site-packages/rapidocr')
     else os.path.join(HERE, '..', '.scratch', 'gui-grounding', 'venv-rapidocr', 'bin', 'python')))
# 内容寻址缓存：与 ys-find 共用同一目录 ⇒ 两个工具互相暖机
CACHE_DIR = os.environ.get('YS_FIND_CACHE_DIR', os.path.join(HERE, '..', '.gsts', 'ys-find-cache'))
CACHE_MAX = 64

