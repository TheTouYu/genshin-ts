# --------------------------------------------------------------------------- 基础
def _sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for blk in iter(lambda: f.read(1 << 20), b''):
            h.update(blk)
    return h.hexdigest()


def _backend_sig():
    """后端签名：venv python 换了（升级/重装）⇒ OCR 缓存自动失效。"""
    try:
        st = os.stat(RAPIDOCR_PY)
        return '%s|%d|%d' % (os.path.abspath(RAPIDOCR_PY), st.st_mtime_ns, st.st_size)
    except OSError:
        return 'missing'


def _prune_cache():
    try:
        fs = [(os.path.getmtime(os.path.join(CACHE_DIR, n)), os.path.join(CACHE_DIR, n))
              for n in os.listdir(CACHE_DIR) if n.endswith('.json')]
        for _, p in sorted(fs)[:max(0, len(fs) - CACHE_MAX)]:
            os.unlink(p)
    except OSError:
        pass


def backend_ok():
    return os.path.exists(RAPIDOCR_PY), os.path.abspath(RAPIDOCR_PY)


LOOKD_SOCK = os.environ.get('YS_LOOKD_SOCK', '/run/user/%d/ys-lookd.sock' % os.getuid())


def _daemon_ocr(frame, src_path, scale):
    """向 ys-lookd 要一次 OCR。服务不可用/未实现该命令 ⇒ 返回 None（调用方回退子进程）。

    为什么值得多这一层：OCR 引擎（模型加载 + CUDA context）是**进程级**开销，
    子进程模型下每次都要重付；常驻后单帧从 5.5s 级降到 0.4s 级。
    """
    import socket
    if not os.path.exists(LOOKD_SOCK):
        return None
    req = {'cmd': 'ocr'}
    if frame is not None:
        req['frame'] = os.path.abspath(frame)
    else:                                  # 缩放帧：让服务读临时文件
        req['frame'] = os.path.abspath(src_path)
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(120)
        c.connect(LOOKD_SOCK)
        c.sendall((json.dumps(req) + '\n').encode())
        data = b''
        while not data.endswith(b'\n'):
            ch = c.recv(65536)
            if not ch:
                break
            data += ch
        c.close()
        r = json.loads(data.decode())
    except (OSError, ValueError):
        return None
    if r.get('error') or not isinstance(r.get('boxes'), list):
        return None                        # 服务不认识 ocr（旧版本）或出错 ⇒ 回退
    boxes = r['boxes']
    if abs(scale - 1.0) > 1e-6:
        boxes = [{'text': b['text'], 'cx': int(b['cx'] / scale), 'cy': int(b['cy'] / scale),
                  'score': b['score'],
                  'box': [[int(p[0] / scale), int(p[1] / scale)] for p in b['box']]}
                 for b in boxes]
    return boxes, {'source': 'daemon', 'ms': int(r.get('ms') or 0),
                   'n_total': int(r.get('n_total') or 0), 'err': None}


def run_ocr(frame, use_cache=True, scale=1.0, debug=False):
    """整帧 OCR（复用 ys_ocr.py 子进程）。返回 (boxes, meta)。

    boxes: [{text,cx,cy,score,box}]（全帧坐标）；meta: {source,ms,n_total,err}
    fail-closed：后端缺/跑失败都返回 err，绝不返回空列表冒充"这屏没字"。
    """
    src_path, tmp_path = frame, None
    if abs(scale - 1.0) > 1e-6:
        from PIL import Image
        im = Image.open(frame).convert('RGB')
        tmp_path = os.path.join('/tmp', 'ys-screen-%d-%d.png' % (os.getpid(), int(scale * 1000)))
        im.resize((max(1, int(im.width * scale)), max(1, int(im.height * scale))),
                  Image.LANCZOS).save(tmp_path)
        src_path = tmp_path
    sha = _sha256(src_path)
    cpath = os.path.join(CACHE_DIR, sha + '.json') if use_cache else None
    if cpath and os.path.exists(cpath):
        try:
            with open(cpath, 'r', encoding='utf-8') as f:
                c = json.load(f)
            if c.get('backend') == _backend_sig() and isinstance(c.get('boxes'), list):
                boxes = _unscale(c['boxes'], scale)
                return boxes, {'source': 'cache', 'ms': int(c.get('ms') or 0),
                               'n_total': int(c.get('n_total') or 0), 'err': None}
        except (OSError, ValueError):
            pass
    # ① 常驻服务优先（2026-10-18）：RapidOCR 每次新起进程要付「启动 + 模型加载」≈ 5s，
    #    而引擎在常驻进程里只付一次。实测单帧：冷进程 5.5~13.8s → 常驻 CUDA **~0.4s**。
    if os.environ.get('YS_SCREEN_NO_DAEMON_OCR') != '1':
        d = _daemon_ocr(frame if abs(scale - 1.0) < 1e-6 else None, src_path, scale)
        if d is not None:
            boxes, meta = d
            meta['source'] = 'daemon'
            if cpath:
                try:
                    os.makedirs(CACHE_DIR, exist_ok=True)
                    tmp = '%s.tmp%d' % (cpath, os.getpid())
                    with open(tmp, 'w', encoding='utf-8') as f:
                        json.dump({'backend': _backend_sig(), 'boxes': boxes,
                                   'n_total': meta.get('n_total') or 0,
                                   'ms': meta.get('ms') or 0,
                                   'frame': os.path.abspath(src_path), 'scale': scale},
                                  f, ensure_ascii=False)
                    os.replace(tmp, cpath)
                    _prune_cache()
                except OSError:
                    pass
            return boxes, meta

    ok, py = backend_ok()
    if not ok:
        return None, {'source': 'nobackend', 'ms': 0, 'n_total': 0,
                      'err': 'RapidOCR venv 缺失：%s（可设 YS_RAPIDOCR_PY）' % py}
    cmd = [py, os.path.join(YS, 'ys_ocr.py'), 'ocr', src_path, '--json']
    if debug:
        sys.stderr.write('[ys-screen] OCR: %s\n' % ' '.join(cmd))
    t0 = time.time()
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    ms = int((time.time() - t0) * 1000)
    if p.returncode != 0:
        return None, {'source': 'error', 'ms': ms, 'n_total': 0,
                      'err': 'OCR 子进程 rc=%d：%s' % (p.returncode, (p.stderr or p.stdout)[-400:])}
    try:
        d = json.loads(p.stdout)
    except ValueError as exc:
        return None, {'source': 'error', 'ms': ms, 'n_total': 0,
                      'err': 'OCR 输出不可解析：%s；首 200 字节=%r' % (exc, p.stdout[:200])}
    boxes = d.get('boxes') or []
    n_total = int(d.get('n_total') or 0)
    inproc_ms = int(d.get('ms') or 0)
    if cpath:
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = '%s.tmp%d' % (cpath, os.getpid())
            with open(tmp, 'w', encoding='utf-8') as f:
                json.dump({'backend': _backend_sig(), 'boxes': boxes, 'n_total': n_total,
                           'ms': inproc_ms, 'frame': os.path.abspath(src_path),
                           'scale': scale}, f, ensure_ascii=False)
            os.replace(tmp, cpath)
            _prune_cache()
        except OSError:
            pass
    return _unscale(boxes, scale), {'source': 'run', 'ms': ms, 'n_total': n_total, 'err': None}


def _unscale(boxes, scale):
    if abs(scale - 1.0) < 1e-6:
        return boxes
    out = []
    for b in boxes:
        nb = dict(b)
        nb['cx'] = int(round(b['cx'] / scale))
        nb['cy'] = int(round(b['cy'] / scale))
        nb['box'] = [[int(round(x / scale)), int(round(y / scale))] for x, y in b['box']]
        out.append(nb)
    return out


def box_bbox(points):
    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    return [int(min(xs)), int(min(ys)), int(max(xs)), int(max(ys))]


# --------------------------------------------------------------------------- 像素层
def load_small(path, scale):
    """读帧并缩到分析尺度（控件/分区/遮挡在缩小图上算：快 + 抗噪，坐标再乘回去）。"""
    from PIL import Image
    import numpy as np
    im = Image.open(path).convert('RGB')
    W0, H0 = im.size
    W, H = max(1, int(round(W0 * scale))), max(1, int(round(H0 * scale)))
    if (W, H) != (W0, H0):
        im = im.resize((W, H), Image.LANCZOS)
    arr = np.asarray(im, dtype=np.uint8)
    return arr, (W0, H0)


def _box_filter(x, r):
    """(2r+1)^2 均值滤波（积分图，纯 numpy）。"""
    import numpy as np
    p = np.pad(x, ((r + 1, r), (r + 1, r)), mode='edge')
    ii = p.cumsum(0).cumsum(1)
    k = 2 * r + 1
    return (ii[k:, k:] - ii[:-k, k:] - ii[k:, :-k] + ii[:-k, :-k]) / float(k * k)


def _label_mask(mask, max_runs=None):
    """二进制 4-连通标号。返回 (labels int32, stats[{label,area,bbox}])。

    有 scipy 就走 `scipy.ndimage.label`（C 速度 ~7ms）；缺失则退回纯 numpy 的
    "逐行游程 + 并查集"（同结果、慢 20~40 倍）。两条路都不装新包：
    scipy 只在**已安装**时当加速器，缺了自动降级，功能不缺。
    """
    import numpy as np
    try:
        from scipy import ndimage as _ndi
        lab, n = _ndi.label(mask)
        if n == 0:
            return np.zeros(mask.shape, dtype=np.int32), []
        areas = np.bincount(lab.ravel())
        stats = []
        for i, sl in enumerate(_ndi.find_objects(lab), start=1):
            if sl is None:
                continue
            stats.append({'label': i, 'area': int(areas[i]),
                          'bbox': [int(sl[1].start), int(sl[0].start),
                                   int(sl[1].stop), int(sl[0].stop)]})
        return lab.astype(np.int32), stats
    except ImportError:
        pass
    H, W = mask.shape
    parent = []
    runs = []       # (y, x0, x1, id)
    prev = []       # (x0, x1, id)
    zero = mask.astype(np.int8)

    def find(a):
        r = a
        while parent[r] != r:
            r = parent[r]
        while parent[a] != r:
            parent[a], a = r, parent[a]
        return r

    for y in range(H):
        row = zero[y]
        if not row.any():
            prev = []
            continue
        d = np.diff(row)
        starts = np.flatnonzero(d == 1) + 1
        ends = np.flatnonzero(d == -1) + 1
        if row[0]:
            starts = np.concatenate(([0], starts))
        if row[-1]:
            ends = np.concatenate((ends, [W]))
        cur = []
        for s, e in zip(starts.tolist(), ends.tolist()):
            rid = len(parent)
            parent.append(rid)
            cur.append((s, e, rid))
            runs.append((y, s, e, rid))
        j = 0
        for (s, e, rid) in cur:
            while j < len(prev) and prev[j][1] <= s:
                j += 1
            k = j
            while k < len(prev) and prev[k][0] < e:
                a, b = find(prev[k][2]), find(rid)
                if a != b:
                    if a < b:
                        parent[b] = a
                    else:
                        parent[a] = b
                k += 1
        prev = cur
        if max_runs is not None and len(runs) > max_runs:
            break
    if not parent:
        return np.zeros_like(zero, dtype=np.int32), []

    roots = np.array([find(i) for i in range(len(parent))], dtype=np.int64)
    uniq = np.unique(roots)
    remap = np.zeros(int(roots.max()) + 1, dtype=np.int32)
    remap[uniq] = np.arange(1, uniq.size + 1, dtype=np.int32)

    labels = np.zeros((H, W), dtype=np.int32)
    ry = np.array([r[0] for r in runs], dtype=np.int64)
    rx0 = np.array([r[1] for r in runs], dtype=np.int64)
    rx1 = np.array([r[2] for r in runs], dtype=np.int64)
    rlab = remap[roots[np.array([r[3] for r in runs], dtype=np.int64)]]
    for i in range(len(runs)):
        labels[ry[i], rx0[i]:rx1[i]] = rlab[i]
    areas = np.bincount(rlab, weights=(rx1 - rx0), minlength=uniq.size + 1).astype(np.int64)
    stats = []
    for lb in range(1, uniq.size + 1):
        sel = rlab == lb
        if not sel.any():
            continue
        stats.append({
            'label': lb,
            'area': int(areas[lb]),
            'bbox': [int(rx0[sel].min()), int(ry[sel].min()),
                     int(rx1[sel].max()), int(ry[sel].max()) + 1],   # 行号是闭区间，+1 才等于高度口径
        })
    return labels, stats


def _find_rings(g, debug=False):
    """第三路：**圆环 / 圆钮**（径向对称投票 + 径向极性一致的环验证）。

    为什么必须单独开一路（2026-10-17 换真帧实测）：同一颗铅笔钮，改名后内部变成
    "白色圆角方框 + 铅笔"——白色占比更高、内部方差更大，于是
      ① 平坦填充面法失手：内部不再均匀；
      ② DoG 斑块法失手：环又细又亮，`MinFilter(3)+MaxFilter(3)` 的开运算把 1~2px 的环
         整圈腐蚀掉（0.5 分析尺度下，40px 直径的环只剩 1px 粗）。
    而**圆环边界的径向对称性**与"环里装了什么"无关，所以这一路对"内部被图标填满的圆钮"稳。

    两阶段：
      1) 每个强边缘像素沿 ±梯度方向、按半径 r 投票到圆心（Loy & Zelinsky 的快速径向对称
         FRST 的简化版）→ 累加器峰值 = "这里可能有个半径 r 的圆"；
      2) 对候选圆心做**环验证**：72 个角度里有多少角度在 r±1 上存在"梯度指向圆心"的强边
         （cov），并要求环亮度与**环内、环外两侧**都明显不同（避免把"两条平行线"、
         "渐变边缘"当成环）。
    """
    import numpy as np
    gx = np.zeros_like(g)
    gy = np.zeros_like(g)
    gx[:, 1:-1] = (g[:, 2:] - g[:, :-2]) / 2.0
    gy[1:-1, :] = (g[2:, :] - g[:-2, :]) / 2.0
    mag = np.hypot(gx, gy)
    ys, xs = np.nonzero(mag > RING_EDGE_THR)
    if len(ys) == 0:
        return []
    if len(ys) > RING_TOPK:
        keep = np.argsort(-mag[ys, xs])[:RING_TOPK]
        ys, xs = ys[keep], xs[keep]
    ux = gx[ys, xs] / (mag[ys, xs] + 1e-6)
    uy = gy[ys, xs] / (mag[ys, xs] + 1e-6)
    H, W = g.shape
    acc = np.zeros((H, W), dtype=np.float32)
    radii = list(range(RING_R_MIN, RING_R_MAX + 1))
    for r in radii:
        a = np.zeros((H, W), dtype=np.float32)
        for sgn in (1.0, -1.0):
            cx = np.rint(xs + sgn * r * ux).astype(np.int32)
            cy = np.rint(ys + sgn * r * uy).astype(np.int32)
            ok = (cx >= 0) & (cx < W) & (cy >= 0) & (cy < H)
            np.add.at(a, (cy[ok], cx[ok]), 1.0)
        acc += a                    # 不除周长：小半径环的票数天生少，除面积会把圆钮压没
    acc = _box_filter(acc, 2)

    centers = []
    order = np.argsort(-acc.ravel())[:RING_MAX_CAND * 8]
    for idx in order:
        y, x = divmod(int(idx), W)
        if acc[y, x] < 3.0:
            break
        if any((x - c[0]) ** 2 + (y - c[1]) ** 2 <= 81 for c in centers):
            continue
        centers.append((x, y))
        if len(centers) >= RING_MAX_CAND:
            break

    ang = np.linspace(0.0, 2.0 * np.pi, 72, endpoint=False)
    ca, sa = np.cos(ang), np.sin(ang)
    out = []
    for (x, y) in centers:
        if x < 2 or y < 2 or x > W - 3 or y > H - 3:
            continue
        best = None
        for r in radii:
            if x - r - 6 < 0 or y - r - 6 < 0 or x + r + 6 >= W or y + r + 6 >= H:
                continue
            hits = np.zeros((3, ang.size), dtype=bool)
            vals = np.full((3, ang.size), np.nan, dtype=np.float32)
            for i, dr in enumerate((-1.0, 0.0, 1.0)):
                rr = r + dr
                px = np.rint(x + rr * ca).astype(np.int32)
                py = np.rint(y + rr * sa).astype(np.int32)
                m = mag[py, px]
                gxv = gx[py, px]
                gyv = gy[py, px]
                pol = np.abs(gxv * ca + gyv * sa) / (m + 1e-6)
                h = (m >= RING_EDGE_THR) & (pol >= RING_POL_MIN)
                hits[i] = h
                vals[i] = np.where(h, g[py, px], np.nan)
            cov = float(hits.any(axis=0).mean())
            if cov < RING_COV_MIN:
                continue
            ring = float(np.nanmean(vals)) if np.any(~np.isnan(vals)) else float(g[y, x])
            inside = float(g[y - 2:y + 3, x - 2:x + 3].mean())
            outs = []
            for rr in (r + 4.0, r + 5.0):
                px = np.rint(x + rr * ca[::4]).astype(np.int32)
                py = np.rint(y + rr * sa[::4]).astype(np.int32)
                outs.extend(g[py, px].tolist())
            outside = float(np.mean(outs)) if outs else ring
            d_in = abs(ring - inside)
            d_out = abs(ring - outside)
            if d_in < RING_SIDE_MIN or d_out < RING_SIDE_MIN:
                continue
            con = abs(ring - 0.5 * (inside + outside))
            if con < RING_CON_MIN:
                continue
            score = cov * min(1.0, con / RING_CON_MIN)
            if best is None or score > best[0]:
                best = (score, r, cov, con, ring, inside, outside)
        if best is None:
            continue
        _, r, cov, con, ring, inside, outside = best
        out.append({'cx': int(x), 'cy': int(y), 'r': int(r), 'cov': round(cov, 3),
                    'contrast': round(con, 1), 'ring': round(ring, 1),
                    'inside': round(inside, 1), 'outside': round(outside, 1)})
    if debug:
        sys.stderr.write('[ys-screen] ring candidates=%d\n' % len(out))
        for c in out[:10]:
            sys.stderr.write('  ring (%d,%d) r=%d cov=%.2f con=%.1f\n'
                             % (c['cx'], c['cy'], c['r'], c['cov'], c['contrast']))
    return out


def find_controls(arr, scale, W0, H0, text_boxes, debug=False):
    """非文字控件候选：三路互补线索（少任何一路都会漏掉某一种按钮）。

    ① **对比斑块**（DoG = 远窗均值 − 近窗均值）：按钮本体常常与周围**同色系、差一档明度**
       （实证：标题右侧铅笔钮 = 暗绿圆盘压在绿面板上，灰度 ~50 vs ~72）。"平坦面"法抓不到它
       —— 在渐变面板上，"均匀"的恰恰是背景；DoG 给的是"这是一块独立的局部色块"。
    ② **均匀填充面**（局部 5x5 标准差极低）：药丸按钮/卡片/图标底板是纯色填充，DoG 抓不到
       （它们大到"远窗均值"也落在自己内部）。两路合起来才覆盖 圆钮 + 药丸 + 卡片。
    ③ **圆环**（径向对称投票 + 极性与径向一致的环验证）：圆钮里被图标填满时 ①② 都会失手
       （实测换帧后同一颗铅笔钮内部变成"白框+铅笔"：① 内部不再均匀；② 细亮环被开运算腐蚀掉）。
    形状：细长=line；长宽比 ≥1.45=rect（药丸）；近方形时看**角部填充率**——
    圆盘四角是空的（≈0.1），方/圆角矩形的四角接近 1。
    """
    import numpy as np
    from PIL import Image as _Img, ImageFilter as _IF

    def _open_mask(b):
        im = _Img.fromarray((b * 255).astype(np.uint8), 'L')
        return np.asarray(im.filter(_IF.MinFilter(3)).filter(_IF.MaxFilter(3))) > 127

    g = arr.astype(np.float32).mean(axis=2)
    tb = [(t['bbox'][0] * scale, t['bbox'][1] * scale, t['bbox'][2] * scale,
           t['bbox'][3] * scale, t['text']) for t in text_boxes]
    cands = []

    def _emit(labels, lb, bbox, src):
        x0, y0, x1, y1 = bbox
        w, h = x1 - x0, y1 - y0
        if w < MIN_CTRL_SIDE * scale or h < MIN_CTRL_SIDE * scale:
            return
        if w * h > MAX_CTRL_FRAC * arr.shape[0] * arr.shape[1]:
            return
        sub = (labels[y0:y1, x0:x1] == lb)
        n = int(sub.sum())
        if n < MIN_CTRL_AREA * scale * scale:
            return
        if _max_text_cover(x0, y0, x1, y1, tb) >= 0.55:
            return                      # 框里几乎全是字 ⇒ 那是一个标签，不是控件
        if _text_union_cover(x0, y0, x1, y1, tb) >= 0.45:
            return                      # 多个文本框合起来盖掉近半 ⇒ 这是"一堆字"，不是控件
        fills = n / float(max(1, w * h))
        aspect = w / float(max(1, h))
        corner = _corner_fill(sub)
        shape, conf = _classify(fills, aspect, corner, w, h, scale)
        if shape == 'unknown':
            return
        cands.append({
            'bbox': [int(x0 / scale), int(y0 / scale), int(x1 / scale), int(y1 / scale)],
            'cx': int(round((x0 + x1) / 2 / scale)), 'cy': int(round((y0 + y1) / 2 / scale)),
            'w': int(round(w / scale)), 'h': int(round(h / scale)),
            'shape': shape, 'confidence': round(conf, 3),
            'label': _label_inside(x0, y0, x1, y1, tb),
            'evidence': {'fill': round(fills, 3), 'aspect': round(aspect, 2),
                         'corner_fill': round(corner, 2),
                         'area': int(n / (scale * scale)), 'src': src},
        })

    resp = np.abs(_box_filter(g, DOG_SURROUND) - _box_filter(g, DOG_CENTER))
    lab1, st1 = _label_mask(_open_mask(resp > DOG_THRESH))
    for st in st1:
        _emit(lab1, st['label'], st['bbox'], 'contrast')

    m1 = _box_filter(g, 1)
    var = _box_filter(g * g, 1) - m1 * m1
    lab2, st2 = _label_mask(np.sqrt(np.maximum(var, 0)) < CTRL_FLAT_STD)
    for st in st2:
        _emit(lab2, st['label'], st['bbox'], 'flat')

    # ③ 圆环/圆钮（内部被图标填满也能抓；见 _find_rings 的说明）
    for rg in _find_rings(g, debug=debug):
        # bbox 必须关于圆心**对称**：下游 adjacency 用 (x0+x1)//2 当控件中心，
        # 不对称会得到 cx+1 这种"报出来的坐标对不上控件坐标"的坑（实测踩过）。
        x0 = max(0, rg['cx'] - rg['r'] - 1)
        y0 = max(0, rg['cy'] - rg['r'] - 1)
        x1 = min(arr.shape[1], rg['cx'] + rg['r'] + 1)
        y1 = min(arr.shape[0], rg['cy'] + rg['r'] + 1)
        if _max_text_cover(x0, y0, x1, y1, tb) >= 0.55:
            continue
        if _text_union_cover(x0, y0, x1, y1, tb) >= 0.45:
            continue
        conf = 0.55 + 0.2 * rg['cov'] + min(0.2, abs(rg['contrast']) / 100.0)
        cands.append({
            'bbox': [int(x0 / scale), int(y0 / scale), int(x1 / scale), int(y1 / scale)],
            'cx': int(round(rg['cx'] / scale)), 'cy': int(round(rg['cy'] / scale)),
            'w': int(round((x1 - x0) / scale)), 'h': int(round((y1 - y0) / scale)),
            'shape': 'circle', 'confidence': round(min(0.95, conf), 3),
            'label': _label_inside(x0, y0, x1, y1, tb),
            'evidence': {'fill': None, 'aspect': 1.0, 'corner_fill': None,
                         'area': int((x1 - x0) * (y1 - y0) / (scale * scale)),
                         'src': 'ring', 'ring_r_px': int(round(rg['r'] / scale)),
                         'cov': rg['cov'], 'contrast': rg['contrast'],
                         'ring_L': rg['ring'], 'inside_L': rg['inside'],
                         'outside_L': rg['outside']},
        })

    cands.sort(key=lambda c: -c['confidence'])
    kept = []
    for c in cands:
        if any(_iou(c['bbox'], k['bbox']) >= 0.35 for k in kept):
            continue                    # 同一控件被两路各抓一次，留置信度高的那条
        kept.append(c)
    # 去掉"套在别人里面的小图标"：磁贴里的图标笔画是磁贴的一部分，报出来只会把
    # "标题旁边有什么"挤满（实测：菜单磁贴的内层图标 gap 60 < 铅笔 179，排在前头）。
    kept = _drop_nested(kept)
    kept = kept[:MAX_CONTROLS]
    for i, c in enumerate(kept):
        c['id'] = 'c%d' % i
    if debug:
        sys.stderr.write('[ys-screen] controls=%d\n' % len(kept))
        for c in kept[:12]:
            sys.stderr.write('  %s %-6s %s conf=%.2f fill=%.2f corner=%.2f src=%s label=%r\n' % (
                c['id'], c['shape'], c['bbox'], c['confidence'], c['evidence']['fill'],
                c['evidence']['corner_fill'], c['evidence']['src'], c['label']))
    return kept


def _drop_nested(ctrls):
    """剔掉"被另一个更大控件包住 ≥85% 面积"的小控件（磁贴里的图标、药丸里的字块）。"""
    keep = []
    for a in ctrls:
        aa = (a['bbox'][2] - a['bbox'][0]) * (a['bbox'][3] - a['bbox'][1])
        nested = False
        for b in ctrls:
            if b is a:
                continue
            bb = (b['bbox'][2] - b['bbox'][0]) * (b['bbox'][3] - b['bbox'][1])
            if bb < 1.6 * aa or bb > 12 * aa:
                continue    # 只把"同一量级的容器"算容器：整块面板/底条包里的小图标不算嵌套
                            # （实测：左侧栏面板把标题旁的铅笔包进去，把该报的入口吃掉了）
            ix = max(0, min(a['bbox'][2], b['bbox'][2]) - max(a['bbox'][0], b['bbox'][0]))
            iy = max(0, min(a['bbox'][3], b['bbox'][3]) - max(a['bbox'][1], b['bbox'][1]))
            if aa > 0 and ix * iy / float(aa) >= 0.85:
                nested = True
                break
        if not nested:
            keep.append(a)
    return keep


def _corner_fill(sub):
    """四角 25% 小方块的平均填充率：圆盘≈0.1，方/圆角矩形≈0.9+。"""
    import numpy as np
    h, w = sub.shape
    k = max(1, int(round(min(w, h) * 0.25)))
    return float(np.mean([sub[0:k, 0:k].mean(), sub[0:k, w - k:w].mean(),
                          sub[h - k:h, 0:k].mean(), sub[h - k:h, w - k:w].mean()]))


def _iou(a, b):
    ix = max(0, min(a[2], b[2]) - max(a[0], b[0]))
    iy = max(0, min(a[3], b[3]) - max(a[1], b[1]))
    inter = ix * iy
    union = (a[2] - a[0]) * (a[3] - a[1]) + (b[2] - b[0]) * (b[3] - b[1]) - inter
    return inter / float(max(1, union))


def _text_union_cover(x0, y0, x1, y1, tb, pad=2):
    """一堆文本框的并集覆盖该 bbox 的比例（粗略：按行/列不重叠的近似上限见下）。

    用"逐个框面积相加（先去重像素）"太贵，这里用更稳的口径：把 bbox 内**被任一文本框
    覆盖的像素数**在一张布尔图上数出来（分析尺度下 bbox 很小，代价可忽略）。
    """
    import numpy as np
    w, h = int(x1 - x0), int(y1 - y0)
    if w <= 0 or h <= 0:
        return 1.0
    mask = np.zeros((h, w), dtype=bool)
    for (tx0, ty0, tx1, ty1, _) in tb:
        ax0, ay0 = max(0, int(tx0) - int(x0) - pad), max(0, int(ty0) - int(y0) - pad)
        ax1 = min(w, int(tx1) - int(x0) + pad)
        ay1 = min(h, int(ty1) - int(y0) + pad)
        if ax1 > ax0 and ay1 > ay0:
            mask[ay0:ay1, ax0:ax1] = True
    return float(mask.mean())


def _max_text_cover(x0, y0, x1, y1, tb):
    """该 bbox 被单个文本框覆盖的最大比例。"""
    best = 0.0
    a = max(1.0, (x1 - x0) * (y1 - y0))
    for (tx0, ty0, tx1, ty1, _) in tb:
        ix = max(0.0, min(x1, tx1) - max(x0, tx0))
        iy = max(0.0, min(y1, ty1) - max(y0, ty0))
        best = max(best, ix * iy / a)
    return best


def _label_inside(x0, y0, x1, y1, tb):
    hits = []
    for (tx0, ty0, tx1, ty1, txt) in tb:
        cx, cy = (tx0 + tx1) / 2.0, (ty0 + ty1) / 2.0
        if x0 <= cx <= x1 and y0 <= cy <= y1:
            hits.append(txt)
    return ' '.join(hits) if hits else None


def _classify(fills, aspect, corner, w, h, scale):
    """形状判定：细长=line；长宽比>1.45 或四角填满=rect；近方形且四角空=circle。"""
    short, long_ = min(w, h), max(w, h)
    if short <= 14 * scale and long_ >= 24 * scale:
        return 'line', 0.55
    if long_ / float(max(1, short)) >= 1.45:
        return 'rect', round(min(0.92, 0.5 + fills * 0.45), 3)
    if corner >= 0.72:
        return 'rect', round(min(0.9, 0.45 + corner * 0.45), 3)
    if corner <= 0.52 and fills >= 0.42:
        return 'circle', round(min(0.95, 0.55 + (0.72 - corner) * 0.5 + fills * 0.2), 3)
    return 'unknown', 0.2


# ── 界面结构：面板 → 行 → 条目（2026-10-18 用户定义，O-2026-10-18-06）─────────
# 用户原话：「我们有快速、高效的获取图片结构的办法吗？这或许是高效的 GUI 模型抵达 AGI 的
# 前置条件，这些基础的事情需要在工程上保证，**不能依赖模型每次都主动去查看图片**」。
#
# 之前的状况：`regions` 返回**空数组**，模型要看懂结构只能调 read_image 看图——
# 我因此盲滚过一次（滚错容器）。结构理解不是能力，是运气。
#
# 方法：**OCR 框 → 几何聚类**（不是像素启发式）。
# 为什么不用像素：实测纯像素的"行带投影"在活动页只找到 3 条行带（真值 6~7 项），
# 因为列表行是图标+文字的组合图形，不是纯色块；而 OCR 框自带语义与位置，
# 按 x 间隙切面板、按 y 邻近合并成行，一次就得到"这个界面有哪些区、每区有哪些条目"。
#
# 成本：聚类 <1ms（OCR 本来就已跑过，复用它，**不新增任何 OCR 开销**）。
HUD_PAD = 12                     # HUD 判定外扩，避免边缘漏网


def _known_hud(W0, H0):
    """已知 HUD 区域（按 2560×1440 标定，按比例缩放）。这些位置上的文字是**读数/水印**，
    不是界面内容，混进"面板/行"会污染结构（实测活动页面板0 的 bbox 从 y=18 起就是 DXVK）。"""
    boxes = [
        (0, 0, 130, 90),                 # 左上 DXVK FPS/GPU
        (0, 1280, 460, 1440),            # 左下 性能叠加（min/max/ms + 曲线）
        (2240, 1360, 2560, 1440),        # 右下 UID
        (2380, 0, 2560, 150),            # 右上 网络延迟
    ]
    sx, sy = W0 / 2560.0, H0 / 1440.0
    return [[int(x0 * sx) - HUD_PAD, int(y0 * sy) - HUD_PAD,
             int(x1 * sx) + HUD_PAD, int(y1 * sy) + HUD_PAD] for x0, y0, x1, y1 in boxes]


def _in_hud(bb, hud):
    cx, cy = (bb[0] + bb[2]) / 2.0, (bb[1] + bb[3]) / 2.0
    return any(h[0] <= cx <= h[2] and h[1] <= cy <= h[3] for h in hud)


def find_structure(text, W0, H0, row_tol=42, panel_gap=260, min_rows=2):
    """从已识别文本聚类出**面板 → 行 → 条目**。返回 list[dict]。

    判据说明（为什么是这些阈值）：
      · row_tol=42：实测行高 40~60px，取 42 能把同行的图标+标签并成一行；
      · panel_gap=260：分栏之间 x 间隙远大于行内元素间距（活动页左列表↔右详情 ≈1100px）；
      · min_rows=2：单行的"区"多半是标题/HUD 残留，不是面板。
    """
    hud = _known_hud(W0, H0)
    items = []
    for t in text:
        if _in_hud(t['bbox'], hud):
            continue                          # ← HUD 滤除（第 2 步）
        items.append(t)
    if not items:
        return []
    items.sort(key=lambda b: b['cx'])

    groups, cur, last_x = [], [], None
    for b in items:
        if last_x is not None and b['cx'] - last_x > panel_gap:
            groups.append(cur)
            cur = []
        cur.append(b)
        last_x = b['cx']
    if cur:
        groups.append(cur)

    out = []
    for gp in groups:
        gp.sort(key=lambda b: b['cy'])
        rows, cur_row = [], [gp[0]]
        for b in gp[1:]:
            if b['cy'] - cur_row[-1]['cy'] <= row_tol:
                cur_row.append(b)
            else:
                rows.append(cur_row)
                cur_row = [b]
        rows.append(cur_row)
        if len(rows) < min_rows:
            continue
        xs = [b['bbox'][0] for b in gp] + [b['bbox'][2] for b in gp]
        ys = [b['bbox'][1] for b in gp] + [b['bbox'][3] for b in gp]
        bbox = [min(xs), min(ys), max(xs), max(ys)]
        # 可滚提示（第 3 步，2026-10-18）：**只给提示，不给断言**。
        # 依据（都可从已经识别到的文本直接算，零额外开销）：
        #   ① 界面自带的滚动键提示（活动页左上角画着 W/S，实测滚它确实动）
        #   ② 末行贴着面板下沿（内容顶到边界 ⇒ 更可能还有）
        # 真值仍以 `ys-scroll-scan --check` 的行为判定为准——这两条只是让调用方**动手前**
        # 就知道"这块可能要滚"，而不是把"这一屏没看到"当成"不存在"。
        HINTS = {'W', 'S', 'w', 's', '▲', '▼', '↑', '↓'}
        hint_tokens = sorted({t.strip() for r in rows for t in
                              [x['text'] for x in r] if t.strip() in HINTS})
        last_y = max(b['cy'] for b in gp)
        to_edge = bbox[3] - last_y
        # ⚠️ 只有**明确提示**才判 yes；其余一律 unknown。
        # 为什么不给"maybe"：实测世界页队伍栏（5 行、末行距边 20px、行距均匀）看着很像可滚，
        # 但行为验证（ys-scroll-scan）证明它**不可滚**。单帧无法确定"后面还有没有内容"——
        # 与其给一个会误导人的弱结论，不如如实说"不知道，请用 --check 验"。
        scrollable = 'yes' if hint_tokens else 'unknown'
        out.append({
            'bbox': bbox,
            'scroll_hint': {'key_tokens': hint_tokens, 'last_row_to_edge': int(to_edge),
                            'scrollable': scrollable,
                            'note': ('有滚动键提示，可直接滚' if hint_tokens
                                     else '单帧无法判定；要真值请跑 ys-scroll-scan --check')},
            'n_rows': len(rows),
            'row_y': [int(sum(b['cy'] for b in r) / len(r)) for r in rows],
            'rows': [{'y': int(sum(b['cy'] for b in r) / len(r)),
                      'texts': [b['text'] for b in r]} for r in rows],
        })
    # 大面板排前面（主内容区优先），行数多的次之
    out.sort(key=lambda p: (-(p['bbox'][2] - p['bbox'][0]) * (p['bbox'][3] - p['bbox'][1]),
                            -p['n_rows']))
    return out


def find_regions(arr, scale, W0, H0, occl, debug=False):
    """分区：靠"长直边"定边界（顶栏/左侧栏/右侧栏/底栏），画布靠"大片平坦亮面"。"""
    import numpy as np
    g = arr.astype(np.float32).mean(axis=2)
    H, W = g.shape
    dx = np.abs(np.diff(g, axis=1))
    dy = np.abs(np.diff(g, axis=0))
    colcov = (dx > 28).mean(axis=0)          # 每一列上"有台阶"的行占比
    rowcov = (dy > 28).mean(axis=1)
    regions = []

    def pick(profile, lo, hi):
        lo, hi = max(1, lo), min(len(profile) - 1, hi)
        if hi <= lo:
            return None
        seg = profile[lo:hi]
        i = int(np.argmax(seg))
        return (lo + i, float(seg[i])) if seg[i] >= REGION_EDGE_COVER else None

    left = pick(colcov, int(W * 0.02), int(W * 0.35))
    right = pick(colcov, int(W * 0.65), int(W * 0.98))
    top = pick(rowcov, int(H * 0.01), int(H * 0.14))
    bottom = pick(rowcov, int(H * 0.86), int(H * 0.99))

    if top:
        regions.append({'name': '顶栏', 'bbox': [0, 0, W0, int(round(top[0] / scale))],
                        'why': '横边长直边 y=%d（覆盖 %.0f%% 宽）' % (
                            int(top[0] / scale), top[1] * 100)})
    if left:
        regions.append({'name': '左侧栏', 'bbox': [0, 0, int(round(left[0] / scale)), H0],
                        'why': '竖边长直边 x=%d（覆盖 %.0f%% 高）' % (
                            int(left[0] / scale), left[1] * 100)})
    if right:
        regions.append({'name': '右侧栏', 'bbox': [int(round(right[0] / scale)), 0, W0, H0],
                        'why': '竖边长直边 x=%d（覆盖 %.0f%% 高）' % (
                            int(right[0] / scale), right[1] * 100)})
    if bottom:
        regions.append({'name': '底栏', 'bbox': [0, int(round(bottom[0] / scale)), W0, H0],
                        'why': '横边长直边 y=%d（覆盖 %.0f%% 宽）' % (
                            int(bottom[0] / scale), bottom[1] * 100)})

    # 画布：大片"平坦亮面"（编辑器 3D 视口在菜单页是纯白平面）
    bright = (g > 205) & (_box_filter(g, 2) > 205)
    if bright.any():
        labels, stats = _label_mask(bright)
        big = [s for s in stats if s['area'] > 0.06 * W * H]
        if big:
            st = max(big, key=lambda s: s['area'])
            x0, y0, x1, y1 = st['bbox']
            regions.append({'name': '画布',
                            'bbox': [int(x0 / scale), int(y0 / scale),
                                     int(x1 / scale), int(y1 / scale)],
                            'why': '最大平坦亮面（面积 %.0f%% 帧）' % (
                                100.0 * st['area'] / (W * H))})
    if debug:
        sys.stderr.write('[ys-screen] regions=%s\n' % [(r['name'], r['bbox']) for r in regions])
    return regions


def region_of(box, regions):
    """点/框落在哪个分区（中心点命中优先，否则返回 None）。"""
    cx, cy = (box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0
    for r in regions:
        x0, y0, x1, y1 = r['bbox']
        if x0 <= cx <= x1 and y0 <= cy <= y1:
            return r['name']
    return None


# --------------------------------------------------------------------------- 容器层
# 为什么单独一层：现有 text/controls/regions 输出的是"文本行"与"对比度团块"，不是**界面结构**
# （2026-10-18 实测：8 帧里人眼可点单元 124 个，工具只对 1 个给出 IoU≥0.4 的对象）。容器层补的是
# 「这里有一块规整皮肤色的可点单元」这一事实，以及"哪些文字/图标/红点属于它"。
# 判据与阈值全部来自已验证原型，见文件头"容器层的实现依据"。

def _lab_flat_energy(arr):
    """返回 (Lab uint8, 三通道 Sobel 合能量的**平方** E²)。

    用整数 Sobel（CV_16S）算平方能量，而不是 float Sobel + sqrt：两者**逐像素等价**
    （ksize=3 的整数核响应与 float 版相同；E²<36 ⟺ E<6），实测 33ms → 19ms（1280×720）。
    """
    import cv2
    import numpy as np
    lab = cv2.cvtColor(arr, cv2.COLOR_RGB2LAB)
    e2 = None
    for c in range(3):
        g = cv2.Sobel(lab[..., c], cv2.CV_16S, 1, 0, ksize=3)
        h = cv2.Sobel(lab[..., c], cv2.CV_16S, 0, 1, ksize=3)
        m = g.astype(np.int32) ** 2 + h.astype(np.int32) ** 2
        e2 = m if e2 is None else e2 + m
    return lab, e2


def _flat_container_candidates(arr, scale):
    """flat+rect 容器候选（原型 `p2_containers.py:detect`，逻辑照搬）。

    判据：Lab 三通道 Sobel 合能量 E<6 ⇒ 平坦像素；5×5 闭；8-连通；矩形度 ≥0.55。
    世界里的天空/地面/水面同样平坦，但矩形规整度低 ⇒ 大多过不了矩形度这一关，
    漏网的由 `_containers_evidenced` 的两条证据判据清掉。
    """
    import cv2
    import numpy as np
    lab, e2 = _lab_flat_energy(arr)
    flat = (e2 < CONTAINER_EDGE_SQ).astype(np.uint8)
    flat = cv2.morphologyEx(flat, cv2.MORPH_CLOSE,
                            np.ones((CONTAINER_CLOSE, CONTAINER_CLOSE), np.uint8))
    min_w = max(4, int(round(CONTAINER_MIN_W_FULL * scale)))
    min_h = max(4, int(round(CONTAINER_MIN_H_FULL * scale)))
    n, cc, stats, _ = cv2.connectedComponentsWithStats(flat, 8)
    out = []
    for i in range(1, n):
        x, y, w, h, a = stats[i]
        if w < min_w or h < min_h:
            continue
        rect = a / float(w * h)
        if rect < CONTAINER_MIN_RECT:
            continue
        m = cc[y:y + h, x:x + w] == i
        med = np.median(lab[y:y + h, x:x + w][m], 0)
        fill = float((e2[y:y + h, x:x + w] < CONTAINER_EDGE_SQ).mean())
        out.append({
            'bbox': [int(round(x / scale)), int(round(y / scale)),
                     int(round((x + w) / scale)), int(round((y + h) / scale))],
            'skin': {'lab': [round(float(v), 1) for v in med],
                     'fill': round(fill, 2), 'rect': round(float(rect), 2)},
            'area_px': int(round(a / (scale * scale))),
        })
    return out


def _containers_evidenced(cands, text_boxes, hud):
    """两条证据判据（满足任一才留）：①同皮肤色兄弟 ≥1 ②内含**界面**文本 ≥1。

    这是**世界假阳性过滤器**（设计文档 §2.2 第一行）：世界的天空/沙滩/水面一样平坦，
    但既没有同色兄弟、也没有文字。实测 world 帧唯一个候选被这条清掉。

    HUD 文本（DXVK 读数 / UID / 延迟）**不算**界面文本——设计文档对屏边残留条给的解法就是
    「接 `_known_hud` 掩膜」。两条边界都要守住：
      · 兄弟判据不受影响：被 HUD 压住的真格子（f07 底行 `装扮搭配` 那个框）靠同皮肤色兄弟活下来；
      · 所以这里只**不给 HUD 文本记分**，绝不因为"框中心在 HUD 角里"就单独否决容器
        （f07 底行格子的中心正好落在左下 HUD 框内，按中心否决会误杀真格子）。
    """
    import numpy as np
    meds = np.array([c['skin']['lab'] for c in cands], dtype=np.float32)
    out = []
    for i, c in enumerate(cands):
        sib = 0
        if len(meds) > 1:
            d = np.linalg.norm(meds - meds[i], axis=1)
            d[i] = 1e9
            sib = int((d <= CONTAINER_PAL_TOL).sum())
        bound, ui_bound = [], []
        for t in text_boxes:
            bb = t['bbox']
            cx, cy = (bb[0] + bb[2]) / 2.0, (bb[1] + bb[3]) / 2.0
            if c['bbox'][0] <= cx <= c['bbox'][2] and c['bbox'][1] <= cy <= c['bbox'][3]:
                bound.append(t)
                if not _in_hud(bb, hud):
                    ui_bound.append(t)
        if sib >= 1 or ui_bound:
            c['skin_siblings'] = sib
            c['_text_in'] = bound
            c['_text_ui'] = len(ui_bound)
            out.append(c)
    return out


def _grid_evidence(kept):
    """每块容器的行列规整度（kind=tile 的判据）：尺寸相近的同行/同列邻居 + 最近中心距。

    只做**几何**判断（设计文档 §2.3-①：结构不猜语义）——同行等距只说明"它们是一组格子"，
    不说明"这是背包格子还是活动格子"。
    """
    ev = []
    for i, a in enumerate(kept):
        ax0, ay0, ax1, ay1 = a['bbox']
        aw, ah = ax1 - ax0, ay1 - ay0
        acx, acy = (ax0 + ax1) / 2.0, (ay0 + ay1) / 2.0
        row_n, col_n, dxs, dys = 0, 0, [], []
        for j, b in enumerate(kept):
            if i == j:
                continue
            bx0, by0, bx1, by1 = b['bbox']
            bw, bh = bx1 - bx0, by1 - by0
            bcx, bcy = (bx0 + bx1) / 2.0, (by0 + by1) / 2.0
            # 同行只看**高度**像不像、同列只看**宽度**像不像：这样"被裁矮的同一行格子"
            # （f07 顶部 174×64 与 174×156）仍算同列，而"上下两块面板碎片"不会互相冒充格子
            if abs(bh - ah) <= 0.25 * max(ah, bh) and abs(bcy - acy) <= 0.30 * max(ah, bh):
                row_n += 1
                dxs.append(abs(bcx - acx))
            if abs(bw - aw) <= 0.25 * max(aw, bw) and abs(bcx - acx) <= 0.30 * max(aw, bw):
                col_n += 1
                dys.append(abs(bcy - acy))
        e = {'row_n': row_n, 'col_n': col_n, 'in_grid': bool(row_n or col_n)}
        if dxs:
            e['pitch_x'] = round(sorted(dxs)[0], 1)
        if dys:
            e['pitch_y'] = round(sorted(dys)[0], 1)
        ev.append(e)
    return ev


def _container_kind(bb, grid, W0, H0):
    """形状角色：tile/card/row/button/panel/chip，判不出就 `unknown`（不猜语义）。

    规则（顺序即优先级，实测标定见设计文档 §2.2 第二行）：
      · **同行且同列**都等距 + 长宽比 0.6~4.0 ⇒ tile——f06 格子 174×156（aspect 1.12）；
        f07 顶部那一行被滚动裁成 174×64，仍与同列格子 pitch_x=208 对齐，也算 tile。
        只要求一轴对齐的不算 tile（f00 左侧面板被撕裂成上下两块，只在同一列 ⇒ 不硬称 tile）
      · 占屏 ≥5% 且长宽比在 0.25~8 ⇒ panel（f00 左侧列表面板 386×568）
      · 高 ≤100 且长宽比 ≥1.3 ⇒ button（药丸按钮 330×74）
      · 高 ≤60 ⇒ chip（细条）
      · 长宽比 ≥2 ⇒ row（整条底栏 1840×182）
      · 占屏 ≥2% 且 1≤长宽比≤3 ⇒ card
      · 其余 ⇒ unknown（例：f06 的 120×1354 屏边竖条——**确实不该硬塞一个名字**）
    """
    x0, y0, x1, y1 = bb
    w, h = x1 - x0, y1 - y0
    aspect = w / float(h) if h else 0.0
    frac = (w * h) / float(W0 * H0)
    if grid['row_n'] >= 1 and grid['col_n'] >= 1 and 0.6 <= aspect <= 4.0:
        return 'tile'
    if frac >= CONTAINER_PANEL_FRAC and 0.25 <= aspect <= 8.0:
        return 'panel'
    if h <= 100 and 1.3 <= aspect <= 8.0:
        return 'button'
    if h <= 60:
        return 'chip'
    if aspect >= 2.0:
        return 'row'
    if frac >= CONTAINER_CARD_FRAC and 1.0 <= aspect <= 3.0:
        return 'card'
    return 'unknown'


def _containers_clipped(bb, parent_bb, W0, H0):
    """裁切：越过父容器/贴屏边 ⇒ {edges, cut_by, px}。

    `px` 只在"越过父容器"时给真实像素数；贴屏边时恒 0——被屏幕裁掉多少在**帧外不可测**，
    这里只声明"它碰到了边"，不编造裁切量（否则下游会按假数字推算可见比例）。
    """
    edges, cut_by, px = [], None, 0
    if parent_bb:
        over = [('left', parent_bb[0] - bb[0]), ('top', parent_bb[1] - bb[1]),
                ('right', bb[2] - parent_bb[2]), ('bottom', bb[3] - parent_bb[3])]
        hit = [(k, v) for k, v in over if v > 0]
        if hit:
            edges = [k for k, _ in hit]
            cut_by = 'parent'
            px = int(max(v for _, v in hit))
    if not edges:
        for name, t in (('left', bb[0] <= 0), ('top', bb[1] <= 0),
                        ('right', bb[2] >= W0), ('bottom', bb[3] >= H0)):
            if t:
                edges.append(name)
        if edges:
            cut_by = 'screen'
    return {'edges': edges, 'cut_by': cut_by, 'px': px}


def _owner_of(center, kept, pad=0):
    """中心点归属：包含它的**最小面积**容器（设计文档 §2.2「text[] → 归属」）。

    pad>0 时把容器 bbox 外扩（角标常压在边界上，红点中心可能落在框外几像素）。
    """
    cx, cy = center
    cand = [c for c in kept
            if c['bbox'][0] - pad <= cx <= c['bbox'][2] + pad
            and c['bbox'][1] - pad <= cy <= c['bbox'][3] + pad]
    return min(cand, key=lambda c: c['area_px']) if cand else None


def _corner_of(center, bb):
    """中心点离容器哪个角最近（tile → tr/bl/br），角标字段用。"""
    cx, cy = center
    corners = {'tl': (bb[0], bb[1]), 'tr': (bb[2], bb[1]),
               'bl': (bb[0], bb[3]), 'br': (bb[2], bb[3])}
    return min(corners, key=lambda k: (cx - corners[k][0]) ** 2 + (cy - corners[k][1]) ** 2)


def _find_glyphs(arr, scale, text_boxes):
    """纯图形叶子：局部对比显著性 |Lab − medianBlur(31)| 三通道和 >45；闭 5×5；16~140px；填充 ≥0.25。

    两处与原型 `ysui.py:glyphs` 的差别（都在"字段语义"上，算法本身照搬）：
      · 原型把容器内部整块挖掉（glyph 只能落在容器外）；这里**全帧找、再按最小包含容器归属**
        ——容器里的图标本来就是那个容器的一部分，挖掉就等于报不出"这格有图标"。
      · 原型没遮文字；这里把 OCR 框（外扩 2px）从掩膜里去掉——汉字本身是最强对比团块，
        不遮的话 glyphs 会退化成 text 的副本（字段语义：`glyphs` = 纯图形）。
    """
    import cv2
    import numpy as np
    lab = cv2.cvtColor(arr, cv2.COLOR_RGB2LAB).astype(np.float32)
    bg = cv2.medianBlur(arr, 31)
    dif = np.abs(cv2.cvtColor(bg, cv2.COLOR_RGB2LAB).astype(np.float32) - lab).sum(2)
    m = (dif > GLYPH_DIFF).astype(np.uint8)
    H, W = m.shape
    for t in text_boxes:
        bb = t['bbox']
        x0 = max(0, int(bb[0] * scale) - 2)
        y0 = max(0, int(bb[1] * scale) - 2)
        x1 = min(W, int(bb[2] * scale) + 2)
        y1 = min(H, int(bb[3] * scale) + 2)
        m[y0:y1, x0:x1] = 0
    m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((GLYPH_CLOSE, GLYPH_CLOSE), np.uint8))
    min_s = max(4, int(round(GLYPH_MIN_SIDE * scale)))
    max_s = max(min_s + 1, int(round(GLYPH_MAX_SIDE * scale)))
    n, _, stats, _ = cv2.connectedComponentsWithStats(m, 8)
    out = []
    for i in range(1, n):
        x, y, w, h, a = stats[i]
        if w < min_s or h < min_s or w > max_s or h > max_s:
            continue
        if a < GLYPH_MIN_FILL * w * h:
            continue
        out.append({'bbox': [int(round(x / scale)), int(round(y / scale)),
                             int(round((x + w) / scale)), int(round((y + h) / scale))],
                    'role': 'icon', 'fill': round(float(a / (w * h)), 2),
                    'contrast': round(float(dif[y:y + h, x:x + w].max()), 1)})
    out.sort(key=lambda d: -d['fill'])
    return out


def _find_badges(arr, scale):
    """红点角标：R>140 且 R−G>55 且 R−B>40；边长 14~90、面积 ≥90、长宽比 0.6~1.7（全帧像素）。

    只报形状事实（`kind=alert` = 形状角色里的"红点"），不猜"这是未读还是可领取"。
    """
    import cv2
    import numpy as np
    r = arr[..., 0].astype(np.int16)
    g = arr[..., 1].astype(np.int16)
    b = arr[..., 2].astype(np.int16)
    m = ((r > BADGE_R) & (r - g > BADGE_RG) & (r - b > BADGE_RB)).astype(np.uint8)
    m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))
    min_s = max(3, int(round(BADGE_MIN_SIDE * scale)))
    max_s = max(min_s + 1, int(round(BADGE_MAX_SIDE * scale)))
    min_area = BADGE_MIN_AREA * scale * scale
    n, _, stats, _ = cv2.connectedComponentsWithStats(m, 8)
    out = []
    for i in range(1, n):
        x, y, w, h, a = stats[i]
        if a < min_area or not (min_s <= w <= max_s and min_s <= h <= max_s):
            continue
        if not (BADGE_ASPECT[0] <= w / float(h) <= BADGE_ASPECT[1]):
            continue
        out.append({'bbox': [int(round(x / scale)), int(round(y / scale)),
                             int(round((x + w) / scale)), int(round((y + h) / scale))],
                    'kind': 'alert', 'color': 'red',
                    'area_px': int(round(a / (scale * scale)))})
    return out


def find_containers(arr, scale, W0, H0, text_boxes, debug=False):
    """容器层：L3 平坦皮肤容器 + 文本/图形/角标叶子归属。返回 dict。

    返回 {containers[], free_text[], free_glyphs[], degraded, error}。
    分层按设计文档 §2.1：containers 是 L2/L3 实体；text/glyphs/badges 是**必须归属**的叶子；
    归属不进去的文本落 `free_text[]`、图形落 `free_glyphs[]`；角标归属不到容器就**丢弃**
    （§2.2：「必须归属到某容器角」）。

    **fail-closed（§2.3-③）**：像素管线任何异常 ⇒ containers=[] + degraded=True + error，
    绝不返回半成品结构——下游宁可"看不见"，也不要按假结构乱点。

    已知**未闭合**（§2.2 第三行 / §五-1）：卡片贴在彩色插画上（f04 的五张白卡、f05 的任务卡/
    药丸按钮）——卡内不平坦（E 中位 17.9~66.5）、边界 ΔE 只有 5.5，本管线检不出来，
    于是**不输出**它们（漏检，不是假对象）。
    """
    t0 = time.time()
    res = {'containers': [], 'free_text': [], 'free_glyphs': [],
           'degraded': False, 'error': None}
    try:
        cands = _flat_container_candidates(arr, scale)
        hud = _known_hud(W0, H0)
        kept = _containers_evidenced(cands, text_boxes, hud)
        for c, g in zip(kept, _grid_evidence(kept)):
            c['_grid'] = g
        # 大块在前：parent 用"面积更小的包含者"求 ⇒ 父永远排在子前面，id 可读
        kept.sort(key=lambda c: (-c['area_px'], c['bbox'][1], c['bbox'][0]))
        for i, c in enumerate(kept):
            c['id'] = 'c%d' % i
        # parent = 几何包含（最小包含者）；**不反推面板**——那需要在 §2.2 里标为未闭合的粘连处理
        for c in kept:
            bb = c['bbox']
            holders = [p for p in kept if p is not c
                       and p['bbox'][0] <= bb[0] and p['bbox'][1] <= bb[1]
                       and p['bbox'][2] >= bb[2] and p['bbox'][3] >= bb[3]]
            c['_parent'] = (min(holders, key=lambda p: p['area_px'])['id']
                            if holders else None)

        glyphs = _find_glyphs(arr, scale, text_boxes)
        badges = _find_badges(arr, scale)
        pad = int(round(CONTAINER_BADGE_PAD_FULL * scale))
        # 叶子归属：文本（必须归属）、图形（归属不到就记 free_glyphs）、角标（归属不到就丢）
        kids = {c['id']: {'text': [], 'glyphs': [], 'badges': []} for c in kept}
        free_text = []
        for t in text_boxes:
            bb = t['bbox']
            owner = _owner_of(((bb[0] + bb[2]) / 2.0, (bb[1] + bb[3]) / 2.0), kept)
            if owner is None:
                free_text.append(t['text'])
            else:
                kids[owner['id']]['text'].append(t['text'])
        free_glyphs = []
        for gl in glyphs:
            bb = gl['bbox']
            owner = _owner_of(((bb[0] + bb[2]) / 2.0, (bb[1] + bb[3]) / 2.0), kept)
            if owner is None:
                free_glyphs.append(gl)
            else:
                kids[owner['id']]['glyphs'].append(gl)
        for bd in badges:
            bb = bd['bbox']
            owner = _owner_of(((bb[0] + bb[2]) / 2.0, (bb[1] + bb[3]) / 2.0), kept, pad)
            if owner is None:
                continue                       # §2.2：角标必须归属到某容器角，否则不报
            kids[owner['id']]['badges'].append(
                {'bbox': bb, 'corner': _corner_of(((bb[0] + bb[2]) / 2.0,
                                                   (bb[1] + bb[3]) / 2.0), owner['bbox']),
                 'kind': bd['kind'], 'color': bd['color']})

        parents = {c['id']: c['_parent'] for c in kept}
        out = []
        for c in kept:
            bb = c['bbox']
            x0, y0, x1, y1 = bb
            w, h = x1 - x0, y1 - y0
            aspect = w / float(h) if h else 0.0
            frac = (w * h) / float(W0 * H0)
            g = c['_grid']
            k = kids[c['id']]
            sib = c['skin_siblings']
            n_text = len(k['text'])
            kind = _container_kind(bb, g, W0, H0)
            parent_bb = next((p['bbox'] for p in kept if p['id'] == parents[c['id']]), None)
            # confidence 是**证据强度**（不是概率）：皮肤色矩形度 + 兄弟 + 文本 + 成网格
            conf = 0.35 + 0.20 * c['skin']['rect']
            conf += 0.15 if sib >= 1 else 0.0
            conf += 0.15 if n_text else 0.0
            conf += 0.10 if g['in_grid'] else 0.0
            aff_ev = ['skin_siblings:%d' % sib]
            if n_text:
                aff_ev.append('text_in:%d' % n_text)
            if g['in_grid']:
                aff_ev.append('grid:%s' % ('row' if g['row_n'] else 'col'))
            aff_ev.append('hover:none(未采集按下/hover 态 ⇒ 不敢判 yes)')
            grid_s = 'none'
            if g['in_grid']:
                grid_s = '%s n=%d pitch_x=%s pitch_y=%s' % (
                    'row' if g['row_n'] else 'col', max(g['row_n'], g['col_n']),
                    g.get('pitch_x'), g.get('pitch_y'))
            out.append({
                'id': c['id'], 'parent': parents[c['id']], 'bbox': bb, 'kind': kind,
                'skin': c['skin'],
                'text': k['text'],
                'glyphs': k['glyphs'],
                'badges': k['badges'],
                'affordance': {'clickable': 'unknown', 'evidence': aff_ev},
                'clipped': _containers_clipped(bb, parent_bb, W0, H0),
                'confidence': round(min(0.95, conf), 2),
                'evidence': {
                    'rule': 'flat+rect: E<%g, 闭%dx%d, 8-连通, rect>=%.2f, '
                            '(%d 个同皮肤色兄弟 ΔE<=%g / 内含界面文本 %d)' % (
                                CONTAINER_EDGE, CONTAINER_CLOSE, CONTAINER_CLOSE,
                                CONTAINER_MIN_RECT, sib, CONTAINER_PAL_TOL, c['_text_ui']),
                    'area_px': c['area_px'], 'area_frac': round(frac, 4),
                    'aspect': round(aspect, 2), 'grid': grid_s,
                    'skin_siblings': sib, 'text_in': n_text, 'text_ui': c['_text_ui'],
                    'skin_lab': c['skin']['lab'], 'flat_fill': c['skin']['fill'],
                    'rect': c['skin']['rect'],
                },
            })
        res['containers'] = out
        res['free_text'] = free_text
        res['free_glyphs'] = free_glyphs
    except Exception as exc:            # noqa: BLE001 —— fail-closed：异常必须变成 degraded
        res['containers'] = []
        res['free_text'] = []
        res['free_glyphs'] = []
        res['degraded'] = True
        res['error'] = '%s: %s' % (type(exc).__name__, exc)
    if debug:
        sys.stderr.write('[ys-screen] containers=%d free_text=%d free_glyphs=%d degraded=%s '
                         '(%dms)\n' % (len(res['containers']), len(res['free_text']),
                                       len(res['free_glyphs']), res['degraded'],
                                       int((time.time() - t0) * 1000)))
        for c in res['containers']:
            sys.stderr.write('  %s %s kind=%-7s conf=%.2f text=%d glyphs=%d badges=%d\n'
                             % (c['id'], c['bbox'], c['kind'], c['confidence'],
                                len(c['text']), len(c['glyphs']), len(c['badges'])))
    return res



# ============================ 可插拔检测后端（票 24） ============================
# 为什么要有它（不是"换实现"而是"换通道"）：现行 `flat+rect` 判据在**不透明纯色**格子/行上已闭合
# （票 23 记分器实测 tile 56/56=100%），但在**纯图标/头像/按钮/贴插画卡**上恒 0 命中
# （icon 0/38、avatar 0/8、chip 0/4、button 2/46）。这些对象没有"平坦皮肤"这个前提，
# 属判据假设失效而非阈值问题 ⇒ 需要一条**学习型**通道并行提供 bbox。
# 本后端约定：**只产 detected bbox，不产语义**（kind 由模型类别表映射，confidence 原样透出），
# 且 **cv 永远是默认**（默认路径逐字节不变），onnx 必须显式 `--backend onnx` 才走。
DETECT_KINDS = ('tile', 'card', 'button', 'row', 'panel', 'chip', 'icon', 'avatar')


def _detect_backend_sig(backend, model):
    """后端标识（进缓存键）：cv / onnx:<模型 sha256 前 12 位>。

    两套后端必须**互不污染缓存**——2026-10-18 实测过的同类坑：只按帧 sha 缓存会让换后端后
    读到旧结构（`CONTAINER_RULESET` 就是为这个加的）。模型换了参数而路径不变时只按路径哈希
    会读到旧结构，所以这里哈的是**模型文件内容**。
    """
    if backend == 'torch':
        return 'torchstub-v1'
    if backend != 'onnx' or not model:
        return 'cv'
    if model.startswith('mock:'):
        return 'onnx-mock-' + hashlib.sha1(model.encode('utf-8')).hexdigest()[:12]
    try:
        h = hashlib.sha256()
        with open(model, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
        return 'onnx-' + h.hexdigest()[:12]
    except OSError as exc:
        raise RuntimeError('检测模型不可读：%s（%s）' % (model, exc))


def _onnx_session(model, providers, debug=False):
    """懒加载 + 进程内复用 ORT session。

    **fail-closed 两条硬约束**（2026-10-18 实测教训）：
      ① 请求了 CUDA 而 `sess.get_providers()` 里没有 CUDA ⇒ 抛错，不拿 CPU 数字冒充 GPU
         （ORT 缺 cuDNN/CUDA 时**不抛异常**，只打一行 warning 然后静默回落 CPU）。
      ② 模型缺失/不可解析 ⇒ 抛错（不静默降级到 cv，否则"看起来跑了"但其实是旧通道）。
    """
    import onnxruntime as ort
    cache = globals().setdefault('_ORT_SESSIONS', {})
    key = (os.path.abspath(model) if not model.startswith('mock:') else model, tuple(providers))
    if key in cache:
        return cache[key]
    want = list(providers)
    so = ort.SessionOptions()
    so.log_severity_level = 3
    sess = ort.InferenceSession(model, sess_options=so, providers=want)
    actual = sess.get_providers()
    if want and want[0] == 'CUDAExecutionProvider' and 'CUDAExecutionProvider' not in actual:
        raise RuntimeError('请求 CUDAExecutionProvider 但实际 providers=%s（ORT 静默回落 CPU；'
                           '先查 cuDNN9/CUDA13 与 register_execution_provider_library）' % (actual,))
    if debug:
        sys.stderr.write('[ys-screen] detect backend=onnx model=%s providers=%s\n'
                         % (os.path.basename(model), actual))
    cache[key] = sess
    return sess



# ---- torch fp16 检测 stub（票 24 阶段 1：只证明链路与耗时，**随机权重、不具语义**）----
# 为什么先做 stub：Lead 会话实测 U-Net@640 fp16 = **10.65ms**（base8）/ 10.79ms（base16），
# 说明"检测一手 ≤10ms"在算力上已成立；剩下要证明的是**接线**：检测输出 → containers[] →
# 世界状态 schema → 记分器。stub 用固定种子的随机权重 U-Net，输出当"objectness 热图"，
# 阈值+连通域成框。**读数用途必须分清**：本后端的 ms 是能力读数，它产出的 bbox **不是**能力读数
# （随机权重 ⇒ 框没有语义，禁止拿它的 coverage 记分当精度）。
def _torch_stub_net(base=8, depth=4):
    """与 bench_gpu.py 同构的轻量 U-Net（3 通道入、1 通道 objectness 出）。"""
    import torch
    import torch.nn as nn

    def block(cin, cout):
        return nn.Sequential(nn.Conv2d(cin, cout, 3, padding=1), nn.ReLU(inplace=True),
                             nn.Conv2d(cout, cout, 3, padding=1), nn.ReLU(inplace=True))

    class UNet(nn.Module):
        def __init__(self):
            super().__init__()
            chans = [base * (2 ** i) for i in range(depth + 1)]
            self.enc = nn.ModuleList()
            cin = 3
            for c in chans[:-1]:
                self.enc.append(block(cin, c))
                cin = c
            self.bottleneck = block(chans[-2], chans[-1])
            self.up = nn.ModuleList()
            self.dec = nn.ModuleList()
            for i in reversed(range(depth)):
                self.up.append(nn.ConvTranspose2d(chans[i + 1], chans[i], 2, 2))
                self.dec.append(block(chans[i] * 2, chans[i]))
            self.head = nn.Conv2d(chans[0], 1, 1)
            self.pool = nn.MaxPool2d(2)

        def forward(self, x):
            sk = []
            for e in self.enc:
                x = e(x)
                sk.append(x)
                x = self.pool(x)
            x = self.bottleneck(x)
            for i in range(depth):
                x = self.up[i](x)
                x = torch.cat([x, sk[depth - 1 - i]], dim=1)
                x = self.dec[i](x)
            return self.head(x)

    return UNet()


def _torch_stub_detect(arr, size=640, threshold=1.0, min_area=400,
                       device=None, dtype='fp16', seed=0):
    """跑一次 stub 前向 → objectness 热图 → 阈值 + 连通域 → 框（**原帧坐标 xyxy**）。

    `threshold` 是热图分位数（1.0 = 取最高的 1% 像素）：随机权重下热图无意义，
    用分位数量化才能稳定产出固定数量的框，方便验证接线可重复。
    """
    import numpy as np
    import torch
    from PIL import Image
    from scipy import ndimage
    torch.manual_seed(seed)
    net = _torch_stub_net()
    if device is None:
        device = 'cuda' if torch.cuda.is_available() else 'cpu'
    net = net.to(device).eval()
    if dtype == 'fp16' and device == 'cuda':
        net = net.half()
    H0, W0 = arr.shape[:2]
    im = Image.fromarray(arr).convert('RGB').resize((size, size), Image.BILINEAR)
    x = np.asarray(im, dtype=np.float32).transpose(2, 0, 1)[None] / 255.0
    t = torch.from_numpy(x).to(device)
    if dtype == 'fp16' and device == 'cuda':
        t = t.half()
    t0 = time.time()
    with torch.no_grad():
        out = net(t)
        if device == 'cuda':
            torch.cuda.synchronize()
    fwd_ms = (time.time() - t0) * 1000
    heat = out[0, 0].float().cpu().numpy()
    heat = (heat - heat.min()) / (float(np.ptp(heat)) + 1e-6)   # numpy 2.x 无 ndarray.ptp
    thr = float(np.quantile(heat, 1.0 - max(0.001, min(0.2, threshold / 100.0))))
    mask = heat > thr
    mask = ndimage.binary_closing(mask, np.ones((5, 5)))
    lab, n = ndimage.label(mask)
    sy, sx = H0 / float(size), W0 / float(size)
    dets = []
    # **不要**逐标签 np.where(lab==i)：377 个连通域 × 640² 全图比较实测把后处理拖到 ~800ms
    # （比网络前向 70ms 还贵 10 倍）。find_objects 是 C 层一次扫描，实测整段 <15ms。
    for i, sl in enumerate(ndimage.find_objects(lab), start=1):
        if sl is None:
            continue
        ys, xs = sl
        x0, x1 = int(xs.start * sx), int(xs.stop * sx)
        y0, y1 = int(ys.start * sy), int(ys.stop * sy)
        area = (x1 - x0) * (y1 - y0)
        if area < min_area:
            continue
        score = float(min(0.99, 0.5 + 0.5 * float(heat[ys, xs].mean())))
        dets.append([x0, y0, x1, y1, score, 0])
    dets.sort(key=lambda d: -d[4])
    return dets, {'forward_ms': round(fwd_ms, 2), 'device': device, 'dtype': dtype,
                  'heat_thr': round(thr, 4), 'boxes': len(dets)}


def find_containers_torch(arr, scale, W0, H0, text_boxes, size=640, threshold=1.0,
                          min_area=400, device=None, dtype='fp16', debug=False,
                          kind_map=None, timing_out=None):
    """torch fp16 stub 通道：与 find_containers_onnx 同形的返回（bbox=xyxy 原帧坐标）。"""
    t0 = time.time()
    res = {'containers': [], 'free_text': [], 'free_glyphs': [], 'degraded': False, 'error': None}
    try:
        dets, info = _torch_stub_detect(arr, size=size, threshold=threshold,
                                        min_area=min_area, device=device, dtype=dtype)
        if timing_out is not None:
            timing_out.update(info)
        kinds = list(kind_map or DETECT_KINDS)
        conts = []
        for d in dets:
            conts.append({'bbox': [max(0, d[0]), max(0, d[1]), min(W0, d[2]), min(H0, d[3])],
                          'kind': kinds[int(d[5]) % len(kinds)], 'score': d[4]})
        conts.sort(key=lambda c: (-(c['bbox'][2] - c['bbox'][0]) * (c['bbox'][3] - c['bbox'][1]),
                                  c['bbox'][1], c['bbox'][0]))
        for i, c in enumerate(conts):
            c['id'] = 't%d' % i
        tb = [t['bbox'] for t in text_boxes]
        used = set()
        out = []
        for c in conts:
            bb = c['bbox']
            texts = []
            for j, tbb in enumerate(tb):
                cx, cy = (tbb[0] + tbb[2]) / 2.0, (tbb[1] + tbb[3]) / 2.0
                if bb[0] <= cx <= bb[2] and bb[1] <= cy <= bb[3]:
                    texts.append(text_boxes[j]['text'])
                    used.add(j)
            holders = [p for p in conts if p is not c
                       and p['bbox'][0] <= bb[0] and p['bbox'][1] <= bb[1]
                       and p['bbox'][2] >= bb[2] and p['bbox'][3] >= bb[3]]
            parent = min(holders, key=lambda p: (p['bbox'][2] - p['bbox'][0]) *
                         (p['bbox'][3] - p['bbox'][1]))['id'] if holders else None
            parent_bb = next((p['bbox'] for p in conts if p['id'] == parent), None)
            out.append({
                'id': c['id'], 'parent': parent, 'bbox': bb, 'kind': c['kind'],
                'skin': {'lab': None, 'fill': None, 'rect': None},
                'text': texts, 'glyphs': [], 'badges': [],
                'affordance': {'clickable': 'unknown',
                               'evidence': ['detector_stub:%.3f(随机权重，无语义)' % c['score'],
                                            'hover:none(未采集按下/hover 态 ⇒ 不敢判 yes)']},
                'clipped': _containers_clipped(bb, parent_bb, W0, H0),
                'confidence': round(min(0.99, max(0.05, c['score'])), 3),
                'evidence': {'rule': 'detector:torch-stub(base=8,fp16,seed=0) 仅证明链路，不判语义',
                             'detector_score': round(c['score'], 4),
                             'area_px': int((bb[2] - bb[0]) * (bb[3] - bb[1])),
                             'text_in': len(texts)},
            })
        res['containers'] = out
        res['free_text'] = [text_boxes[j]['text'] for j in range(len(text_boxes))
                            if j not in used]
    except Exception as exc:            # noqa: BLE001 —— fail-closed
        res['containers'] = []
        res['free_text'] = []
        res['free_glyphs'] = []
        res['degraded'] = True
        res['error'] = 'detect-backend(torch): %s: %s' % (type(exc).__name__, exc)
    if debug:
        sys.stderr.write('[ys-screen] torch-stub containers=%d degraded=%s err=%s (%dms)\n'
                         % (len(res['containers']), res['degraded'], res['error'],
                            int((time.time() - t0) * 1000)))
    return res

def _parse_detect_output(out, in_w, in_h, fw, fh):
    """把模型输出解析成 [[x0,y0,x1,y1,score,cls], …]（**原帧坐标**）。

    支持的三种布局（先按形状判，判不出就报明确错，不猜）：
      A. (N,6) / (N,5+)：已是 [x0,y0,x1,y1,score,(cls)]（模型输入像素坐标）
      B. (1,M,4+nc) 或 (1,4+nc,M)：YOLOv8/11 导出形态 cx,cy,w,h + nc 个类分数
      C. (1,N,6)：同 A（多一层 batch 维）
    """
    import numpy as np
    arr = out[0] if isinstance(out, (list, tuple)) else out
    a = np.asarray(arr)
    if a.ndim == 3:
        a = a[0]
    if a.ndim != 2:
        raise RuntimeError('检测输出维度不支持：shape=%s' % (a.shape,))
    dets = []
    if a.shape[1] >= 4 and a.shape[1] <= 8 and a.shape[1] not in (5, 6, 7):
        # 极少见；按 A 处理
        pass
    if a.shape[1] >= 5 and a.shape[1] <= 8 and (a[:, :4].max() > 1.5 or a[:, 2:4].max() > 1.5):
        # A/C：像素坐标 xyxy（原点域 >1 说明不是 0..1 归一化）
        for row in a:
            score = float(row[4])
            cls = int(row[5]) if a.shape[1] >= 6 else 0
            if score < 0.0:
                continue
            dets.append([float(row[0]), float(row[1]), float(row[2]), float(row[3]), score, cls])
        return dets, 'xyxy-score-class'
    # B：YOLO 转置形态（4+nc 行 × M 列）
    if a.shape[0] >= 5 and a.shape[0] <= 4 + 200:
        a = a.T
    if a.shape[1] < 5:
        raise RuntimeError('检测输出形状无法识别：%s（期望 (N,6) 或 YOLO (1,4+nc,M)）'
                           % (np.asarray(arr).shape,))
    for row in a:
        cls_scores = row[4:]
        ci = int(np.argmax(cls_scores))
        score = float(cls_scores[ci])
        cx, cy, w, h = [float(v) for v in row[:4]]
        if max(w, h) <= 1.5:            # 归一化 cxcywh
            cx, cy, w, h = cx * in_w, cy * in_h, w * in_w, h * in_h
        dets.append([cx - w / 2.0, cy - h / 2.0, cx + w / 2.0, cy + h / 2.0, score, ci])
    return dets, 'yolo-cxcywh-classes'


def find_containers_onnx(arr, scale, W0, H0, text_boxes, model, providers=('CUDAExecutionProvider',
                                                                          'CPUExecutionProvider'),
                         min_score=0.25, max_det=200, kind_map=None, debug=False):
    """学习型检测通道：**返回与 find_containers 同形的 dict**（containers/free_text/free_glyphs/
    degraded/error），bbox 一律 **xyxy 原帧坐标**（与 cv 通道同口径）。

    预处理约定（训练/导出必须一致，写进模型卡）：整帧**拉伸**到模型输入尺寸、RGB、/255、NCHW float32。
    后处理：`_parse_detect_output` → 反归一化（除以缩放比）→ 过滤 score/min_score → 几何包含求 parent。
    """
    import numpy as np
    t0 = time.time()
    res = {'containers': [], 'free_text': [], 'free_glyphs': [],
           'degraded': False, 'error': None}
    try:
        # mock 通道：只用于**打通 plumbing 与记分器**（无权重/无 GPU 时也能验证接线）
        if model.startswith('mock:'):
            with open(model[5:], encoding='utf-8') as f:
                dets = [list(map(float, d[:6])) for d in json.load(f)]
            fmt = 'mock-xyxy'
        else:
            sess = _onnx_session(model, providers, debug=debug)
            inp = sess.get_inputs()[0]
            in_h, in_w = (inp.shape[2], inp.shape[3]) if len(inp.shape) == 4 else (640, 640)
            in_w = int(in_w) if isinstance(in_w, int) and in_w > 0 else 640
            in_h = int(in_h) if isinstance(in_h, int) and in_h > 0 else 640
            from PIL import Image
            im = Image.fromarray(arr).convert('RGB').resize((in_w, in_h), Image.BILINEAR)
            x = np.asarray(im, dtype=np.float32).transpose(2, 0, 1)[None] / 255.0
            outs = sess.run(None, {inp.name: x})
            dets, fmt = _parse_detect_output(outs, in_w, in_h, W0, H0)
            sx, sy = W0 / float(in_w), H0 / float(in_h)
            dets = [[d[0] * sx, d[1] * sy, d[2] * sx, d[3] * sy, d[4], d[5]] for d in dets]
        dets = [d for d in dets if d[4] >= min_score]
        dets.sort(key=lambda d: -d[4])
        dets = dets[:max_det]
        kinds = list(kind_map or DETECT_KINDS)
        conts = []
        for d in dets:
            x0 = max(0.0, min(W0 - 1.0, d[0]))
            y0 = max(0.0, min(H0 - 1.0, d[1]))
            x1 = max(x0 + 1.0, min(float(W0), d[2]))
            y1 = max(y0 + 1.0, min(float(H0), d[3]))
            ci = int(d[5]) % len(kinds)
            conts.append({'bbox': [int(x0), int(y0), int(x1), int(y1)],
                          'kind': kinds[ci], 'score': float(d[4])})
        conts.sort(key=lambda c: (-(c['bbox'][2] - c['bbox'][0]) * (c['bbox'][3] - c['bbox'][1]),
                                  c['bbox'][1], c['bbox'][0]))
        for i, c in enumerate(conts):
            c['id'] = 'd%d' % i
        tb = [t['bbox'] for t in text_boxes]

        def center_in(bb, tbb):
            cx = (tbb[0] + tbb[2]) / 2.0
            cy = (tbb[1] + tbb[3]) / 2.0
            return bb[0] <= cx <= bb[2] and bb[1] <= cy <= bb[3]

        used_text = set()
        out = []
        for c in conts:
            bb = c['bbox']
            texts, tids = [], []
            for j, tbb in enumerate(tb):
                if center_in(bb, tbb):
                    texts.append(text_boxes[j]['text'])
                    tids.append(j)
                    used_text.add(j)
            holders = [p for p in conts if p is not c
                       and p['bbox'][0] <= bb[0] and p['bbox'][1] <= bb[1]
                       and p['bbox'][2] >= bb[2] and p['bbox'][3] >= bb[3]]
            parent = min(holders, key=lambda p: (p['bbox'][2] - p['bbox'][0]) *
                         (p['bbox'][3] - p['bbox'][1]))['id'] if holders else None
            parent_bb = next((p['bbox'] for p in conts if p['id'] == parent), None)
            out.append({
                'id': c['id'], 'parent': parent, 'bbox': bb, 'kind': c['kind'],
                'skin': {'lab': None, 'fill': None, 'rect': None},
                'text': texts, 'glyphs': [], 'badges': [],
                'affordance': {'clickable': 'unknown',
                               'evidence': ['detector_score:%.3f' % c['score'],
                                            'hover:none(未采集按下/hover 态 ⇒ 不敢判 yes)']},
                'clipped': _containers_clipped(bb, parent_bb, W0, H0),
                'confidence': round(min(0.99, max(0.05, c['score'])), 3),
                'evidence': {'rule': 'detector:onnx(%s) fmt=%s min_score=%.2f' % (
                    os.path.basename(model), fmt, min_score),
                    'detector_score': round(c['score'], 4),
                    'area_px': int((bb[2] - bb[0]) * (bb[3] - bb[1])),
                    'text_in': len(texts)},
            })
        res['containers'] = out
        res['free_text'] = [text_boxes[j]['text'] for j in range(len(text_boxes))
                            if j not in used_text]
        res['free_glyphs'] = []
    except Exception as exc:            # noqa: BLE001 —— fail-closed：异常必须变成 degraded + 说清原因
        res['containers'] = []
        res['free_text'] = []
        res['free_glyphs'] = []
        res['degraded'] = True
        res['error'] = 'detect-backend: %s: %s' % (type(exc).__name__, exc)
    if debug:
        sys.stderr.write('[ys-screen] onnx containers=%d degraded=%s err=%s (%dms)\n'
                         % (len(res['containers']), res['degraded'], res['error'],
                            int((time.time() - t0) * 1000)))
    return res

def _cont_cache_path(frame_sha, scale, text_boxes, backend_sig='cv'):
    """容器层缓存路径：键 = 帧字节 sha256 + 分析尺度 + **文本盒签名**。

    文本签名必须进键：`text[]` 归属和"内含文本"判据都吃 OCR 结果，换后端/换缩放后
    容器集合会变——只按帧 sha 缓存会让换后端后读到旧结构。
    frame_sha 由调用方传入（同一帧只算一次 sha：2.5MB 读+哈希 ~15ms，重复算会白付）。
    """
    th = hashlib.sha1(json.dumps([(t['bbox'], t['text']) for t in text_boxes],
                                 ensure_ascii=False).encode('utf-8')).hexdigest()[:16]
    # 规则版本进键：否则改了判据还会读到旧规则写下的结构（"改了但看起来没变"的经典坑——
    # 2026-10-18 实测踩到：加了 text_ui 判据后缓存命中返回的仍是旧结构）
    return os.path.join(CACHE_DIR, 'cont-%s-%d-%s-%s-%s.json'
                        % (frame_sha, int(round(scale * 1000)), th, CONTAINER_RULESET,
                           backend_sig))


def containers_cached(frame, arr, scale, W0, H0, text_boxes, use_cache=True, debug=False,
                      frame_sha=None, backend='cv', detect_model=None,
                      detect_providers=('CUDAExecutionProvider', 'CPUExecutionProvider'),
                      detect_min_score=0.25, kind_map=None, detect_opts=None):
    """容器层 + 内容寻址缓存。返回 {containers,free_text,free_glyphs,degraded,error,timing}。

    timing.container_ms = 这一层自己的耗时（命中缓存时就是读文件+解析的时间）。
    这是性能门禁的口径来源（设计文档 §四末段）：**常驻 ≤200ms/帧、缓存命中 ≤5ms**。
    """
    t0 = time.time()
    backend_sig = _detect_backend_sig(backend, detect_model)
    path = (_cont_cache_path(frame_sha or _sha256(frame), scale, text_boxes, backend_sig)
            if use_cache else None)
    if path:
        try:
            with open(path, encoding='utf-8') as f:
                c = json.load(f)
            if isinstance(c.get('containers'), list):
                c['timing'] = {'container_ms': int((time.time() - t0) * 1000), 'cached': True}
                return c
        except (OSError, ValueError):
            pass
    if backend == 'onnx':
        if not detect_model:
            res = {'containers': [], 'free_text': [], 'free_glyphs': [], 'degraded': True,
                   'error': 'detect-backend: onnx 需要 --detect-model <path.onnx>'
                            '（或 env YS_DETECT_ONNX）；缺模型 fail-closed，不静默回落到 cv'}
        else:
            res = find_containers_onnx(arr, scale, W0, H0, text_boxes, detect_model,
                                       providers=detect_providers, min_score=detect_min_score,
                                       kind_map=kind_map, debug=debug)
    elif backend == 'torch':
        o = dict(detect_opts or {})
        res = find_containers_torch(arr, scale, W0, H0, text_boxes, kind_map=kind_map,
                                    debug=debug, **o)
    else:
        res = find_containers(arr, scale, W0, H0, text_boxes, debug=debug)
    res['timing'] = {'container_ms': int((time.time() - t0) * 1000), 'cached': False}
    if path and not res['degraded']:
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = '%s.tmp%d' % (path, os.getpid())
            with open(tmp, 'w', encoding='utf-8') as f:
                json.dump({k: res[k] for k in ('containers', 'free_text',
                                               'free_glyphs', 'degraded', 'error')},
                          f, ensure_ascii=False)
            os.replace(tmp, path)
        except OSError:
            pass
    return res


def find_occlusion(arr, scale, W0, H0, text_boxes, debug=False):
    """遮挡区：**半透明叠加层**（HUD / 录屏读数 / 通知条）。

    判据（2026-10-17 三帧实测标定；DXVK 性能叠加层是典型样本）：
      ① 自带**小字**：≥2 个 h ≤ 36px 的 OCR 框紧挨成一簇（HUD 读数形态），并贴在画面边角
         （≤22% 边距）——正文不会这样聚集在角上；
      ② **低方差**：把簇内文字像素遮掉后，背景 std 明显低（叠加层是平涂色块，
         实测 DXVK 底 std ≈ 6~8；它盖住的草地/面板纹理 std 20+）；
      ③ **非纯黑**：背景均值落在 6..210（DXVK 实测 L≈80；纯黑=黑屏，另判）；
      ④ **纹理对比骤降**：簇背景 std / 紧邻外围环 std ≤ 0.55（叠加层把下面的纹理压平）。
    bbox = 小字簇外接框（±3px），即"这块被压上了读数"的最小诚实范围。
    这里**故意不用**"找叠加层矩形边框"的做法：实测那玩意儿的边阶跃不是画面里最强的台阶
    （全帧最强台阶在存档图标上，x=106，ΔL=73），靠它定位会把叠加层框错成 252×138。
    """
    import numpy as np
    g = arr.astype(np.float32).mean(axis=2)
    tb = [(t['bbox'][0] * scale, t['bbox'][1] * scale, t['bbox'][2] * scale,
           t['bbox'][3] * scale) for t in text_boxes]
    tiny = [t for t in text_boxes if t['h'] <= OCCL_TINY_TEXT_H]
    out = []
    for cl, idxs in _cluster_boxes([t['bbox'] for t in tiny], gap=OCCL_CLUSTER_GAP):
        members = _trim_hud_cluster([tiny[i] for i in idxs])
        if len(members) < 2:
            continue
        # bbox 必须用**裁剪后成员**的并集：原始聚类并集可能连到标题/标签页（实测会把
        # 遮挡框撑成 332×105，把标题也框进去）
        x0 = min(m['bbox'][0] for m in members)
        y0 = min(m['bbox'][1] for m in members)
        x1 = max(m['bbox'][2] for m in members)
        y1 = max(m['bbox'][3] for m in members)
        if (x1 - x0) > 0.30 * W0 or (y1 - y0) > 0.16 * H0:
            continue                     # 太散：是正文段落，不是 HUD 读数
        corner, cdist = _nearest_corner([x0, y0, x1, y1], W0, H0)
        if cdist > 0.12 * max(W0, H0):
            continue                     # HUD 贴边；画面中央/内容区的小字簇不算遮挡
                                             # （实测 0.22 会把右上角卡片的"名字+日期"簇误判成 HUD）
        stats = _bg_stats(g, scale, [x0, y0, x1, y1], tb)
        ring = _ring_stats(g, scale, [x0, y0, x1, y1])
        colr = _bg_color(arr, scale, [x0, y0, x1, y1], tb)
        ratio = stats['std'] / max(ring['std'], 0.5)
        conf, cues = 0.35, []
        if len(members) >= 3:
            conf += 0.14
            cues.append('小字 %d 框' % len(members))
        if stats['std'] <= 22:
            conf += 0.12
            cues.append('低方差 std=%.1f' % stats['std'])
        if 6 <= stats['mean'] <= 210:
            conf += 0.08
            cues.append('非纯黑 L=%.0f' % stats['mean'])
        if ratio <= 0.55:
            conf += 0.16
            cues.append('纹理对比骤降 std %.1f→%.1f（%.2f×）' % (ring['std'], stats['std'], ratio))
        if corner in ('左上', '右上') and len(members) >= 3:
            conf += 0.05
        if conf < 0.55 or not cues:
            continue
        bb = [max(0, x0 - 3), max(0, y0 - 3), min(W0, x1 + 3), min(H0, y1 + 3)]
        out.append({
            'bbox': [int(v) for v in bb],
            'confidence': round(min(0.97, conf), 3),
            'label': 'hud-overlay',
            'why': '%s角小字叠加层：%s' % (corner, '，'.join(cues)),
            'evidence': {
                'texts': [m['text'] for m in members][:8],
                'text_ids': [m['id'] for m in members],
                'n_texts': len(members),
                'corner': corner, 'corner_dist_px': int(round(cdist)),
                'bg_mean': round(stats['mean'], 1), 'bg_std': round(stats['std'], 1),
                'ring_mean': round(ring['mean'], 1), 'ring_std': round(ring['std'], 1),
                'texture_ratio': round(ratio, 2), 'bg_rgb': colr,
            },
        })
    # 排序：顶部两角优先（性能 HUD / 录屏条都在顶部），同角再按置信度。
    # 实测：底部那条「min/max 读数」也会命中判据，但它是界面自身的读数，不该抢头条。
    out.sort(key=lambda o: (0 if o['evidence']['corner'] in ('左上', '右上') else 1,
                            -o['confidence']))
    if debug:
        sys.stderr.write('[ys-screen] occlusion=%d\n' % len(out))
        for o in out:
            sys.stderr.write('  occ %s conf=%.2f %s\n' % (o['bbox'], o['confidence'], o['why']))
    return out


def _ring_stats(g, scale, bb, pad=8):
    """bb 外围一圈（pad 宽、挖掉 bb 本体）的亮度统计——用来比"纹理有没有被压平"。"""
    import numpy as np
    x0, y0, x1, y1 = [int(v * scale) for v in bb]
    H, W = g.shape
    X0, Y0 = max(0, x0 - pad), max(0, y0 - pad)
    X1, Y1 = min(W, x1 + pad), min(H, y1 + pad)
    reg = g[Y0:Y1, X0:X1]
    keep = np.ones(reg.shape, dtype=bool)
    keep[max(0, y0 - Y0):max(0, y1 - Y0), max(0, x0 - X0):max(0, x1 - X0)] = False
    vals = reg[keep]
    if vals.size == 0:
        return {'mean': 0.0, 'std': 0.0}
    return {'mean': float(vals.mean()), 'std': float(vals.std())}


def _trim_hud_cluster(members):
    """把"同一个读数块"和"凑巧挨着的界面文字"分开。

    规则（2026-10-17 实测标定）：HUD 读数是一组**字号接近的短串**，而标题/标签页
    又长又大。按簇内字高中位数取：只保留 `h ≤ 1.5×中位高` 且 `w ≤ 8×中位高` 的成员。
    实证：ESC 帧里 HUD 簇原本连到了 8 个框，其中标题「未分类页签_存档_1」h=33、w=231，
    中位高 20.5 ⇒ 两条规则各自都会把它剔掉（30.75 < 33；164 < 231）。
    """
    if len(members) < 2:
        return members
    hs = sorted(m['h'] for m in members)
    med = hs[len(hs) // 2] if len(hs) % 2 else (hs[len(hs) // 2 - 1] + hs[len(hs) // 2]) / 2.0
    med = max(med, 8.0)
    keep = [m for m in members if m['h'] <= 1.5 * med and (m['bbox'][2] - m['bbox'][0]) <= 8 * med]
    return keep if len(keep) >= 2 else members


def _center_in(bb, cl):
    cx, cy = (bb[0] + bb[2]) / 2.0, (bb[1] + bb[3]) / 2.0
    return cl[0] - 2 <= cx <= cl[2] + 2 and cl[1] - 2 <= cy <= cl[3] + 2


def _cluster_boxes(boxes, gap):
    """按"边缘间距 ≤ gap"做并查集聚类。

    返回 [(并集 bbox, [成员下标…]), …]。**必须返回成员下标**：只返回并集 bbox 会让
    "落在并集框里但没连上"的框被误当成成员（实测病历：HUD 小字簇的并集框把标题和标签页
    一起框进去，标题因此被判成"被遮挡的 HUD"，标题识别直接错人）。
    """
    n = len(boxes)
    par = list(range(n))

    def find(a):
        while par[a] != a:
            par[a] = par[par[a]]
            a = par[a]
        return a

    for i in range(n):
        for j in range(i + 1, n):
            a, b = boxes[i], boxes[j]
            gx = max(0, max(a[0], b[0]) - min(a[2], b[2]))
            gy = max(0, max(a[1], b[1]) - min(a[3], b[3]))
            if gx <= gap and gy <= gap:
                ra, rb = find(i), find(j)
                if ra != rb:
                    par[max(ra, rb)] = min(ra, rb)
    groups = {}
    for i in range(n):
        groups.setdefault(find(i), []).append(i)
    out = []
    for idxs in groups.values():
        g = [boxes[i] for i in idxs]
        out.append(([min(b[0] for b in g), min(b[1] for b in g),
                     max(b[2] for b in g), max(b[3] for b in g)], idxs))
    return out


def _nearest_corner(bb, W0, H0):
    corners = {'左上': (0, 0), '右上': (W0, 0), '左下': (0, H0), '右下': (W0, H0)}
    best, bd = None, 1e18
    for name, (cx, cy) in corners.items():
        dx = max(0, max(bb[0], cx) - min(bb[2], cx)) if bb[2] < cx or bb[0] > cx else 0
        dy = max(0, max(bb[1], cy) - min(bb[3], cy)) if bb[3] < cy or bb[1] > cy else 0
        d = (dx * dx + dy * dy) ** 0.5
        if d < bd:
            best, bd = name, d
    return best, bd


def _mask_text(g, bb, tb, pad=2):
    import numpy as np
    x0, y0, x1, y1 = [int(v) for v in bb]
    sub = g[y0:y1, x0:x1]
    keep = np.ones(sub.shape, dtype=bool)
    for (tx0, ty0, tx1, ty1) in tb:
        ax0, ay0 = max(0, int(tx0) - x0 - pad), max(0, int(ty0) - y0 - pad)
        ax1, ay1 = min(sub.shape[1], int(tx1) - x0 + pad), min(sub.shape[0], int(ty1) - y0 + pad)
        if ax1 > ax0 and ay1 > ay0:
            keep[ay0:ay1, ax0:ax1] = False
    return sub, keep


def _bg_stats(g, scale, bb, tb):
    import numpy as np
    sub, keep = _mask_text(g, [v * scale for v in bb], tb)
    vals = sub[keep]
    if vals.size < 16:
        vals = sub.ravel()
    return {'mean': float(vals.mean()), 'std': float(vals.std())}


def _bg_color(arr, scale, bb, tb):
    import numpy as np
    x0, y0, x1, y1 = [int(v * scale) for v in bb]
    sub = arr[y0:y1, x0:x1].astype(np.float32)
    gg = sub.mean(axis=2)
    keep = np.ones(gg.shape, dtype=bool)
    for (tx0, ty0, tx1, ty1) in tb:
        ax0, ay0 = max(0, int(tx0) - x0 - 2), max(0, int(ty0) - y0 - 2)
        ax1, ay1 = min(gg.shape[1], int(tx1) - x0 + 2), min(gg.shape[0], int(ty1) - y0 + 2)
        if ax1 > ax0 and ay1 > ay0:
            keep[ay0:ay1, ax0:ax1] = False
    if keep.sum() < 16:
        keep[:] = True
    return [int(v) for v in sub[keep].mean(axis=0)]


# --------------------------------------------------------------------------- 语义层
def _is_action(txt):
    """动作词判定：**短串** + 词在首/尾。

    只做子串匹配会把长标签误标成按钮（实测 "关卡设置×" 含 "设置"、"资产导入导出管理"
    含 "导入"），于是"标题旁边有什么可点的"被这些假按钮占满。短串+首尾两条就够了。
    """
    s = (txt or '').strip()
    if not s or len(s) > 5:
        return False
    return any(s == w or s.startswith(w) or s.endswith(w) for w in ACTION_WORDS)


def classify_texts(text_boxes, regions, occl):
    """给文本框贴 kind：title / content / action / data / hud / other。

    hud **只按遮挡簇的成员 id 标**（不按"落在遮挡 bbox 里"）——实测过按 bbox 包含判会
    把紧挨 HUD 的标题一起吞成 hud，于是标题识别认错人（把右上角图标误读的 "S L I" 当标题）。
    """
    import re
    date_re = re.compile(r'\d{4}\s*年\s*\d{1,2}\s*月\s*\d{1,2}\s*日|\d{1,2}:\d{2}|\d+\.\d+\s*(ms|s|%)')
    hud_ids = set()
    for o in occl:
        hud_ids.update(o.get('evidence', {}).get('text_ids') or [])
    for t in text_boxes:
        txt = t['text']
        t['kind'] = 'other'
        if t['id'] in hud_ids:
            t['kind'] = 'hud'
        elif t['h'] <= 1.4 * OCCL_TINY_TEXT_H and any(
                o['bbox'][0] - 2 <= t['cx'] <= o['bbox'][2] + 2 and
                o['bbox'][1] - 2 <= t['cy'] <= o['bbox'][3] + 2 for o in occl):
            # 兜底：簇成员之外的**小字**只要落在遮挡框里也算 HUD（OCR 常把 HUD 的一行
            # 读成一个大框，实测 "FPSI" h=39 就是这样混进标题候选的）
            t['kind'] = 'hud'
        elif _is_action(txt):
            t['kind'] = 'action'
        elif date_re.search(txt):
            t['kind'] = 'data'
        elif t['h'] >= 20:
            t['kind'] = 'content'      # 内容名（卡片名/条目名）：字高够，才不是角标读数
    return text_boxes


def pick_title(text_boxes, regions, H0):
    best = None
    for t in text_boxes:
        if t['kind'] in ('hud', 'action'):
            continue
        if t['cy'] > 0.30 * H0:
            continue
        key = (t['h'], t['score'], -t['cy'])
        if best is None or key > best[0]:
            best = (key, t)
    if not best:
        return None
    t = best[1]
    t['kind'] = 'title'
    return {'text': t['text'], 'cx': t['cx'], 'cy': t['cy'], 'bbox': t['bbox'],
            'region': region_of(t['bbox'], regions),
            'why': '上半屏字高最大（%dpx, score=%.2f）' % (t['h'], t['score'])}


def build_targets(controls, text_boxes):
    """可点目标 = 图标控件（有/无标签） + 动作词文本框。"""
    targets = []
    for c in controls:
        targets.append({'id': c['id'], 'kind': 'icon', 'bbox': c['bbox'],
                        'label': c['label'], 'shape': c['shape'], 'conf': c['confidence']})
    for i, t in enumerate(text_boxes):
        if t['kind'] == 'action':
            targets.append({'id': 't%d' % i, 'kind': 'label', 'bbox': t['bbox'],
                            'label': t['text'], 'shape': 'label', 'conf': 0.6,
                            'text_id': i})
    return targets


def _hit_any(bb, boxes, min_frac=0.5):
    """bb 是否与任一 boxes 重叠超过 min_frac（按 bb 面积）。"""
    a = max(1.0, (bb[2] - bb[0]) * (bb[3] - bb[1]))
    for o in boxes:
        ix = max(0, min(bb[2], o[2]) - max(bb[0], o[0]))
        iy = max(0, min(bb[3], o[3]) - max(bb[1], o[1]))
        if ix * iy / a >= min_frac:
            return True
    return False


def _dir_gap(a, b):
    """方位 + 边缘间距。a=锚文本 bbox，b=目标 bbox。"""
    ax0, ay0, ax1, ay1 = a
    bx0, by0, bx1, by1 = b
    gx = max(0, bx0 - ax1, ax0 - bx1)
    gy = max(0, by0 - ay1, ay0 - by1)
    dx = (bx0 + bx1) / 2.0 - (ax0 + ax1) / 2.0
    dy = (by0 + by1) / 2.0 - (ay0 + ay1) / 2.0
    if gx == 0 and gy == 0:
        return 'overlap', 0, dx, dy
    if gx >= gy:
        return ('right' if dx > 0 else 'left'), gx, dx, dy
    return ('below' if dy > 0 else 'above'), gy, dx, dy


def build_adjacency(text_boxes, targets, W0, H0, hud_boxes=(), limit=24):
    """核心：把"名字 → 旁边的控件"显式化。

    一条邻接 = 一个**锚文本**（标题 / 内容名；HUD 读数与日期不当锚） + 最近的**可点目标**
    （图标控件，或动作词按钮文本），带方位与**边缘间距**（不用中心距：中心距会把大按钮算得
    比实际远，正是"铅笔就在右边却看不见"那类误差的来源）。
    太大、吞掉半个屏幕的"控件"（面板底条/整条工具栏）不算可点目标。
    """
    adj, seen = [], set()
    prio = {'title': 0, 'content': 1}
    anchors = [t for t in text_boxes if t['kind'] in prio]
    anchors.sort(key=lambda t: (prio[t['kind']], -t['h'], t['cy'], t['cx']))
    for t in anchors:
        tid = t['id']
        cands = []
        for tg in targets:
            if tg.get('text_id') == tid:
                continue
            bw = tg['bbox'][2] - tg['bbox'][0]
            bh = tg['bbox'][3] - tg['bbox'][1]
            if bw > 0.45 * W0 or bh > 0.45 * H0:
                continue                      # 面板/底条，不是按钮
            if _hit_any(tg['bbox'], hud_boxes):
                continue                      # HUD 读数簇不是可点目标
            d, gap, dx, dy = _dir_gap(t['bbox'], tg['bbox'])
            cap = ADJ_MAX_LABEL if tg['kind'] == 'label' else ADJ_MAX_ICON
            if gap > cap:
                continue
            if t['kind'] == 'content' and tg['kind'] != 'label' and gap > 150:
                continue                      # 普通正文只跟"真的有按钮挨着"的情况配对
            cands.append(((gap, 0 if tg['kind'] == 'label' else 1), tg, d, gap, dx, dy))
        if not cands:
            continue
        cands.sort(key=lambda c: (c[0][0], c[0][1]))
        # 每个锚最多出 3 条：**最近的** + 其它方向的最近几条。
        # 为什么不是只留最近：标题正上方常常是窗口图标（gap 33），只留最近就把
        # "标题右侧那个圆钮（gap 179）"整条吞掉——正是本文档开头要根治的那种遗漏。
        # 排序 = 同一行优先 → 未标文字的控件优先 → 距离近优先。
        # 为什么这样排：带文字的控件本来就逃不过 OCR，**不带文字的图标才是"人看不见的入口"**
        # ——标题右侧那颗圆形铅笔就是这类。实测：标题上方 33px 是保存图标、右侧 179px 是铅笔，
        # 若只按距离排，铅笔会被菜单磁贴挤掉。
        hh = (t['bbox'][3] - t['bbox'][1])

        def _rank(c):
            tg = c[1]
            th = tg['bbox'][3] - tg['bbox'][1]
            cy_a = (t['bbox'][1] + t['bbox'][3]) / 2.0
            cy_b = (tg['bbox'][1] + tg['bbox'][3]) / 2.0
            same_row = 0 if abs(cy_a - cy_b) <= 0.6 * (hh + th) / 2.0 else 1
            unlabeled = 0 if tg.get('label') is None else 1
            if t['kind'] == 'title':
                # 标题旁边：**看不见的图标优先**（带字的按钮 OCR 自己会读到）
                return (same_row, unlabeled, c[0][0])
            # 内容名（卡片名/条目名）：**带文字的按钮优先** + **下方优先**。
            # 为什么压"上方"：卡片名在卡片左上、操作按钮在同一张卡的右下；同名按钮在
            # 上一行卡片里也有一个，间距常常相等（实测 fighting 到上/下两个【编辑】都是 175px），
            # 不压上方就会把"上一张卡的按钮"当成这张卡的操作入口。
            above = 0 if cy_b > cy_a else 1
            return (0 if tg.get('label') is not None else 1, above, same_row, c[0][0])

        rest = sorted(cands, key=_rank)
        picks, dirs = [], set()
        for c in rest:
            if len(picks) >= 3:
                break
            picks.append(c)
            dirs.add(c[2])
        for rank, (_, tg, d, gap, dx, dy) in enumerate(picks):
            sig = (t['text'], tg['id'])
            if sig in seen:
                continue
            seen.add(sig)
            conf = 0.55 + (0.2 if tg['kind'] == 'label' else 0.0)
            conf += 0.15 if t['kind'] == 'title' else 0.0
            conf -= min(0.25, gap / 1200.0)
            adj.append({
                'text': t['text'], 'text_id': tid,
                'target': '%s@(%d,%d)' % (tg['shape'], (tg['bbox'][0] + tg['bbox'][2]) // 2,
                                          (tg['bbox'][1] + tg['bbox'][3]) // 2),
                'target_id': tg['id'], 'target_kind': tg['kind'], 'label': tg.get('label'),
                'anchor_kind': t['kind'], 'rank': rank,
                'dir': d, 'gap_px': int(round(gap)), 'dx': int(round(dx)), 'dy': int(round(dy)),
                'confidence': round(max(0.2, min(0.95, conf)), 3),
            })
    adj.sort(key=lambda a: (0 if a['anchor_kind'] == 'title' else 1,
                            a.get('rank', 9), a['gap_px']))
    return adj[:limit]


# --------------------------------------------------------------------------- 摘要
def render_digest(res, max_lines=10):
    fr, text, ctrls, regs = res['frame'], res['text'], res['controls'], res['regions']
    adj, occ, title, tm = res['adjacency'], res['occlusion'], res['title'], res['timing']
    lines = []
    lines.append('屏幕 %dx%d · 文本 %d · 控件 %d · 容器 %d · 邻接 %d · 遮挡 %d · %dms（OCR %s）' % (
        fr['w'], fr['h'], len(text), len(ctrls), len(res.get('containers') or []), len(adj),
        len(occ),
        tm['total_ms'], {'run': 'run', 'cache': 'cache', 'skip': 'skip', 'nobackend': '缺后端',
                         'error': '失败'}.get(tm['ocr_source'], tm['ocr_source'])))
    if title:
        where = title['region'] or '画面'
        lines.append('标题「%s」@(%d,%d) %s · 字高 %dpx' % (
            title['text'], title['cx'], title['cy'], where,
            text[res['title_text_id']]['h'] if res.get('title_text_id') is not None else 0))
    else:
        lines.append('标题：未识别到（上半屏无可读大字）')
    tadj = [a for a in adj if title and a['text'] == title['text']]
    lab = [a for a in adj if a['target_kind'] == 'label' and a not in tadj]
    # 其它条目里优先展示「卡片级动作」（编辑/保存/另存为）——这张卡能干什么的那一条
    _primary = ('编辑', '保存', '另存为')
    lab.sort(key=lambda a: (0 if (a.get('label') or '').startswith(_primary) else 1,
                            a['gap_px']))
    shown, picked = set(), []
    for a in (tadj[:3] + lab[:1]):
        sig = (a['text'], a['target'])
        if sig in shown:
            continue
        shown.add(sig)
        picked.append(a)
    for a in picked[:4]:
        lines.append('邻接「%s」→ %s%s %s %dpx' % (
            a['text'], a['target'], ('「%s」' % a['label']) if a['label'] else '',
            {'right': '右侧', 'left': '左侧', 'below': '下方', 'above': '上方',
             'overlap': '重叠'}[a['dir']], a['gap_px']))
    # 控件顺序：先"邻接里出现过的"（=就在名字旁边的），再按置信度补
    by_id = {c['id']: c for c in ctrls}
    ordered, seen_c = [], set()
    for a in adj:
        c = by_id.get(a['target_id'])
        if c is not None and c['id'] not in seen_c:
            seen_c.add(c['id'])
            ordered.append(c)
    for c in ctrls:
        if c['id'] not in seen_c:
            seen_c.add(c['id'])
            ordered.append(c)
    ordered = [c for c in ordered if c['shape'] != 'unknown'][:4]
    if ordered:
        lines.append('控件: ' + ' | '.join(
            '%s@(%d,%d)%s' % (c['shape'], c['cx'], c['cy'],
                              ('「%s」' % c['label']) if c['label'] else '')
            for c in ordered))
    if regs:
        lines.append('区域: ' + ' | '.join('%s %s' % (r['name'], _bs(r['bbox'])) for r in regs))
    if occ:
        for o in occ[:2]:
            lines.append('遮挡 %s %s（conf %.2f）：%s' % (
                o['bbox'], _bs(o['bbox'], short=True), o['confidence'], o['why']))
    else:
        lines.append('遮挡：未发现叠加层/被覆盖区')
    acts = [t for t in text if t['kind'] == 'action']
    if acts:
        lines.append('可点文字 %d 个: %s' % (len(acts), ' / '.join(t['text'] for t in acts[:6])))
    return '\n'.join(lines[:max_lines])


def _bs(bb, short=False):
    if short:
        return '(%d,%d)-(%d,%d)' % (bb[0], bb[1], bb[2], bb[3])
    return '(%d,%d)-(%d,%d)' % (bb[0], bb[1], bb[2], bb[3])


# --------------------------------------------------------------------------- 主流程
def text_objects(boxes):
    """OCR boxes → text[] 对象（全帧坐标；`kind` 先给 other，交给 classify_texts 定）。"""
    out = []
    for i, b in enumerate(boxes):
        bb = box_bbox(b['box'])
        out.append({'id': i, 'text': b['text'], 'cx': int(b['cx']), 'cy': int(b['cy']),
                    'bbox': bb, 'w': bb[2] - bb[0], 'h': bb[3] - bb[1],
                    'score': float(b['score']), 'kind': 'other'})
    return out


def _ocr_text(frame, use_ocr, use_cache, scale, debug=False):
    """OCR（可选）→ (text[], meta)。失败按 fail-closed 退出：4=后端缺 / 5=后端在但跑失败。"""
    meta = {'source': 'skip', 'ms': 0, 'n_total': 0, 'err': None}
    if not use_ocr:
        return [], meta
    got, meta = run_ocr(frame, use_cache=use_cache, scale=scale, debug=debug)
    if got is None:
        sys.stderr.write('[ys-screen] OCR 失败：%s\n' % meta['err'])
        sys.stderr.write('[ys-screen] 期望：ys_ocr.py 返回 {"boxes":[...]}\n'
                         '[ys-screen] 实测：%s\n' % meta['err'])
        raise SystemExit(4 if meta['source'] == 'nobackend' else 5)
    return text_objects(got), meta


def analyze(frame, use_ocr=True, use_cache=True, scale=1.0, debug=False, structure_only=False,
            containers_only=False, repeat=1, backend='cv', detect_model=None,
            detect_providers=('CUDAExecutionProvider', 'CPUExecutionProvider'),
            detect_min_score=0.25, detect_opts=None, kind_map=None):
    # 结构缓存（2026-10-18）：按帧 sha 存一份 structure.json，**必须在解码之前查**——
    # 放后面试过一次，命中仍要 260ms（解码 170ms + OCR 查缓存），等于没省。
    # 判据：同一帧第二次查询 <10ms。
    frame_sha = _sha256(frame)              # 同一帧只算一次：结构缓存/容器缓存/frame 信息共用
    if structure_only:
        _sc = os.path.join(CACHE_DIR, 'struct-%s.json' % frame_sha)
        if os.path.exists(_sc):
            try:
                with open(_sc, encoding='utf-8') as f:
                    return json.load(f)                # 结构缓存命中：analyze 的返回是**单个 dict**
            except (OSError, ValueError):
                pass
    struct_cache = os.path.join(CACHE_DIR, 'struct-%s.json' % frame_sha)
    t0 = time.time()
    arr, (W0, H0) = load_small(frame, 0.5)
    t_load = time.time()
    text, meta = _ocr_text(frame, use_ocr, use_cache, scale, debug)
    t_after_ocr = time.time()
    # 容器层（2026-10-18 新增，设计文档 §2.1/§2.2）：像素管线 + 文本/图形/角标归属。
    # 异常不外抛——find_containers 自己 fail-closed 成 degraded，不拖垮其余字段。
    cont = containers_cached(frame, arr, 0.5, W0, H0, text,
                             use_cache=use_cache and repeat <= 1, debug=debug,
                             frame_sha=frame_sha, backend=backend,
                             detect_model=detect_model,
                             detect_providers=detect_providers,
                             detect_min_score=detect_min_score,
                             detect_opts=detect_opts, kind_map=kind_map)
    t_after_cont = time.time()
    frame_info = {'path': os.path.abspath(frame), 'sha256': frame_sha,
                  'w': W0, 'h': H0, 'bytes': os.path.getsize(frame)}
    if containers_only:
        # 轻量路径：只出容器层（跳过遮挡/控件/分区/结构/邻接，实测省 ~1.1s）。
        # 与 --structure 同一形态：给下游一个直接可消费的小 JSON。
        runs = [cont['timing']['container_ms']]
        if repeat > 1:
            # 稳态口径（设计文档 §四末段：**常驻 ≤200ms/帧**）：同一帧在同一进程里连跑 N 次，
            # 取第 2..N 次的中位数。第 1 次含 numpy/cv2 首次调用的一次性分配（实测 f06 冷 412ms
            # vs 稳态 134ms），那不是"每帧成本"；缓存也读不出稳态值 ⇒ --repeat 强制真算。
            for _ in range(repeat - 1):
                t1 = time.time()
                # 必须重复**当前后端**：早先这里写死 find_containers（cv），
                # 于是 `--backend torch --repeat 3` 会拿 cv 的 20ms 冒充检测后端的稳态（假读数）。
                if backend == 'onnx':
                    find_containers_onnx(arr, 0.5, W0, H0, text, detect_model,
                                         providers=detect_providers,
                                         min_score=detect_min_score, kind_map=kind_map,
                                         debug=False)
                elif backend == 'torch':
                    find_containers_torch(arr, 0.5, W0, H0, text, kind_map=kind_map,
                                          debug=False, **dict(detect_opts or {}))
                else:
                    find_containers(arr, 0.5, W0, H0, text, debug=False)
                runs.append(int((time.time() - t1) * 1000))
        steady = int(statistics.median(runs[1:])) if repeat > 1 else runs[0]
        return {
            'schema': 'ys-screen/1',
            'layer': 'containers',
            'frame': frame_info,
            'containers': cont['containers'], 'free_text': cont['free_text'],
            'free_glyphs': cont['free_glyphs'],
            'degraded': cont['degraded'], 'error': cont['error'],
            'timing': {'load_ms': int((t_load - t0) * 1000),
                       'ocr_ms': int((t_after_ocr - t_load) * 1000),
                       # container_ms = 这一层的代表耗时：--repeat N 给稳态中位数，否则给本次实测
                       'container_ms': steady,
                       'container_runs': runs if repeat > 1 else len(runs),
                       'container_first_ms': runs[0],
                       'container_cached': cont['timing']['cached'],
                       'pixel_ms': int((t_after_cont - t_after_ocr) * 1000),
                       'total_ms': int((t_after_cont - t0) * 1000),
                       'ocr_source': meta['source'], 'ocr_backend': _backend_sig()},
            'ocr': {'n_total': meta['n_total'], 'err': meta['err']},
        }
    if structure_only:
        # 只要结构就跳过遮挡/控件/分区这三遍像素分析（实测省 ~200ms）。
        # 这三样是给"动作目标解析"用的，结构查询用不到。
        occ, ctrls, regs = [], [], []
        text = classify_texts(text, [], occ)
    else:
        occ = find_occlusion(arr, 0.5, W0, H0, text, debug=debug)
        text = classify_texts(text, [], occ)
        ctrls = find_controls(arr, 0.5, W0, H0, text, debug=debug)
        regs = find_regions(arr, 0.5, W0, H0, occ, debug=debug)
    struct = find_structure(text, W0, H0)          # 面板→行→条目（复用已识别的 text，零额外 OCR）
    title = pick_title(text, regs, H0)
    targets = build_targets(ctrls, text)
    adj = build_adjacency(text, targets, W0, H0,
                          hud_boxes=[o['bbox'] for o in occ])
    t_end = time.time()
    res = {
        'schema': 'ys-screen/1',
        'frame': frame_info,
        'title': title,
        'text': text, 'controls': ctrls, 'regions': regs, 'structure': struct,
        'adjacency': adj, 'occlusion': occ,
        # 容器层：结构是"这块界面上有哪些容器 + 谁属于谁"
        'containers': cont['containers'], 'free_text': cont['free_text'],
        'free_glyphs': cont['free_glyphs'],
        'degraded': cont['degraded'], 'error': cont['error'],
        # ⚠️ pixel_ms 原先算的是 `t_end - t_load`，而 t_load 在 run_ocr **之前** ——
        # 于是 OCR 的耗时被重复计进"像素"里（实测 ocr_source=daemon 时 ocr_ms=0、pixel_ms=1262，
        # 那个 1262 里绝大部分是等 daemon）。现在分开计时，读数才能指向真瓶颈。
        'timing': {'load_ms': int((t_load - t0) * 1000),
                   'ocr_ms': int((t_after_ocr - t_load) * 1000),
                   'pixel_ms': int((t_end - t_after_ocr) * 1000),
                   'container_ms': cont['timing']['container_ms'],
                   'container_cached': cont['timing']['cached'],
                   'total_ms': int((t_end - t0) * 1000),
                   'ocr_source': meta['source'], 'ocr_backend': _backend_sig()},
        'ocr': {'n_total': meta['n_total'], 'err': meta['err']},
    }
    res['title_text_id'] = next((t['id'] for t in text if title and t['text'] == title['text']),
                                None)
    res['digest'] = render_digest(res)
    if structure_only and res.get('structure') is not None:
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = '%s.tmp%d' % (struct_cache, os.getpid())
            with open(tmp, 'w', encoding='utf-8') as f:
                json.dump(res, f, ensure_ascii=False)
            os.replace(tmp, struct_cache)
        except OSError:
            pass
    return res


def main(argv=None):
    ap = argparse.ArgumentParser(
        description='屏幕摘要层：像素 → 界面（文本/控件/分区/邻接/遮挡 + 人读摘要）')
    ap.add_argument('frame', help='帧 PNG 路径（离线读文件，不碰屏幕）')
    ap.add_argument('--json', action='store_true', help='stdout 输出 JSON（含 digest 字段）')
    ap.add_argument('--json-out', default=None, help='把 JSON 另存到指定路径')
    ap.add_argument('--no-ocr', action='store_true', help='跳过 OCR（只做像素层，~0.4s）')
    ap.add_argument('--no-cache', action='store_true', help='忽略 OCR 缓存，强制真跑')
    ap.add_argument('--structure', action='store_true',
                    help='只输出界面结构（面板→行→条目）。模型规划动作读这个，不必看图')
    ap.add_argument('--containers', action='store_true',
                    help='只输出容器层（containers[] + 叶子归属）。下游直接消费这个，不必解 digest')
    ap.add_argument('--repeat', type=int, default=1,
                    help='容器层稳态基准：同一帧连跑 N 次，container_ms 取第 2..N 次中位数'
                         '（常驻口径；自动绕过缓存）')
    ap.add_argument('--scale', type=float, default=1.0, help='OCR 前缩图比例（默认 1.0）')
    ap.add_argument('--backend', choices=('cv', 'onnx', 'torch'), default='cv',
                    help='对象检测后端：cv=现行 flat+rect（**默认，输出不变**）；'
                         'torch=U-Net fp16 stub（随机权重，只验证链路与耗时）；'
                         'onnx=外部 ONNX 检测模型（需 --detect-model）')
    ap.add_argument('--detect-model', default=os.environ.get('YS_DETECT_ONNX'),
                    help='onnx 后端的 .onnx 路径（或 env YS_DETECT_ONNX）；'
                         '也接受 mock:<dets.json> 用于打通接线')
    ap.add_argument('--detect-providers', default='cuda',
                    choices=('cuda', 'cpu'), help='onnx 后端的 EP：cuda=请求 CUDA 并**断言真起**')
    ap.add_argument('--detect-min-score', type=float, default=0.25, help='onnx 后端置信度下限')
    ap.add_argument('--detect-device', default=None, choices=('cuda', 'cpu'),
                    help='torch 后端的设备（默认自动：有 cuda 就用）')
    ap.add_argument('--detect-dtype', default='fp16', choices=('fp16', 'fp32'),
                    help='torch 后端精度（fp16 只在 cuda 生效，cpu 自动 fp32）')
    ap.add_argument('--detect-threshold', type=float, default=1.0,
                    help='torch stub 的热图分位阈值（1.0 = 最高 1%% 像素）')
    ap.add_argument('--detect-min-area', type=int, default=400,
                    help='torch stub 的最小框面积（px²）')
    ap.add_argument('--max-lines', type=int, default=10, help='摘要最大行数（默认 10）')
    ap.add_argument('--debug', action='store_true', help='诊断打到 stderr')
    a = ap.parse_args(argv)
    if not os.path.isfile(a.frame):
        sys.stderr.write('[ys-screen] 帧不存在：%s\n' % os.path.abspath(a.frame))
        sys.stderr.write('[ys-screen] 期望：可读的 PNG 文件；实测：ENOENT\n')
        return 3
    try:
        res = analyze(a.frame, use_ocr=not a.no_ocr, use_cache=not a.no_cache,
                      structure_only=getattr(a, 'structure', False),
                      containers_only=getattr(a, 'containers', False),
                      repeat=max(1, a.repeat), scale=a.scale, debug=a.debug,
                      backend=a.backend, detect_model=a.detect_model,
                      detect_providers=(('CUDAExecutionProvider', 'CPUExecutionProvider')
                                        if a.detect_providers == 'cuda'
                                        else ('CPUExecutionProvider',)),
                      detect_min_score=a.detect_min_score,
                      detect_opts={'device': a.detect_device, 'dtype': a.detect_dtype,
                                   'threshold': a.detect_threshold,
                                   'min_area': a.detect_min_area})
    except SystemExit as exc:
        return int(exc.code or 0)
    except OSError as exc:
        sys.stderr.write('[ys-screen] 读图失败：%s\n' % exc)
        sys.stderr.write('[ys-screen] 期望：可解码的 PNG；实测：%s\n' % exc)
        return 3
    # fail-closed 硬信号（票 24）：检测后端不可用 ⇒ 退出码 6。
    # 与"pixel 管线抖动"的 degraded 区分开：那是降级（有读数但自述不可信），这是**配置错误**。
    if (a.backend != 'cv' and isinstance(res, dict) and res.get('degraded')
            and str(res.get('error') or '').startswith('detect-backend')):
        sys.stderr.write('[ys-screen] 检测后端不可用（backend=%s）：%s\n'
                         % (a.backend, res.get('error')))
        if a.json_out:
            with open(a.json_out, 'w', encoding='utf-8') as f:
                json.dump(res, f, ensure_ascii=False, indent=1)
        return 6
    if getattr(a, 'containers', False):
        # 轻量输出：容器结构 + 归属。**永远出 JSON**（与 --structure 同形态）——
        # 下游要的是可机读结构，不是人读摘要。
        if a.json_out:
            with open(a.json_out, 'w', encoding='utf-8') as f:
                json.dump(res, f, ensure_ascii=False, indent=1)
        print(json.dumps(res, ensure_ascii=False))
        return 0
    res['digest'] = render_digest(res, max_lines=a.max_lines)
    if a.json_out:
        with open(a.json_out, 'w', encoding='utf-8') as f:
            json.dump(res, f, ensure_ascii=False, indent=1)
    if getattr(a, 'structure', False):
        # 模型规划动作读这个就够：面板 → 行 → 条目文本。**不需要看图**。
        print(json.dumps({'frame': res['frame'], 'structure': res.get('structure') or [],
                          'timing': res['timing']}, ensure_ascii=False))
        return 0
    if a.json:
        print(json.dumps(res, ensure_ascii=False))
    else:
        print(res['digest'])
    return 0


if __name__ == '__main__':
    sys.exit(main())
