#!/usr/bin/env python3
"""ys-annotate — 标注修复编辑器（浏览器内，静态 HTML，直接改框并导出补丁）。

设计要点（按用户 2026-10-19 的要求）：
  · **按层级配色**：大层级(panel/card) 紫 / 列表行(row) 蓝 / 元素(tile/button/icon/chip/avatar) 绿
  · 三种修复动作：①拖拽移动大框 ②拖空处新建框 ③选中 2 个同 kind 的行 → **等距补全**（按实测行距填中间）
  · 导出 **patch JSON**：deleted / updated / added 三类操作逐条记录，
    代理据此知道"人改了哪几条、补了哪几条"，再按同一规律把剩下的补齐。

用法：
  python3 tools/ys-annotate --truth-dir .scratch/gui-corpus/truth-v5 \
      --out .scratch/gui-corpus/review/truth-v5-edit.html
"""
import argparse
import glob
import html
import json
import os
import sys

LEVEL = {
    "panel": "big", "card": "big",
    "row": "row",
    "tile": "el", "button": "el", "icon": "el", "chip": "el", "avatar": "el",
}

TEMPLATE = r"""<!doctype html><html lang="zh"><meta charset="utf-8">
<title>__TITLE__ · 标注修复</title>
<style>
 body{margin:0;font:13px/1.5 system-ui,"Noto Sans CJK SC",sans-serif;background:#0f0f12;color:#e6e6e6}
 header{padding:6px 12px;background:#1b1b20;display:flex;gap:10px;align-items:center;flex-wrap:wrap;position:sticky;top:0;z-index:30}
 header b{color:#7fd1ff}
 button,select{background:#26262e;color:#ddd;border:1px solid #3a3a44;border-radius:4px;padding:3px 8px;cursor:pointer}
 button.on{background:#3b82f6;border-color:#3b82f6;color:#fff}
 #wrap{display:flex;height:calc(100vh - 46px)}
 #left{flex:1;overflow:auto;padding:10px;display:flex;justify-content:center;align-items:flex-start}
 #stage{position:relative;max-width:100%;user-select:none}
 #stage img{width:100%;display:block;pointer-events:none}
 .box{position:absolute;box-sizing:border-box;cursor:pointer}
 .box.big{border:2px solid #c084fc}
 .box.row{border:2px solid #60a5fa}
 .box.el{border:2px solid #34d399}
 .box.sel{outline:2px solid #fde047;outline-offset:1px;z-index:8;box-shadow:0 0 0 1px #fde047 inset}
 .box .tag{position:absolute;left:0;top:-16px;font-size:10px;padding:0 2px;color:#000;background:#fde047;white-space:nowrap;pointer-events:none}
 .box.big .tag{background:#c084fc} .box.row .tag{background:#60a5fa} .box.el .tag{background:#34d399}
 .h{position:absolute;width:9px;height:9px;background:#fde047;border:1px solid #000;z-index:9}
 #right{width:320px;overflow:auto;background:#16161b;border-left:1px solid #2c2c34;padding:8px}
 .u{display:flex;gap:6px;align-items:center;padding:2px 3px;border-bottom:1px solid #222;cursor:pointer}
 .u:hover{background:#20202a} .u.sel{background:#2a2a12}
 .u .id{width:34px;color:#8ab} .u .k{width:52px} .u .t{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#bbb}
 #bar{position:sticky;bottom:0;background:#1b1b20;padding:6px 12px;display:flex;gap:10px;align-items:center}
 #hint{color:#888}
</style>
<header>
  <b>标注修复</b><span id="which"></span>
  <select id="level"><option value="all">选择：全部层级</option><option value="big">只选大层级</option><option value="row">只选行</option><option value="el">只选元素</option></select>
  <select id="kind"><option value="row">row</option><option value="tile">tile</option><option value="button">button</option><option value="icon">icon</option><option value="chip">chip</option><option value="avatar">avatar</option><option value="card">card</option><option value="panel">panel</option></select>
  <button id="mode-draw">新建框 (N)</button>
  <button id="del">删除 (Del)</button>
  <button id="undo">撤销 (Ctrl+Z)</button>
  <span style="margin-left:auto"><span style="color:#c084fc">■大</span> <span style="color:#60a5fa">■行</span> <span style="color:#34d399">■元素</span></span>
</header>
<div id="wrap">
  <div id="left"><div id="stage"><img id="img"></div></div>
  <div id="right"><div id="framesel" style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px"></div><div id="list"></div></div>
</div>
<div id="bar"><button id="export">导出补丁 JSON</button><span id="hint"></span><span id="stat" style="margin-left:auto;color:#888"></span></div>
<script>
const FRAMES = __DATA__;
const LEVEL = __LEVEL__;
const BATCH = __BATCH__;
const SAVE_PREFIX = __SAVE_PREFIX__;
let cur=0, selId=null, drawMode=false, els=new Map(), cycleIdx=0, lastPtBtn=null;
const PATCH={}, HIST=[];
function pt(stem){ return PATCH[stem] || (PATCH[stem]={deleted:{},updated:{},added:[]}); }
function levelOf(k){ return LEVEL[k]||'el'; }
function frame(){ return FRAMES[cur]; }
function savePos(o,bbox){ o.bbox=bbox; if(!o._added) pt(frame().stem).updated[o.id]=bbox; else { const a=pt(frame().stem).added.find(x=>x.id===o.id); if(a) a.bbox=bbox; } }

function renderFrames(){
  const el=document.getElementById('framesel'); el.innerHTML='';
  FRAMES.forEach((f,i)=>{ const b=document.createElement('button'); b.textContent=(i+1)+' '+f.stem.slice(-8);
    b.className=i===cur?'on':''; b.onclick=()=>{cur=i;selId=null;build();}; el.appendChild(b); });
}
function hitTest(cx,cy){
  const f=frame(), st=document.getElementById('stage').getBoundingClientRect();
  const x=(cx-st.left)/st.width*f.w, y=(cy-st.top)/st.height*f.h;
  const lv=document.getElementById('level').value;
  let hits=f.objects.filter(o=>{ const [bx,by,bw,bh]=o.bbox; return x>=bx&&x<=bx+bw&&y>=by&&y<=by+bh; });
  if(lv!=='all') hits=hits.filter(o=>levelOf(o.kind)===lv);
  hits.sort((a,b)=>a.bbox[2]*a.bbox[3]-b.bbox[2]*b.bbox[3]);   // 小的一层在上
  return hits;
}
function selectNext(cx,cy){
  const hits=hitTest(cx,cy); if(!hits.length){ selId=null; paint(); return; }
  if(lastPtBtn && Math.hypot(cx-lastPtBtn.x,cy-lastPtBtn.y)<3) cycleIdx++;
  else cycleIdx=0;
  lastPtBtn={x:cx,y:cy};
  selId=hits[cycleIdx%hits.length].id; paint();
}
function paint(){
  const f=frame();
  els.forEach((el,id)=>{ const o=f.objects.find(x=>x.id===id); if(!o) return;
    el.classList.toggle('sel', id===selId);
    el.querySelectorAll('.h').forEach(h=>h.style.display = id===selId?'block':'none');
  });
  document.querySelectorAll('.u').forEach(d=>d.classList.toggle('sel', d.dataset.id===selId));
  const o=f.objects.find(x=>x.id===selId);
  document.getElementById('hint').textContent = o ? `已选 #${o.id} ${o.kind}｜方向键移 1px（Shift 10px）｜Alt+方向键改大小` : '点击框选择（重叠时再点一次切换）｜N 新建';
}
function build(){
  const f=frame(); els=new Map(); selId=null;
  document.getElementById('which').textContent=f.stem+' · '+f.layout+' · '+f.objects.length+' 单元';
  document.getElementById('img').src='file://'+f.image;
  const st=document.getElementById('stage');
  st.querySelectorAll('.box').forEach(e=>e.remove());
  f.objects.forEach(o=>{
    const [x,y,w,h]=o.bbox;
    const el=document.createElement('div');
    el.className='box '+levelOf(o.kind); el.dataset.id=o.id;
    el.style.left=(100*x/f.w)+'%'; el.style.top=(100*y/f.h)+'%';
    el.style.width=(100*w/f.w)+'%'; el.style.height=(100*h/f.h)+'%';
    const t=document.createElement('span'); t.className='tag'; t.textContent=(o.id+'').slice(0,6)+' '+o.kind; el.appendChild(t);
    [['nw',0,0],['ne',1,0],['sw',0,1],['se',1,1]].forEach(([nm,fx,fy])=>{
      const hd=document.createElement('div'); hd.className='h'; hd.dataset.h=nm;
      hd.style.left='calc('+(fx*100)+'% - 4px)'; hd.style.top='calc('+(fy*100)+'% - 4px)'; hd.style.display='none';
      hd.addEventListener('mousedown',ev=>{ ev.stopPropagation(); startResize(ev,o,el,nm); });
      el.appendChild(hd);
    });
    el.addEventListener('mousedown',ev=>{ ev.stopPropagation(); startDrag(ev,o,el); });
    st.appendChild(el); els.set(o.id,el);
  });
  const list=document.getElementById('list'); list.innerHTML='';
  f.objects.forEach(o=>{
    const d=document.createElement('div'); d.className='u'; d.dataset.id=o.id;
    d.innerHTML='<span class="id">#'+(o.id+'').slice(0,5)+'</span><span class="k">'+o.kind+'</span><span class="t">'+((o.text||'').replace(/</g,'&lt;'))+'</span>';
    d.onclick=()=>{ selId=o.id; paint(); const el=els.get(o.id); if(el) el.scrollIntoView({block:'center'}); };
    list.appendChild(d);
  });
  renderFrames(); upd(); paint();
}
function startDrag(ev,o,el){
  if(drawMode) return;
  ev.preventDefault();
  const f=frame(), st=document.getElementById('stage').getBoundingClientRect();
  const sx=ev.clientX, sy=ev.clientY, [x0,y0,w0,h0]=o.bbox;
  let moved=false;
  const onMove=e=>{
    const dx=(e.clientX-sx)/st.width*f.w, dy=(e.clientY-sy)/st.height*f.h;
    if(Math.abs(e.clientX-sx)>2||Math.abs(e.clientY-sy)>2) moved=true;
    const nb=[Math.round(x0+dx),Math.round(y0+dy),w0,h0];
    o.bbox=nb; el.style.left=(100*nb[0]/f.w)+'%'; el.style.top=(100*nb[1]/f.h)+'%';
  };
  const onUp=()=>{
    document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp);
    if(!moved){ selectNext(ev.clientX,ev.clientY); }
    else { savePos(o,o.bbox); HIST.push({stem:f.stem,id:o.id,from:[x0,y0,w0,h0],to:o.bbox.slice()}); upd(); }
  };
  document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onUp);
}
function startResize(ev,o,el,corner){
  ev.preventDefault(); ev.stopPropagation();
  const f=frame(), st=document.getElementById('stage').getBoundingClientRect();
  const sx=ev.clientX, sy=ev.clientY, [x0,y0,w0,h0]=o.bbox.slice();
  const onMove=e=>{
    const dx=(e.clientX-sx)/st.width*f.w, dy=(e.clientY-sy)/st.height*f.h;
    let nx=x0, ny=y0, nw=w0, nh=h0;
    if(corner.includes('w')){ nx=x0+dx; nw=w0-dx; }
    if(corner.includes('e')){ nw=w0+dx; }
    if(corner.includes('n')){ ny=y0+dy; nh=h0-dy; }
    if(corner.includes('s')){ nh=h0+dy; }
    if(nw<8||nh<8) return;
    o.bbox=[Math.round(nx),Math.round(ny),Math.round(nw),Math.round(nh)];
    el.style.left=(100*o.bbox[0]/f.w)+'%'; el.style.top=(100*o.bbox[1]/f.h)+'%';
    el.style.width=(100*o.bbox[2]/f.w)+'%'; el.style.height=(100*o.bbox[3]/f.h)+'%';
  };
  const onUp=()=>{ document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp);
    savePos(o,o.bbox); HIST.push({stem:f.stem,id:o.id,from:[x0,y0,w0,h0],to:o.bbox.slice()}); upd(); };
  document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onUp);
}
function startDraw(ev){
  if(!drawMode) return; ev.preventDefault();
  const f=frame(), st=document.getElementById('stage').getBoundingClientRect();
  const sx=ev.clientX, sy=ev.clientY;
  const ghost=document.createElement('div'); ghost.className='box '+levelOf(document.getElementById('kind').value)+' sel';
  ghost.style.left=((sx-st.left)/st.width*100)+'%'; ghost.style.top=((sy-st.top)/st.height*100)+'%';
  document.getElementById('stage').appendChild(ghost);
  const onMove=e=>{
    const x=Math.min(sx,e.clientX), y=Math.min(sy,e.clientY);
    ghost.style.left=((x-st.left)/st.width*100)+'%'; ghost.style.top=((y-st.top)/st.height*100)+'%';
    ghost.style.width=(Math.abs(e.clientX-sx)/st.width*100)+'%'; ghost.style.height=(Math.abs(e.clientY-sy)/st.height*100)+'%';
  };
  const onUp=e=>{
    document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp); ghost.remove();
    const x=Math.min(sx,e.clientX), y=Math.min(sy,e.clientY), w=Math.abs(e.clientX-sx), h=Math.abs(e.clientY-sy);
    if(w<6||h<6) return;
    const bbox=[Math.round((x-st.left)/st.width*f.w),Math.round((y-st.top)/st.height*f.h),Math.round(w/st.width*f.w),Math.round(h/st.height*f.h)];
    const kind=document.getElementById('kind').value;
    const id='+'+String(pt(f.stem).added.length+1).padStart(2,'0');
    pt(f.stem).added.push({id,bbox,kind});
    f.objects.push({id,bbox,kind,text:'',_added:true});
    selId=id; build();
  };
  document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onUp);
}
function delSel(){
  if(selId==null) return; const f=frame(); const i=f.objects.findIndex(o=>o.id===selId); if(i<0) return;
  const o=f.objects[i];
  if(o._added){ pt(f.stem).added=pt(f.stem).added.filter(a=>a.id!==o.id); } else { pt(f.stem).deleted[o.id]=true; delete pt(f.stem).updated[o.id]; }
  f.objects.splice(i,1); selId=null; build();
}
function nudge(dx,dy,resize){
  const f=frame(); const o=f.objects.find(x=>x.id===selId); if(!o) return;
  const [x,y,w,h]=o.bbox;
  o.bbox = resize ? [x,y,Math.max(8,w+dx),Math.max(8,h+dy)] : [x+dx,y+dy,w,h];
  savePos(o,o.bbox); build();
}
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT'||e.target.tagName==='SELECT') return;
  const step=e.shiftKey?10:1, alt=e.altKey;
  if(e.key==='ArrowLeft'){ nudge(alt?step:0, 0, alt); e.preventDefault(); }
  if(e.key==='ArrowRight'){ nudge(alt?-step:0, 0, alt); e.preventDefault(); }
  if(e.key==='ArrowUp'){ nudge(0, alt?step:0, alt); e.preventDefault(); }
  if(e.key==='ArrowDown'){ nudge(0, alt?-step:0, alt); e.preventDefault(); }
  if(e.key==='Delete'||e.key==='Backspace'){ delSel(); e.preventDefault(); }
  if(e.key==='n'||e.key==='N'){ drawMode=!drawMode; document.getElementById('mode-draw').classList.toggle('on',drawMode); }
  if(e.key==='Escape'){ selId=null; drawMode=false; document.getElementById('mode-draw').classList.remove('on'); paint(); }
  if(e.key==='z'&&(e.ctrlKey||e.metaKey)){ undo(); e.preventDefault(); }
});
function undo(){
  const h=HIST.pop(); if(!h) return; const f=FRAMES.find(x=>x.stem===h.stem); if(!f) return;
  const o=f.objects.find(x=>x.id===h.id); if(!o) return;
  o.bbox=h.from; savePos(o,h.from); build();
}
let _saveTimer=null, _saveState='未保存';
function scheduleSave(){
  if(!SAVE_PREFIX) return;
  clearTimeout(_saveTimer);
  _saveTimer=setTimeout(async ()=>{
    const out={batch:BATCH,at:new Date().toISOString(),frames:{}};
    Object.entries(PATCH).forEach(([k,v])=>{ if(Object.keys(v.deleted).length||Object.keys(v.updated).length||v.added.length) out.frames[k]=v; });
    try{
      const r=await fetch('/save/'+SAVE_PREFIX+'-'+BATCH+'.json',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(out)});
      _saveState = r.ok ? '已自动保存 '+new Date().toLocaleTimeString() : '保存失败';
    }catch(e){ _saveState='保存失败（服务没起？）'; }
    document.getElementById('stat').textContent += ' · '+_saveState;
  }, 800);
}
function upd(){
  const p=pt(frame().stem);
  document.getElementById('stat').textContent='改 '+Object.keys(p.updated).length+' · 删 '+Object.keys(p.deleted).length+' · 增 '+p.added.length;
  scheduleSave();
}
document.getElementById('stage').addEventListener('mousedown',e=>{ if(drawMode) startDraw(e); });
document.getElementById('mode-draw').onclick=e=>{ drawMode=!drawMode; e.target.classList.toggle('on',drawMode); };
document.getElementById('del').onclick=delSel;
document.getElementById('undo').onclick=undo;
document.getElementById('export').onclick=()=>{
  const out={batch:BATCH,at:new Date().toISOString(),frames:{}};
  Object.entries(PATCH).forEach(([k,v])=>{ if(Object.keys(v.deleted).length||Object.keys(v.updated).length||v.added.length) out.frames[k]=v; });
  const blob=new Blob([JSON.stringify(out,null,1)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  a.download='patch-'+BATCH+'-'+Date.now()+'.json'; a.click();
};
build();
</script></html>
"""


def load(truth_dir):
    frames = []
    for jf in sorted(glob.glob(os.path.join(truth_dir, "*.json"))):
        stem = os.path.splitext(os.path.basename(jf))[0]
        if stem.startswith("_"):
            continue
        d = json.load(open(jf, encoding="utf-8"))
        objs = d.get("objects") or []
        if not objs:
            continue
        img = d.get("image") or ""
        cand = os.path.abspath(img) if img else ""
        frames.append({"stem": stem, "layout": d.get("layout") or "",
                       "image": cand if os.path.exists(cand) else "",
                       "objects": [{"id": o.get("id"), "bbox": o.get("bbox"), "kind": o.get("kind"),
                                    "text": o.get("text") or ""} for o in objs],
                       "w": (d.get("size") or [2560, 1440])[0], "h": (d.get("size") or [2560, 1440])[1]})
    return frames


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--truth-dir", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--title", default="")
    ap.add_argument("--save-prefix", default="", help="设置后启用自动保存：POST /save/<prefix>-<batch>.json")
    a = ap.parse_args()
    frames = load(a.truth_dir)
    if not frames:
        print("没有可编辑的帧", file=sys.stderr)
        return 2
    batch = a.title or os.path.basename(os.path.normpath(a.truth_dir))
    out = (TEMPLATE.replace("__TITLE__", html.escape(batch))
                   .replace("__LEVEL__", json.dumps(LEVEL))
                   .replace("__DATA__", json.dumps(frames, ensure_ascii=False))
                   .replace("__BATCH__", json.dumps(batch))
                   .replace("__SAVE_PREFIX__", json.dumps(a.save_prefix)))
    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
    open(a.out, "w", encoding="utf-8").write(out)
    n = sum(len(f["objects"]) for f in frames)
    print(f"frames={len(frames)} units={n} -> {os.path.abspath(a.out)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
