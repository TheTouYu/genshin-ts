#!/usr/bin/env python3
"""ys-scrollbar — 滚动条/滑块检测（**只读像素，不注入、不占屏**）。

判据唯一实现在 `tools/ys-editor/ys_scrollbar.py`；本文件只是 CLI 外壳，**不含任何判据常数**。
`tools/ys-scroll --seek-ratio` 与 `tools/ys-screen` 也 import 同一个模块。

用法
  tools/ys-scrollbar <png> [--json] [--orient v|h] [--debug]

输出
  默认一行人读摘要 + 一行机读：
    SCROLLBAR-RESULT found=1 orient=v pos=0.023 pages=1.78 track=[2425,164,2432,1359] thumb=[2425,176,2432,848]
    SCROLLBAR-RESULT found=0 reason=no_band
  `--json` 输出完整结构：
    {"found":bool,"orientation":"v|h"|null,"track_bbox":[x0,y0,x1,y1]|null,
     "thumb_bbox":[...]|null,"position_ratio":0..1|null,"thumb_ratio":float|null,
     "estimated_pages":float|null,"evidence":{...},"reason":str|null}

退出码
  0 = found    1 = 未找到（合法读数，附 reason）    3 = 读不到图    4 = 参数错

**拿不到就给 found:false + reason，绝不猜。** 宁可漏（假阴）也不要假阳——
假阳会让 `--seek-ratio` 把列表拖到错误位置，比"不会 seek"更糟。
"""
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, 'ys-editor'))

try:
    from PIL import Image          # noqa: F401  （依赖自检）
    import numpy as np             # noqa: F401
except Exception as exc:           # pragma: no cover
    print('缺少依赖：%s' % exc, file=sys.stderr)
    sys.exit(3)

try:
    import ys_scrollbar
except Exception as exc:           # pragma: no cover
    print('无法加载判据模块 ys-editor/ys_scrollbar.py：%s' % exc, file=sys.stderr)
    sys.exit(3)

USAGE = 'usage: ys-scrollbar <png> [--json] [--orient v|h] [--debug]'


def main(argv):
    path, as_json, orient, debug = None, False, 'v', False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ('-h', '--help'):
            print(__doc__)
            return 0
        elif a == '--json':
            as_json = True
        elif a == '--debug':
            debug = True
        elif a == '--orient':
            i += 1
            if i >= len(argv) or argv[i] not in ('v', 'h'):
                print(USAGE, file=sys.stderr)
                return 4
            orient = argv[i]
        elif a.startswith('-'):
            print('未知参数：%s\n%s' % (a, USAGE), file=sys.stderr)
            return 4
        else:
            path = a
        i += 1
    if not path:
        print(USAGE, file=sys.stderr)
        return 4
    if not os.path.exists(path):
        print('读不到图：%s' % path, file=sys.stderr)
        return 3
    try:
        res = ys_scrollbar.detect_path(path, orient=orient, debug=debug)
    except Exception as exc:
        print('解码失败：%s: %s' % (type(exc).__name__, exc), file=sys.stderr)
        return 3

    if as_json:
        print(json.dumps(res, ensure_ascii=False, sort_keys=True))
    if res.get('found'):
        ev = res.get('evidence') or {}
        print('SCROLLBAR-RESULT found=1 orient=%s pos=%.3f pages=%.2f track=%s thumb=%s'
              % (res['orientation'], res['position_ratio'], res['estimated_pages'],
                 _fmt(res['track_bbox']), _fmt(res['thumb_bbox'])))
        if not as_json:
            print('  带宽 %s 轨道长 %s 滑块长 %s 轨道中心 %s 滑块中心 %s rest_std %s'
                  % (ev.get('band_w'), ev.get('track_len'), ev.get('thumb_len'),
                     ev.get('track_center'), ev.get('thumb_center'), ev.get('rest_std')))
        return 0
    print('SCROLLBAR-RESULT found=0 reason=%s' % res.get('reason'))
    return 1


def _fmt(b):
    return '[%d,%d,%d,%d]' % tuple(b) if b else 'null'


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
