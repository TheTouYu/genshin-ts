#!/usr/bin/env python3
"""ys-scroll-scan — 逐屏采集可滚区域，合并去重成**全量**列表。

为什么必须有它（2026-10-18 用户实测点破，O-2026-10-18-04 ②）
--------------------------------------------------------------------------
用户原话：「无论是活动页面，还是本体的菜单，都没有考虑可以下滑的情况，导致信息丢失」。
`ys-screen` / `ys-ocr` / `ys-find` 都只读**当前可见区域**，且**没有任何"还有更多"的判据**
⇒ 把"这一屏没看到"当成"不存在"。这是遗漏型静默失败，比"识别错"更危险：
它不报错，只是让你在错误的前提上做决策。

判定方式刻意选**行为判定**而不是视觉判定
--------------------------------------------------------------------------
"有没有滚动条"靠像素判很不可靠（滚动条会淡出、会随主题变、会被遮挡）。
本工具反过来：**滚一下，看内容变没变**——
  · 变了 ⇒ 下面还有 ⇒ 继续
  · 没变 ⇒ 到底了 ⇒ 停，并记 `at_bottom=true`
这是可证伪的判据，不依赖任何视觉样式假设。

输入通道（实测）
----------------
`xdotool click 4/5`（X11 滚轮上/下）在 Xwayland 游戏窗上**实测有效**
（2026-10-18 在活动一览页验：文本 32 → 35 条，内容变化）。
⚠️ 必须在 `ys-gui-slot` 里跑（注入的前置是"执行前是什么窗口，执行后就还是什么窗口"）。

用法
----
  tools/ys-editor/ys-gui-slot 0x01400001 90 bash -c \\
      'tools/ys-scroll-scan --region 0,180,2560,1200 --json'

  选项:
    --region x,y,w,h   只采这个区域（缺省整帧）。列表类界面建议框住列表，排除 HUD。
    --direction down|up  缺省 down
    --step N           每步滚几格（缺省 3）
    --max N            最多翻几屏（缺省 8）——上限是硬约束，防止无限滚
    --json             机读输出
    --save-dir DIR     保存每屏帧作为证据（缺省不存）

输出
----
  {"items":[{"text":..., "cx":..., "cy":..., "first_page":N}],
   "pages":N, "at_bottom":bool, "changed_last":bool, "region":[...]}

退出码: 0 正常 / 2 取帧失败 / 3 参数错
"""
import argparse
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
YS = os.path.join(HERE, 'ys-editor')
sys.path.insert(0, YS)
import ys_env  # noqa: E402
OB = os.path.join(YS, 'ys-observe')
SOCK = os.environ.get('YS_LOOKD_SOCK', '/run/user/%d/ys-lookd.sock' % os.getuid())


def grab():
    """经唯一取数入口抓帧，返回路径；失败返回 (None, 原因)。"""
    env = dict(os.environ)
    env.setdefault('YS_SLOT_ACTIVE', '1')
    r = subprocess.run([OB, 'frame'], capture_output=True, text=True, timeout=120, env=env)
    if r.returncode != 0:
        return None, (r.stdout + r.stderr).strip()[:300]
    # ys-observe frame 返回的是**一行 JSON**（不是裸路径）：{"kind":"frame","path":...,"fresh":...}
    # 2026-10-18 踩过：直接取最后一行当路径 ⇒ OCR 拿到一段 JSON 文本 ⇒ 0 条框。
    line = (r.stdout or '').strip().splitlines()
    if not line:
        return None, 'ys-observe 无输出'
    try:
        d = json.loads(line[-1])
    except ValueError:
        return line[-1], None            # 兼容将来改成裸路径
    if not d.get('fresh') or not d.get('path'):
        return None, '取数不新鲜：%s' % json.dumps(d, ensure_ascii=False)[:200]
    return d['path'], None


def ocr_boxes(frame):
    """取 OCR 框：常驻服务优先（~0.7s），失败回退子进程。"""
    import socket
    if os.path.exists(SOCK):
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.settimeout(120)
            c.connect(SOCK)
            c.sendall((json.dumps({'cmd': 'ocr', 'frame': os.path.abspath(frame)}) + '\n').encode())
            data = b''
            while not data.endswith(b'\n'):
                ch = c.recv(65536)
                if not ch:
                    break
                data += ch
            c.close()
            r = json.loads(data.decode())
            if isinstance(r.get('boxes'), list) and not r.get('error'):
                return r['boxes']
        except (OSError, ValueError):
            pass
    py = os.environ.get('YS_RAPIDOCR_PY') or '/usr/bin/python3'
    p = subprocess.run([py, os.path.join(YS, 'ys_ocr.py'), 'ocr', frame, '--json'],
                       capture_output=True, text=True, timeout=180)
    if p.returncode != 0:
        return []
    try:
        return json.loads(p.stdout).get('boxes') or []
    except ValueError:
        return []


def in_region(box, region):
    if not region:
        return True
    x, y, w, h = region
    return x <= box['cx'] <= x + w and y <= box['cy'] <= y + h


_NOISE = __import__('re').compile(r'^[\s\d.,:;%\-+/x×MKGms]*$')


def visible_texts(boxes, region):
    """该区域内的文本集合（用于"变没变"的比对）——只比文本，不比坐标：
    滚动时同一批文本会**整体平移**，比坐标会把"平移"误判成"新增"。

    过滤噪声：FPS/耗时（"60.3"、"10.9 ms"）、序号（"2"、"3"）、单字符（"N"、"Z"）
    这些每帧都可能抖，会把"画面在动"误判成"滚出了新内容"（实测世界页 diffs 0.364）。
    """
    out = set()
    for b in boxes:
        if not in_region(b, region):
            continue
        t = (b['text'] or '').strip()
        if len(t) < 2 or _NOISE.match(t):
            continue
        out.add(t)
    return out


def pix_delta(p1, p2, region=None):
    """区域内**像素**变化比例 —— 文本判据的第二通道。

    为什么必须有：2026-10-19 实测，背包网格滚动时文本几乎不变（全是 Lv.90 / ★食★），
    文本集 Jaccard = 0.7826 > 阈值 0.15 ⇒ 单靠文本判"没变"，判成**不可滚**，
    而同期像素实测变化 **85.7%**（滚回去与原图差 0.15%）。
    ⇒ 纯图形列表的滚动，文本判据必然假阴性。
    """
    try:
        from PIL import Image
        import numpy as np
    except ImportError:
        return 0.0
    try:
        a1 = np.asarray(Image.open(p1).convert('RGB'), dtype=np.int16)
        a2 = np.asarray(Image.open(p2).convert('RGB'), dtype=np.int16)
    except (OSError, ValueError):
        return 0.0
    if a1.shape != a2.shape:
        return 1.0
    if region:
        x, y, w, h = region
        a1, a2 = a1[y:y + h, x:x + w], a2[y:y + h, x:x + w]
    if a1.size == 0:
        return 0.0
    d = np.abs(a1 - a2).sum(2)
    return float((d > 30).mean())


def scroll(direction, step, region=None, at=None):
    """发滚轮事件。

    ⚠️ 必须先把**指针移到目标区域**——`xdotool click` 用的是当前指针位置，
    指针要是不在可滚区上，滚轮会被游戏当视角缩放/无效操作吞掉。
    2026-10-18 实测踩过：没移指针 ⇒ 活动页 diffs=[0.0]（滚了等于没滚），
    却把"判不出来"误读成"没有更多"。
    """
    px, py = at if at else (None, None)
    if px is None and region:
        x, y, w, h = region
        px, py = x + w // 2, y + h // 2
    if px is not None:
        subprocess.run(['xdotool', 'mousemove', str(px), str(py)],
                       capture_output=True, timeout=30)
        time.sleep(0.15)
    btn = '5' if direction == 'down' else '4'
    subprocess.run(['xdotool', 'click', '--repeat', str(step), '--delay', '120', btn],
                   capture_output=True, timeout=60)


def main(argv=None):
    ys_env.apply()   # 进程内 os.environ 一次到位：scroll() 的 xdotool 子进程全继承它
    ap = argparse.ArgumentParser()
    ap.add_argument('--region', default='')
    ap.add_argument('--direction', default='down', choices=('down', 'up'))
    ap.add_argument('--step', type=int, default=3)
    ap.add_argument('--max', type=int, default=8, dest='nmax')
    ap.add_argument('--json', action='store_true')
    ap.add_argument('--save-dir', default='')
    # --check：只回答"这块要不要滚"。判据仍是行为（滚一次看内容变没变），
    # 因为像素启发式实测不可靠：世界页右侧队伍栏的对比度比真滚动条还高，
    # 按"右侧有竖条就是可滚"会误报（2026-10-18 实测）。
    ap.add_argument('--at', default='', help='滚轮生效点 x,y（缺省=区域中心）')
    ap.add_argument('--pixdelta', type=float, default=0.25,
                    help='像素变化比例阈值（区域内的占比）。文本判据之外的第二通道；'
                         '2026-10-19 实测背包：真滚动 0.857 / 往返 0.0015 ⇒ 0.25 余量充足')
    ap.add_argument('--jaccard', type=float, default=0.15,
                    help='判定内容变了的集合差异阈值（缺省 0.15；实测可滚页 0.22~0.36 / 不可滚页 0.0）')
    ap.add_argument('--check', action='store_true',
                    help='只判断可滚性：可滚退出 1（下面还有）、不可滚退出 0')
    a = ap.parse_args(argv)

    region = None
    if a.region:
        try:
            region = tuple(int(v) for v in a.region.split(','))
            if len(region) != 4:
                raise ValueError
        except ValueError:
            sys.stderr.write('--region 要 x,y,w,h 四个整数\n')
            return 3

    at_point = None
    if a.at:
        try:
            at_point = tuple(int(v) for v in a.at.split(','))
        except ValueError:
            sys.stderr.write('--at 要 x,y\n')
            return 3
    frame, err = grab()
    if not frame:
        sys.stderr.write('取帧失败（是否在 ys-gui-slot 里？）：%s\n' % err)
        return 2
    if a.save_dir:
        os.makedirs(a.save_dir, exist_ok=True)

    items, seen = [], {}
    prev = None
    prev_frame = None
    diffs, pixdiffs = [], []
    pages = 0
    at_bottom = False
    changed_last = False

    at_point = None
    if a.at:
        try:
            at_point = tuple(int(v) for v in a.at.split(','))
        except ValueError:
            sys.stderr.write('--at 要 x,y\n')
            return 3

    for page in range(1, a.nmax + 1):
        if page > 1:
            frame, err = grab()
            if not frame:
                sys.stderr.write('第 %d 屏取帧失败：%s\n' % (page, err))
                return 2
        if a.save_dir:
            import shutil
            shutil.copy(frame, os.path.join(a.save_dir, 'page%02d.png' % page))
        boxes = ocr_boxes(frame)
        cur = visible_texts(boxes, region)
        pages = page

        # 「内容变了」必须容忍 OCR 抖动：游戏画面本身在动（血条/粒子/帧数），
        # 同一屏前后两次 OCR 也会有一两个字符差异。用**集合差异比例**判，而不是 `cur != prev`
        # （2026-10-18 实测：用 != 判，提瓦特世界这种**完全不可滚**的画面也被判成"可滚"，
        #  因为队伍名/FPS 抖动了一下）。阈值取 0.35：滚一屏通常换掉 1/3 以上文本。
        if prev is None:
            changed = False
        else:
            union = prev | cur
            diff = len(prev ^ cur) / float(len(union) or 1)
            text_changed = diff >= a.jaccard   # 0.15：实测可滚页 ≥0.22、不可滚页 0.0
            diffs.append(round(diff, 3))
            pdelta = pix_delta(prev_frame, frame, region) if prev_frame else 0.0
            pixdiffs.append(round(pdelta, 4))
            # 双通道：文本变了 **或** 像素大面积变了，都算"还有更多"。
            # 单靠文本 = 纯图形列表假阴性（背包实测）；单靠像素 = 3D 动画假阳性 ⇒ 必须取或。
            changed = text_changed or (pdelta >= a.pixdelta)
        changed_last = changed
        if prev is not None and not changed:
            at_bottom = True            # 滚完没变化 ⇒ 到底（或这一屏原本就不可滚）
            break

        for b in boxes:
            if not in_region(b, region):
                continue
            t = b['text']
            if t in seen:
                continue                # 去重：同一文本只留**首次出现**（滚下去它还会再出现）
            seen[t] = True
            items.append({'text': t, 'cx': b['cx'], 'cy': b['cy'], 'first_page': page})

        prev = cur
        prev_frame = frame
        scroll(a.direction, a.step, region=region, at=at_point)
        time.sleep(1.0)                 # 等滚动动画落定（不是"用时长冒充同步"：下一步会验证变化）

    out = {'items': items, 'pages': pages, 'at_bottom': at_bottom, 'diffs': diffs,
           'pixdiffs': pixdiffs,
           'changed_last': changed_last, 'region': list(region) if region else None,
           'direction': a.direction}
    if a.check:
        # 语义：退出码 1 = 还有更多（可滚），0 = 到底/不可滚。与 grep 的"找到=0"相反，
        # 这里刻意让"还有信息没看"成为**非零**（异常才是非零，符合 shell 惯例）。
        print('scrollable=%s pages=%d at_bottom=%s text_diffs=%s pix_diffs=%s'
              % ('yes' if not at_bottom else 'no', pages, at_bottom, diffs, pixdiffs))
        return 0 if at_bottom else 1
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print('══ ys-scroll-scan %s  %d 屏  %d 条文本 ══' % (a.direction, pages, len(items)))
        for it in items:
            print('  [p%d] %s' % (it['first_page'], it['text']))
        print('到底: %s' % ('是' if at_bottom else '否（达上限 %d 屏）' % a.nmax))
    return 0


if __name__ == '__main__':
    sys.exit(main())
