{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.04,
      "to": 2.36,
      "sid": 1,
      "location": 2,
      "content": "千行奇遇带来了革命性的更新",
      "music": 0.0
    },
    {
      "from": 2.36,
      "to": 6.38,
      "sid": 2,
      "location": 2,
      "content": "在新的版本不仅可以创作更多2D交互游戏",
      "music": 0.0
    },
    {
      "from": 6.38,
      "to": 9.5,
      "sid": 3,
      "location": 2,
      "content": "还可以制作更多有趣好玩的动画效果",
      "music": 0.0
    },
    {
      "from": 9.5,
      "to": 13.54,
      "sid": 4,
      "location": 2,
      "content": "接下来便让我们看看编辑器的主要更新内容吧",
      "music": 0.0
    },
    {
      "from": 13.54,
      "to": 16.7,
      "sid": 5,
      "location": 2,
      "content": "首先来介绍的便是这个版本的重头功能",
      "music": 0.0
    },
    {
      "from": 16.7,
      "to": 18.41,
      "sid": 6,
      "location": 2,
      "content": "客户端控件容器",
      "music": 0.0
    },
    {
      "from": 18.41,
      "to": 21.65,
      "sid": 7,
      "location": 2,
      "content": "客户端控件容器是一个新的界面控件",
      "music": 0.1268656669079973
    },
    {
      "from": 21.65,
      "to": 25.39,
      "sid": 8,
      "location": 2,
      "content": "在界面控件组库中作为服务器控件模板存在",
      "music": 0.0
    },
    {
      "from": 25.39,
      "to": 27.87,
      "sid": 9,
      "location": 2,
      "content": "它的生成依然是通过节点图生成",
      "music": 0.15740740012002935
    },
    {
      "from": 27.87,
      "to": 31.66,
      "sid": 10,
      "location": 2,
      "content": "但它的内部逻辑全都是交由客户端脚本执行",
      "music": 0.0
    },
    {
      "from": 31.66,
      "to": 33.22,
      "sid": 11,
      "location": 2,
      "content": "进入编辑界面",
      "music": 0.0
    },
    {
      "from": 33.22,
      "to": 35.44,
      "sid": 12,
      "location": 2,
      "content": "左侧层级与以前的层级不同",
      "music": 0.0
    },
    {
      "from": 35.44,
      "to": 38.94,
      "sid": 13,
      "location": 2,
      "content": "客户端控件容器存在父子节点的层级关系",
      "music": 0.06329113723762307
    },
    {
      "from": 38.94,
      "to": 41.92,
      "sid": 14,
      "location": 2,
      "content": "会更加偏向一般的游戏引擎的逻辑",
      "music": 0.0
    },
    {
      "from": 41.92,
      "to": 43.44,
      "sid": 15,
      "location": 2,
      "content": "而在控件的属性栏",
      "music": 0.0
    },
    {
      "from": 43.44,
      "to": 45.87,
      "sid": 16,
      "location": 2,
      "content": "这里能看见多了一个脚本的选项",
      "music": 0.0
    },
    {
      "from": 45.87,
      "to": 47.07,
      "sid": 17,
      "location": 2,
      "content": "我们来到沙箱",
      "music": 0.0
    },
    {
      "from": 47.07,
      "to": 50.35,
      "sid": 18,
      "location": 2,
      "content": "在左上角多出了客户端脚本资源管理器选项",
      "music": 0.0
    },
    {
      "from": 50.35,
      "to": 52.9,
      "sid": 19,
      "location": 2,
      "content": "我们所有的脚本都在这里管理",
      "music": 0.0
    },
    {
      "from": 52.9,
      "to": 56.22,
      "sid": 20,
      "location": 2,
      "content": "在空白处右键即可添加脚本",
      "music": 0.0
    },
    {
      "from": 57.01,
      "to": 58.81,
      "sid": 21,
      "location": 2,
      "content": "脚本的实际单独存档",
      "music": 0.2545454391184584
    },
    {
      "from": 58.81,
      "to": 61.05,
      "sid": 22,
      "location": 2,
      "content": "在我们的磁盘位置创建后",
      "music": 0.0
    },
    {
      "from": 61.05,
      "to": 63.09,
      "sid": 23,
      "location": 2,
      "content": "双击即可打开脚本进行编写",
      "music": 0.0
    },
    {
      "from": 63.09,
      "to": 65.87,
      "sid": 24,
      "location": 2,
      "content": "由于暂时不能展示文档内容",
      "music": 0.0
    },
    {
      "from": 65.87,
      "to": 68.27,
      "sid": 25,
      "location": 2,
      "content": "因此本视频将不作为教程介绍",
      "music": 0.37313430979431467
    },
    {
      "from": 68.27,
      "to": 71.05,
      "sid": 26,
      "location": 2,
      "content": "为pi内容仅做简单的概念介绍",
      "music": 0.3526970808009551
    },
    {
      "from": 71.05,
      "to": 73.67,
      "sid": 27,
      "location": 2,
      "content": "我会在下面的示例中写上注释",
      "music": 0.0
    },
    {
      "from": 73.67,
      "to": 77.23,
      "sid": 28,
      "location": 2,
      "content": "感兴趣的奇酱可以在网上搜索洛E语言教程",
      "music": 0.207667724994638
    },
    {
      "from": 77.23,
      "to": 78.37,
      "sid": 29,
      "location": 2,
      "content": "学习基本概念",
      "music": 0.5533980045244583
    },
    {
      "from": 78.37,
      "to": 81.75,
      "sid": 30,
      "location": 2,
      "content": "我们把刚才创建的脚本挂在在容器节点上",
      "music": 0.0
    },
    {
      "from": 81.75,
      "to": 84.68,
      "sid": 31,
      "location": 2,
      "content": "脚本的逻辑实际上和节点图类似",
      "music": 0.13559321459350582
    },
    {
      "from": 84.68,
      "to": 87.66,
      "sid": 32,
      "location": 2,
      "content": "官方定义了一些公共事件和公共方法",
      "music": 0.0
    },
    {
      "from": 87.66,
      "to": 90.44,
      "sid": 33,
      "location": 2,
      "content": "例如在脚本中写下UNSTLE函数",
      "music": 0.0
    },
    {
      "from": 90.44,
      "to": 92.52,
      "sid": 34,
      "location": 2,
      "content": "可执行控件生成时事件",
      "music": 0.0
    },
    {
      "from": 92.52,
      "to": 95.729,
      "sid": 35,
      "location": 2,
      "content": "r und sty则是控件销毁时的事件",
      "music": 0.0
    },
    {
      "from": 95.969,
      "to": 99.329,
      "sid": 36,
      "location": 2,
      "content": "我们在函数内写下由官方提供的pin函数",
      "music": 0.0
    },
    {
      "from": 99.329,
      "to": 101.87,
      "sid": 37,
      "location": 2,
      "content": "便可以执行打印日志的行为",
      "music": 0.0
    },
    {
      "from": 101.87,
      "to": 105.19,
      "sid": 38,
      "location": 2,
      "content": "结合起来能看到进入试玩和退出试玩",
      "music": 0.0
    },
    {
      "from": 105.19,
      "to": 107.31,
      "sid": 39,
      "location": 2,
      "content": "分别输出了一次日志",
      "music": 0.0
    },
    {
      "from": 110.02,
      "to": 112.3,
      "sid": 40,
      "location": 2,
      "content": "脚本拥有脚本变量管理区域",
      "music": 0.0
    },
    {
      "from": 112.3,
      "to": 116.74,
      "sid": 41,
      "location": 2,
      "content": "类似节点图变量可以创建变量后供脚本读取",
      "music": 0.0
    },
    {
      "from": 120.44,
      "to": 122.12,
      "sid": 42,
      "location": 2,
      "content": "也可以选择公开变量",
      "music": 0.0
    },
    {
      "from": 122.12,
      "to": 125.2,
      "sid": 43,
      "location": 2,
      "content": "在控件的脚本区域选择编辑变量",
      "music": 0.0
    },
    {
      "from": 133.98,
      "to": 136.5,
      "sid": 44,
      "location": 2,
      "content": "客户端的控件除了基本的文本框",
      "music": 0.0
    },
    {
      "from": 136.5,
      "to": 137.24,
      "sid": 45,
      "location": 2,
      "content": "图片等",
      "music": 0.0
    },
    {
      "from": 137.24,
      "to": 139.16,
      "sid": 46,
      "location": 2,
      "content": "将更多逻辑拆分开来了",
      "music": 0.0
    },
    {
      "from": 139.16,
      "to": 142.09,
      "sid": 47,
      "location": 2,
      "content": "例如单独的按键提示和网格视窗",
      "music": 0.0
    },
    {
      "from": 142.09,
      "to": 143.29,
      "sid": 48,
      "location": 2,
      "content": "在交互这块",
      "music": 0.0
    },
    {
      "from": 143.29,
      "to": 145.11,
      "sid": 49,
      "location": 2,
      "content": "它不再是由按钮设置按键",
      "music": 0.0
    },
    {
      "from": 145.11,
      "to": 147.95,
      "sid": 50,
      "location": 2,
      "content": "而是转为在脚本中设置按键的监听",
      "music": 0.11811023157046818
    },
    {
      "from": 147.95,
      "to": 150.41,
      "sid": 51,
      "location": 2,
      "content": "监听按钮触发并执行行为",
      "music": 0.0
    },
    {
      "from": 150.41,
      "to": 152.47,
      "sid": 52,
      "location": 2,
      "content": "因此我们需要一个按键提示",
      "music": 0.0
    },
    {
      "from": 152.47,
      "to": 156.22,
      "sid": 53,
      "location": 2,
      "content": "来提醒玩家使用哪个按键触发行为",
      "music": 0.0
    },
    {
      "from": 168.06,
      "to": 170.36,
      "sid": 54,
      "location": 2,
      "content": "特别的光标检测区域",
      "music": 0.0
    },
    {
      "from": 170.36,
      "to": 171.74,
      "sid": 55,
      "location": 2,
      "content": "作为全新的控件",
      "music": 0.0
    },
    {
      "from": 171.74,
      "to": 174.4,
      "sid": 56,
      "location": 2,
      "content": "它可以检测该控件区域内的光标事件",
      "music": 0.0
    },
    {
      "from": 174.4,
      "to": 175.72,
      "sid": 57,
      "location": 2,
      "content": "或鼠标事件",
      "music": 0.0
    },
    {
      "from": 175.72,
      "to": 177.04,
      "sid": 58,
      "location": 2,
      "content": "支持多点触控",
      "music": 0.0
    },
    {
      "from": 177.04,
      "to": 179.56,
      "sid": 59,
      "location": 2,
      "content": "便能提供光标的位置信息",
      "music": 0.05376343796971946
    },
    {
      "from": 183.62,
      "to": 186.74,
      "sid": 60,
      "location": 2,
      "content": "而模板引用控件将可以直接引用客户端",
      "music": 0.0
    },
    {
      "from": 186.74,
      "to": 188.9,
      "sid": 61,
      "location": 2,
      "content": "模板控件内的控件",
      "music": 0.0
    },
    {
      "from": 193.22,
      "to": 195.3,
      "sid": 62,
      "location": 2,
      "content": "它的作用类似素材组",
      "music": 0.4444444170096019
    },
    {
      "from": 195.3,
      "to": 198.0,
      "sid": 63,
      "location": 2,
      "content": "但是实际上在游戏中表现",
      "music": 0.08571428163265674
    },
    {
      "from": 198.0,
      "to": 199.96,
      "sid": 64,
      "location": 2,
      "content": "其实是将控件引用进来",
      "music": 0.0
    },
    {
      "from": 199.96,
      "to": 201.99,
      "sid": 65,
      "location": 2,
      "content": "可以查询到子节点",
      "music": 0.0
    },
    {
      "from": 207.16,
      "to": 208.2,
      "sid": 66,
      "location": 2,
      "content": "特别的是",
      "music": 0.0
    },
    {
      "from": 208.2,
      "to": 211.44,
      "sid": 67,
      "location": 2,
      "content": "脚本之间是可以通过require函数进行引用的",
      "music": 0.0
    },
    {
      "from": 211.44,
      "to": 212.77,
      "sid": 68,
      "location": 2,
      "content": "这个非常重要",
      "music": 0.0
    },
    {
      "from": 212.77,
      "to": 214.59,
      "sid": 69,
      "location": 2,
      "content": "相当于是复合节点的功能",
      "music": 0.0
    },
    {
      "from": 214.59,
      "to": 217.15,
      "sid": 70,
      "location": 2,
      "content": "可以便捷的引用方法或者数据",
      "music": 0.0
    },
    {
      "from": 217.15,
      "to": 218.97,
      "sid": 71,
      "location": 2,
      "content": "美华儿的实际入餐",
      "music": 0.0
    },
    {
      "from": 218.97,
      "to": 221.76,
      "sid": 72,
      "location": 2,
      "content": "为客户端脚本中显示的文件路径",
      "music": 0.0
    },
    {
      "from": 221.76,
      "to": 225.62,
      "sid": 73,
      "location": 2,
      "content": "例如我这里引用类文件夹下的log模块",
      "music": 0.0
    },
    {
      "from": 225.62,
      "to": 228.16,
      "sid": 74,
      "location": 2,
      "content": "触发long模块的debug函数",
      "music": 0.0
    },
    {
      "from": 228.16,
      "to": 230.68,
      "sid": 75,
      "location": 2,
      "content": "即可执行相应的行为",
      "music": 0.0
    },
    {
      "from": 232.74,
      "to": 235.44,
      "sid": 76,
      "location": 2,
      "content": "而在下的版本中让我非常惊喜",
      "music": 0.0
    },
    {
      "from": 235.44,
      "to": 237.519,
      "sid": 77,
      "location": 2,
      "content": "则是不见动画功能",
      "music": 0.0
    },
    {
      "from": 237.719,
      "to": 239.159,
      "sid": 78,
      "location": 2,
      "content": "但是我自己用了一会",
      "music": 0.0
    },
    {
      "from": 239.159,
      "to": 239.719,
      "sid": 79,
      "location": 2,
      "content": "发现",
      "music": 0.0
    },
    {
      "from": 239.719,
      "to": 241.719,
      "sid": 80,
      "location": 2,
      "content": "我想要通过代码创建动画",
      "music": 0.0
    },
    {
      "from": 241.719,
      "to": 243.579,
      "sid": 81,
      "location": 2,
      "content": "也不是非常容易的事情",
      "music": 0.0
    },
    {
      "from": 243.579,
      "to": 246.299,
      "sid": 82,
      "location": 2,
      "content": "想写win sequence就要写一长串代码",
      "music": 0.0
    },
    {
      "from": 246.299,
      "to": 247.579,
      "sid": 83,
      "location": 2,
      "content": "非常不优雅",
      "music": 0.0
    },
    {
      "from": 247.579,
      "to": 249.479,
      "sid": 84,
      "location": 2,
      "content": "因此我们发动传统异能",
      "music": 0.0
    },
    {
      "from": 249.479,
      "to": 250.859,
      "sid": 85,
      "location": 2,
      "content": "无论是多小的事情",
      "music": 0.0
    },
    {
      "from": 250.859,
      "to": 252.56,
      "sid": 86,
      "location": 2,
      "content": "都要先制作一份工具",
      "music": 0.13689252998681573
    },
    {
      "from": 252.56,
      "to": 254.44,
      "sid": 87,
      "location": 2,
      "content": "因此我和百里一起",
      "music": 0.38028166336044394
    },
    {
      "from": 254.44,
      "to": 256.56,
      "sid": 88,
      "location": 2,
      "content": "共同制作和优化了一份在线的工具",
      "music": 0.20754716002135887
    },
    {
      "from": 256.56,
      "to": 258.769,
      "sid": 89,
      "location": 2,
      "content": "客户端UI动画编辑器",
      "music": 0.13253011249820043
    },
    {
      "from": 258.769,
      "to": 262.149,
      "sid": 90,
      "location": 2,
      "content": "在这份工具中可以便捷的预览修改动画",
      "music": 0.0
    },
    {
      "from": 262.149,
      "to": 264.23,
      "sid": 91,
      "location": 2,
      "content": "导出动画数据给游戏使用",
      "music": 0.17045453576960368
    },
    {
      "from": 264.23,
      "to": 266.93,
      "sid": 92,
      "location": 2,
      "content": "在视频开头给大家演示的露米快跑",
      "music": 0.21951218619870178
    },
    {
      "from": 266.93,
      "to": 269.59,
      "sid": 93,
      "location": 2,
      "content": "同样是百里在这份编辑器中制作后得到的",
      "music": 0.0
    },
    {
      "from": 269.59,
      "to": 270.9,
      "sid": 94,
      "location": 2,
      "content": "动画数据",
      "music": 0.2197801956285314
    },
    {
      "from": 270.9,
      "to": 273.2,
      "sid": 95,
      "location": 2,
      "content": "目前仍然在调优阶段",
      "music": 0.12195121207613546
    },
    {
      "from": 273.2,
      "to": 276.06,
      "sid": 96,
      "location": 2,
      "content": "大家可以收藏这个网址或者关注我",
      "music": 0.0
    },
    {
      "from": 276.06,
      "to": 278.44,
      "sid": 97,
      "location": 2,
      "content": "未来我会发一个网页的使用教程里",
      "music": 0.0
    },
    {
      "from": 278.44,
      "to": 281.6,
      "sid": 98,
      "location": 2,
      "content": "同时有了补间动画语对话模板",
      "music": 0.0
    },
    {
      "from": 281.6,
      "to": 283.57,
      "sid": 99,
      "location": 2,
      "content": "也终于迎来了它的更新",
      "music": 0.20512819197895737
    },
    {
      "from": 283.57,
      "to": 286.93,
      "sid": 100,
      "location": 2,
      "content": "除了将所有的以外迁移至客户端以外",
      "music": 0.13127412620562093
    },
    {
      "from": 286.93,
      "to": 289.59,
      "sid": 101,
      "location": 2,
      "content": "还提供了更加还原元宝本身的历史对话",
      "music": 0.0
    },
    {
      "from": 289.59,
      "to": 290.47,
      "sid": 102,
      "location": 2,
      "content": "隐藏对话",
      "music": 0.0
    },
    {
      "from": 290.47,
      "to": 292.4,
      "sid": 103,
      "location": 2,
      "content": "自动对话等功能",
      "music": 0.0
    },
    {
      "from": 292.84,
      "to": 296.24,
      "sid": 104,
      "location": 2,
